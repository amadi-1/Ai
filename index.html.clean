 return'<div class="mmbar mm2"><select data-mmg>'+o+'</select><button type="button" data-mmz="out">−</button><span class="mut" style="min-width:36px;text-align:center">'+Math.round(MM.z*100).toLocaleString("fa-IR")+'٪</span><button type="button" data-mmz="in">+</button><button type="button" data-mmz="0">۱:۱</button></div>'}
