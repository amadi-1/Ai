while((m=re.exec(h))){var tds=m[1].match(/<t[dh][^>]*>[\s\S]*?<\/t[dh]>/gi);if(!tds||tds.length<2)continue;var lb=nz(oxStrip(tds[0]));
if(!/^شاخص(کل|فرابورس)/.test(lb)||/هموزن|همسنگ/.test(lb))continue;var x=oxVal(tds[1]);if(!x)continue;
if(/فرابورس/.test(lb)||(fi>=0&&m.index>fi)){if(!o.f)o.f=x}else if(!o.b)o.b=x}return o}
