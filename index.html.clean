function fxDetail(C){var F=C.fx||(C.fx={m:"and",mk:"b",c:[]}),sl=function(k,t,o,cur){return'<div class="fl"><label style="min-width:90px">'+t+'</label><select data-fxs="'+k+'" style="flex:1;max-width:none;min-width:0">'+o.map(function(x){return'<option value="'+x[0]+'"'+(x[0]===cur?" selected":"")+">"+x[1]+"</option>"}).join("")+"</select></div>"},o=function(k,v){return Object.keys(k).map(function(i){return'<option value="'+i+'">'+k[i]+'</option>'}).join("")};
var ks={};Object.keys(FXK).forEach(function(k){ks[k]=FXK[k][0]+(FXK[k][1]?" ("+FXK[k][1]+")":"")});
