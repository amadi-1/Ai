var code="// "+t0.replace(/\n/g," ")+"\n"+pre.join("\n")+(pre.length?"\n":"")+cf.filter(function(x,i,a){return a.indexOf(x)===i}).join("\n")+(cf.length?"\n":"")+conds.map(function(c){return"// شرط: "+c.c.trim()}).join("\n")+"\n"+expr;
return{code:code,msg:"کد از "+conds.length.toLocaleString("fa-IR")+" شرط ساخته شد"+(bad.length?"؛ این بخش‌ها فهمیده نشد: «"+bad.join("»، «")+"»":"")+". کد را بررسی و بعد «تست کد» را بزنید."}}

// ================= تابلوی ارزش بورس: دلاری از چارتیکس، ریالی از بورس =================
var CX={sym:"BRS00IRALLUSDCAP",bars:null,last:null,src:"",dbg:[],t:0,run:0,err:"",rg:"d"},RX={bars:null,last:null,mv:null,t:0,run:0,err:"",day:null,dayD:0,dt:0,dr:0};
try{var _cxc=JSON.parse(localStorage.getItem("cx1")||"null");if(_cxc&&_cxc.bars&&_cxc.sym===CX.sym){CX.bars=_cxc.bars;CX.last=_cxc.last;CX.src=_cxc.src;CX.t=_cxc.t||0}}catch(e){}
var CXJF=new Intl.DateTimeFormat("fa-IR-u-ca-persian",{year:"2-digit",month:"numeric",day:"numeric"});
// --- devalue (__NUXT_DATA__) ---
function cxUnflat(v){if(!Array.isArray(v))return v;var H={};function h(i){if(i===-1||i===-2)return undefined;if(i===-3)return NaN;if(i===-4)return Infinity;if(i===-5)return -Infinity;if(i===-6)return -0;if(typeof i!=="number")return i;if(i in H)return H[i];var x=v[i];
if(x===null||typeof x!=="object")return H[i]=x;
if(Array.isArray(x)){if(typeof x[0]==="string"){var tg=x[0];if(tg==="Date")return H[i]=new Date(x[1]);if(tg==="Set"){var s=[];H[i]=s;for(var a=1;a<x.length;a++)s.push(h(x[a]));return s}if(tg==="Map"){var mo={};H[i]=mo;for(var b=1;b<x.length;b+=2)mo[String(h(x[b]))]=h(x[b+1]);return mo}if(tg==="null"){var no={};H[i]=no;for(var c=1;c<x.length;c+=2)no[x[c]]=h(x[c+1]);return no}if(/^(EmptyRef|EmptyShallowRef|undefined)$/.test(tg))return H[i]=undefined;return H[i]=h(x[1])}
var ar0=[];H[i]=ar0;x.forEach(function(j){ar0.push(h(j))});return ar0}
var o={};H[i]=o;for(var k in x)o[k]=h(x[k]);return o}return h(0)}
function cxNuxt(html){var m=/<script[^>]*id=["']__NUXT_DATA__["'][^>]*>([\s\S]*?)<\/script>/i.exec(html);if(m){try{return cxUnflat(JSON.parse(m[1]))}catch(e){}}
m=/window\.__NUXT__\s*=\s*(\{[\s\S]*?\})\s*;?\s*<\/script>/.exec(html);if(m){try{return JSON.parse(m[1])}catch(e){}}return null}
// --- جستجوی سری قیمت (OHLC) و آخرین مقدار در هر ساختاری ---
function cxNum(x){if(typeof x==="number")return isFinite(x)?x:null;if(typeof x==="string"){var s=lat(x).replace(/[,٬\s]/g,"");if(/^-?\d+(\.\d+)?$/.test(s))return parseFloat(s)}return null}
function cxTime(x){if(x instanceof Date)return{k:x.getTime(),lab:CXJF.format(x)};var n=cxNum(x);if(n!=null){if(n>1e11)return{k:n,lab:CXJF.format(new Date(n))};if(n>1e9)return{k:n*1000,lab:CXJF.format(new Date(n*1000))};if(n>19000000&&n<21000000){var d=new Date(Math.floor(n/1e4),Math.floor(n/100)%100-1,n%100);return{k:d.getTime(),lab:CXJF.format(d)}}if(n>13000000&&n<15000000)return{k:n,lab:String(n).replace(/(\d{4})(\d\d)(\d\d)/,"$1/$2/$3"),j:1}}
if(typeof x==="string"){var s=lat(x),mj=/^(1[34]\d\d)[\/-](\d{1,2})[\/-](\d{1,2})/.exec(s);if(mj)return{k:+mj[1]*1e4+ +mj[2]*100+ +mj[3],lab:s.slice(0,10),j:1};var t=Date.parse(s);if(isFinite(t)&&t>0)return{k:t,lab:CXJF.format(new Date(t))}}return null}
var CXK={t:/^(t|time|timestamp|date|datetime|d|x|ts|day|tarikh|dt|candle_?time|date_?time)$/i,c:/^(c|close|closing|value|price|last|y|v|close_?price|final)$/i,o:/^(o|open|first|open_?price)$/i,h:/^(h|high|max|high_?price)$/i,l:/^(l|low|min|low_?price)$/i};
function cxKey(o,re){for(var k in o)if(re.test(k))return k;return null}
function cxSeries(a){if(!Array.isArray(a)||a.length<5)return null;var s=a[Math.floor(a.length/2)],out=[];
if(s&&typeof s==="object"&&!Array.isArray(s)){var kt=cxKey(s,CXK.t),kc=cxKey(s,CXK.c);if(!kt||!kc)return null;var ko=cxKey(s,CXK.o),kh=cxKey(s,CXK.h),kl=cxKey(s,CXK.l);
a.forEach(function(r){if(!r)return;var tm=cxTime(r[kt]),c=cxNum(r[kc]);if(tm&&c!=null&&c>0)out.push({k:tm.k,lab:tm.lab,c:c,o:ko?cxNum(r[ko]):null,h:kh?cxNum(r[kh]):null,l:kl?cxNum(r[kl]):null})})}
else if(Array.isArray(s)&&s.length>=2&&cxTime(s[0])&&cxNum(s[s.length-1])!=null){a.forEach(function(r){if(!Array.isArray(r))return;var tm=cxTime(r[0]),n=r.length;if(!tm)return;if(n>=5){var o=cxNum(r[1]),h=cxNum(r[2]),l=cxNum(r[3]),c=cxNum(r[4]);if(c>0)out.push({k:tm.k,lab:tm.lab,o:o,h:h,l:l,c:c})}else{var c2=cxNum(r[1]);if(c2>0)out.push({k:tm.k,lab:tm.lab,c:c2})}})}
else return null;
if(out.length<5)return null;out.sort(function(x,y){return x.k-y.k});var u=[];out.forEach(function(b){if(u.length&&u[u.length-1].k===b.k)u[u.length-1]=b;else u.push(b)});return u}
function cxUdf(o){if(!o||typeof o!=="object"||!Array.isArray(o.t)||!Array.isArray(o.c)||o.t.length<5)return null;var out=[];for(var i=0;i<o.t.length;i++){var tm=cxTime(o.t[i]),c=cxNum(o.c[i]);if(tm&&c>0)out.push({k:tm.k,lab:tm.lab,c:c,o:o.o?cxNum(o.o[i]):null,h:o.h?cxNum(o.h[i]):null,l:o.l?cxNum(o.l[i]):null})}return out.length>=5?out:null}
function cxFind(root){var best=null,last=null,q=[root],seen=[],n=0;
while(q.length&&n++<200000){var x=q.shift();if(!x||typeof x!=="object")continue;if(seen.indexOf(x)>=0)continue;if(seen.length<20000)seen.push(x);
var u=cxUdf(x);if(u&&(!best||u.length>best.length))best=u;
if(Array.isArray(x)){var se=cxSeries(x);if(se&&(!best||se.length>best.length))best=se;for(var i=0;i<x.length&&i<5000;i++)if(x[i]&&typeof x[i]==="object")q.push(x[i])}
else{var hasSym=false;for(var k in x){var v=x[k];if(typeof v==="string"&&v.toUpperCase().indexOf(CX.sym)>=0)hasSym=true;if(v&&typeof v==="object")q.push(v)}
if(hasSym){var kl=cxKey(x,/^(last|last_?price|price|close|value|c|pl|pc|close_?price|lastValue)$/i),kp=cxKey(x,/(percent|pct|change_?p|changePercent|cp|darsad|change_percent)/i),kch=cxKey(x,/^(change|chg|diff|ch)$/i);if(kl&&cxNum(x[kl])>0)last={v:cxNum(x[kl]),pc:kp?cxNum(x[kp]):null,ch:kch?cxNum(x[kch]):null,h:cxNum(x[cxKey(x,CXK.h)]),l:cxNum(x[cxKey(x,CXK.l)]),o:cxNum(x[cxKey(x,CXK.o)])}}}}
return{bars:best,last:last}}
function cxUrls(html){var o={},rx=/https?:\/\/[a-z0-9.-]*chartix\.ir(?:\/[^"'\s<>\\)]*)?/gi,m;while((m=rx.exec(html))){var u=m[0].replace(/[.,;]+$/,"");if(/\.(png|jpe?g|svg|webp|css|ico|woff2?)(\?|$)/i.test(u))continue;o[u]=1}
var r2=/["'](\/api\/[^"'\s<>]*)["']/g;while((m=r2.exec(html)))o["https://chartix.ir"+m[1]]=1;return Object.keys(o).slice(0,40)}
async function cxTry(url){try{var b=await GET(url),j=null;try{j=JSON.parse(b)}catch(e){}if(j==null)return null;var f=cxFind(Array.isArray(j)&&typeof j[0]!=="object"?cxUnflat(j):j);if(!(f.bars&&f.bars.length>=5)){try{var f2=cxFind(cxUnflat(j));if(f2.bars)f=f2}catch(e){}}return f.bars&&f.bars.length>=5?f:null}catch(e){CX.dbg.push(url.replace(/^https?:\/\//,"")+" ✗");return null}}
async function cxLoad(force){if(CX.run)return;if(!force&&CX.bars&&Date.now()-CX.t<5*60e3)return;CX.run=1;CX.err="";CX.dbg=[];cxPaint();
var to=Math.floor(Date.now()/1000),fr=to-3*365*86400,sym=CX.sym,page="https://chartix.ir/market/saham/"+sym,ok=null,how="";
try{var tpl=localStorage.getItem("cxu");if(tpl){ok=await cxTry(tpl.replace("{s}",sym).replace("{f}",fr).replace("{t}",to));if(ok)how="آدرس ذخیره‌شده"}}catch(e){}
var html="";if(!ok){try{html=await GET(page);CX.dbg.push("صفحه‌ی چارتیکس: "+html.length.toLocaleString("fa-IR")+" نویسه");var nd=cxNuxt(html);CX.dbg.push(nd?"داده‌ی Nuxt پیدا شد":"داده‌ی Nuxt پیدا نشد");if(nd){var f=cxFind(nd);if(f.last)CX.last=f.last;if(f.bars){ok=f;how="داده‌ی داخل صفحه"}}}catch(e){CX.dbg.push("صفحه‌ی چارتیکس باز نشد: "+(e&&e.message||e))}}
if(!ok){var c1=[page+"/_payload.json",page+"/_payload.js"];for(var i=0;i<c1.length&&!ok;i++){ok=await cxTry(c1[i]);if(ok)how="payload"}}
if(!ok){var bases=["https://chartix.ir/api","https://api.chartix.ir","https://chartix.ir/api/v1","https://api.chartix.ir/v1","https://chartix.ir/api/udf","https://api.chartix.ir/udf","https://chartix.ir/tv","https://data.chartix.ir"];
cxUrls(html).forEach(function(u){if(/api|udf|feed|data|tv/i.test(u)&&!/\/market\//.test(u)){var b=u.replace(/\/(history|symbols|config|time|search)(\?.*)?$/,"").replace(/\?.*$/,"");if(bases.indexOf(b)<0)bases.unshift(b)}});
var pats=["{b}/history?symbol={s}&resolution=D&from={f}&to={t}","{b}/history?symbol={s}&resolution=1D&from={f}&to={t}","{b}/udf/history?symbol={s}&resolution=D&from={f}&to={t}","{b}/chart/{s}","{b}/market/saham/{s}","{b}/symbols/{s}/history"];
outer:for(var a=0;a<bases.length&&a<12;a++)for(var p=0;p<pats.length;p++){var t=pats[p].replace("{b}",bases[a]),u2=t.replace("{s}",sym).replace("{f}",fr).replace("{t}",to);ok=await cxTry(u2);if(ok){how=u2.replace(/^https?:\/\//,"").replace(/\?.*$/,"");try{localStorage.setItem("cxu",t.replace(/symbol=[^&]*/,"symbol={s}").replace(/from=\d+/,"from={f}").replace(/to=\d+/,"to={t}").replace(bases[a],bases[a]))}catch(e){}break outer}}}
if(ok){CX.bars=ok.bars;if(ok.last)CX.last=ok.last;CX.src=how;CX.t=Date.now();try{localStorage.setItem("cx1",JSON.stringify({sym:CX.sym,bars:CX.bars.slice(-800),last:CX.last,src:CX.src,t:CX.t}))}catch(e){}}
else CX.err=CX.bars?"آخرین تلاش برای گرفتن داده از چارتیکس ناموفق بود؛ داده‌ی قبلی نمایش داده می‌شود.":"داده‌ی ارزش دلاری از چارتیکس خوانده نشد.";
CX.run=0;cxPaint()}
async function rxLoad(force){if(RX.run)return;if(!force&&RX.bars&&Date.now()-RX.t<60e3)return;RX.run=1;RX.err="";
try{var hi=firstArr(JSON.parse(await GET(TS+"Index/GetIndexB2History/"+IDX)).indexB2||[]),b=[];hi.forEach(function(x){var d=num(x.dEven),c=idxClose(x);if(!(d>0&&c>0))return;var tm=cxTime(d);if(!tm)return;b.push({k:tm.k,lab:tm.lab,c:c,h:ixPick(x,/^xNivInuPh/i),l:ixPick(x,/^xNivInuPb/i),o:ixPick(x,/^xNivInuOp|first/i)})});b.sort(function(x,y){return x.k-y.k});if(b.length)RX.bars=b}catch(e){RX.err="سابقه‌ی شاخص کل از بورس دریافت نشد."}
try{var a=firstArr(JSON.parse(await GETC(TS+"Index/GetIndexB1LastAll/All/1",4000)).indexB1||[]);for(var i=0;i<a.length;i++){if(String(a[i].insCode)===String(IDX)||/^شاخص کل$/.test(nz(a[i].lVal30||""))){var r=a[i];RX.last={v:idxClose(r),h:ixPick(r,/^xPhNivJIdx|max|high/i),l:ixPick(r,/^xPbNivJIdx|min|low/i),pc:ixPick(r,/^xVarIdxJRfV|percent/i),ch:ixPick(r,/^indexChange$/i)};break}}}catch(e){}
try{var mv=0,p0=0;for(var q=1;q<=2;q++){try{var mj=JSON.parse(await GETC(TS+"MarketData/GetMarketOverview/"+q,30000)),v0=findNum(mj,[/^marketValue$/i,/marketValue/i],1e9);if(v0&&v0!==p0){mv+=v0;p0=v0}}catch(e){}}if(mv>0)RX.mv=mv}catch(e){}
RX.t=Date.now();RX.run=0;cxPaint()}
// ---- نقاط نمودار برای هر بازه (مثل نمودار عمق بازار) ----
function vcJ(k){if(k<1e9){return[Math.floor(k/1e4),Math.floor(k/100)%100,k%100]}var d=new Date(k);return cdj(d.getFullYear()*1e4+(d.getMonth()+1)*100+d.getDate())}
function vcHM(h){h=+h;var p=function(x){return(x<10?"0":"")+x};return faD(p(Math.floor(h/10000))+":"+p(Math.floor(h/100)%100))}
function vcDays(b,rg){if(!b||!b.length)return null;var days={w:7,m:31,q:93,y:366}[rg]||31,lastK=b[b.length-1].k,cut;
if(lastK<1e9){var j=cdj(key(add(today,-days)));cut=j[0]*1e4+j[1]*100+j[2]}else cut=Date.now()-days*86400e3;
var a=b.filter(function(x){return x.k>=cut});if(a.length<2)a=b.slice(-Math.min(b.length,{w:5,m:22,q:66,y:250}[rg]||22));if(a.length<2)return null;
return a.map(function(x){var j=vcJ(x.k);return{l:cjs(j,"md"),f:cjs(j,"full"),v:x.c,o:x.o,h:x.h,lo:x.l}})}
function vcIrrDay(){var a=RX.day;if(!a||a.length<2)return null;var j=RX.dayD?cdj(RX.dayD):cdj(key(today));return a.map(function(x){var hm=vcHM(x.h);return{l:hm,f:cjs(j,"full")+" ساعت "+hm,v:x.v}})}
function vcUsdDay(){var P=vcIrrDay(),cur=(CX.last&&CX.last.v>0)?CX.last.v:(CX.bars&&CX.bars.length?CX.bars[CX.bars.length-1].c:0);if(!P||!(cur>0))return null;var il=P[P.length-1].v;if(!(il>0))return null;return P.map(function(p){return{l:p.l,f:p.f,v:cur*p.v/il}})}
var VC={};
function vcNorm(P){return P.map(function(a,k){var o=a.o>0?a.o:(k?P[k-1].v:a.v),c=a.v,h=Math.max(a.h>0?a.h:c,o,c),l=Math.min(a.lo>0?a.lo:c,o,c);return{l:a.l,f:a.f,v:c,o:o,h:h,lo:l}})}
function vcCandles(P){var N=vcNorm(P),n=N.length,g=Math.max(1,Math.ceil(n/90)),C=[];for(var i=0;i<n;i+=g){var s=N.slice(i,i+g),h=-Infinity,l=Infinity;s.forEach(function(a){if(a.h>h)h=a.h;if(a.lo<l)l=a.lo});var e=s[s.length-1];C.push({l:e.l,f:e.f,v:e.v,o:s[0].o,h:h,lo:l})}return C}
function vcMA(C,w){var o=[];for(var i=0;i<C.length;i++){if(i<w-1){o.push(null);continue}var t=0;for(var k=i-w+1;k<=i;k++)t+=C[k].v;o.push(t/w)}return o}
function vcSvg(id,P,ref,fmt){var cd=(CX.ty==="c"),ov=CX.ov||{},Q=cd?vcCandles(P):P,n=Q.length,W=320,Ht=(tab==="i"?127:150),L=48,R=316,T=6,B=(tab==="i"?105:128),mn=Infinity,mx=-Infinity,i,showRef=ov.rf!==0;
Q.forEach(function(a){var hi=cd?a.h:a.v,lo=cd?a.lo:a.v;if(hi>mx)mx=hi;if(lo<mn)mn=lo});var dmx=mx,dmn=mn;
if(ref>0&&showRef){mn=Math.min(mn,ref);mx=Math.max(mx,ref)}if(mx<=mn)mx=mn+1;var pd=(mx-mn)*.08;mn-=pd;mx+=pd;
var X=function(k){return L+(n>1?k/(n-1):.5)*(R-L)},Y=function(v){return T+(mx-v)/(mx-mn)*(B-T)},g="",up=Q[n-1].v>=(ref>0?ref:(cd?Q[0].o:Q[0].v)),col=up?"#12803a":"#d32f2f";
for(i=0;i<4;i++){var v=mn+(mx-mn)*i/3,y=Y(v);g+='<line x1="'+L+'" x2="'+R+'" y1="'+y.toFixed(1)+'" y2="'+y.toFixed(1)+'" stroke="var(--ln)"/><text x="'+(L-4)+'" y="'+(y+3).toFixed(1)+'" text-anchor="end" font-size="8.5" fill="var(--mut)">'+fmt(v)+'</text>'}
if(cd){var bw=Math.max(1.2,Math.min(9,(R-L)/Math.max(n,1)*.7));Q.forEach(function(a,k){var x=X(k),c=a.v>=a.o?"#12803a":"#d32f2f",y1=Y(Math.max(a.o,a.v)),y2=Y(Math.min(a.o,a.v));g+='<line x1="'+x.toFixed(1)+'" x2="'+x.toFixed(1)+'" y1="'+Y(a.h).toFixed(1)+'" y2="'+Y(a.lo).toFixed(1)+'" stroke="'+c+'" stroke-width="1"/><rect x="'+(x-bw/2).toFixed(1)+'" y="'+y1.toFixed(1)+'" width="'+bw.toFixed(1)+'" height="'+Math.max(1,y2-y1).toFixed(1)+'" fill="'+c+'"/>'})}
else{var d=Q.map(function(a,k){return(k?"L":"M")+X(k).toFixed(1)+" "+Y(a.v).toFixed(1)}).join(" ");
g+='<path d="'+d+' L'+X(n-1).toFixed(1)+' '+B+' L'+X(0).toFixed(1)+' '+B+' Z" fill="'+col+'" opacity=".1"/><path d="'+d+'" fill="none" stroke="'+col+'" stroke-width="1.8" stroke-linejoin="round"/>'}
[["m5",5,"#1976d2"],["m20",20,"#f57c00"]].forEach(function(m){if(!ov[m[0]])return;var C2=cd?Q:vcNorm(Q),ma=vcMA(C2,Math.min(m[1],Math.max(2,Math.floor(n/2)))),p=[];ma.forEach(function(v,k){if(v!=null)p.push(X(k).toFixed(1)+","+Y(v).toFixed(1))});if(p.length>1)g+='<polyline points="'+p.join(" ")+'" fill="none" stroke="'+m[2]+'" stroke-width="1.3"/>'});
if(ov.hl){[[dmx,"#12803a"],[dmn,"#d32f2f"]].forEach(function(z){var y=Y(z[0]);g+='<line x1="'+L+'" x2="'+R+'" y1="'+y.toFixed(1)+'" y2="'+y.toFixed(1)+'" stroke="'+z[1]+'" stroke-dasharray="4 3" stroke-width=".9"/><text x="'+(R-1)+'" y="'+(y-2).toFixed(1)+'" text-anchor="end" font-size="8" fill="'+z[1]+'">'+fmt(z[0])+'</text>'})}
if(ref>0&&showRef){var yr=Y(ref);g+='<line x1="'+L+'" x2="'+R+'" y1="'+yr.toFixed(1)+'" y2="'+yr.toFixed(1)+'" stroke="#64748b" stroke-dasharray="3 3"/>'}
var ix=[0,Math.round((n-1)/3),Math.round((n-1)*2/3),n-1];ix.forEach(function(k,j){if(j&&ix[j-1]===k)return;g+='<text x="'+X(k).toFixed(1)+'" y="'+(Ht-2)+'" text-anchor="'+(j===0?"start":(j===3?"end":"middle"))+'" font-size="8.5" fill="var(--mut)">'+Q[k].l+'</text>'});
VC[id]={P:Q,W:W,L:L,R:R,T:T,B:B,mn:mn,mx:mx,fmt:fmt,col:col,c:cd};return'<svg data-vc="'+id+'" viewBox="0 0 '+W+' '+(Ht+2)+'" style="width:100%;height:auto;direction:ltr;display:block;touch-action:pan-y">'+g+'<g class="vcr" pointer-events="none"></g></svg>'}
function vcShow(sv,e){var D=VC[sv.getAttribute("data-vc")];if(!D)return;var r=sv.getBoundingClientRect();if(!r.width)return;var n=D.P.length,vx=(e.clientX-r.left)/r.width*D.W,k=Math.round((vx-D.L)/(D.R-D.L)*(n-1));k=Math.max(0,Math.min(n-1,k));
var q=D.P[k],X=D.L+(n>1?k/(n-1):.5)*(D.R-D.L),Y=D.T+(D.mx-q.v)/(D.mx-D.mn)*(D.B-D.T),g=sv.querySelector(".vcr");if(!g)return;
var t1=q.f,t2=D.fmt(q.v,1),t3=D.c?("باز "+D.fmt(q.o,1)+" | بالا "+D.fmt(q.h,1)+" | پایین "+D.fmt(q.lo,1)):"",bw=Math.max(92,Math.max(t1.length*4.9,t2.length*6.5,t3.length*4.4)+12),bx=Math.max(2,Math.min(D.W-bw-2,X-bw/2)),bh=t3?43:31,by=Y>(t3?58:46)?Y-(bh+9):Y+8;
g.innerHTML='<line x1="'+X+'" x2="'+X+'" y1="'+D.T+'" y2="'+D.B+'" stroke="'+D.col+'" stroke-dasharray="3 3"/><circle cx="'+X+'" cy="'+Y+'" r="3.2" fill="'+D.col+'" stroke="#fff" stroke-width="1.5"/><rect x="'+bx+'" y="'+by+'" width="'+bw+'" height="'+bh+'" rx="5" fill="#fff" stroke="'+D.col+'"/><text x="'+(bx+bw/2)+'" y="'+(by+12)+'" text-anchor="middle" font-size="9" fill="#444">'+t1+'</text><text x="'+(bx+bw/2)+'" y="'+(by+25)+'" text-anchor="middle" font-size="11" font-weight="700" fill="#111">'+t2+'</text>'+(t3?'<text x="'+(bx+bw/2)+'" y="'+(by+37)+'" text-anchor="middle" font-size="8.5" fill="#555">'+t3+'</text>':'')}
var VCA=null;
document.addEventListener("pointerdown",function(e){var s=e.target.closest&&e.target.closest("svg[data-vc]");if(s){VCA=s;vcShow(s,e)}});
document.addEventListener("pointermove",function(e){var s=VCA||(e.pointerType==="mouse"&&e.target.closest&&e.target.closest("svg[data-vc]"));if(s)vcShow(s,e)});
document.addEventListener("pointerup",function(){VCA=null});document.addEventListener("pointercancel",function(){VCA=null});
async function rxDay(force){if(RX.dr||(!force&&Date.now()-RX.dt<(RX.day?60e3:15e3)))return;RX.dr=1;try{var a=firstArr(JSON.parse(await GET(TS+"Index/GetIndexB1LastDay/"+IDX))),o=[];a.forEach(function(x){var h=num(x.hEven),v=idxClose(x);if(!(v>0))v=ixPick(x,/^xDrNivJIdx|value|last/i);if(h>0&&v>0)o.push({h:h,v:v})});o.sort(function(x,y){return x.h-y.h});if(o.length>1){RX.day=o;RX.dayD=num(a[0]&&a[0].dEven)||0}}catch(e){}RX.dt=Date.now();RX.dr=0;cxPaint()}
function cxF(v,d){if(v==null||!isFinite(v))return"—";var a=Math.abs(v);return a>=1e9?cfp(v/1e9,2)+"B":(a>=1e6?cfp(v/1e6,2)+"M":cfp(v,a<100?2:(a<1000?1:0)))}
function vcCard(id,title,src,B,L,dayP,fmt,unit,extra,note){var bars=B||[],lb=bars.length?bars[bars.length-1]:null,pb=bars.length>1?bars[bars.length-2]:null,cur=(L&&L.v>0)?L.v:(lb?lb.c:null);
if(!(cur>0))return'<div class="card" style="padding:8px"><b style="font-size:13px">'+title+'</b><div class="mut" style="font-size:12px;padding:6px 0;line-height:1.8">'+esc(src)+'</div></div>';
var py=pb&&lb&&L&&L.v>0&&Math.abs(L.v-lb.c)/lb.c>1e-6&&(lb.k<1e9?false:lb.k<Date.now()-12*3600e3)?lb.c:(pb?pb.c:null);if(L&&L.pc!=null&&!(py>0))py=cur/(1+L.pc/100);
var pcn=py>0?(cur/py-1)*100:null,c2=pcn>0?"var(--up)":(pcn<0?"var(--dn)":"var(--tx)"),P=CX.rg==="d"?dayP:vcDays(bars,CX.rg),
lo=(L&&L.l>0)?L.l:null,hi=(L&&L.h>0)?L.h:null;if(CX.rg==="d"&&P){P.forEach(function(p){lo=lo==null?p.v:Math.min(lo,p.v);hi=hi==null?p.v:Math.max(hi,p.v)})}
var sm=function(a,b,c){return'<span style="white-space:nowrap"><span class="mut">'+a+'</span> <b style="direction:ltr'+(c?";color:"+c:"")+'">'+b+'</b></span>'};
return'<div class="card" style="padding:7px 8px"><div style="display:flex;justify-content:space-between;align-items:baseline;gap:6px"><b style="font-size:13px">'+title+'</b><span><b style="font-size:16px;direction:ltr">'+fmt(cur)+'</b><small class="mut"> '+unit+'</small> <b style="color:'+c2+';font-size:13px">'+(pcn==null?"":sgp(pcn,2))+'</b></span></div>'+
'<div style="display:flex;flex-wrap:wrap;gap:3px 12px;font-size:11px;margin:3px 0 4px">'+sm("دیروز",fmt(py))+(lo!=null?sm("کمترین",fmt(lo),"var(--dn)"):"")+(hi!=null?sm("بیشترین",fmt(hi),"var(--up)"):"")+(extra||"")+'</div>'+
(P&&P.length>1?vcSvg(id,P,CX.rg==="d"?py:0,fmt):'<div class="mut" style="text-align:center;padding:14px 6px;font-size:12px">'+(CX.rg==="d"?((RX.dr?"در حال دریافت نمودار امروز…":"نمودار امروز در دسترس نیست؛ بازه‌ی «هفته» یا «ماه» را بزنید.")):"داده‌ی این بازه در دسترس نیست.")+'</div>')+
'<div class="mut" style="font-size:10px;margin-top:2px">'+esc(src)+(note&&CX.rg==="d"&&P?" — "+note:"")+'</div></div>'}
function cxInner(){var B=[["d","روز"],["w","هفته"],["m","ماه"],["q","۳ ماه"],["y","سال"]],
bar='<div style="display:flex;gap:5px;margin:0 0 6px;flex-wrap:wrap;align-items:center">'+B.map(function(b){var on=b[0]===CX.rg;return'<button type="button" data-cx="'+b[0]+'" style="padding:4px 11px;font-size:11.5px;border-radius:9px;border:1px solid '+(on?"var(--ac)":"var(--ln)")+';background:'+(on?"var(--ac)":"var(--bg)")+';color:'+(on?"#fff":"var(--tx)")+'">'+b[1]+'</button>'}).join("")+'</div>',
fu=function(v){return cxF(v)},fi=function(v){return v==null||!isFinite(v)?"—":cfp(v)},
usd=(CX.bars||CX.last)?vcCard("usd","ارزش دلاری کل بورس","منبع: چارتیکس"+(CX.t?" — "+new Date(CX.t).toLocaleTimeString("fa-IR",{hour:"2-digit",minute:"2-digit"}):""),CX.bars,CX.last,vcUsdDay(),fu,"$","","روز: برآورد از حرکت شاخص کل"):vcCard("usd","ارزش دلاری کل بورس",CX.run?"در حال دریافت از چارتیکس…":(CX.err||"…"),null,null,null,fu,"$"),
mvx=RX.mv?'<span style="white-space:nowrap"><span class="mut">ارزش بازار</span> <b>'+cfp(RX.mv/1e13,0)+'</b> <span class="mut">هزار میلیارد تومان</span></span>':"",
irr=vcCard("irr","شاخص کل بورس (ریالی)","منبع: بورس تهران (tsetmc)",RX.bars,RX.last,vcIrrDay(),fi,"",mvx);
var dbg=false?'<details style="font-size:11px;margin-top:2px"><summary class="mut">جزئیات دریافت از چارتیکس</summary><div class="mut" style="line-height:1.8">'+(CX.err?esc(CX.err)+"<br>":"")+CX.dbg.map(esc).join("<br>")+'</div></details>':"";
if(CX.rg==="d")setTimeout(function(){rxDay(false)},0);
return'<b style="display:block;margin-bottom:5px">تابلوی ارزش بورس</b>'+cxCtl()+'<div class="cxcards">'+usd+irr+'</div>'+dbg}
function cxBar2(){var cb=function(a,v,l,on){return'<button type="button" '+a+'="'+v+'" style="padding:4px 10px;font-size:11.5px;border-radius:9px;border:1px solid '+(on?"var(--ac)":"var(--ln)")+';background:'+(on?"var(--ac)":"var(--bg)")+';color:'+(on?"#fff":"var(--tx)")+'">'+l+'</button>'},ov=CX.ov||{};
return'<div style="display:flex;gap:5px;margin:0 0 6px;flex-wrap:wrap;align-items:center"><span class="mut" style="font-size:11px">نمودار:</span>'+cb("data-cxt","l","خطی",CX.ty!=="c")+cb("data-cxt","c","کندل شمعی",CX.ty==="c")+'<span class="mut" style="font-size:11px;margin-right:6px">خط‌ها:</span>'+cb("data-cxo","m5","میانگین ۵",!!ov.m5)+cb("data-cxo","m20","میانگین ۲۰",!!ov.m20)+cb("data-cxo","hl","بیشترین/کمترین",!!ov.hl)+cb("data-cxo","rf","مرجع دیروز",ov.rf!==0)+'</div>'}
try{var _co=JSON.parse(localStorage.getItem("cxo1")||"{}");CX.ov=_co.ov||{}}catch(e){CX.ov={}}try{CX.ty=localStorage.getItem("cxty2")==="l"?"l":"c"}catch(e){CX.ty="c"}
