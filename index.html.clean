for(var d=add(today,-7);d<=to;d=add(d,1)){if(d.getDay()===5)continue;HC[ds(d)]=set[ds(d)]?1:0}
HC.__t=Date.now();HOLDONE=true;localStorage.setItem("hc",JSON.stringify(HC));localStorage.setItem("hcdone","1")}catch(e){}}
function cfgPaint(){var st=CFG.st||{online:true},o=document.getElementById("offov");
if(st.online===false){if(!o){o=document.createElement("div");o.id="offov";document.body.appendChild(o)}
o.innerHTML='<div class="ofbox"><div class="ofic">🛠️</div><h2>'+esc(st.title||"سینو بورس موقتاً در دسترس نیست")+'</h2><p>'+esc(st.message||"در حال به‌روزرسانی و بهبود سرویس هستیم؛ کمی بعد دوباره سر بزنید.").replace(/\n/g,"<br>")+'</p><button id="ofre">تلاش دوباره</button><div class="ofsup">پشتیبانی: <b dir="ltr">'+esc(CFG.links.phone||"")+'</b></div></div>';
document.getElementById("ofre").onclick=function(){this.textContent="در حال بررسی…";cfgLoad()};document.documentElement.classList.add("offl")}
else if(o){o.parentNode.removeChild(o);document.documentElement.classList.remove("offl")}
var nb=document.getElementById("ntc"),n=CFG.notice,dis="";try{dis=localStorage.getItem("ntd")||""}catch(e){}
if(n&&n.text&&String(n.id)!==dis){if(!nb){nb=document.createElement("div");nb.id="ntc";var v=document.getElementById("v");v.parentNode.insertBefore(nb,v)}
nb.className="ntc nt-"+(n.type||"info");nb.innerHTML='<span class="ntx">'+esc(n.text).replace(/\n/g,"<br>")+(n.link?' <a href="#" id="ntl">'+esc(n.linkText||"بیشتر")+'</a>':"")+'</span><button id="ntx" title="بستن">✕</button>';
document.getElementById("ntx").onclick=function(){try{localStorage.setItem("ntd",String(n.id))}catch(e){}nb.parentNode.removeChild(nb)};
var nl=document.getElementById("ntl");if(nl)nl.onclick=function(e){e.preventDefault();openIn("",n.link)}}
else if(nb)nb.parentNode.removeChild(nb);
tkDot()}
