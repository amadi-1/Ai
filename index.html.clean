if(ncl!==!!S.cl||stt!==S.stt){S.cl=ncl;S.stt=stt;save();var sb0=document.getElementById("symb");if(sb0){sb0.className="sb "+mkCls();sb0.title=S.stt||""}}}
if(S.cl)return;
