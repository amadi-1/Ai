function wlD(s){return String(s==null?"":s).replace(/[۰-۹]/g,function(d){return"۰۱۲۳۴۵۶۷۸۹".indexOf(d)}).replace(/[٠-٩]/g,function(d){return"٠١٢٣٤٥٦٧٨٩".indexOf(d)})}
function wlBarFix(){var b=document.querySelector(".wlbar");if(!b)return;if(WL.bs!=null){b.scrollLeft=WL.bs;return}var c=b.querySelector('[data-wk="'+WL.cur+'"]');if(c){var r=c.getBoundingClientRect(),q=b.getBoundingClientRect();b.scrollLeft+=(r.left+r.width/2)-(q.left+q.width/2);WL.bs=b.scrollLeft}}
document.getElementById("v").addEventListener("scroll",function(e){var t=e.target;if(t&&t.classList&&t.classList.contains("wlbar"))WL.bs=t.scrollLeft},true);
function wlIsMain(){var C=wlCur();return !!C&&(WL.cur===0||C.name==="اصلی")}
