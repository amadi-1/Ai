if(!u.nm&&I.lVal18AFC)u.nm=ar(String(I.lVal18AFC));if(mx>mn&&mn>0&&r>0.004&&r<0.25)u.pct=Math.min(10,Math.max(1,Math.round(r*100)))}catch(e){}
