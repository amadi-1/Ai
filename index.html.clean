var HOLSRC=[{h:"https://persiancalapi.ir",pad:0},{h:"https://holidayapi.ir",pad:1}],HOLDONE=false;
try{HOLDONE=localStorage.getItem("hcdone")==="1"}catch(e){}
function p2(n){return(n<10?"0":"")+n}
async function hday(d,dead){var p=cal(d,"persian"),y=p.year||p.relatedYear,m=+p.month,dd=+p.day;
for(var i=0;i<HOLSRC.length;i++){if(dead[i])continue;
for(var j=0;j<2;j++){var pad=(j===0)===!!HOLSRC[i].pad,u=HOLSRC[i].h+"/jalali/"+y+"/"+(pad?p2(m):m)+"/"+(pad?p2(dd):dd);
try{var t=JSON.parse(await GET(u));if(t&&typeof t==="object"&&("is_holiday" in t||t.events)){return(t.is_holiday===true||(t.events||[]).some(function(e){return e.is_holiday}))?1:0}}
catch(e){if(e.kind==="dns"||e.kind==="timeout"||e.kind==="conn"){dead[i]=1;break}}}}
throw mkErr("calendar")}
// runs once after install (silently); afterwards only when started by hand from the settings page
async function loadHol(force){
if(!force&&HOLDONE)return{n:0,bad:0};
var T=force?{}:HC,q=[];
for(var i=0;i<=400;i++){var d=add(today,i);if(d.getDay()!==5&&T[ds(d)]===undefined)q.push(d)}
var n=0,bad=0,dead=[0,0];
async function w(){while(q.length){var d=q.shift();try{T[ds(d)]=await hday(d,dead);n++}catch(e){if(++bad>6)q.length=0}}}
await Promise.all([w(),w(),w(),w()]);
if(n){if(force)HC=T;HC.__t=Date.now();HOLDONE=true;try{localStorage.setItem("hc",JSON.stringify(HC));localStorage.setItem("hcdone","1")}catch(e){}}
return{n:n,bad:bad}}
