function mkcCard(){var c=mkcGet(),R=mkcRows(),vis=R.filter(function(r){return !r.hid}),hid=R.filter(function(r){return r.hid}),ks=MK.keys||[];if(!ks.length){try{ks=JSON.parse(localStorage.getItem("mkk")||"[]")}catch(e){}}
