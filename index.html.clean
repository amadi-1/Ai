P:{tf:"D",ty:"c",adj:1,log:0,px:"c",mg:0,dk:0,ov:{m20:1,m50:1,m200:0,e21:0,bb:0,ich:0,sar:0,dn:0,st:0},sp:{vol:1,rsi:0,macd:0,sto:0,cci:0,obv:0,atr:0}}};
