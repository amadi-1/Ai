if(!ok)bad.push(p);if(ok&&conds.length)conds[conds.length-1].op=ix>0?ops[ix-1]:"&&"});
if(!conds.length)return{msg:"✖ از متن چیزی شناخته نشد. نمونه‌ی عبارت‌های قابل فهم: «ورود پول حقیقی بیشتر از ۵ میلیارد»، «قدرت خریدار بالای ۲»، «سرانه خرید بیش از ۵۰ میلیون»، «حجم ۳ برابر میانگین ماه»، «حجم بیشتر از حجم مبنا»، «آخرین قیمت بالای ۲ درصد»، «آخرین بالاتر از پایانی»، «شکست سقف ۶۰ روز»، «بالای میانگین متحرک ۵۰ روزه»، «صف خرید نباشد»، «حقوقی به حقیقی»، «ارزش معاملات بیش از ۱۰ میلیارد»، «P/E زیر ۸»، «کندل سبز»."};
