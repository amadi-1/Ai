async function wlItemLoad(it){try{extMark(it.c,null,it.n);if(preOpen())await wlYdLoad(it.c);var q0=WL.q[it.c];if(!liveFor(it.c)&&q0&&(q0.pl>0||q0.pc>0||q0.py>0))return;var j=JSON.parse(await GET(TS+"ClosingPrice/GetClosingPriceInfo/"+it.c)),c=j.closingPriceInfo||j,q=WL.q[it.c]||{},cl=isCl(j);
var o={fi:num(c.priceFirst),pl:num(c.pDrCotVal),pc:num(c.pClosing),py:num(c.priceYesterday),lo:num(c.priceMin),hi:num(c.priceMax),vol:num(c.qTotTran5J),val:num(c.qTotCap),tr:num(c.zTotTran),cl:cl===null?q.cl:cl,bl:q.bl,st:(function(){var e=deep(j,"cEtaval");return e===undefined?q.st:String(e==null?"":e).trim().toUpperCase()})()};var lv=liveFor(it.c);extMark(it.c,j,it.n);
if(lv||(!q.bl&&!(q.pl>0||q.pc>0||q.py>0))){try{var bl=nbl(firstArr(JSON.parse(await GET(TS+"BestLimits/"+it.c))));o.bl=bl;snB(it.c,bl);var hd=ph()==="ord"?(bl.slice().sort(function(a,b){return num(a.number)-num(b.number)})[0]||{}):null;if(hd){var hp=num(hd.pmd)>0?num(hd.pmd):num(hd.pmo);if(hp>0){o.pl=hp;o.pc=hp}}}catch(e){}}
if(lv)snQ(it.c,j);WL.q[it.c]=o;
if(!WL.thr[it.c]){try{var I=JSON.parse(await GET(TS+"Instrument/GetInstrumentInfo/"+it.c)),I2=I.instrumentInfo||I,t=I2.staticThreshold||{},mx=num(t.psGelStaMax),mn=num(t.psGelStaMin);if(mx>mn&&mn>0)WL.thr[it.c]=Math.round(((mx-mn)/(mx+mn))*1000)/10}catch(e){}}if(WL.fl[it.c]===undefined){WL.fl[it.c]=null;try{WL.fl[it.c]=await getFloat(it.c);wlFlSave()}catch(e){}}}catch(e){}}
