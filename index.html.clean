var MK={t:0,load:false,err:"",D:null,src:{}};
function pnum(x){if(x==null)return null;var v=parseFloat(String(x).replace(/[,\s٬]/g,"").replace(/[۰-۹]/g,function(c){return"۰۱۲۳۴۵۶۷۸۹".indexOf(c)}));return isFinite(v)?v:null}
function lat(s){return String(s).replace(/[۰-۹]/g,function(c){return"۰۱۲۳۴۵۶۷۸۹".indexOf(c)}).replace(/[٠-٩]/g,function(c){return"٠١٢٣٤٥٦٧٨٩".indexOf(c)})}
var TGH=["https://call4.tgju.org/ajax.json","https://call1.tgju.org/ajax.json","https://call2.tgju.org/ajax.json","https://call3.tgju.org/ajax.json"];
function tgGet(cur,keys,rx){var k=null,i;for(i=0;i<keys.length;i++){if(cur[keys[i]]&&pnum(cur[keys[i]].p)!=null){k=keys[i];break}}
if(!k&&rx){var ks=Object.keys(cur);for(i=0;i<ks.length;i++){if(rx.test(ks[i])&&cur[ks[i]]&&pnum(cur[ks[i]].p)!=null){k=ks[i];break}}}
if(!k)return null;var e=cur[k],v=pnum(e.p),dp=pnum(e.dp);if(dp!=null&&String(e.dt||"").toLowerCase()==="low")dp=-Math.abs(dp);else if(dp!=null)dp=Math.abs(dp);
return{v:v,ch:dp}}
function strip(h){return String(h).replace(/<script[\s\S]*?<\/script>/gi," ").replace(/<style[\s\S]*?<\/style>/gi," ").replace(/<[^>]+>/g," ").replace(/&nbsp;|&#?\w+;/g," ").replace(/\s+/g," ")}
function opParse(t,name){var re=new RegExp(name+"\\s*[^0-9A-Za-z]{0,6}\\s*(?:\\d+\\s*(?:mins?|hours?|days?)\\s*)?([0-9][0-9,]*\\.?[0-9]*)\\s+([+\\-−][0-9,]*\\.?[0-9]+)\\s+([+\\-−]\\s?[0-9.]+)\\s*%","g"),m;
while((m=re.exec(t))){var v=pnum(m[1]);if(v>0)return{v:v,ch:parseFloat(m[3].replace("−","-").replace(/\s/g,""))}}return null}
function fitScale(v,ref){if(!ref||!v)return v;if(v<ref*0.3)return v*10;if(v>ref*3)return v/10;return v}
function findNum(o,rxs,min){for(var i=0;i<rxs.length;i++){var q=[o],n=0;while(q.length&&n++<400){var x=q.shift();if(x&&typeof x==="object"){for(var k in x){var v=x[k];if(rxs[i].test(k)&&pnum(v)>min)return pnum(v);if(v&&typeof v==="object")q.push(v)}}}}return null}
async function nbGet(){var m={};
try{var j=JSON.parse(await GET("https://apiv2.nobitex.ir/market/stats?srcCurrency=usdt,btc,eth&dstCurrency=rls")),s=j.stats||{};["usdt","btc","eth"].forEach(function(c){var x=s[c+"-rls"];if(x&&pnum(x.latest)>0)m[c]={v:pnum(x.latest),ch:pnum(x.dayChange),rial:1}})}catch(e){}
if(!m.usdt||!m.btc){var P=[["usdt","USDTIRT"],["btc","BTCIRT"]];for(var i=0;i<P.length;i++){if(m[P[i][0]])continue;try{var o=JSON.parse(await GET("https://apiv2.nobitex.ir/v3/orderbook/"+P[i][1])),v=pnum(o.lastTradePrice);if(v>0)m[P[i][0]]={v:v,ch:null}}catch(e){}}}
if(!Object.keys(m).length)throw new Error("nobitex");return m}
async function milliGet(ref){var u=["https://milli.gold/api/v1/public/milli-price/external","https://milli.gold/api/v1/public/milli-price/detail"];
for(var i=0;i<u.length;i++){try{var j=JSON.parse(await GETC(u[i],10000)),v=findNum(j,[/price.?18|18.?price|geram18|gram18/i,/^price$/i,/price/i],1e4);if(v)return{v:fitScale(v,ref),ch:null}}catch(e){}}
var t=strip(await GET("https://milli.gold/landing/geram18/")),best=null,re=/\d{1,3}(?:,\d{3}){2,}/g,m;
while((m=re.exec(t))){var n=fitScale(pnum(m[0]),ref);if(ref&&Math.abs(n/ref-1)<0.2&&(!best||Math.abs(n/ref-1)<Math.abs(best/ref-1)))best=n}
if(!best)throw new Error("milli");return{v:best,ch:null}}
async function mkSafe(f,name){try{var r=await f();MK.src[name]=1;return r}catch(e){MK.src[name]=0;return null}}

