];
var NW={show:20,items:[],t:0,run:false,err:"",cat:"",q:"",src:"",tm:0,ok:{},fu:{}};
try{var _n0=JSON.parse(localStorage.getItem("nw2"));if(_n0&&_n0.i){NW.items=_n0.i;NW.t=_n0.t||0;NW.fu=_n0.fu||{}}}catch(e){}
function nwSrc(id){for(var i=0;i<NWS.length;i++)if(NWS[i].id===id)return NWS[i];return null}
function nwTxt(h){try{var d=new DOMParser().parseFromString(String(h||""),"text/html");return(d.body&&d.body.textContent||"").replace(/\s+/g," ").trim()}catch(e){return String(h||"").replace(/<[^>]*>/g," ").replace(/\s+/g," ").trim()}}
function nwParse(x){var d=new DOMParser().parseFromString(x,"text/xml"),N=d.getElementsByTagName("item");if(!N.length)N=d.getElementsByTagName("entry");if(!N.length)return[];
function g(e,t){var a=e.getElementsByTagName(t)[0];return a?(a.textContent||""):""}
var L=[];for(var i=0;i<N.length;i++){var e=N[i],ti=nwTxt(g(e,"title")),li=g(e,"link").trim();
if(!li){var le=e.getElementsByTagName("link")[0];if(le)li=le.getAttribute("href")||""}
if(!li)li=g(e,"guid").trim();
var raw=g(e,"content:encoded")||g(e,"description")||g(e,"summary")||g(e,"content"),im="",en=e.getElementsByTagName("enclosure")[0];
if(en&&/image|jpe?g|png|webp/i.test((en.getAttribute("type")||"")+(en.getAttribute("url")||"")))im=en.getAttribute("url")||"";
if(!im){var mc=e.getElementsByTagName("media:content")[0]||e.getElementsByTagName("media:thumbnail")[0];if(mc)im=mc.getAttribute("url")||""}
if(!im){var mm=/<img[^>]+src=["']([^"']+)/i.exec(raw);if(mm)im=mm[1]}
var tm=Date.parse(g(e,"pubDate")||g(e,"published")||g(e,"updated")||g(e,"dc:date"))||0,sm=nwTxt(raw);if(sm===ti)sm="";
if(ti&&li)L.push({t:ti,l:li,s:sm.slice(0,1500),im:im,d:tm,c:nwTxt(g(e,"category")),o:i})}
return L}
// plan B when a feed is unreachable: read the headlines straight from the site's page
function nwParseHtml(x,base){var L=[],seen={},re=/<a\b[^>]*href=["']([^"']+)["'][^>]*>([\s\S]*?)<\/a>/gi,m,k=0,org=/^(https?:\/\/[^\/]+)/.exec(base)[1],host=org.replace(/^https?:\/\/(www\.)?/,"");
while((m=re.exec(x))){var h=m[1],tx=nwTxt(m[2]);if(tx.length<18||!/(\/detail\/\d+|\/news\/\d+|\/\d{5,}(?:[-\/]|$))/.test(h))continue;
if(h.indexOf("//")===0)h="https:"+h;else if(h.charAt(0)==="/")h=org+h;else if(!/^https?:/.test(h))continue;
if(h.replace(/^https?:\/\/(www\.)?/,"").indexOf(host)!==0)continue;
if(seen[h])continue;seen[h]=1;L.push({t:tx,l:h,s:"",im:"",d:0,c:"",o:k++})}
return L.slice(0,40)}
async function nwOne(S){var tr=NW.fu[S.id]?[NW.fu[S.id]].concat(S.f.filter(function(u){return u!==NW.fu[S.id]})):S.f.slice(),bad=null;
for(var i=0;i<tr.length;i++){try{var l=nwParse(await GET0(tr[i]));if(l.length){NW.fu[S.id]=tr[i];return{l:l}}}catch(e){bad=bad||e}}
try{var h=nwParseHtml(await GET0(S.h),S.h);if(h.length)return{l:h}}catch(e){bad=bad||e}
return{l:[],e:bad||{kind:"empty"}}}
async function nwLoad(force){if(NW.run)return;if(!force&&NW.t&&Date.now()-NW.t<15000)return;NW.run=true;NW.err="";if(!NW.items.length)nwPaint();
var rs=await Promise.all(NWS.map(function(S){return nwOne(S).then(function(r){NW.ok[S.id]=r.l.length>0;r.l.forEach(function(x){x.sr=S.id;x.o=x.o+0});return r},function(e){NW.ok[S.id]=false;return{l:[],e:e}})})),all=[],bad=null;
rs.forEach(function(r){all=all.concat(r.l);if(r.e&&!bad)bad=r.e});
if(all.length){var m={},u=[];all.forEach(function(x){var k=x.l.replace(/^https?:\/\/(www\.)?/,"");if(!m[k]){m[k]=1;u.push(x)}});
u.sort(function(a,b){return(a.d&&b.d)?b.d-a.d:(a.d?-1:(b.d?1:a.o-b.o))});NW.items=u.slice(0,300);NW.t=Date.now();
try{localStorage.setItem("nw2",JSON.stringify({t:NW.t,i:NW.items.slice(0,100),fu:NW.fu}))}catch(e){}}
else NW.err=(bad&&bad.kind!=="empty")?why(bad,"اخبار بورس"):"خبری از منابع دریافت نشد.";
NW.run=false;nwPaint()}
function nwAgo(t){if(!t)return"";var s=Math.max(0,(Date.now()-t)/1000);if(s<60)return"چند لحظه پیش";var m=Math.floor(s/60);if(m<60)return m.toLocaleString("fa-IR")+" دقیقه پیش";var h=Math.floor(m/60);if(h<24)return h.toLocaleString("fa-IR")+" ساعت پیش";return Math.floor(h/24).toLocaleString("fa-IR")+" روز پیش"}
function nwWhen(t){try{return new Date(t).toLocaleString("fa-IR",{month:"long",day:"numeric",hour:"2-digit",minute:"2-digit"})}catch(e){return""}}
function nwFiltered(){var q=NW.q.trim().toLowerCase();return NW.items.filter(function(x){return(!NW.cat||x.sr===NW.cat)&&(!q||(x.t+" "+x.s).toLowerCase().indexOf(q)>=0)})}
function nwStatus(){return (NW.run&&!NW.items.length)?'<span class="nwdot"></span> در حال دریافت خبرها…':(NW.err?'<span style="color:var(--dn)">'+esc(NW.err)+'</span>'+(NW.items.length?" (آخرین خبرهای ذخیره‌شده نمایش داده می‌شود)":""):'<span class="nwdot"></span> '+(NW.t?"آخرین بروزرسانی "+nwAgo(NW.t)+" · "+NW.items.length.toLocaleString("fa-IR")+" خبر":"هنوز دریافت نشده"))}
// chips = news sources (✓ answered on the last refresh, ✗ did not)
function nwChips(){return'<button data-nc=""'+(NW.cat?"":' class="on"')+'>همه</button>'+NWS.map(function(S){var st=NW.ok[S.id]===true?' <span style="color:#1b7a3a">✓</span>':(NW.ok[S.id]===false?' <span style="color:#d32f2f">✗</span>':"");return'<button data-nc="'+S.id+'"'+(NW.cat===S.id?' class="on"':"")+'>'+esc(S.n)+st+'</button>'}).join("")}
function nwList(){var l=nwFiltered();if(!l.length)return'<div class="mut" style="padding:14px;text-align:center;line-height:1.9">'+(NW.items.length?"خبری مطابق جست‌وجو یا منبع انتخاب‌شده پیدا نشد.":(NW.run?"در حال دریافت…":"خبری برای نمایش نیست."))+'</div>';
var h="",cap=NW.show||20,more=l.length>cap;l=l.slice(0,cap);
l.forEach(function(x){var fresh=x.d&&Date.now()-x.d<18e5,S=nwSrc(x.sr),meta='<div class="nwm"><button class="nwgo '+(fresh?"nwred":"nwgrn")+'" data-l="'+esc(x.l)+'">'+esc(S?S.n:"منبع")+'</button>'+(x.d?'<span title="'+esc(nwWhen(x.d))+'">'+nwAgo(x.d)+'</span>':"")+(x.c?'<span class="nwc">'+esc(x.c)+'</span>':"")+'</div>';
var img=x.im?'<img loading="lazy" referrerpolicy="no-referrer" src="'+esc(x.im)+'" onerror="this.parentNode.removeChild(this)">':"";
h+='<div class="nwcard nwrow"><div class="nwbody"><div class="nwt">'+esc(x.t)+'</div>'+(x.s?'<div class="nws">'+esc(x.s)+'</div>':"")+meta+'</div>'+(img?'<div class="nwth">'+img+'</div>':"")+'</div>'});
return h+(more?'<div style="text-align:center;margin:6px 0 14px"><button class="nwgo nwred" data-more="1" style="font-size:14px;padding:9px 26px">ادامه اخبار</button></div>':"")}
function nwLight(){var e=document.getElementById("nwLive");if(!e)return;var ok=!NW.err&&NW.t&&Date.now()-NW.t<60000&&navigator.onLine!==false;e.style.color=ok?"#1b7a3a":"#d32f2f";e.style.animation=ok?"nwp 1.2s infinite":"nwp .5s infinite"}
function nwHtml(){return'<div class="card nwhd"><div class="nwtop"><div class="nwttl"><span class="nwlive" id="nwLive">●</span> اخبار بورس</div></div>'+
'<input id="nw_q" placeholder="جست‌وجو در تیترها…" value="'+esc(NW.q)+'" style="width:100%;margin-top:8px;padding:8px 10px;border:1px solid var(--ln);border-radius:10px;background:var(--card)">'+
'<div class="nwch" id="nwC">'+nwChips()+'</div></div><div id="nwL">'+nwList()+'</div>'+
'<div class="mut" style="font-size:11px;text-align:center;margin:10px 0;line-height:1.9">منابع: '+NWS.map(function(S){return esc(S.n)+" ("+esc(S.h.replace(/^https?:\/\/(www\.)?/,"").split("/")[0])+")"}).join("، ")+'. خبرها هر ۱۵ ثانیه خودکار بروزرسانی می‌شوند؛ دکمه‌ی هر خبر نام منبع است و با لمس آن متن کامل خبر باز می‌شود (قرمز = کمتر از ۳۰ دقیقه پیش). ✓/✗ کنار نام منبع یعنی آن سایت در آخرین دریافت جواب داده یا نه.</div>'}
function nwPaint(){if(tab!=="n")return;var l=document.getElementById("nwL");if(!l)return;l.innerHTML=nwList();nwLight();var c=document.getElementById("nwC");if(c)c.innerHTML=nwChips();
}
function nwBind(first){var q=document.getElementById("nw_q");if(q)q.oninput=function(){NW.q=this.value;NW.show=20;var l=document.getElementById("nwL");if(l)l.innerHTML=nwList()};
var v=document.getElementById("v");if(v)v.onclick=function(e){if(tab!=="n")return;var mb=e.target.closest("[data-more]");if(mb){NW.show=(NW.show||20)+20;nwPaint();return}var b=e.target.closest("[data-nc]");if(b){NW.cat=b.getAttribute("data-nc");NW.show=20;nwPaint();return}var c=e.target.closest("button[data-l]");if(c)openIn("",c.getAttribute("data-l"))};
if(!NW.tm)NW.tm=setInterval(function(){if(tab==="n"&&!document.hidden){nwLoad(false);nwLight()}},5000);
nwLight();if(first)nwLoad(false)}

// ===== شاخص کل بورس در سطر جستجوی بالای برنامه =====
var IX={v:null,ch:null,pc:null,t:0,run:false};
try{var _i0=JSON.parse(localStorage.getItem("ix1"));if(_i0&&_i0.v){IX.v=_i0.v;IX.ch=_i0.ch;IX.pc=_i0.pc}}catch(e){}
function ixN(x){var n=typeof x==="number"?x:parseFloat(String(x==null?"":x).replace(/,/g,""));return isFinite(n)?n:null}
function ixPick(r,re){var k=Object.keys(r);for(var i=0;i<k.length;i++)if(re.test(k[i])){var n=ixN(r[k[i]]);if(n!=null)return n}return null}
// previous session close from the daily history (used only when the live record has no change field)
async function ixPrev(dE){var c=null;try{c=JSON.parse(localStorage.getItem("ixp")||"null")}catch(e){}
if(c&&c.k===dE&&c.v>0)return c.v;
var hi=firstArr(JSON.parse(await GETC(TS+"Index/GetIndexB2History/"+IDX,600000)).indexB2||[]),best=null,bd=0;
hi.forEach(function(r){var g=num(r.dEven),v=idxClose(r);if(g>0&&g<dE&&g>bd&&v>0){bd=g;best=v}});
if(best){try{localStorage.setItem("ixp",JSON.stringify({k:dE,v:best}))}catch(e){}}return best}
async function ixLoad(){if(IX.run)return;IX.run=true;var v=null,ch=null,pv=null;
// 0) old.tsetmc.com/Loader.aspx?ParTree=15 (بازار نقدی بورس در یک نگاه)
oxLoad();if(OX.b&&!OX.b.fb&&OX.b.v>1000&&Date.now()-OX.t<60000){v=OX.b.v;ch=OX.b.ch}
// 1) the same "بورس در یک نگاه" data the TSETMC market page shows
if(v==null)try{var j=JSON.parse(await GETC(TS+"MarketData/GetMarketOverview/1",3000)),o=j.marketOverview||j;
v=ixPick(o,/^indexLastValue$/i);ch=ixPick(o,/^indexChange$/i);if(!(v>1000)){v=null;ch=null}}catch(e){}
// 2) plan B: the index list
if(v==null){try{var a=firstArr(JSON.parse(await GETC(TS+"Index/GetIndexB1LastAll/All/1",3000)).indexB1||[]),r=null,i;
for(i=0;i<a.length;i++)if(String(a[i].insCode)===IDX){r=a[i];break}
if(!r)for(i=0;i<a.length;i++)if(/^شاخص کل$/.test(nz(a[i].lVal30||""))){r=a[i];break}
if(r){var v2=idxClose(r),c2=ixPick(r,/^indexChange$/i);
if(c2==null){pv=ixPick(r,/^xNivInuPr|prev|yesterday/i);if(pv>0)c2=v2-pv}
if(c2==null){var p2=await ixPrev(num(r.dEven)||key(new Date()));if(p2>0)c2=v2-p2}
if(v2>1000){v=v2;ch=c2}}}catch(e){}}
if(v!=null){IX.v=v;IX.ch=ch;IX.pc=(ch!=null&&v-ch>0)?ch/(v-ch)*100:null;IX.t=Date.now();try{localStorage.setItem("ix1",JSON.stringify({v:IX.v,ch:IX.ch,pc:IX.pc}))}catch(e){}}
IX.run=false;ixPaint()}
function ixPaint(){var e=document.getElementById("ix");if(!e)return;
if(IX.v==null){e.innerHTML='<span style="font-size:12px;opacity:.85">شاخص…</span>';var r0=document.getElementById("r1");if(r0)r0.className="";return}
var up=IX.ch>0,dn=IX.ch<0,f=function(n,d){return Math.abs(n).toLocaleString("fa-IR",{minimumFractionDigits:d,maximumFractionDigits:d})},sg=up?"+":(dn?"\u2212":"");
var r1=document.getElementById("r1");if(r1)r1.className=(ph()==="ord")?"pre":(up?"up":(dn?"dn":""));
e.innerHTML=(IX.ch==null?"":'<span class="ixs"><span dir="ltr" class="ixp">'+(IX.pc==null?"":sg+f(IX.pc,2)+"\u066a")+'</span><span dir="ltr" class="ixc">'+sg+f(IX.ch,0)+'</span></span>')+'<span class="ixw"><span class="ixv">'+IX.v.toLocaleString("fa-IR",{maximumFractionDigits:0})+'</span><small class="ixl">شاخص کل</small></span>'}
setInterval(function(){if(!document.hidden)ixLoad()},4000);setTimeout(function(){ixPaint();ixLoad()},400);
function afterPaint(f){try{requestAnimationFrame(function(){setTimeout(f,0)})}catch(e){setTimeout(f,30)}}
function subReset(t){if(t==="i"){IG.t="b"}else if(t==="g"){if(WL.lists){var m=WL.lists.findIndex(function(l){return l.name==="اصلی"});WL.cur=m>=0?m:0;WL.sk=null;WL.bs=null}}else if(t==="o"){S.ot="d"}}
function goTab(t){if(!t)return;if(t===tab&&_vt===tab&&document.getElementById("v").childNodes.length&&(t!=="i"||document.getElementById("igpg")))return;if(t==="i"&&igSv()){try{igLeave()}catch(e){IG.sv=null}}tab=t;try{view()}catch(e){if(t==="i"){IG.sv=null;tab="i";try{view()}catch(e2){}}}window.scrollTo(0,0);afterPaint(function(){if(tab===t)bgAll(t)})}


// ===== سبد من / صنعت‌های داغ / هشدار قیمت =====
var MW={t:0,l:null,p:null};
function mwGet(){if(MW.l&&Date.now()-MW.t<15000)return Promise.resolve(MW.l);if(MW.p)return MW.p;
MW.p=getAny("/tsev2/data/MarketWatchInit.aspx?h=0&r=0").then(function(t){var l=parseMW(t);if(l.length<50)throw mkErr("data",0,"parse");MW.l=l;MW.t=Date.now();MW.p=null;return l},function(e){MW.p=null;throw e});return MW.p}
function xNum(v){var n=parseFloat(lat(String(v||"")).replace(/[,٬\s]/g,"").replace(/٫/g,".").replace(/[−–]/g,"-"));return isFinite(n)?n:0}
function xLast(r){return r?(r.pl>0?r.pl:r.pc):0}
function xCol(v){return v>0?"var(--up)":(v<0?"var(--dn)":"inherit")}
function xSg(v,d){return v==null||!isFinite(v)?"—":(v>0?"+":(v<0?"\u2212":""))+cfp(Math.abs(v),d)}
function xLS(k){try{return JSON.parse(localStorage.getItem(k)||"[]")}catch(e){return[]}}
function xSet(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}
function xNotify(t,b,c,n){try{if(c&&window.Android&&Android.notifySym){Android.notifySym(t,b,String(c),String(n||""));return}if(window.Android&&Android.notify)Android.notify(t,b)}catch(e){}}
// باز کردن مستقیم نماد/صفحه‌ای که اعلان لمس‌شده درخواست کرده (از Bridge.takeOpen)
function nativeOpen(){try{if(!(window.Android&&Android.takeOpen))return;var v=String(Android.takeOpen()||"");if(!v)return;var p=v.split("|");if(p[0]==="sym"&&p[1]){openDepth(p[1],p[2]||"")}else if(p[0]==="tab"&&p[1]){window.scrollTo(0,0);goTab(p[1])}}catch(e){}}
window.nativeOpen=nativeOpen;[500,1400,3000].forEach(function(t){setTimeout(nativeOpen,t)});
function xBg(){return !!(window.Android&&Android.alertsSet)}
function alSync(){try{if(!xBg())return;var A=xLS("al1"),ch=0;A.forEach(function(x){if(!x.id){x.id=Date.now().toString(36)+Math.random().toString(36).slice(2,7);ch=1}});if(ch)xSet("al1",A);
Android.alertsSet(JSON.stringify({al:A.map(function(x){var o={id:x.id,c:String(x.c),n:x.n,k:x.k||"p",t:x.t,v:x.v,d:x.d?1:0};if(x.s0!==undefined)o.s0=x.s0;if(x.r>0)o.r=x.r;if(x.f>0)o.f=x.f;if(x.lt>0)o.lt=x.lt;return o}),ag:agCfg()}))}catch(e){}}
// هشدارهایی که سرویس در پس‌زمینه زده را «رسید» علامت بزن و وضعیت صف/نماد سرویس را بگیر
function alPull(){try{if(!(window.Android&&Android.alertsGet))return 0;var j=JSON.parse(Android.alertsGet()),d=j.done||[],A=xLS("al1"),ch=0,sc=0;A.forEach(function(x){if(!x.d&&x.id&&d.indexOf(x.id)>=0){x.d=1;ch=1}});
var cn=j.cnt||{};A.forEach(function(x){var c=cn[x.id];if(!c)return;if(c[0]>(x.f||0)){x.f=c[0];x.lt=Math.max(x.lt||0,c[1]||0);ch=1}else if(c[1]>(x.lt||0)){x.lt=c[1];ch=1}});
if(j.st){for(var k in j.st){if(ALST[k]!==j.st[k]){ALST[k]=j.st[k];sc=1}}if(sc)alStSave()}
if(ch){xSet("al1",A);if(tab==="r")alPaint()}return ch}catch(e){return 0}}
setTimeout(alSync,2500);document.addEventListener("visibilitychange",function(){if(!document.hidden)alPull()});
function xToast(t){var e=document.createElement("div");e.className="tktoast";e.textContent=t;document.body.appendChild(e);try{navigator.vibrate&&navigator.vibrate([200,100,200])}catch(x){}setTimeout(function(){e.style.opacity=0},6000);setTimeout(function(){e.remove()},6600)}
function xForm(id,extra){return'<div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin:6px 0"><input id="'+id+'s" placeholder="نماد" style="flex:1 1 90px;min-width:80px">'+extra+'<button id="'+id+'a" style="flex:none;padding:6px 14px">افزودن</button></div><div id="'+id+'m" class="mut" style="font-size:12px;min-height:16px"></div>'}
async function xFind(id){var q=ar(lat(document.getElementById(id+"s").value).trim()),m=document.getElementById(id+"m");if(!q){m.textContent="نام نماد را بنویسید.";return null}
try{var r=(await mwGet()).filter(function(z){return z.n===q})[0];if(!r){m.textContent="نماد «"+q+"» پیدا نشد.";return null}m.textContent="";return r}catch(e){m.textContent="دریافت فهرست بازار انجام نشد؛ اینترنت را بررسی کنید.";return null}}
// --- هشدارها: همه‌ی انواع در یک کارت ---
// k = نوع (p قیمت، c درصد آخرین، e درصد پایانی، q صف، s وضعیت نماد، v حجم، a ارزش، b حجم به مبنا، w قدرت خریدار)، t = جهت یا زیرنوع
// [مقدار select، عنوان کامل، واحد (خالی = بدون عدد)، عنوان کوتاه جدول]
var ALK=[
{g:"قیمت",i:[["p|up","قیمت بالاتر از","ریال","قیمت بالاتر"],["p|dn","قیمت پایین‌تر از","ریال","قیمت پایین‌تر"]]},
{g:"درصد تغییر",i:[["c|up","درصد آخرین قیمت بالاتر از","٪","٪ آخرین بالاتر"],["c|dn","درصد آخرین قیمت پایین‌تر از","٪","٪ آخرین پایین‌تر"],["e|up","درصد قیمت پایانی بالاتر از","٪","٪ پایانی بالاتر"],["e|dn","درصد قیمت پایانی پایین‌تر از","٪","٪ پایانی پایین‌تر"]]},
{g:"صف",i:[["q|bf","تشکیل صف خرید","","تشکیل صف خرید"],["q|bx","ریختن صف خرید","","ریختن صف خرید"],["q|sf","تشکیل صف فروش","","تشکیل صف فروش"],["q|sx","ریختن صف فروش","","ریختن صف فروش"]]},
{g:"وضعیت نماد",i:[["s|a","تغییر وضعیت نماد (مجاز، ممنوع، متوقف)","","تغییر وضعیت"]]},
{g:"حجم و ارزش",i:[["v|up","حجم معاملات بیشتر از","سهم","حجم بیشتر"],["a|up","ارزش معاملات بیشتر از","میلیارد تومان","ارزش بیشتر"],["b|up","حجم بیشتر از حجم مبنا","برابر","حجم به مبنا"]]},
{g:"قدرت خریدار",i:[["w|up","قدرت خریدار حقیقی بالاتر از","برابر","قدرت بالاتر"],["w|dn","قدرت خریدار حقیقی پایین‌تر از","برابر","قدرت پایین‌تر"]]}
];
var ALT={p:"قیمت",c:"درصد",e:"درصد",q:"صف",s:"وضعیت نماد",v:"حجم",a:"ارزش معاملات",b:"حجم",w:"قدرت خریدار"};
function alInfo(x){var k=(x.k||"p")+"|"+(x.t||"up");for(var i=0;i<ALK.length;i++)for(var j=0;j<ALK[i].i.length;j++)if(ALK[i].i[j][0]===k)return ALK[i].i[j];return null}
function alEv(x){var k=x.k||"p";return k==="q"||k==="s"}
function xNumF(v){var s=lat(String(v==null?"":v)).replace(/[,٬\s%٪]/g,"").replace(/٫/g,".").replace(/[−–]/g,"-");if(!s)return NaN;var n=parseFloat(s);return isFinite(n)?n:NaN}
function alStLbl(c){c=String(c||"").trim().toUpperCase();return({A:"مجاز",AR:"مجاز-محفوظ",AS:"مجاز-متوقف",AG:"مجاز-مسدود",I:"ممنوع",IR:"ممنوع-محفوظ",IS:"ممنوع-متوقف",IG:"ممنوع-مسدود"})[c]||c}
// وضعیت صف: b صف خرید، s صف فروش، n بدون صف، null = امروز معامله نشده
function alQs(r){if(!(r&&r.vol>0))return null;if(r.smx>0&&r.pl>=r.smx)return"b";if(r.smn>0&&r.pl>0&&r.pl<=r.smn)return"s";return"n"}
function alCurSt(x,r){if(x.k==="q")return alQs(r);var s=String(r.st||"").trim().toUpperCase();return s||null}
var ALCT={t:0,m:null};
async function alCT(){if(ALCT.m&&Date.now()-ALCT.t<15000)return ALCT.m;try{ALCT.m=parseCT(await getAny("/tsev2/data/ClientTypeAll.aspx"));ALCT.t=Date.now()}catch(e){}return ALCT.m||{}}
// مقدار فعلی معیار هشدار (null = در دسترس نیست)
function alVal(x,r,ct){var k=x.k||"p";if(!r)return null;
if(k==="p"){var p=xLast(r);return p>0?p:null}
if(k==="c"){var l=xLast(r);return r.py>0&&l>0?(l/r.py-1)*100:null}
if(k==="e"){return r.py>0&&r.pc>0?(r.pc/r.py-1)*100:null}
if(k==="v")return r.vol;if(k==="a")return r.val/1e10;
if(k==="b")return r.bv>0?r.vol/r.bv:null;
if(k==="w"){var q=ct&&ct[r.c];return q&&isFinite(q.pw)?q.pw:null}
return null}
function alHit(x,v){if(v==null||!isFinite(v))return false;return x.t==="dn"?v<=x.v:v>=x.v}
function alTitle(x){return"هشدار "+(ALT[x.k||"p"]||"")+" "+x.n}
function alValMsg(x,r,v){var k=x.k||"p",up=x.t!=="dn",d=up?" به بالاتر از ":" به پایین‌تر از ",o="هشدار: "+x.n;
if(k==="p")return o+d+cfp(x.v)+" رسید (آخرین: "+cfp(v)+")";
if(k==="c"||k==="e")return o+" — "+(k==="c"?"درصد آخرین قیمت":"درصد قیمت پایانی")+d+xSg(x.v,1)+"٪ رسید (اکنون: "+xSg(v,2)+"٪)";
if(k==="v")return o+" — حجم معاملات"+d+cfp(x.v)+" سهم رسید (اکنون: "+cfp(v)+")";
if(k==="a")return o+" — ارزش معاملات"+d+cfp(x.v,1)+" میلیارد تومان رسید (اکنون: "+cfp(v,1)+")";
if(k==="b")return o+" — حجم معاملات به "+cfp(v,1)+" برابر حجم مبنا رسید (هدف: "+cfp(x.v,1)+")";
return o+" — قدرت خریدار حقیقی"+d+cfp(x.v,2)+" رسید (اکنون: "+cfp(v,2)+")"}
function alEvMsg(x,r,a,b){var n=x.n;
if(x.k==="q"){var t=x.t,px=" (آخرین: "+cfp(xLast(r))+")";
if(t==="bf"&&b==="b"&&a!=="b")return"هشدار: "+n+" — صف خرید تشکیل شد"+px;
if(t==="bx"&&a==="b"&&b!=="b")return"هشدار: "+n+" — صف خرید ریخت"+px;
if(t==="sf"&&b==="s"&&a!=="s")return"هشدار: "+n+" — صف فروش تشکیل شد"+px;
if(t==="sx"&&a==="s"&&b!=="s")return"هشدار: "+n+" — صف فروش ریخت"+px;
return null}
return"هشدار: "+n+" — وضعیت نماد از «"+alStLbl(a)+"» به «"+alStLbl(b)+"» تغییر کرد"}
function alTxt(x,r,ct,kind){var k=x.k||"p",v;
if(kind==="t"){if(alEv(x))return"—";if(k==="p"||k==="v")return cfp(x.v);if(k==="c"||k==="e")return xSg(x.v,1)+"٪";if(k==="a")return cfp(x.v,1);return cfp(x.v,k==="w"?2:1)}
if(!r)return"—";
if(k==="q")return({b:"صف خرید",s:"صف فروش",n:"بدون صف"})[alQs(r)]||"—";
if(k==="s")return alStLbl(r.st)||"—";
v=alVal(x,r,ct);if(v==null)return"—";
if(k==="p"||k==="v")return cfp(v);if(k==="c"||k==="e")return xSg(v,2)+"٪";if(k==="a")return cfp(v,1);return cfp(v,k==="w"?2:1)}
function alPh(sel){var a=String(sel||"").split("|"),k=a[0],inf=null,i,j;
for(i=0;i<ALK.length;i++)for(j=0;j<ALK[i].i.length;j++)if(ALK[i].i[j][0]===sel)inf=ALK[i].i[j];
if(!inf||!inf[2])return"";return k==="p"?"قیمت (ریال)":(k==="c"||k==="e"?"درصد، مثلاً ۳ یا ‎−۳":(k==="v"?"حجم (سهم)":(k==="a"?"ارزش (میلیارد تومان)":(k==="b"?"چند برابر حجم مبنا":"قدرت (برابر)"))))}
function alHtml(){var bat="";try{if(window.Android&&Android.batteryOk&&!Android.batteryOk())bat='<div style="display:flex;gap:6px;align-items:center;margin:6px 0"><span class="mut" style="font-size:11.5px;flex:1">برای اینکه هشدار وقتی برنامه بسته است هم برسد، محدودیت باتری را بردارید.</span><button type="button" id="albat" style="flex:none">اجازه‌ی پس‌زمینه</button></div>'}catch(e){}
var opts=ALK.map(function(g){return'<optgroup label="'+g.g+'">'+g.i.map(function(i){return'<option value="'+i[0]+'">'+i[1]+'</option>'}).join("")+'</optgroup>'}).join("");
return'<div class="card alf"><b>هشدارها</b>'+bat+'<div class="mut" style="font-size:11.5px">قیمت، درصد تغییر، صف، وضعیت نماد، حجم و قدرت خریدار در یک‌جا. هنگام رسیدن، پیغام و لرزش می‌گیرید؛ در ساعت بازار حتی وقتی برنامه بسته است. کادر «تکرار» = هشدار چند بار اعلام شود (فاصله‌ی هر بار حدود ۱ دقیقه)؛ بعد از آن «✔ رسید» می‌شود و دیگر تکرار نمی‌شود. خالی = یک بار.</div>'+
'<div class="al1r"><input id="als" placeholder="نماد"><select id="alt">'+opts+'</select></div>'+
'<div class="al1r"><input id="alp" inputmode="decimal" placeholder="'+alPh("p|up")+'"><input id="alr" inputmode="numeric" maxlength="2" placeholder="تکرار" title="این هشدار چند بار تکرار شود"><button type="button" id="ala">افزودن</button></div>'+
'<div id="alm" class="mut" style="font-size:12px;min-height:16px"></div><div class="sc scv" id="alv"></div>'+agHtml()+'</div>'}
var PXS={};
async function alPaint(){var b=document.getElementById("alv");if(!b)return;var A=xLS("al1"),l=null,ct=null,m={};try{l=await mwGet();l.forEach(function(z){m[z.c]=z})}catch(e){}
if(A.some(function(x){return x.k==="w"}))try{ct=await alCT()}catch(e){}
try{PXS=JSON.parse((window.Android&&Android.pxGet&&Android.pxGet())||"{}")||{}}catch(e){PXS={}}
b=document.getElementById("alv");if(!b)return;
if(!A.length){b.innerHTML='<div class="mut" style="padding:8px">هشداری ثبت نشده است.</div>';return}
b.innerHTML='<table class="stk"><tr><th>نماد</th><th>شرط</th><th>هدف</th><th>اکنون</th><th>وضعیت</th><th></th></tr>'+A.map(function(x,i){var r=m[x.c],k=x.k||"p",inf=alInfo(x)||["","","",""],cur=alTxt(x,r,ct,"c"),sv=null;
if(k==="p"&&!(xLast(r)>0)){try{var q=PXS[x.c];if(q){cur=cfp(q[0]);sv=q[1]}}catch(e){}}
var ev=alEv(x);
return'<tr data-tc="'+x.c+'" data-tn="'+esc(x.n)+'" style="cursor:pointer"><td style="font-weight:700">'+esc(x.n)+'</td><td>'+esc(inf[3]||"")+'</td><td>'+alTxt(x,r,ct,"t")+'</td><td>'+cur+(sv!=null?'<div class="mut" style="font-size:9.5px">ذخیره '+dxHM(sv)+'</div>':'')+'</td><td style="color:'+(x.d?"var(--up)":"inherit")+'">'+(x.d?"✔ رسید":(ev?"● فعال":"منتظر"))+(x.r>1||(ev&&x.r>0)?'<div class="mut" style="font-size:9.5px">'+cfp(x.f||0)+' از '+cfp(x.r)+'</div>':'')+'</td><td data-ad="'+i+'" style="cursor:pointer;color:var(--dn)">✕</td></tr>'}).join("")+'</table>'}
function alBind(){var sl=document.getElementById("alt"),pv=document.getElementById("alp"),sync=function(){var ph=alPh(sl.value);pv.placeholder=ph||"بدون نیاز به عدد";pv.disabled=!ph;if(!ph)pv.value=""};sl.onchange=sync;sync();
document.getElementById("ala").onclick=async function(){var r=await xFind("al"),sel=document.getElementById("alt").value.split("|"),k=sel[0],ph=alPh(sel.join("|")),v=0,m=document.getElementById("alm");if(!r)return;
var rrw=lat(String(document.getElementById("alr").value||"")).replace(/[\s]/g,""),rr=0;if(rrw!==""){if(!/^\d{1,2}$/.test(rrw)||+rrw<1){m.textContent="تعداد تکرار را بین ۱ تا ۹۹ وارد کنید.";return}rr=+rrw}
if(ph){v=xNumF(document.getElementById("alp").value);var neg=(k==="c"||k==="e");if(!isFinite(v)||(!neg&&!(v>0))){m.textContent=neg?"درصد هدف را درست وارد کنید.":"مقدار هدف را درست وارد کنید.";return}}
var x={id:Date.now().toString(36)+Math.random().toString(36).slice(2,7),c:r.c,n:r.n,k:k,t:sel[1],v:v,d:0,f:0};x.r=rr>0?rr:((k==="q"||k==="s")?0:1);
if(alEv(x)){var s0=alCurSt(x,r);if(s0==null&&k==="q")s0="n";if(s0!=null){x.s0=s0;ALST[x.id]=s0;alStSave()}}
var A=xLS("al1");A.push(x);xSet("al1",A);alSync();document.getElementById("als").value="";document.getElementById("alp").value="";document.getElementById("alr").value="";m.textContent="";alPaint()};
document.getElementById("alv").onclick=function(e){var d=e.target.closest("[data-ad]");if(!d)return;var A=xLS("al1");A.splice(+d.getAttribute("data-ad"),1);xSet("al1",A);alSync();alPaint()};alPaint();agBind();try{if(window.Android&&Android.askNotify)Android.askNotify()}catch(e){}
var bb=document.getElementById("albat");if(bb)bb.onclick=function(){try{Android.askBattery()}catch(e){}}}
var ALST={};try{ALST=JSON.parse(localStorage.getItem("alst")||"{}")||{}}catch(e){}
function alStSave(){try{localStorage.setItem("alst",JSON.stringify(ALST))}catch(e){}}
function alRepTxt(f,r){return" (تکرار "+cfp(f)+" از "+cfp(r)+")"}
async function alCheck(){alPull();var A=xLS("al1");if(!A.some(function(x){return !x.d}))return;
try{var l=await mwGet(),m={},ch=0,sc=0,ct=null;l.forEach(function(z){m[z.c]=z});
if(A.some(function(x){return x.k==="w"&&!x.d}))ct=await alCT();
A.forEach(function(x){var r=m[x.c],msg=null;if(!r||x.d)return;
if(alEv(x)){var cur=alCurSt(x,r);if(cur==null)return;var prev=ALST[x.id];if(prev===undefined&&x.s0!==undefined)prev=x.s0;
if(prev===undefined||prev===cur){if(ALST[x.id]!==cur){ALST[x.id]=cur;sc=1}return}
ALST[x.id]=cur;sc=1;msg=alEvMsg(x,r,prev,cur)}
else if(!x.d){var v=alVal(x,r,ct);if(alHit(x,v)&&Date.now()-(x.lt||0)>=45000){var rv=x.r>0?x.r:1;x.f=(x.f||0)+1;x.lt=Date.now();if(x.f>=rv)x.d=1;ch=1;msg=alValMsg(x,r,v)+(rv>1?alRepTxt(x.f,rv):"")}}
if(msg&&alEv(x)){var re=x.r>0?x.r:0;x.f=(x.f||0)+1;x.lt=Date.now();ch=1;if(re>0&&x.f>=re)x.d=1;if(re>1)msg+=alRepTxt(x.f,re)}
if(msg){xToast(msg);if(!xBg()||!igOpen())xNotify(alTitle(x),msg,x.c,x.n)}});
if(sc)alStSave();if(ch){xSet("al1",A);alSync();}if((ch||sc)&&tab==="r")alPaint()}catch(e){}}
setInterval(function(){if(document.hidden)return;alCheck()},15000);
// --- هشدار اختلاف قیمت پایانی و آخرین قیمت (ag) ---
// اختلاف = درصد آخرین قیمت − درصد قیمت پایانی (هر دو نسبت به قیمت دیروز)
function agCfg(){var c={};try{c=JSON.parse(localStorage.getItem("ag1")||"{}")||{}}catch(e){}if(c.on==null)c.on=1;if(!(c.th>0))c.th=5;if(!c.mk)c.mk="a";if(!c.dr)c.dr="b";return c}
function agGap(r){if(!(r&&r.py>0&&r.pl>0&&r.pc>0)||!(r.vol>0))return null;return(r.pl-r.pc)/r.py*100}
function agList(l,c){return(l||[]).filter(function(r){if(c.mk==="b"&&r.fl!=="1")return false;if(c.mk==="f"&&["2","3","4"].indexOf(r.fl)<0)return false;var g=agGap(r);if(g==null)return false;r.ag=g;return c.dr==="u"?g>=c.th:(c.dr==="d"?g<=-c.th:Math.abs(g)>=c.th)}).sort(function(a,b){return Math.abs(b.ag)-Math.abs(a.ag)})}
function alExpl(){return'<div class="card" style="margin-top:8px"><div class="mut" style="font-size:12px;line-height:2"><b>انواع هشدار:</b><br>'+
'• <b>قیمت:</b> آخرین قیمت از عدد بالاتر یا پایین‌تر شود.<br>'+
'• <b>درصد تغییر:</b> درصد آخرین قیمت (یا قیمت پایانی) نسبت به دیروز از درصد دلخواه بالاتر یا پایین‌تر شود؛ عدد منفی هم مجاز است (مثلاً ‎−۳).<br>'+
'• <b>صف:</b> تشکیل یا ریختن صف خرید و صف فروش. صف یعنی آخرین قیمت روی سقف یا کف مجاز امروز باشد. هر بار که وضعیت صف عوض شود اعلام می‌شود تا هشدار را حذف کنید.<br>'+
'• <b>وضعیت نماد:</b> هر تغییر وضعیت، مثل مجاز به ممنوع یا متوقف و برعکس، اعلام می‌شود.<br>'+
'• <b>حجم و ارزش:</b> حجم یا ارزش معاملات امروز از عدد بیشتر شود، یا حجم از چند برابرِ حجم مبنا بگذرد.<br>'+
'• <b>قدرت خریدار:</b> قدرت خریدار حقیقی (میانگین خرید هر حقیقی ÷ میانگین فروش هر حقیقی) از عدد بالاتر یا پایین‌تر شود.<br>'+
'• <b>اختلاف قیمت:</b> اختلاف = درصد آخرین قیمت منهای درصد قیمت پایانی (هر دو نسبت به قیمت دیروز). مثبت یعنی آخرین قیمت بالاتر از پایانی است (فشار خرید در دقایق اخیر) و منفی یعنی پایین‌تر. هر نماد در روز یک‌بار اعلام می‌شود؛ فقط نمادهای معامله‌شده‌ی امروز بررسی می‌شوند.<br>'+
'هشدارهای عددی (قیمت، درصد، حجم، قدرت) به تعداد «تکرار» اعلام می‌شوند (پیش‌فرض یک بار؛ فاصله‌ی هر بار حدود ۱ دقیقه تا وقتی شرط برقرار است) و بعد با «✔ رسید» نشان داده می‌شوند و دیگر تکرار نمی‌شوند. هشدارهای صف و وضعیت نماد هم اگر عددی در کادر «تکرار» بنویسید بعد از همان تعداد اعلام «رسید» می‌شوند؛ خالی بگذارید تا حذفشان کنید ادامه دارد. با لمس هر سطر، صفحه‌ی عمق بازار آن نماد باز می‌شود. توصیه‌ی خرید یا فروش نیست.<br>'+
'<b>وقتی برنامه بسته است:</b> در ساعت معاملات (شنبه تا چهارشنبه ۸:۴۴ تا ۱۲:۳۶) یک سرویس پس‌زمینه هر ۱۵ ثانیه بازار را بررسی می‌کند و هشدارها را با اعلان، صدا و لرزش می‌رساند. در این مدت یک اعلان بی‌صدا و کم‌اهمیت با متن «سینو بورس در حال رصد بازار» دیده می‌شود. بیرون از ساعت بازار سرویس خاموش است و صبح روز معاملاتی بعد خودش روشن می‌شود. بار اول اجازه‌ی اعلان را تأیید کنید و اگر دکمه‌ی «اجازه‌ی پس‌زمینه» دیده می‌شود، آن را هم بزنید. اگر گوشی را خاموش و روشن کردید، یک‌بار برنامه را باز کنید. این بررسی‌ها حدود ۲۰ تا ۳۰ مگابایت اینترنت در روز مصرف می‌کند.<br>'+
'<b>ثبت موقعیت باز آپشن‌ها:</b> هر ۱ دقیقه از ساعت ۸:۵۴ تا ۱۲:۳۰ (شنبه تا چهارشنبه)، موقعیت باز همه‌ی قراردادهای آپشن برای نمودار صفحه‌ی عمق بازار ثبت می‌شود، حتی اگر هیچ هشداری فعال نباشد (هر تغییر یک نقطه). سابقه‌ی همه‌ی روزها تا روز سررسید هر قرارداد نگهداری می‌شود و بعد از سررسید پاک می‌شود. این ثبت چند ده مگابایت اینترنت در روز اضافه می‌کند.<br>'+
'• باید «اجازه‌ی اعلان» و «اجازه‌ی پس‌زمینه» (بدون محدودیت باتری) را داده باشید. اگر گوشی سرویس را ببندد، ثبت متوقف می‌شود.<br>'+
'• نقطه‌ها از روزی شروع می‌شوند که این نسخه نصب شود و برنامه یک بار باز شود تا سرویس راه بیفتد.</div></div>'}
function agHtml(){var c=agCfg(),op=function(v,t,cur){return'<option value="'+v+'"'+(v===cur?" selected":"")+'>'+t+'</option>'};
return'<div style="margin-top:10px;padding-top:8px;border-top:1px solid var(--ln)"><b>اختلاف قیمت (پایانی و آخرین)</b><div class="mut" style="font-size:11.5px">سهم‌هایی که فاصله‌ی آخرین قیمت و قیمت پایانی‌شان از حد تعیین‌شده بیشتر شود.</div>'+
'<div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin:6px 0"><label style="display:flex;align-items:center;gap:4px"><input type="checkbox" id="agon"'+(c.on?" checked":"")+' style="width:auto;min-width:0;margin:0"> فعال</label>'+
'<label style="display:flex;align-items:center;gap:4px">بیش از <input id="agth" inputmode="decimal" value="'+c.th+'" style="width:52px;min-width:0;text-align:center"> درصد</label>'+
'<select id="agdr" style="flex:1 1 110px">'+op("b","هر دو جهت",c.dr)+op("u","آخرین بالاتر از پایانی",c.dr)+op("d","آخرین پایین‌تر از پایانی",c.dr)+'</select>'+
'<select id="agmk" style="flex:1 1 80px">'+op("a","همه",c.mk)+op("b","بورس",c.mk)+op("f","فرابورس",c.mk)+'</select></div>'+
'<div class="sc scv" id="agv"><div class="mut" style="padding:8px">در حال دریافت…</div></div>'+
'</div>'}
async function agPaint(){var b=document.getElementById("agv");if(!b)return;var c=agCfg(),l=null;try{l=await mwGet()}catch(e){b.innerHTML='<div class="mut" style="padding:8px">دریافت فهرست بازار انجام نشد؛ اینترنت را بررسی کنید.</div>';return}
b=document.getElementById("agv");if(!b)return;var R=agList(l,c);
if(!R.length){b.innerHTML='<div class="mut" style="padding:8px">نمادی با اختلاف بیش از '+cfp(c.th,1)+' درصد نیست.</div>';return}
var pp=function(p,py){var v=(p/py-1)*100;return'<td style="color:'+xCol(v)+';font-weight:700">'+xSg(v,2)+'</td>'};
b.innerHTML='<div class="mut" style="font-size:11.5px;padding:2px 4px">'+R.length.toLocaleString("fa-IR")+' نماد</div><table class="stk"><tr><th>نماد</th><th>آخرین</th><th>آخرین ٪</th><th>پایانی</th><th>پایانی ٪</th><th>اختلاف ٪</th></tr>'+R.slice(0,200).map(function(r){return'<tr'+tcA(r)+'><td style="font-weight:700">'+esc(r.n)+'</td><td>'+cfp(r.pl)+'</td>'+pp(r.pl,r.py)+'<td>'+cfp(r.pc)+'</td>'+pp(r.pc,r.py)+'<td style="color:'+xCol(r.ag)+';font-weight:800">'+xSg(r.ag,2)+'</td></tr>'}).join("")+'</table>'}
function agBind(){var sv=function(){var c=agCfg();c.on=document.getElementById("agon").checked?1:0;var t=xNum(document.getElementById("agth").value);if(t>0)c.th=t;c.dr=document.getElementById("agdr").value;c.mk=document.getElementById("agmk").value;xSet("ag1",c);alSync();agPaint();agCheck()};
["agon","agdr","agmk","agth"].forEach(function(id){var e=document.getElementById(id);if(e)e.onchange=sv});agPaint()}
async function agCheck(){var c=agCfg();if(!c.on)return;try{var l=await mwGet(),R=agList(l,c),d=key(today),S0={};try{S0=JSON.parse(localStorage.getItem("ag1d")||"{}")||{}}catch(e){}if(S0.d!==d)S0={d:d,c:{}};
if(typeof igOpen==="function"&&!igOpen()){if(tab==="r")agPaint();return}
var nw=R.filter(function(r){return !S0.c[r.c]});if(nw.length){nw.forEach(function(r){S0.c[r.c]=1});xSet("ag1d",S0);
