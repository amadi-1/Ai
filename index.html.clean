function mmCol(p){if(p==null||!isFinite(p)||Math.abs(p)<0.05)return"#546e7a";var up=["#66bb6a","#43a047","#2e7d32","#1b5e20","#0b3d12"],dn=["#e57373","#e53935","#c62828","#b71c1c","#7f0000"],i=Math.min(4,Math.floor(Math.abs(p)));return p>0?up[i]:dn[i]}
// چیدمان مربع‌گونه (squarified treemap)
function mmSq(items,x,y,w,h){var out=[],a=items.slice(),tot=0;a.forEach(function(t){tot+=t.s});if(!(tot>0)||w<=0||h<=0)return out;var sc=w*h/tot;a.forEach(function(t){t.ar=t.s*sc});
 function worst(row,len){var s=0,mx=0,mn=Infinity;row.forEach(function(t){s+=t.ar;mx=Math.max(mx,t.ar);mn=Math.min(mn,t.ar)});var s2=s*s,l2=len*len;return Math.max(l2*mx/s2,s2/(l2*mn))}
 function lay(row,r){var s=0;row.forEach(function(t){s+=t.ar});if(r.w>=r.h){var cw=s/r.h,yy=r.y;row.forEach(function(t){var ch=t.ar/cw;out.push({t:t,x:r.x,y:yy,w:cw,h:ch});yy+=ch});return{x:r.x+cw,y:r.y,w:r.w-cw,h:r.h}}
  var rh=s/r.w,xx=r.x;row.forEach(function(t){var cw2=t.ar/rh;out.push({t:t,x:xx,y:r.y,w:cw2,h:rh});xx+=cw2});return{x:r.x,y:r.y+rh,w:r.w,h:r.h-rh}}
 var r={x:x,y:y,w:w,h:h},row=[];while(a.length){var t=a[0],len=Math.min(r.w,r.h);if(!row.length||worst(row.concat([t]),len)<=worst(row,len)){row.push(t);a.shift()}else{r=lay(row,r);row=[]}}if(row.length)lay(row,r);return out}
