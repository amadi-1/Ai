var FXK={pp:["درصد آخرین قیمت","٪"],pc:["درصد قیمت پایانی","٪"],pr:["آخرین قیمت","ریال"],val:["ارزش معاملات","میلیارد تومان"],vol:["حجم معاملات","میلیون سهم"],tr:["تعداد معاملات",""],vb:["حجم به پایه","برابر"],rl:["ورود پول حقیقی","میلیارد تومان"],hd:["فاصله تا سقف مجاز","٪"],bq:["صف خرید","۱ = هست"],sq:["صف فروش","۱ = هست"]};
function fxL(r){return r.pl>0?r.pl:r.pc}
function fxVal(r,k,ct){var p=fxL(r);switch(k){case"pp":return(p/r.py-1)*100;case"pc":return r.pc>0?(r.pc/r.py-1)*100:0;case"pr":return p;case"val":return r.val/1e10;case"vol":return r.vol/1e6;case"tr":return r.tr;case"vb":return r.bv>0?r.vol/r.bv:0;case"rl":return ct[r.c]?ct[r.c].net*p/1e10:0;case"hd":return r.smx>0?(r.smx/p-1)*100:0;case"bq":return r.smx>0&&p>=r.smx?1:0;case"sq":return r.smn>0&&p<=r.smn?1:0}return 0}
function fxCmp(a,c){return c.o===">"?a>c.v:(c.o==="<"?a<c.v:a===c.v)}
// متغیرهای کد: (pl) (pc) (py) (pf) (pmin) (pmax) (tvol) (tval) (tno) (bvol) (eps) (pe) (z) (mv) (tmax) (tmin) (flow) (cs) (heven) (visitcount) (yval)
// (ct).Buy_CountI … ، (qd1)…(qd5) (zd1) (pd1) (qo1) (zo1) (po1) ، [ih][i].PClosing … ، [is1]… ، (cfield0..2)
var FXV=["pl","pc","py","pf","pmin","pmax","tvol","tval","tno","bvol","eps","pe","z","mv","tmax","tmin","flow","cs","heven","visitcount","yval","cfield0","cfield1","cfield2"];
for(var _i=1;_i<=5;_i++)["qd","zd","pd","qo","zo","po"].forEach(function(k){FXV.push(k+_i)});
var FXN={};
function fxNeed(){var e=new Error("ih");e.fxih=1;return e}
function fxTr(t){t=lat(String(t||"")).replace(/\r/g,"").replace(/[“”]/g,'"').replace(/[‘’]/g,"'");
t=t.replace(/\[\s*ih\s*\]/gi,"IH").replace(/\[\s*is(\d+)\s*\]/gi,"IS[$1]").replace(/\(\s*ct\s*\)\s*\./gi,"CT.").replace(/\bct\s*\./g,"CT.");
t=t.replace(/\(\s*([a-z]+\d?)\s*\)/gi,function(m,n){var k=n.toLowerCase();return FXV.indexOf(k)>=0?"(V."+k+")":m});return t}
function fxComp(code){var t=fxTr(code);if(!t.trim())return{err:"کد فیلتر خالی است."};
try{new Function("V","CT","IH","IS",t)}catch(e){return{err:"خطای نگارشی در کد: "+e.message}}
// eval مستقیم مقدار آخرین عبارت را برمی‌گرداند (مثل فیلتر بورس)
var f;try{f=new Function("V","CT","IH","IS","__s","return eval(__s)")}catch(e){return{err:String(e.message)}}
var ih=/\bIH\b/.test(t),mx=0;(t.match(/IH\s*\[\s*(\d+)\s*\]/g)||[]).forEach(function(m){mx=Math.max(mx,+m.replace(/\D/g,""))});
if(/IH\s*\[\s*[^\d\s\]]/.test(t)){mx=Math.max(mx,59);(t.match(/<\s*=?\s*(\d+)/g)||[]).forEach(function(m){var v=+m.replace(/\D/g,"");if(v<=250)mx=Math.max(mx,v)})}
return{f:f,t:t,ih:ih,n:Math.min(Math.max(mx+1,ih?5:0),250),cf:/V\.cfield[0-2]/.test(t)}}
function fxIS(s){var o=[];o[1]=1e10;String(lat(s||"")).replace(/is\s*(\d+)\s*=\s*(-?[\d.eE+]+)/gi,function(m,k,v){var n=parseFloat(v);if(isFinite(n))o[+k]=n});return o}
function fxOB(t){var m={};String(t).split("@").forEach(function(sg){sg.split(";").forEach(function(r){var f=r.split(",");if(f.length!==8)return;var n=+f[1];if(!(n>=1&&n<=5))return;var c=f[0].trim(),o=m[c]||(m[c]={});o["zo"+n]=num(f[2]);o["zd"+n]=num(f[3]);o["pd"+n]=num(f[4]);o["po"+n]=num(f[5]);o["qd"+n]=num(f[6]);o["qo"+n]=num(f[7])})});return m}
function fxVars(r,ob){var p=r.pc>0?r.pc:r.pl,v={pl:r.pl,pc:r.pc,py:r.py,pf:r.pf||0,pmin:r.lw,pmax:r.hg,tvol:r.vol,tval:r.val,tno:r.tr,bvol:r.bv,eps:r.eps,pe:r.eps?p/r.eps:0,z:r.z||0,mv:(r.z||0)*p,tmax:r.smx,tmin:r.smn,flow:+r.fl||0,cs:+r.sc||0,heven:r.hv||0,visitcount:r.vc||0,yval:+r.yv||0,cfield0:undefined,cfield1:undefined,cfield2:undefined},o=ob[r.c]||{};
for(var i=1;i<=5;i++)["qd","zd","pd","qo","zo","po"].forEach(function(k){v[k+i]=o[k+i]||0});return v}
function fxCT(t){t=t||{};return{Buy_CountI:t.bI||0,Buy_CountN:t.bN||0,Buy_I_Volume:t.bvR||0,Buy_N_Volume:t.bvN||0,Sell_CountI:t.sI||0,Sell_CountN:t.sN||0,Sell_I_Volume:t.svR||0,Sell_N_Volume:t.svN||0}}
var FXIH0=new Proxy([],{get:function(o,k){if(k==="length")throw fxNeed();if(typeof k==="string"&&/^\d+$/.test(k))throw fxNeed();return o[k]}});
function fxIHrow(x){var o={};for(var k in x)o[k]=x[k];var mp={PClosing:"pClosing",PDrCotVal:"pDrCotVal",PriceFirst:"priceFirst",PriceMin:"priceMin",PriceMax:"priceMax",PriceYesterday:"priceYesterday",QTotTran5J:"qTotTran5J",QTotCap:"qTotCap",ZTotTran:"zTotTran",DEven:"dEven",PriceChange:"priceChange"};for(var K in mp)o[K]=num(x[mp[K]]);return o}
function fxEval(Q,r,ct,ob,IH,IS){var V=fxVars(r,ob),ok;ok=Q.f(V,fxCT(ct[r.c]),IH,IS,Q.t);return{ok:!!ok,cf:[V.cfield0,V.cfield1,V.cfield2]}}
async function fxRun(C){if(WP.run)return;WP.run=true;WP.err="";C.cl=0;WP.msg="دریافت فهرست بازار…";if(wlOn())wlPaint();
try{var F=C.fx||(C.fx={m:"and",mk:"b",c:[]}),Q=null;if(F.code){Q=fxComp(F.code);if(Q.err)throw{fxm:Q.err}}
var raw=await getAny("/tsev2/data/MarketWatchInit.aspx?h=0&r=0"),l=C.opt?parseOptMW(raw):parseMW(raw);if(l.length<(C.opt?1:50))throw mkErr("data",0,"parse");
var ob=Q?fxOB(raw):{},ct={},cc={};if(Q||F.c.some(function(c){return c.k==="rl"})){WP.msg="دریافت حقیقی و حقوقی…";if(wlOn())wlPaint();var ctt="";try{ctt=await getAny("/tsev2/data/ClientTypeAll.aspx")}catch(e){}ct=parseCT(ctt);cc=parseCTc(ctt)}
var IS=fxIS(F.is),out=[],need=[],bad=0,lastE="";
if(F.c.length||Q)l.forEach(function(r){if(!(fxL(r)>0&&r.py>0))return;if(!C.opt&&F.mk==="b"&&r.fl!=="1")return;if(!C.opt&&F.mk==="f"&&["2","3","4"].indexOf(r.fl)<0)return;
if(F.c.length){var res=F.c.map(function(c){return fxCmp(fxVal(r,c.k,ct),c)});if(!(F.m==="and"?res.every(Boolean):res.some(Boolean)))return}
if(!Q){out.push(r);return}
try{var e=fxEval(Q,r,cc,ob,FXIH0,IS);if(e.ok){r.cf=e.cf;out.push(r)}}catch(x){if(x&&x.fxih)need.push(r);else{bad++;lastE=String(x&&x.message||x)}}});
if(need.length){var tk=key(today);
await pool(need,6,async function(r){try{var j=JSON.parse(await GET(TS+"ClosingPrice/GetClosingPriceDailyList/"+r.c+"/"+(Q.n+2))),a=firstArr(j.closingPriceDaily||j).slice();
a.sort(function(x,y){return num(y.dEven)-num(x.dEven)});if(a.length&&(num(a[0].dEven)>=tk||num(a[0].qTotTran5J)===r.vol))a.shift();
var e=fxEval(Q,r,cc,ob,a.map(fxIHrow),IS);if(e.ok){r.cf=e.cf;out.push(r)}}catch(x){bad++;lastE=String(x&&x.message||x)}},function(d){WP.msg="بررسی سابقه‌ی معاملات ([ih])… "+d.toLocaleString("fa-IR")+" از "+need.length.toLocaleString("fa-IR");if(d%8===0&&wlOn())wlPaint()})}
out.sort(function(a,b){return b.val-a.val});C.tot=out.length;C.items=out.slice(0,(C.cfg&&C.cfg.n>0)?C.cfg.n:150).map(function(r){return{c:r.c,n:r.n,nm:r.nm,cf:r.cf}});
C.dg=(F.c.length||Q)?"نمادهای منطبق: "+out.length.toLocaleString("fa-IR")+(out.length>C.items.length?" ("+C.items.length.toLocaleString("fa-IR")+" نماد با بیشترین ارزش معاملات نمایش داده شد)":"")+(bad?" — خطای اجرای کد در "+bad.toLocaleString("fa-IR")+" نماد: "+lastE:""):"هنوز کد یا شرطی وارد نشده است.";C.ft=Date.now();WP.stat={m:l.length,c:out.length};wlSave()}
catch(e){WP.run=false;if(e&&e.fxm){WP.err=e.fxm;C.dg=e.fxm;C.ft=Date.now();if(wlOn())wlPaint();return}return nfEnd(e)}
WP.run=false;if(wlOn()){wlPaint();setTimeout(wlLoad,50)}}
