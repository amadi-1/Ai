else if(a==="test"){var tx=(document.getElementById("fxc")||{}).value||"",iv=(document.getElementById("fxis")||{}).value||(F.is||"");try{var ae=document.activeElement;if(ae&&ae.blur)ae.blur()}catch(x){}C.fxd=tx;C.fxt=null;fxShow({ok:-1,msg:"در حال بررسی کد…"});
