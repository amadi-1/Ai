// ---------- touch / mouse ----------
function chPtr(cv){var P1={},g0=null,mv=0,t0=0;
function pos(e){var q=cv.getBoundingClientRect();return{x:e.clientX-q.left,y:e.clientY-q.top}}
function pw(){return CH.geo?CH.geo.pw:cv.clientWidth-48}
cv.onpointerdown=function(e){var p=pos(e);P1[e.pointerId]=p;try{cv.setPointerCapture(e.pointerId)}catch(_){}
var ids=Object.keys(P1);
if(ids.length===1&&CH.selDr>=0&&CH.hp&&CH.hp.length){var hh=null;CH.hp.forEach(function(q){if(Math.hypot(q.x-p.x,q.y-p.y)<18&&(!hh||Math.hypot(q.x-p.x,q.y-p.y)<Math.hypot(hh.x-p.x,hh.y-p.y)))hh=q});if(hh){g0={drag:hh.w};mv=99;return}}
if(ids.length===1&&CH.selDr>=0&&CH.dr[CH.selDr]&&CH.inv&&CH.geo&&chHit(p.x,p.y)===CH.selDr){var o0=CH.dr[CH.selDr],og={};["a","b","c"].forEach(function(k){if(o0[k])og[k]={i:chIdxOfDate(o0[k].d),p:o0[k].p}});g0={move:1,x:p.x,y:p.y,i0:chIdxRaw(p.x),p0:CH.inv(p.y),og:og};mv=0;return}
if(ids.length===1){g0={x:p.x,y:p.y,r:CH.r,yo:CH.yo||0,pan:1};mv=0;t0=Date.now()}
else if(ids.length===2){var a=P1[ids[0]],b=P1[ids[1]],mx=(a.x+b.x)/2;g0={d:Math.hypot(a.x-b.x,a.y-b.y)||1,bw:CH.bw,f:CH.r-(pw()-CH.bw/2-mx)/CH.bw,cx:mx,pinch:1};mv=99}};
cv.onpointermove=function(e){var p=pos(e);
if(!P1[e.pointerId]){if(e.pointerType==="mouse"&&!CH.tool&&CH.geo){CH.sel=chIdxAt(p.x);CH.cy=p.y;chDrawSoon()}return}
P1[e.pointerId]=p;var ids=Object.keys(P1);
if(ids.length===1&&g0&&g0.drag){var o=CH.dr[CH.selDr];if(o&&CH.inv&&CH.B.length){var ix=chIdxRaw(p.x),pv=ix<CH.B.length?chSnap(ix,p.y):CH.inv(p.y),dd=chPtDate(ix);if(o.t==="h"){if(g0.drag==="a"){o.a={d:dd,p:pv};if(o.b)o.b={d:o.b.d,p:pv}}else o.b={d:dd,p:o.a.p}}else if(o.t==="v"){if(g0.drag==="a"){o.a={d:dd,p:pv};if(o.b)o.b={d:dd,p:o.b.p}}else o.b={d:o.a.d,p:pv}}else o[g0.drag]={d:dd,p:pv};chDrawSoon()}return}
if(ids.length===1&&g0&&g0.move){mv=Math.max(mv,Math.hypot(p.x-g0.x,p.y-g0.y));var om=CH.dr[CH.selDr];if(om&&mv>=4){var di=chIdxRaw(p.x)-g0.i0,p1=CH.inv(p.y),lg=CH.P.log&&g0.p0>0&&p1>0;for(var kk in g0.og){var q0=g0.og[kk];om[kk]={d:chPtDate(Math.max(0,q0.i+di)),p:lg?q0.p*p1/g0.p0:q0.p+(p1-g0.p0)}}chDrawSoon()}return}
if(ids.length===1&&g0&&g0.pan){var dx=p.x-g0.x,dy=p.y-g0.y;mv=Math.max(mv,Math.hypot(dx,dy));if(mv>=8){CH.r=g0.r-dx/CH.bw;var mhh=CH.geo?CH.geo.mainH-8:300;CH.yo=g0.yo+dy/mhh*(CH.span||1);chDrawSoon()}}
else if(ids.length>=2&&g0&&g0.pinch){var a=P1[ids[0]],b=P1[ids[1]],ds=Math.hypot(a.x-b.x,a.y-b.y)||1;CH.bw=Math.max(1.2,Math.min(48,g0.bw*ds/g0.d));CH.r=g0.f+(pw()-CH.bw/2-g0.cx)/CH.bw;chDrawSoon()}};
cv.onpointerup=function(e){var p=P1[e.pointerId];if(g0&&g0.move){if(mv>=4)chDrSave();delete P1[e.pointerId];g0=null;return}if(g0&&g0.drag){chDrSave();delete P1[e.pointerId];g0=null;return}delete P1[e.pointerId];var ids=Object.keys(P1);
if(p&&g0&&g0.pan&&mv<8&&Date.now()-t0<600){chTap(p.x,p.y,e.pointerType==="mouse")}
if(!ids.length)g0=null;else{var q=P1[ids[0]];g0={x:q.x,y:q.y,r:CH.r,yo:CH.yo||0,pan:1};mv=99}};
cv.onpointercancel=function(e){delete P1[e.pointerId];if(!Object.keys(P1).length)g0=null};
cv.onwheel=function(e){e.preventDefault();var p=pos(e),f=CH.r-(pw()-CH.bw/2-p.x)/CH.bw;CH.bw=Math.max(1.2,Math.min(48,CH.bw*(e.deltaY<0?1.15:1/1.15)));CH.r=f+(pw()-CH.bw/2-p.x)/CH.bw;chDrawSoon()}}
function chTap(px,py,mouse){var g=CH.geo,n=CH.B.length;if(!g||!n)return;var i=chIdxAt(px);
if(!CH.tool&&CH.cm){var bm=null,bd=26;CH.cm.forEach(function(cm){var d0=Math.hypot(cm.x-px,cm.y-py);if(d0<bd){bd=d0;bm=cm}});if(bm){showCaInfo(bm.e);return}}
if(!CH.tool){var hi=chHit(px,py);if(hi>=0){CH.selDr=hi;CH.sel=-1;chPaint();return}if(CH.selDr>=0){CH.selDr=-1;chPaint();return}}
if(CH.tool){if(py>g.mainH||!CH.inv)return;var ir=chIdxRaw(px),pt={d:chPtDate(ir),p:ir<n?chSnap(ir,py):CH.inv(py)},nd=CHNEED[CH.tool]||2;CH.pend.push(pt);
if(CH.pend.length>=nd){var ob={t:CH.tool,a:CH.pend[0]};if(nd>1)ob.b=CH.pend[1];if(nd>2)ob.c=CH.pend[2];if(ob.t==="h")ob.b={d:ob.b.d,p:ob.a.p};if(ob.t==="v")ob.b={d:ob.a.d,p:ob.b.p};CH.dr.push(ob);CH.selDr=CH.dr.length-1;CH.pend=[];CH.tool=""}
chDrSave();chPaint();return}
if(!mouse&&CH.sel===i&&Math.abs(py-CH.cy)<24)CH.sel=-1;else{CH.sel=i;CH.cy=py}
chDraw();chInfo()}
window.addEventListener("resize",function(){if(tab==="k"||tab==="i")chDraw()});


// ======================================================================================
// وضعیت بازار برای رنگ نماد: آبی = خارج از ساعت کاری، زرد پررنگ = سفارش‌گیری، سبز = بازار باز، قرمز = نماد بسته
// ======================================================================================
function mkClsIx(){var c=S.cl,s=S.stt;S.cl=0;S.stt="";try{return mkCls()}finally{S.cl=c;S.stt=s}}
function mkCls(){if(S.cl)return"cl";if(/^مجاز.*مسدود|^AG$/.test(String(S.stt||"").trim()))return"pre";var h=0,m=0,wd="",o={};
try{new Intl.DateTimeFormat("en-US",{timeZone:"Asia/Tehran",hour12:false,hour:"2-digit",minute:"2-digit",weekday:"short"}).formatToParts(new Date()).forEach(function(p){o[p.type]=p.value});h=(+o.hour)%24;m=+o.minute;wd=o.weekday}
catch(e){var n=new Date();h=n.getHours();m=n.getMinutes();wd=["Sun","Mon","Tue","Wed","Thu","Fri","Sat"][n.getDay()]}
if(wd==="Thu"||wd==="Fri"||hol(today))return"off";
var t=h*60+m;if(t>=510&&t<540)return"pre";if(t>=540&&t<750)return"mk";if(S.ins&&EXT[String(S.ins)]&&t>=750&&t<=1080)return"mk";return"off"}
setInterval(function(){var b=document.getElementById("symb");if(b)b.className="sb "+mkCls()},20000);

// ======================================================================================
// توضیح کامل «بازده آپشن» (سبز = سود، قرمز = زیان و ریسک، مشکی = توضیح)
// ======================================================================================
function ysec(k,title,txt){var c=k==="g"?"var(--up)":(k==="r"?"var(--dn)":(k==="y"?"#7a5a00":"var(--tx)")),b=k==="g"?"var(--upb)":(k==="r"?"var(--dnb)":(k==="y"?"#fff3a8":"var(--bg)"));
return'<div style="border-inline-start:4px solid '+c+';background:'+b+';border-radius:8px;padding:6px 10px;margin:8px 0;line-height:2"><b style="color:'+c+'">'+title+'</b><div style="color:'+(k==="b"?"var(--tx)":c)+'">'+txt+'</div></div>'}
function yieldNote(mode,St,FR){var h='<div class="card" style="font-size:12.5px">';
var ex="";
if(FR&&FR.r){var r=FR.r,T=FR.T;
if(mode==="cc")ex="مثال زنده با اولین ردیف ("+esc(r.n)+"): سهم "+fp(St)+"، اعمال "+fp(r.k)+"، پرمیوم "+fp(r.pm)+". سود در سررسید = "+fp(r.k)+" + "+fp(r.pm)+" − "+fp(St)+" = <b style=\""+yc(r.r)+"\">"+fp(r.k+r.pm-St)+"</b> ریال به‌ازای هر سهم؛ یعنی "+yp(r.r,2)+" در "+T.toLocaleString("fa-IR")+" روز و حدود "+yp(r.a)+" سالانه (ساده).";
else if(mode==="cp")ex="مثال زنده با اولین ردیف ("+esc(r.n)+"): اعمال "+fp(r.k)+"، پرمیوم "+fp(r.pm)+". اگر سهم زیر اعمال نرود، "+fp(r.pm)+" ÷ "+fp(r.k)+" = <b style=\""+yc(r.r)+"\">"+yp(r.r,2)+"</b> سود می‌برید ("+yp(r.a)+" سالانه). سر به سر شما "+fp(r.k-r.pm)+" ریال است.";
else ex="مثال زنده با اولین ردیف: اعمال "+fp(r.k)+"، کال "+fp(r.c)+"، پوت "+fp(r.p)+"، سهم "+fp(St)+". سود قفل‌شده = "+fp(r.k)+" + "+fp(r.c)+" − "+fp(r.p)+" − "+fp(St)+" = <b style=\""+yc(r.g)+"\">"+fp(r.g)+"</b> ریال به‌ازای هر سهم ("+yp(r.r,2)+"، حدود "+yp(r.a)+" سالانه).";
}
if(mode==="cc"){
h+=ysec("b","کاورد کال چیست؟","سهم را به قیمت پایانی می‌خرید و هم‌زمان به همان تعداد، اختیار خرید (کال) می‌فروشید و پرمیوم را همان روز می‌گیرید. یعنی سهم را گران‌تر از امروز به خریدار کال «قول فروش» داده‌اید و در عوض پول نقد گرفته‌اید.");
h+=ysec("g","سود شما","پرمیوم دریافتی همیشه مال شماست. اگر سهم در سررسید بالاتر از قیمت اعمال باشد، سهم شما به قیمت اعمال فروخته می‌شود و به بیشترین سود می‌رسید: اعمال + پرمیوم − قیمت سهم. اگر سهم پایین‌تر از اعمال بماند، سهم را نگه می‌دارید و پرمیوم هم برایتان می‌ماند.");
h+=ysec("r","زیان و ریسک","اگر سهم تا سررسید از «قیمت سهم − پرمیوم» پایین‌تر بیاید (حاشیه امن)، زیان می‌کنید؛ پرمیوم فقط بخشی از افت را جبران می‌کند. سودتان سقف دارد: اگر سهم بسیار بالا برود، بیشتر از سقف سود نمی‌گیرید. وجه تضمین فروش کال، کارمزد، مالیات و نقدشوندگی کم در نتیجه لحاظ نشده است.");
h+=ysec("b","ستون‌ها","<b>بازده تا سررسید</b> = (اعمال + پرمیوم − قیمت سهم) ÷ قیمت سهم؛ <b>سالانه</b> = بازده × ۳۶۵ ÷ روز مانده (ساده)؛ <b>حاشیه امن</b> = پرمیوم ÷ قیمت سهم، یعنی سهم تا این درصد می‌تواند افت کند و هنوز ضرر نکنید. عدد <b style=\"color:var(--up)\">سبز</b> مثبت و <b style=\"color:var(--dn)\">قرمز</b> منفی است.");
}else if(mode==="cp"){
h+=ysec("b","فروش پوت چیست؟","اختیار فروش (پوت) می‌فروشید و پرمیوم را همان روز می‌گیرید؛ در عوض متعهد می‌شوید اگر خریدار خواست، سهم را به قیمت اعمال از او بخرید. باید پول خرید سهم یا وجه تضمین را آماده داشته باشید.");
h+=ysec("g","سود شما","اگر سهم در سررسید بالاتر از قیمت اعمال بماند، پوت اعمال نمی‌شود و کل پرمیوم سود شماست: پرمیوم ÷ مبلغ اعمال. اگر هم سهم را بخرید، آن را با قیمتی پایین‌تر از بازار امروز (اعمال − پرمیوم) خریده‌اید.");
h+=ysec("r","زیان و ریسک","اگر سهم زیر «اعمال − پرمیوم» (سر به سر) بیاید زیان می‌کنید و هر چه پایین‌تر برود زیان بیشتر می‌شود؛ بدترین حالت نزدیک به کل مبلغ اعمال است. وجه تضمین ممکن است با افت قیمت بیشتر شود و اگر تکمیل نکنید، پوزیشن بسته می‌شود. کارمزد و مالیات لحاظ نشده است.");
h+=ysec("b","ستون‌ها","<b>بازده تا سررسید</b> = پرمیوم ÷ مبلغ اعمال؛ <b>سالانه</b> = بازده × ۳۶۵ ÷ روز مانده (ساده)؛ <b>حاشیه امن</b> = فاصله‌ی قیمت سهم تا سر به سر، یعنی سهم تا چند درصد می‌تواند افت کند و شما هنوز ضرر نکنید. <b style=\"color:var(--up)\">سبز</b> مثبت و <b style=\"color:var(--dn)\">قرمز</b> منفی است.");
}else{
h+=ysec("b","کانورژن چیست؟","سه کار هم‌زمان: خرید سهم، خرید پوت و فروش کال با یک قیمت اعمال و یک سررسید. چون هر سه پوزیشن به هم وصل‌اند، قیمت سهم اثری در نتیجه ندارد و سود یا زیان از همان امروز مشخص است.");
h+=ysec("g","سود شما","سود در سررسید = اعمال + کال − پوت − قیمت سهم. اگر این عدد مثبت باشد (ستون «سود» سبز)، بدون ریسک قیمتی سودی ثابت قفل کرده‌اید و بازده آن مقایسه‌پذیر با سپرده است.");
h+=ysec("r","زیان و ریسک","اگر ستون سود منفی (قرمز) باشد، همان مقدار زیان قفل می‌شود و کانورژن نمی‌ارزد. حتی در ردیف سبز: کارمزد خرید و فروش، مالیات، وجه تضمین کال فروخته‌شده، کم‌بودن نقدشوندگی (نداشتن خریدار برای پوت یا کال) و لزوم ثبت درخواست اعمال در مهلت مقرر می‌تواند سود را کم یا صفر کند.");
h+=ysec("b","ستون‌ها","<b>سود</b> = ریال سود هر سهم؛ <b>بازده</b> = سود ÷ هزینه‌ی ورود (سهم + پوت − کال)؛ <b>سالانه</b> = بازده × ۳۶۵ ÷ روز مانده (ساده).");
}
if(ex)h+=ysec("b","مثال",ex);
return h+'<div class="mut" style="line-height:1.9;margin-top:6px">ردیف‌ها بر اساس بازده سالانه (ساده) مرتب‌اند؛ فقط آپشن‌هایی که امروز معامله دارند آمده و پرمیوم = آخرین قیمت. این محاسبه فقط ابزار کمکی است و توصیه‌ی خرید یا فروش نیست.</div></div>'}

// ======================================================================================
// «کدال»: اطلاعیه‌های ناشران (search.codal.ir)
// ======================================================================================
var CD={all:false,flt:"",items:[],page:0,total:0,load:false,err:"",t:0,sym:null};
var CDF=[["","همه"],["صورت","صورت‌های مالی"],["مجمع","مجمع"],["تقسیم|سود نقدی","تقسیم سود"],["افزایش سرمایه","افزایش سرمایه"],["فعالیت ماهانه","فعالیت ماهانه"],["اصلاحیه|توضیحات","اصلاحیه و توضیحات"],["پیش‌بینی|برآورد","پیش‌بینی سود"]];
function pdg(s){return String(s==null?"":s).replace(/\d/g,function(c){return"۰۱۲۳۴۵۶۷۸۹".charAt(+c)})}
function cdAbs(u){if(!u)return"";if(/^https?:/i.test(u))return u;return"https://codal.ir"+(u.charAt(0)==="/"?"":"/")+u}
function cdUrl(pg,sym){return"https://search.codal.ir/api/search/v2/q?&Audited=true&AuditorRef=-1&Category=-1&Childs=true&CompanyState=-1&CompanyType=-1&Consolidatable=true&IsNotAudited=false&Length=-1&LetterType=-1&Mains=true&NotAudited=true&NotConsolidatable=true&PageNumber="+pg+"&Publisher=false&ReportingType=-1&Symbol="+encodeURIComponent(sym||"")+"&TracingNo=-1&search=true"}
async function cdLoad(more){if(CD.load)return;var sym=CD.all?"":(S.sym||"");
if(!more){CD.items=[];CD.page=0;CD.total=0}
CD.load=true;CD.err="";cdPaint();
try{var pg=CD.page+1,j=JSON.parse(await GET(cdUrl(pg,sym))),L=j.Letters||firstArr(j);if(!Array.isArray(L))L=[];
L.forEach(function(x){CD.items.push({s:ar(x.Symbol||""),cn:ar(x.CompanyName||""),t:ar(x.Title||""),d:x.PublishDateTime||x.SentDateTime||"",u:x.Url||"",p:x.PdfUrl||"",x:x.ExcelUrl||"",a:x.AttachmentUrl||"",no:x.TracingNo})});
CD.page=pg;CD.total=+j.Total||CD.items.length;CD.sym=sym;CD.t=Date.now();
if(!L.length&&pg===1)CD.err="اطلاعیه‌ای برای این نماد در کدال پیدا نشد. ممکن است نام نماد در کدال متفاوت باشد؛ «همه ناشران» را امتحان کنید."}
catch(e){CD.err=(e&&e.kind)?why(e,"اطلاعیه‌های کدال"):"پاسخ کدال خوانده نشد؛ چند دقیقه بعد دوباره امتحان کنید یا کدال را در مرورگر باز کنید.";ST.d="codal: "+String(e&&e.message)}
CD.load=false;cdPaint()}
function cdHtml(){var h='<div class="card" style="padding:8px"><div class="sg2" style="margin:2px 0 6px">'+
'<button data-cd="sym"'+(!CD.all?' class="on"':"")+'>'+esc(S.sym||"نماد")+'</button><button data-cd="all"'+(CD.all?' class="on"':"")+'>همه ناشران</button></div>'+
'<div class="prs">'+CDF.map(function(f){return'<button data-cf="'+esc(f[0])+'"'+(CD.flt===f[0]?' class="on"':"")+'>'+f[1]+'</button>'}).join("")+'</div>'+
'<div class="row2" style="justify-content:center;margin:4px 0 0"><button data-cd="rl">بروزرسانی</button><button data-o="https://www.codal.ir/">باز کردن کدال</button></div></div>';
var re=null;try{if(CD.flt)re=new RegExp(CD.flt)}catch(e){}
var l=CD.items.filter(function(x){return!re||re.test(x.t)});
if(CD.err&&!CD.items.length)h+='<div class="card mut" style="text-align:center;line-height:2">'+esc(CD.err)+'</div>';
else if(!CD.items.length)h+='<div class="card mut" style="text-align:center;padding:24px">'+(CD.load?"در حال دریافت اطلاعیه‌های کدال…":"هنوز دریافت نشده؛ «بروزرسانی» را بزنید.")+'</div>';
else{h+='<div class="card" style="padding:4px 8px">';
if(!l.length)h+='<div class="mut" style="padding:10px;text-align:center">در اطلاعیه‌های دریافت‌شده مورد مطابق فیلتر نیست؛ «بارگذاری بیشتر» را بزنید.</div>';
l.forEach(function(x,i){var u=cdAbs(x.u);
h+='<div style="padding:8px 2px;border-bottom:1px solid var(--ln);line-height:1.9"'+(u?' data-o="'+esc(u)+'"':"")+'><div style="display:flex;justify-content:space-between;gap:8px"><b style="color:var(--bl)">'+esc(x.s)+(CD.all&&x.cn?' <small class="mut" style="font-weight:400">'+esc(x.cn)+'</small>':"")+'</b><small class="mut" style="white-space:nowrap">'+pdg(esc(x.d))+'</small></div>'+
'<div style="font-size:13px">'+esc(x.t)+'</div><div style="display:flex;gap:6px;margin-top:3px">'+(u?'<button class="sb" data-o="'+esc(u)+'">مشاهده</button>':"")+(x.p?'<button class="sb" data-o="'+esc(cdAbs(x.p))+'">PDF</button>':"")+(x.x?'<button class="sb" data-o="'+esc(cdAbs(x.x))+'">اکسل</button>':"")+(x.a?'<button class="sb" data-o="'+esc(cdAbs(x.a))+'">پیوست</button>':"")+'</div></div>'});
h+='</div>';
if(CD.err)h+='<div class="mut" style="text-align:center;color:var(--dn)">'+esc(CD.err)+'</div>';
if(CD.items.length<CD.total||CD.load)h+='<div style="text-align:center;margin-bottom:12px"><button data-cd="more"'+(CD.load?" disabled":"")+'>'+(CD.load?"در حال دریافت…":"بارگذاری بیشتر")+'</button></div>';
h+='<div class="mut" style="line-height:1.9">'+CD.items.length.toLocaleString("fa-IR")+' اطلاعیه از '+CD.total.toLocaleString("fa-IR")+' دریافت شد. فیلترها روی عنوان اطلاعیه‌های دریافت‌شده کار می‌کنند. با لمس هر اطلاعیه در مرورگر یا برنامه‌ی دستگاه باز می‌شود.</div>'}
return h}
function cdPaint(){if(tab!=="q")return;var v=document.getElementById("v");if(!v)return;var y=window.pageYOffset||0;v.innerHTML=cdHtml();cdBind(false);try{window.scrollTo(0,y)}catch(e){}setHH()}
function cdBind(trig){
document.querySelectorAll("[data-cd]").forEach(function(b){b.onclick=function(e){e.stopPropagation();var k=b.dataset.cd;if(k==="sym"||k==="all"){var a=k==="all";if(a!==CD.all){CD.all=a;cdLoad(false)}}else if(k==="rl")cdLoad(false);else if(k==="more")cdLoad(true)}});
document.querySelectorAll("[data-cf]").forEach(function(b){b.onclick=function(){CD.flt=b.dataset.cf;cdPaint()}});
document.querySelectorAll("[data-o]").forEach(function(b){b.onclick=function(e){e.stopPropagation();openIn("",b.dataset.o)}});
if(trig&&!CD.load&&(CD.t===0||CD.sym!==(CD.all?"":(S.sym||""))))cdLoad(false)}

// ======================================================================================
// «TSE»: صفحه‌ی کامل نماد از بورس (tsetmc): قیمت‌ها، صف‌ها، حقیقی/حقوقی، آمار و تاریخچه
// ======================================================================================
var TX={ins:"",d:null,load:false,err:"",ei:"",t:0};
function tsKV(a,b,c){return'<div style="display:flex;justify-content:space-between;gap:8px;padding:4px 0;border-bottom:1px solid var(--ln)"><span class="mut" style="font-size:12px">'+a+'</span><b style="font-size:12.5px'+(c?";color:"+c:"")+'">'+b+'</b></div>'}
function tsCol(x){return x>0?"var(--up)":(x<0?"var(--dn)":"")}
async function tsLoad(){if(TX.load||!S.ins)return;var ins=S.ins;TX.load=true;TX.err="";tsPaint();
function g(p){return GET(TS+p).then(function(t){return JSON.parse(t)},function(e){return{__e:e}})}
try{var r=await Promise.all([g("Instrument/GetInstrumentInfo/"+ins),g("ClosingPrice/GetClosingPriceInfo/"+ins),g("BestLimits/"+ins),g("ClientType/GetClientType/"+ins+"/1/0"),g("ClosingPrice/GetClosingPriceDailyList/"+ins+"/20")]);
if(r[0].__e&&r[1].__e)throw r[1].__e;
var I=r[0].__e?{}:(r[0].instrumentInfo||r[0]),C=r[1].__e?{}:(r[1].closingPriceInfo||r[1]);
var BL=r[2].__e?[]:firstArr(r[2].bestLimits||r[2]),CT=r[3].__e?null:(r[3].clientType||r[3]),H=r[4].__e?[]:firstArr(r[4].closingPriceDaily||r[4]);
if(S.ins===ins){TX.d={I:I,C:C,BL:BL,CT:CT,H:H};TX.ins=ins;TX.t=Date.now()}}
catch(e){TX.err=(e&&e.kind==="data")?"برای این نماد داده‌ای از بورس دریافت نشد.":why(e,"اطلاعات نماد");TX.ei=ins}
TX.load=false;if(tab==="e"){if(S.ins!==ins)tsLoad();else tsPaint()}}
function tsHtml(){
if(!S.ins)return'<div class="card mut">ابتدا نماد را در کادر جستجو وارد کنید.</div>';
var bar='<div class="card" style="padding:8px"><div class="row2" style="justify-content:center;margin:0"><button data-ts="rl">بروزرسانی</button><button data-o="https://www.tsetmc.com/instInfo/'+esc(S.ins)+'">باز کردن در tsetmc</button></div></div>';
if(TX.ins!==S.ins||!TX.d)return bar+'<div class="card mut" style="text-align:center;padding:24px;line-height:2">'+(TX.load?"در حال دریافت اطلاعات "+esc(S.sym)+"…":esc((TX.ei===S.ins&&TX.err)||"هنوز دریافت نشده؛ «بروزرسانی» را بزنید."))+'</div>';
var I=TX.d.I,C=TX.d.C,pc=num(C.pClosing),pl=num(C.pDrCotVal),py=num(C.priceYesterday),pr=(preOpen()&&py>0)?py:(pc>0?pc:pl),
chg=function(p){return py>0&&p>0?(p-py)/py*100:null},cc=chg(pc),cl=chg(pl),
st=I.staticThreshold||{},mx=num(st.psGelStaMax),mn=num(st.psGelStaMin),eps=num((I.eps||{}).estimatedEPS)||num((I.eps||{}).epsValue),spe=num((I.eps||{}).sectorPE),
sh=num(I.zTitad),mc=sh>0&&pr>0?sh*pr:0,vol=num(C.qTotTran5J),val=num(C.qTotCap),nm=ar(String(I.lVal30||I.lVal18AFC||S.sym||"")),sec=I.sector&&I.sector.lSecVal?ar(String(I.sector.lSecVal).trim()):"",
pcs=function(x){return x==null?"":" <small>("+(x>0?"+":(x<0?"−":""))+f1(Math.abs(x),2)+"٪)</small>"},
h=bar+'<div class="card"><div style="font-weight:700;font-size:15px">'+esc(S.sym)+' <small class="mut" style="font-weight:400">'+esc(nm)+'</small></div>'+(sec?'<div class="mut" style="font-size:12px">'+esc(sec)+'</div>':"")+
(S.cl&&S.stt?'<div class="cr">نماد بسته است – وضعیت: '+esc(S.stt)+'</div>':"")+
tsTop(C,mn,mx)+
tsKV("حجم مبنا",cvol(num(I.baseVol)))+tsKV("میانگین حجم ماه",cvol(num(I.qTotTran5JAvg)))+
tsKV("ارزش بازار",mc>0?cfp(mc/1e9,0)+" میلیارد ریال":"—")+tsKV("تعداد سهام",sh>0?cvol(sh):"—")+
tsKV("EPS",eps?fp(eps):"—",eps<0?"var(--dn)":"")+tsKV("P/E",eps>0&&pr>0?f1(pr/eps):(eps<0?"زیان‌ده":"—"))+tsKV("P/E گروه",spe>0?f1(spe):"—")+
tsKV("کمترین / بیشترین هفته",fp(num(I.minWeek))+" / "+fp(num(I.maxWeek)))+tsKV("کمترین / بیشترین سال",fp(num(I.minYear))+" / "+fp(num(I.maxYear)))+
(num(I.nav)>0?tsKV("NAV",fp(num(I.nav)))+tsKV("حباب",f1((pr/num(I.nav)-1)*100,2)+"٪",tsCol(-(pr-num(I.nav)))):"")+'</div>';
var BL=TX.d.BL;
if(BL&&BL.length){var sb=0,ss=0,cb=0,cs=0;BL.forEach(function(b){sb+=num(b.qTitMeDem);ss+=num(b.qTitMeOf);cb+=num(b.zOrdMeDem);cs+=num(b.zOrdMeOf)});
h+='<div class="card"><b>سفارش‌های خرید و فروش</b><table class="stk" style="margin-top:6px"><tr><th>تعداد</th><th>حجم</th><th>قیمت خرید</th><th>قیمت فروش</th><th>حجم</th><th>تعداد</th></tr>'+
BL.slice(0,5).map(function(b,i){return'<tr'+(i%2?"":' class="zb"')+'><td>'+cfp(num(b.zOrdMeDem))+'</td><td>'+cvol(num(b.qTitMeDem))+'</td><td style="color:var(--up);font-weight:700">'+fp(num(b.pMeDem))+'</td><td style="color:var(--dn);font-weight:700">'+fp(num(b.pMeOf))+'</td><td>'+cvol(num(b.qTitMeOf))+'</td><td>'+cfp(num(b.zOrdMeOf))+'</td></tr>'}).join("")+
'<tr><td class="gh">'+cfp(cb)+'</td><td class="gh" style="color:var(--up)">'+cvol(sb)+'</td><td class="gh" colspan="2">مجموع ۵ ردیف</td><td class="gh" style="color:var(--dn)">'+cvol(ss)+'</td><td class="gh">'+cfp(cs)+'</td></tr></table></div>'}
var CT=TX.d.CT;
if(CT){var bI=num(deep(CT,"buy_I_Volume")),bN=num(deep(CT,"buy_N_Volume")),sI=num(deep(CT,"sell_I_Volume")),sN=num(deep(CT,"sell_N_Volume")),
cbI=num(deep(CT,"buy_CountI")),cbN=num(deep(CT,"buy_CountN")),csI=num(deep(CT,"sell_CountI")),csN=num(deep(CT,"sell_CountN")),
pw=(cbI>0&&csI>0&&sI>0)?(bI/cbI)/(sI/csI):null,nI=(bI-sI)*pr/1e9,nN=(bN-sN)*pr/1e9;
function cr(a,b,c,d,e,f,g){return'<tr><td class="nm">'+a+'</td><td style="color:var(--up)">'+b+'</td><td style="color:var(--dn)">'+c+'</td><td>'+d+'</td><td>'+e+'</td><td style="color:'+tsCol(f)+';font-weight:700">'+g+'</td></tr>'}
h+='<div class="card"><b>حقیقی و حقوقی</b><table class="stk" style="margin-top:6px"><tr><th></th><th>حجم خرید</th><th>حجم فروش</th><th>خریدار</th><th>فروشنده</th><th>خالص (م.ریال)</th></tr>'+
cr("حقیقی",cvol(bI),cvol(sI),cfp(cbI),cfp(csI),nI,cfp(nI,0))+cr("حقوقی",cvol(bN),cvol(sN),cfp(cbN),cfp(csN),nN,cfp(nN,0))+'</table>'+
(pw!=null?tsKV("قدرت خریدار حقیقی",f1(pw,2),pw>1?"var(--up)":"var(--dn)"):"")+
'<div class="mut" style="line-height:1.9;margin-top:4px">قدرت خریدار = میانگین خرید هر خریدار حقیقی ÷ میانگین فروش هر فروشنده‌ی حقیقی؛ بالای ۱ یعنی حقیقی‌ها درشت‌تر می‌خرند تا بفروشند. خالص = (خرید − فروش) × قیمت.</div></div>'}
var H=TX.d.H;
if(H&&H.length){var rows=H.map(function(r){return{d:num(r.dEven),c:num(r.pClosing),l:num(r.pDrCotVal),y:num(r.priceYesterday),v:num(r.qTotTran5J)}}).filter(function(r){return r.d>19000101}).sort(function(a,b){return b.d-a.d}).slice(0,20);
h+='<div class="card"><b>تاریخچه‌ی ۲۰ روز اخیر</b><table class="stk" style="margin-top:6px"><tr><th>تاریخ</th><th>پایانی</th><th>تغییر</th><th>آخرین</th><th>حجم</th></tr>'+
rows.map(function(r,i){var ch=r.y>0&&r.c>0?(r.c-r.y)/r.y*100:null;return'<tr'+(i%2?"":' class="zb"')+'><td>'+cjs(cdj(r.d),"full")+'</td><td>'+fp(r.c)+'</td><td style="color:'+tsCol(ch)+';font-weight:700">'+(ch==null?"—":(ch>0?"+":(ch<0?"−":""))+f1(Math.abs(ch),2)+"٪")+'</td><td>'+fp(r.l)+'</td><td>'+cvol(r.v)+'</td></tr>'}).join("")+'</table></div>'}
return h+'<div class="mut" style="line-height:1.9">منبع: tsetmc. آخرین دریافت: '+new Date(TX.t).toLocaleTimeString("fa-IR",{hour:"2-digit",minute:"2-digit"})+'. برخی بخش‌ها اگر بورس پاسخ ندهد نمایش داده نمی‌شوند.</div>'}
function tsPaint(){if(tab!=="e")return;var v=document.getElementById("v");if(!v)return;var y=window.pageYOffset||0;v.innerHTML=tsHtml();tsBind(false);try{window.scrollTo(0,y)}catch(e){}setHH()}
function tsBind(trig){
document.querySelectorAll("[data-ts]").forEach(function(b){b.onclick=function(){if(b.dataset.ts==="rl")tsLoad();else{tab="q";view()}}});
document.querySelectorAll("[data-o]").forEach(function(b){b.onclick=function(e){e.stopPropagation();openIn("",b.dataset.o)}});
if(trig&&S.ins&&!TX.load&&(TX.ins!==S.ins||!TX.d)&&TX.ei!==S.ins)tsLoad()}


