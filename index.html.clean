function mkPaint(){if(tab!=="m")return;var v=document.getElementById("v");if(!v)return;var _ae=document.activeElement;if(_ae&&_ae.closest&&_ae.closest("#mkc")&&/INPUT|SELECT|TEXTAREA/.test(_ae.tagName))return;var hh=mkRest(),kk=hh.replace(/آخرین دریافت:[^.]*\./,"");if(kk===MK.ph&&MK.D&&!MK.load)return;MK.ph=kk;var y=window.pageYOffset||0,mr=document.getElementById("mkr");if(mr&&document.getElementById("cxc"))mr.innerHTML=hh;else v.innerHTML=mkHtml();mkBind(false);try{window.scrollTo(0,y)}catch(e){}setHH()}
