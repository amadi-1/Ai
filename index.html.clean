if(D.usd&&!D.usdProxy||D.teth){gc='<div class="card"><b class="'+secCls("fx")+'">دلار آزاد و تتر</b>'+(D.usd&&!D.usdProxy?mkKV("قیمت دلار آزاد",mkTom(D.usd.v,D.usd.ch)):"")+(D.teth?mkKV("قیمت تتر",mkTom(D.teth.v,D.teth.ch)):"")+(D.usd&&!D.usdProxy&&D.teth?(function(){var q=mkDiffT(D.teth.v,D.usd.v);return mkKV("اختلاف تتر با دلار آزاد",q[0],q[1])})():"")+'</div>'}
if(D.ons||D.brent||D.btc){wc='<div class="card"><b class="'+secCls("world")+'">بازارهای جهانی</b>'+
(D.ons?mkKV("انس جهانی طلا",mkUsd(D.ons.v,D.ons.ch,2)+' &nbsp;'+mkChg(D.ons.ch)):"")+
(D.brent?mkKV("نفت برنت",mkUsd(D.brent.v,D.brent.ch,2)+' &nbsp;'+mkChg(D.brent.ch)):"")+
(D.btc?mkKV("بیت‌کوین",mkUsd(D.btc.v,D.btc.ch,0)+' &nbsp;'+mkChg(D.btc.ch)):"")+'</div>'}
function bzBlock(title,o,raw,pre,extra){var dv=mkDiff(o.cur,o.avg),dh=(o.cur/o.hi.r-1)*100,dl=(o.cur/o.lo.r-1)*100;
return'<div class="card"><b class="'+secCls("idx")+'">'+title+'</b>'+(pre||"")+mkKV("ارزش فعلی","$"+f1(o.cur,2))+(extra||"")+
