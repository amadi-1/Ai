function ccLive(u){return/ClosingPrice\/GetClosingPriceInfo|ClosingPrice\/GetClosingPriceDailyList|BestLimits|OptionMarketWatch|Trade\/GetTrade|ClientType|Index\/|MarketData\/|MarketWatchInit|ClientTypeAll/.test(u)}
