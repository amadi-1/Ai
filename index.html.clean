if(ser.length<50)return null;var s=0,mx=ser[0],mn=ser[0];ser.forEach(function(x){s+=x[1];if(x[1]>mx[1])mx=x;if(x[1]<mn[1])mn=x});
return{n:ser.length,avg:s/ser.length,hi:{r:mx[1],k:mx[0]},lo:{r:mn[1],k:mn[0]},from:ser[0][0],lastIdx:idxClose(hi[hi.length-1])}}
