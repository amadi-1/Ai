if(!cs)cs='<div class="mut" style="padding:6px">کد یا شرطی ندارید؛ کد فیلتر را بنویسید یا از پایین شرط اضافه کنید.</div>';
var dr=C.fxd!=null?C.fxd:(F.code||""),isv=C.fxi!=null?C.fxi:(F.is||"is1=10000000000"),it=C.items||[],cft="";
if(it.some(function(x){return x.cf&&x.cf.some(function(v){return v!==undefined&&v!==null})})){var cv=function(v){return v===undefined||v===null?"—":(typeof v==="number"?cfp(v,Math.abs(v)<100?2:0):esc(String(v)))};
cft='<div class="card" style="padding:6px;margin-top:8px"><b>ستون‌های cfield</b><div class="sc scv"><table class="stk"><tr><th class="drw">ردیف</th><th>نماد</th><th>cfield0</th><th>cfield1</th><th>cfield2</th></tr>'+it.map(function(x,i){var f=x.cf||[];return'<tr'+(typeof tcA==="function"?tcA(x):"")+'><td class="drw">'+(i+1).toLocaleString("fa-IR")+'</td><td style="font-weight:700">'+esc(x.n)+'</td><td>'+cv(f[0])+'</td><td>'+cv(f[1])+'</td><td>'+cv(f[2])+'</td></tr>'}).join("")+'</table></div></div>'}
return'<div class="card fxw" style="padding:8px;margin-top:8px"><b>ساخت فیلتر</b><div class="mut" style="font-size:11px;line-height:1.8">'+esc(WP.run?WP.msg:(C.dg||wpMsg(C)))+'</div>'+(C.opt?"":sl("mk","بازار",[["b","بورس"],["f","فرابورس"],["a","همه"]],F.mk))+sl("m","ترکیب شرط‌ها",[["and","همه برقرار باشد (و)"],["or","هرکدام (یا)"]],F.m)+cs+
'<div class="fl" style="margin-top:8px"><label style="min-width:90px">پارامترهای [is]</label><input id="fxis" dir="ltr" value="'+esc(C.fxi!=null?C.fxi:(F.is||"is1=10000000000"))+'" style="flex:1;max-width:none;min-width:0;font-family:monospace;font-size:12px"></div>'+
'<div class="fl" style="margin-top:8px"><select id="fxk" style="flex:2 1 130px;max-width:none">'+o(ks)+'</select><select id="fxo" style="flex:1 1 80px;max-width:none"><option value=">">بزرگ‌تر از</option><option value="<">کوچک‌تر از</option><option value="=">برابر با</option></select><input id="fxv" inputmode="decimal" placeholder="عدد" style="flex:1 1 70px;min-width:60px;max-width:none"><button data-fx="add" style="flex:none">افزودن شرط</button></div><div id="fxmsg" class="mut" style="font-size:12px;min-height:16px"></div>'+
'<div class="fl" style="margin-top:6px"><button data-fx="run">اجرای فیلتر</button><button data-fx="save">ذخیره بنام</button></div></div>'+cft+
'<div class="card fxw" style="padding:8px;margin-top:8px;line-height:2;font-size:12px"><b>توضیح فیلتر ساز</b><br>'+(C.opt?'<b>ویژه‌ی آپشن:</b> این فیلتر ساز فقط روی نمادهای اختیار خرید و فروش اجرا می‌شود. برای سنجش صف می‌توانید از (qd1) حجم صف خرید و (qo1) حجم صف فروش و (pd1) و (po1) قیمت آن‌ها استفاده کنید؛ مثلاً <span dir="ltr">(qd1)-(qo1)>[is1]</span>.<br>':'')+'<b>کد فیلتر:</b> همان کدی که در فیلترهای سایت بورس (TSETMC) می‌نویسید، مثل فیلتر ورود پول، را در کادر «کد فیلتر» بالای صفحه بچسبانید و «تست کد» را بزنید. کادر کنار دکمه می‌گوید کد سالم است یا خراب، و اگر خراب است ایراد و شماره‌ی سطر آن را نشان می‌دهد؛ کد سالم بلافاصله روی کل بازار اجرا می‌شود. مقدار آخرین عبارت کد تعیین می‌کند نماد در لیست بیاید یا نه (true یعنی بیاید). می‌توانید var، if، for و Math را به کار ببرید.<br><b>متغیرهای قابل استفاده:</b> <span dir="ltr">(pl)</span> آخرین قیمت، <span dir="ltr">(pc)</span> قیمت پایانی، <span dir="ltr">(py)</span> قیمت دیروز، <span dir="ltr">(pf)</span> اولین قیمت، <span dir="ltr">(pmin) (pmax)</span> کمترین و بیشترین امروز، <span dir="ltr">(tvol) (tval) (tno)</span> حجم، ارزش و تعداد معاملات، <span dir="ltr">(bvol)</span> حجم مبنا، <span dir="ltr">(eps) (pe) (z) (mv)</span>، <span dir="ltr">(tmax) (tmin)</span> سقف و کف مجاز، <span dir="ltr">(flow) (cs)</span> بازار و گروه صنعت.<br><b>حقیقی و حقوقی:</b> <span dir="ltr">(ct).Buy_CountI, (ct).Buy_CountN, (ct).Buy_I_Volume, (ct).Buy_N_Volume, (ct).Sell_CountI, (ct).Sell_CountN, (ct).Sell_I_Volume, (ct).Sell_N_Volume</span><br><b>عرضه و تقاضا (۵ سطح):</b> <span dir="ltr">(qd1)…(qd5)</span> حجم خرید، <span dir="ltr">(zd1)</span> تعداد خریدار، <span dir="ltr">(pd1)</span> قیمت خرید، <span dir="ltr">(qo1) (zo1) (po1)</span> همین‌ها برای فروش.<br><b>سابقه:</b> <span dir="ltr">[ih][0]</span> آخرین روز معاملاتی قبل از امروز، <span dir="ltr">[ih][1]</span> روز قبل از آن و…؛ فیلدها: <span dir="ltr">PClosing, PDrCotVal, PriceFirst, PriceMin, PriceMax, PriceYesterday, QTotTran5J, QTotCap, ZTotTran</span>. سابقه فقط برای نمادهایی گرفته می‌شود که شرط‌های قبلی کد را پاس کرده‌اند، پس شرط‌های سبک را اول بنویسید.<br><b>پارامترها و ستون‌ها:</b> <span dir="ltr">[is1]</span>، <span dir="ltr">[is2]</span>… از کادر کوچک زیر کد خوانده می‌شوند (پیش‌فرض is1 = یک میلیارد تومان). با <span dir="ltr">(cfield0)=…</span> تا <span dir="ltr">(cfield2)</span> ستون دلخواه در جدول پایین نشان داده می‌شود.<br><b>شرط‌های ساده:</b> از فهرست کشویی هم می‌توانید شرط اضافه کنید؛ اگر هم کد و هم شرط داشته باشید، نماد باید هر دو را پاس کند. «ذخیره بنام» نمادهای منطبق فعلی را در یک دیده‌بان تازه ثابت می‌کند. نتیجه‌ی فیلتر آماری است و توصیه‌ی خرید یا فروش نیست.</div>'}
document.addEventListener("input",function(e){var t=e.target;if(!t||(t.id!=="fxc"&&t.id!=="fxis"&&t.id!=="fxnl"))return;var C=wlCur();if(!C||C.flt!=="fx1")return;if(t.id==="fxc")C.fxd=t.value;else if(t.id==="fxnl")C.fxn=t.value;else C.fxi=t.value});
