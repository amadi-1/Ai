var act=bgOf(first&&tab?tab:tab),order=[act,"m","px","e","a","k","q","z"].filter(function(k,i,a){return a.indexOf(k)===i});
for(var i=0;i<order.length;i++){var k=order[i],now=Date.now();if(BG.t[k])continue;
if(k==="z"&&SA.run)continue;if(preOpen()&&k!=="m"&&!(k==="px"&&S.ins&&!(+S.base>0)))continue;BG.t[k]=now;
if(k===act){try{await BGT[k].f()}catch(e){}}else{(function(f){try{var p=f();if(p&&p.catch)p.catch(function(){})}catch(e){}})(BGT[k].f);await new Promise(function(r){setTimeout(r,400)})}}}}
finally{BG.run=false}}
