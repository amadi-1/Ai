else if(/حجم/.test(p)&&/برابر|مشکوک|میانگین/.test(p)){var k=Nb(p,"برابر",/مشکوک/.test(p)?3:2),d=days(p,20);vr("vavg"+d,"var vs"+d+"=0,vn"+d+"=0;for(var i=0;i<"+d+"&&i<[ih].length;i++){vs"+d+"+=[ih][i].QTotTran5J;vn"+d+"++}var vavg"+d+"=vn"+d+"?vs"+d+"/vn"+d+":0; // میانگین حجم "+d+" روز");cf.push("(cfield2)=vavg"+d+">0?Math.round((tvol)/vavg"+d+"*10)/10:0; // حجم به میانگین");add(p,"vavg"+d+">0 && (tvol)"+dir(p,">")+k+"*vavg"+d)}
else if(/حجم\s*مبنا/.test(p)){add(p,"(tvol)"+dir(p,">")+"(bvol)")}
else if(/ارزش\s*(معامل|بازار)/.test(p)){if(/ارزش\s*بازار/.test(p))add(p,"(mv)"+dir(p,">")+Nb(p,"(هزار\\s*)?میلیارد",N(p,1000))+"*1e10");else add(p,"(tval)"+dir(p,">")+Nb(p,"میلیارد",N(p,10))+"*1e10")}
else if(/تعداد\s*معامل/.test(p)){add(p,"(tno)"+dir(p,">")+N(p,100))}
else if(/حجم/.test(p)){var u=/هزار/.test(p)?1e3:1e6;add(p,"(tvol)"+dir(p,">")+N(p,1)+"*"+u)}
else if(/کندل\s*(سبز|مثبت)|(سبز|مثبت)\s*کندل/.test(p)){add(p,"(pl)>(pf)")}
else if(/کندل\s*(قرمز|منفی)|(قرمز|منفی)\s*کندل/.test(p)){add(p,"(pl)<(pf)")}
else if(/سقف|مقاومت/.test(p)&&!/سقف\s*(مجاز|روزانه|قیمت\s*مجاز)/.test(p)){var d2=days(p,20);vr("mx"+d2,"var mx"+d2+"=0;for(var i=0;i<"+d2+"&&i<[ih].length;i++){mx"+d2+"=Math.max(mx"+d2+",[ih][i].PriceMax)} // سقف "+d2+" روز");add(p,ng?"(pl)<=mx"+d2:"mx"+d2+">0 && (pl)>mx"+d2)}
else if(/کف|حمایت/.test(p)&&!/کف\s*(مجاز|روزانه)/.test(p)){var d3=days(p,20);vr("mn"+d3,"var mn"+d3+"=1e15;for(var i=0;i<"+d3+"&&i<[ih].length;i++){if([ih][i].PriceMin>0)mn"+d3+"=Math.min(mn"+d3+",[ih][i].PriceMin)} // کف "+d3+" روز");add(p,dir(p,"<")==="<"?"(pl)<mn"+d3:"(pl)>mn"+d3)}
else if(/میانگین\s*(متحرک|قیمت)|\bma\b|مووینگ/i.test(p)){var d4=days(p,N(p,20)>2?N(p,20):20);vr("ma"+d4,"var ms"+d4+"=0,mc"+d4+"=0;for(var i=0;i<"+d4+"&&i<[ih].length;i++){ms"+d4+"+=[ih][i].PClosing;mc"+d4+"++}var ma"+d4+"=mc"+d4+"?ms"+d4+"/mc"+d4+":0; // میانگین متحرک "+d4+" روزه");add(p,"ma"+d4+">0 && (pl)"+dir(p,">")+"ma"+d4)}
else if(/تقاضا|خریدار\s*بیشتر|سفارش\s*خرید/.test(p)&&!/عرضه\s*بیشتر/.test(p)){add(p,"(qd1)>(qo1)")}
else if(/عرضه/.test(p)){add(p,"(qo1)>(qd1)")}
