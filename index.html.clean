function mkcGet(){var c=null;try{c=JSON.parse(localStorage.getItem("mkc1")||"null")}catch(e){}c=c||{};c.h=c.h||[];c.nm=c.nm||{};c.o=c.o||[];c.a=c.a||[];return c}
