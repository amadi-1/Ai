// ---------- formatting ----------
function cfp(v,d){return v==null||!isFinite(v)?"—":v.toLocaleString("fa-IR",{maximumFractionDigits:d==null?0:d})}
function cpr(v){return v==null||!isFinite(v)?"—":(Math.abs(v)>=1000?Math.round(v).toLocaleString("fa-IR"):v.toLocaleString("fa-IR",{maximumFractionDigits:2}))}
function cvol(v){if(v==null||!isFinite(v))return"—";var a=Math.abs(v);return a>=1e9?cfp(v/1e9,1)+" میلیارد":(a>=1e6?cfp(v/1e6,1)+" میلیون":(a>=1e3?cfp(v/1e3,1)+" هزار":cfp(v,0)))}
var CPJ=new Intl.DateTimeFormat("en-u-ca-persian",{year:"numeric",month:"numeric",day:"numeric"});
function g2j(gy,gm,gd){var g_d_m=[0,31,59,90,120,151,181,212,243,273,304,334];var jy=(gy<=1600)?0:979;gy-=(gy<=1600)?621:1600;var gy2=(gm>2)?(gy+1):gy;var days=(365*gy)+Math.floor((gy2+3)/4)-Math.floor((gy2+99)/100)+Math.floor((gy2+399)/400)-80+gd+g_d_m[gm-1];jy+=33*Math.floor(days/12053);days%=12053;jy+=4*Math.floor(days/1461);days%=1461;if(days>365){jy+=Math.floor((days-1)/365);days=(days-1)%365}var jm=(days<186)?1+Math.floor(days/31):7+Math.floor((days-186)/30);var jd=1+((days<186)?(days%31):((days-186)%30));return[jy,jm,jd]}
function cdj(d){return g2j(Math.floor(d/1e4),Math.floor(d/100)%100,d%100)}
var JMN=["","فروردین","اردیبهشت","خرداد","تیر","مرداد","شهریور","مهر","آبان","آذر","دی","بهمن","اسفند"];
function cjn(j,mode){var P2=function(x){return String(x).replace(/\d/g,function(c){return"۰۱۲۳۴۵۶۷۸۹".charAt(+c)})};return mode==="ym"?JMN[j[1]]+" "+P2(j[0]):(mode==="md"?P2(j[2])+" "+JMN[j[1]]:cjs(j,"full"))}
function cjs(j,mode){var p=function(n){return(n<10?"0":"")+n},s=mode==="ym"?j[0]+"/"+p(j[1]):(mode==="md"?p(j[1])+"/"+p(j[2]):j[0]+"/"+p(j[1])+"/"+p(j[2]));return s.replace(/\d/g,function(c){return"۰۱۲۳۴۵۶۷۸۹".charAt(+c)})}
function cnice(raw){var p=Math.pow(10,Math.floor(Math.log(raw)/Math.LN10)),f=raw/p;return(f<1.5?1:(f<3?2:(f<7?5:10)))*p}

// ---------- loading ----------
async function chLoad(){
if(CH.load||!S.ins)return;var ins=S.ins;CH.load=true;CH.err="";chPaint();
try{var a=IGX[ins]?await igRows(ins):firstArr((function(j){return j.closingPriceDaily||j})(JSON.parse(await GET(TS+"ClosingPrice/GetClosingPriceDailyList/"+ins+"/0")))),rows=[],seen={};
a.forEach(function(r){var d=num(r.dEven);if(d<19000101||seen[d])return;var c=num(r.pClosing),l=num(r.pDrCotVal);if(!(c>0||l>0))return;seen[d]=1;
rows.push({d:d,o:num(r.priceFirst),h:num(r.priceMax),l:num(r.priceMin),c:c,lp:l,y:num(r.priceYesterday),v:num(r.qTotTran5J),n:num(r.zTotTran),j:cdj(d)})});
rows.sort(function(x,y){return x.d-y.d});
var caE=[];for(var q=1;q<rows.length;q++){var pr0=rows[q-1].c>0?rows[q-1].c:rows[q-1].lp,rf0=rows[q].y;if(pr0>0&&rf0>0&&Math.abs(rf0-pr0)/pr0>0.004)caE.push({d:rows[q].d,prev:pr0,ref:rf0,type:"div"})}
try{var sj=JSON.parse(await GET(TS+"Instrument/GetInstrumentShareChange/"+ins)),sc=firstArr(sj.instrumentShareChange||sj),dn=function(d){return Math.floor(new Date(Math.floor(d/1e4),Math.floor(d/100)%100-1,d%100,12).getTime()/864e5)};
sc.forEach(function(r){var sd=num(r.dEven),so=num(r.numberOfShareOld),sn=num(r.numberOfShareNew);if(!(sd>19000101&&so>0&&sn>so))return;
var m0=null;caE.forEach(function(e){if(Math.abs(dn(e.d)-dn(sd))<=5&&!e.cap)m0=e});
if(m0){m0.cap={o:so,n:sn};var ex=m0.prev*so/sn;m0.type=Math.abs(m0.ref-ex)/ex>0.012?"both":"cap"}
else{var bi=null;for(var z=0;z<rows.length;z++){if(rows[z].d>=sd){bi=z;break}}caE.push({d:sd,prev:bi>0?(rows[bi-1].c||rows[bi-1].lp):0,ref:bi!=null?rows[bi].y:0,type:"cap",cap:{o:so,n:sn}})}});
caE.sort(function(a,b){return a.d-b.d})}catch(e){}
if(rows.length<5)throw mkErr("data",0,"تاریخچه‌ی کافی برای این نماد دریافت نشد.");
if(S.ins===ins){CH.ca=caE;CH.raw=rows;CH.ins=ins;CH.t=Date.now();CH.key="";CH.vk="";CH.sel=-1;CH.pend=[];CH.tool="";CH.more=40;
try{CH.dr=JSON.parse(localStorage.getItem("chd_"+ins)||"[]")}catch(e){CH.dr=[]}}}
catch(e){CH.err=(e&&e.kind==="data")?e.message:why(e,"تاریخچه‌ی نماد");CH.errIns=ins;CH.ins=null;CH.raw=[]}
CH.load=false;
if(tab==="k"||tab==="i"){if(S.ins!==ins)chLoad();else chPaint()}}

// ---------- data series (adjusted for capital increases, aggregated to the chosen timeframe) ----------
function chWk(d){var t=new Date(Math.floor(d/1e4),Math.floor(d/100)%100-1,d%100,12);return Math.floor(t.getTime()/864e5)-((t.getDay()+1)%7)}
function chAgg(D,tf){var out=[],cur=null,key;
D.forEach(function(b){key=tf==="M"?b.j[0]*100+b.j[1]:chWk(b.d);
if(!cur||cur.k!==key){cur={k:key,d:b.d,d0:b.d,j:b.j,o:b.o,h:b.h,l:b.l,c:b.c,v:b.v,n:b.n};out.push(cur)}
else{cur.h=Math.max(cur.h,b.h);cur.l=Math.min(cur.l,b.l);cur.c=b.c;cur.d=b.d;cur.j=b.j;cur.v+=b.v;cur.n+=b.n}});
return out}
// ===== درون‌روز شاخص: ۱ / ۵ / ۱۵ / ۳۰ دقیقه و ۱ ساعت (از نمودار آخرین روز معاملاتی و روزهای ذخیره‌شده) =====
function chIn(){return /^\d+$/.test(String(CH.P.tf))}
function chHM(t){var h=Math.floor(t/60),m=t%60,p=function(x){return(x<10?"0":"")+x};return(p(h)+":"+p(m)).replace(/\d/g,function(c){return"۰۱۲۳۴۵۶۷۸۹".charAt(+c)})}
function chDl(b){return cjs(b.j,"full")+(b.t!=null?" "+chHM(b.t):"")}
function chXl(i,n,B,mode){if(!chIn())return cjn(i<n?B[i].j:chFutJ(i-n+1),mode);if(i>=n)return"";var b=B[i];return(i===0||B[i-1].d!==b.d)?cjn(b.j,"md"):chHM(b.t)}
function chIntra(tf){var o=[],R=CH.itr;if(!R||R.ins!==CH.ins||!(tf>0))return o;
R.days.forEach(function(day){var cur=null;day.p.forEach(function(q){var h=q[0],v=q[1],m=Math.floor(h/10000)*60+Math.floor(h/100)%100,bk=Math.floor(m/tf);
if(!cur||cur.k!==bk){var op=cur?cur.c:v,st=bk*tf;cur={k:bk,d:day.d,d0:day.d,dk:day.d*10000+Math.floor(st/60)*100+st%60,j:cdj(day.d),t:st,o:op,h:Math.max(op,v),l:Math.min(op,v),c:v,v:0,n:0};o.push(cur)}
else{if(v>cur.h)cur.h=v;if(v<cur.l)cur.l=v;cur.c=v}cur.v+=(q[2]||0)})});return o}
async function chItLoadS(ins){var days=[];try{days=JSON.parse(localStorage.getItem("ixi_"+ins)||"[]")||[]}catch(e){days=[]}
var pack=function(rows){var by={};rows.forEach(function(x){if(num(x.canceled)>0)return;var h=num(x.hEven),pr=num(x.pTran),q=num(x.qTitTran),d=num(x.dEven)||key(new Date());if(!(h>0&&pr>0))return;(by[d]=by[d]||[]).push([h,pr,q])});
return Object.keys(by).map(function(d){var L=by[d].sort(function(a,b){return a[0]-b[0]}),mm={},ord=[];L.forEach(function(r){var k=Math.floor(r[0]/100),o=mm[k];if(!o){o=mm[k]={h:r[0],o:r[1],hi:r[1],lo:r[1],c:r[1],q:0};ord.push(k)}if(r[1]>o.hi)o.hi=r[1];if(r[1]<o.lo)o.lo=r[1];o.c=r[1];o.q+=r[2]});
var p=[];ord.forEach(function(k){var o=mm[k];p.push([o.h,o.o,o.q],[o.h,o.hi,0],[o.h,o.lo,0],[o.h,o.c,0])});return{d:+d,p:p}}).filter(function(z){return z.p.length>3})};
var add=function(z){days=days.filter(function(q){return q.d!==z.d});days.push(z)};
try{var j=JSON.parse(await GET(TS+"Trade/GetTrade/"+ins));pack(firstArr(j.trade||j)).forEach(add)}catch(e){}
try{var have={};days.forEach(function(z){have[z.d]=1});var need=(CH.raw||[]).map(function(r){return r.d}).filter(function(d){return !have[d]}).slice(-3).reverse().slice(0,2);
for(var i=0;i<need.length;i++){try{var jh=JSON.parse(await GET(TS+"Trade/GetTradeHistory/"+ins+"/"+need[i]+"/false"));var rows=firstArr(jh.tradeHistory||jh).map(function(x){x.dEven=x.dEven||need[i];return x});pack(rows).forEach(add)}catch(e){}}}catch(e){}
days.sort(function(p,q){return p.d-q.d});days=days.slice(-4);
try{localStorage.setItem("ixi_"+ins,JSON.stringify(days))}catch(e){}
CH.itErr=days.length?"":"داده‌ی درون‌روز این نماد دریافت نشد؛ اینترنت را بررسی کنید.";
CH.itr={ins:ins,days:days,t:Date.now()};CH.itl=0;if(S.ins===ins&&chIn())chPaint()}
async function chItLoad(force){var ins=S.ins;if(CH.itl||!ins)return;if(!IGX[ins]){if(!force&&CH.itr&&CH.itr.ins===ins&&Date.now()-CH.itr.t<45000)return;CH.itl=1;return chItLoadS(ins)}if(!force&&CH.itr&&CH.itr.ins===ins&&Date.now()-CH.itr.t<45000)return;CH.itl=1;
var days=[];try{days=JSON.parse(localStorage.getItem("ixi_"+ins)||"[]")||[]}catch(e){days=[]}
try{var a=firstArr(JSON.parse(await GET(TS+"Index/GetIndexB1LastDay/"+ins))),o=[];
a.forEach(function(x){var h=num(x.hEven),v=idxClose(x);if(!(v>0))v=ixPick(x,/^xDrNivJIdx|value|last/i);if(h>0&&v>0)o.push([h,v])});
o.sort(function(p,q){return p[0]-q[0]});var dd=num(a[0]&&a[0].dEven)||key(new Date());
if(o.length>1){days=days.filter(function(z){return z.d!==dd});days.push({d:dd,p:o});days.sort(function(p,q){return p.d-q.d});days=days.slice(-10);try{localStorage.setItem("ixi_"+ins,JSON.stringify(days))}catch(e){}CH.itErr=""}
else if(!days.length)CH.itErr="داده‌ی درون‌روز شاخص دریافت نشد."}
catch(e){if(!days.length)CH.itErr="داده‌ی درون‌روز شاخص دریافت نشد؛ اینترنت را بررسی کنید."}
CH.itr={ins:ins,days:days,t:Date.now()};CH.itl=0;if(S.ins===ins&&chIn())chPaint()}
function chHA(B){var o=[],i,b,c,po,pc;for(i=0;i<B.length;i++){b=B[i];c=(b.o+b.h+b.l+b.c)/4;po=i?(o[i-1].o+o[i-1].c)/2:(b.o+b.c)/2;
o.push({o:po,c:c,h:Math.max(b.h,po,c),l:Math.min(b.l,po,c)})}return o}

function wilder(tr,p){var o=[],a=null,i,j,s0;for(i=0;i<tr.length;i++){if(i<p-1){o.push(null);continue}if(i===p-1){s0=0;for(j=0;j<p;j++)s0+=tr[j];a=s0/p}else a=(a*(p-1)+tr[i])/p;o.push(a)}return o}
function chExtra(B,I){var n=B.length,i,j,tr=[],dh=[],dl=[],st=[],su=[],fub=[],flb=[];
for(i=0;i<n;i++){var b=B[i],pc=i?B[i-1].c:b.c;tr.push(Math.max(b.h-b.l,Math.abs(b.h-pc),Math.abs(b.l-pc)));
if(i>=19){var hi=-Infinity,lo=Infinity;for(j=i-19;j<=i;j++){if(B[j].h>hi)hi=B[j].h;if(B[j].l<lo)lo=B[j].l}dh.push(hi);dl.push(lo)}else{dh.push(null);dl.push(null)}}
var a10=wilder(tr,10);
for(i=0;i<n;i++){if(a10[i]==null){st.push(null);su.push(true);fub.push(null);flb.push(null);continue}
var mid=(B[i].h+B[i].l)/2,ub=mid+3*a10[i],lb=mid-3*a10[i];
if(i>0&&fub[i-1]!=null){ub=(ub<fub[i-1]||B[i-1].c>fub[i-1])?ub:fub[i-1];lb=(lb>flb[i-1]||B[i-1].c<flb[i-1])?lb:flb[i-1]}
fub.push(ub);flb.push(lb);
var pu=(i>0&&st[i-1]!=null)?su[i-1]:(B[i].c>=mid),nu=pu?(B[i].c>=lb):(B[i].c>ub);st.push(nu?lb:ub);su.push(nu)}
I.dh=dh;I.dl=dl;I.st=st;I.su=su;I.atr=wilder(tr,14)}
function chEnsure(){var P=CH.P,key=[CH.ins,P.tf,P.adj,P.px,CH.raw.length,(chIn()&&CH.itr)?CH.itr.t:0].join("|");if(chIn()&&(!CH.itr||CH.itr.ins!==CH.ins)&&!CH.itl)setTimeout(chItLoad,0);if(CH.key===key)return;CH.key=key;
var R=CH.raw,n=R.length,m=new Array(n),i;m[n-1]=1;
for(i=n-1;i>0;i--){var f=1,pc=R[i-1].c||R[i-1].lp;if(P.adj&&R[i].y>0&&pc>0){var q=R[i].y/pc;if(Math.abs(q-1)>0.003&&q>0.05&&q<20)f=q}m[i-1]=m[i]*f}
var D=[];
R.forEach(function(r,i){var k=m[i],c=(P.px==="c"?(r.c||r.lp):(r.lp||r.c))*k,o=r.o>0?r.o*k:0,h=r.h*k,l=r.l*k;
if(!(o>0))o=D.length?D[D.length-1].c:c;h=Math.max(h||c,o,c);l=l>0?Math.min(l,o,c):Math.min(o,c);
D.push({d:r.d,d0:r.d,j:r.j,o:o,h:h,l:l,c:c,v:r.v,n:r.n})});
var B=chIn()?chIntra(+P.tf):(P.tf==="D"?D:chAgg(D,P.tf));
for(i=0;i<B.length;i++)B[i].pc=i?B[i-1].c:B[i].o;
CH.B=B;CH.HA=chHA(B);CH.I=chInd(B);chExtra(B,CH.I);CH.ev=chEv(B,CH.I);
var vk=CH.ins+"|"+P.tf;if(CH.vk!==vk){CH.vk=vk;CH.needView=chIn()?"1":(P.tf==="D"?"180":(P.tf==="W"?"730":"all"))}}

// ---------- indicators ----------
function smaN(a,n){var o=[],i,j,s,ok;for(i=0;i<a.length;i++){if(i<n-1){o.push(null);continue}s=0;ok=1;for(j=i-n+1;j<=i;j++){if(a[j]==null){ok=0;break}s+=a[j]}o.push(ok?s/n:null)}return o}
function emaN(a,n){var o=[],k=2/(n+1),e=null,c=0,i;for(i=0;i<a.length;i++){if(a[i]==null){o.push(null);continue}c++;e=e==null?a[i]:a[i]*k+e*(1-k);o.push(c>=n?e:null)}return o}
function rsiN(c,n){var o=[null],ag=0,al=0,i,d,g,l;for(i=1;i<c.length;i++){d=c[i]-c[i-1];g=d>0?d:0;l=d<0?-d:0;
if(i<=n){ag+=g;al+=l;if(i===n){ag/=n;al/=n;o.push(al===0?100:100-100/(1+ag/al))}else o.push(null)}
else{ag=(ag*(n-1)+g)/n;al=(al*(n-1)+l)/n;o.push(al===0?100:100-100/(1+ag/al))}}return o}
function psar(h,l){var n=h.length,v=[],up=[],i;for(i=0;i<n;i++){v.push(null);up.push(true)}if(n<5)return{v:v,up:up};
var af0=.02,afm=.2,bull=true,af=af0,ep=h[0],sar=l[0];
for(i=1;i<n;i++){sar=sar+af*(ep-sar);
if(bull){sar=Math.min(sar,l[i-1],i>1?l[i-2]:l[i-1]);if(l[i]<sar){bull=false;sar=ep;ep=l[i];af=af0}else if(h[i]>ep){ep=h[i];af=Math.min(af+af0,afm)}}
else{sar=Math.max(sar,h[i-1],i>1?h[i-2]:h[i-1]);if(h[i]>sar){bull=true;sar=ep;ep=h[i];af=af0}else if(l[i]<ep){ep=l[i];af=Math.min(af+af0,afm)}}
v[i]=sar;up[i]=bull}
return{v:v,up:up}}
function chInd(B){var n=B.length,c=B.map(function(b){return b.c}),h=B.map(function(b){return b.h}),l=B.map(function(b){return b.l}),v=B.map(function(b){return b.v}),I={},i,j;
I.m20=smaN(c,20);I.m50=smaN(c,50);I.m200=smaN(c,200);I.e21=emaN(c,21);
I.bu=[];I.bl=[];
for(i=0;i<n;i++){var mm=I.m20[i];if(mm==null){I.bu.push(null);I.bl.push(null);continue}var s=0;for(j=i-19;j<=i;j++){s+=(c[j]-mm)*(c[j]-mm)}var sd=Math.sqrt(s/20);I.bu.push(mm+2*sd);I.bl.push(mm-2*sd)}
function hl(len,i){var a=-Infinity,b=Infinity,k;for(k=i-len+1;k<=i;k++){if(h[k]>a)a=h[k];if(l[k]<b)b=l[k]}return(a+b)/2}
I.tk=[];I.kj=[];I.sa=[];I.sb=[];
for(i=0;i<n+26;i++){I.sa.push(null);I.sb.push(null)}
for(i=0;i<n;i++){var t=i>=8?hl(9,i):null,k2=i>=25?hl(26,i):null;I.tk.push(t);I.kj.push(k2);
if(t!=null&&k2!=null)I.sa[i+26]=(t+k2)/2;if(i>=51)I.sb[i+26]=hl(52,i)}
var sp=psar(h,l);I.sar=sp.v;I.sarUp=sp.up;
I.rsi=rsiN(c,14);
var e12=emaN(c,12),e26=emaN(c,26);I.mc=e12.map(function(x,i){return x!=null&&e26[i]!=null?x-e26[i]:null});I.ms=emaN(I.mc,9);
I.mh=I.mc.map(function(x,i){return x!=null&&I.ms[i]!=null?x-I.ms[i]:null});
var kr=[];for(i=0;i<n;i++){if(i<13){kr.push(null);continue}var hh=-Infinity,ll=Infinity;for(j=i-13;j<=i;j++){if(h[j]>hh)hh=h[j];if(l[j]<ll)ll=l[j]}kr.push(hh===ll?50:(c[i]-ll)/(hh-ll)*100)}
I.sk=smaN(kr,3);I.sd=smaN(I.sk,3);
var tp=B.map(function(b){return(b.h+b.l+b.c)/3}),tm=smaN(tp,20);I.cci=[];
for(i=0;i<n;i++){if(tm[i]==null){I.cci.push(null);continue}var md=0;for(j=i-19;j<=i;j++)md+=Math.abs(tp[j]-tm[i]);md/=20;I.cci.push(md>0?(tp[i]-tm[i])/(0.015*md):0)}
I.obv=[];var o2=0;for(i=0;i<n;i++){if(i>0){if(c[i]>c[i-1])o2+=v[i];else if(c[i]<c[i-1])o2-=v[i]}I.obv.push(o2)}
I.vma=smaN(v,20);
return I}

// ---------- history of past technical signals ----------
function chEv(B,I){var ev=[],n=B.length,i;
function X(a,b,i){return a[i]!=null&&b[i]!=null&&a[i-1]!=null&&b[i-1]!=null}
for(i=1;i<n;i++){
if(X(I.m50,I.m200,i)){if(I.m50[i-1]<=I.m200[i-1]&&I.m50[i]>I.m200[i])ev.push({i:i,t:"تقاطع طلایی: MA50 از MA200 بالاتر رفت",s:1});else if(I.m50[i-1]>=I.m200[i-1]&&I.m50[i]<I.m200[i])ev.push({i:i,t:"تقاطع مرگ: MA50 از MA200 پایین‌تر رفت",s:-1})}
if(X(I.m20,I.m50,i)){if(I.m20[i-1]<=I.m50[i-1]&&I.m20[i]>I.m50[i])ev.push({i:i,t:"MA20 از MA50 بالاتر رفت",s:1});else if(I.m20[i-1]>=I.m50[i-1]&&I.m20[i]<I.m50[i])ev.push({i:i,t:"MA20 از MA50 پایین‌تر رفت",s:-1})}
if(X(I.mc,I.ms,i)){if(I.mc[i-1]<=I.ms[i-1]&&I.mc[i]>I.ms[i])ev.push({i:i,t:"MACD سیگنال خرید داد (عبور از خط سیگنال)",s:1});else if(I.mc[i-1]>=I.ms[i-1]&&I.mc[i]<I.ms[i])ev.push({i:i,t:"MACD سیگنال فروش داد (عبور از خط سیگنال)",s:-1})}
if(I.rsi[i]!=null&&I.rsi[i-1]!=null){if(I.rsi[i-1]<30&&I.rsi[i]>=30)ev.push({i:i,t:"RSI از اشباع فروش (۳۰) خارج شد",s:1});else if(I.rsi[i-1]>70&&I.rsi[i]<=70)ev.push({i:i,t:"RSI از اشباع خرید (۷۰) خارج شد",s:-1})}
if(I.m200[i]!=null&&I.m200[i-1]!=null){if(B[i-1].c<=I.m200[i-1]&&B[i].c>I.m200[i])ev.push({i:i,t:"قیمت MA200 را رو به بالا شکست",s:1});else if(B[i-1].c>=I.m200[i-1]&&B[i].c<I.m200[i])ev.push({i:i,t:"قیمت MA200 را رو به پایین شکست",s:-1})}
if(I.sarUp[i]!==I.sarUp[i-1]&&I.sar[i-1]!=null)ev.push({i:i,t:I.sarUp[i]?"پارابولیک SAR به حالت صعودی برگشت":"پارابولیک SAR به حالت نزولی برگشت",s:I.sarUp[i]?1:-1})}
ev.sort(function(a,b){return b.i-a.i});return ev}

// ---------- technical summary ----------
function chSum(){var B=CH.B,I=CH.I,n=B.length,i=n-1,b=B[i],c=b.c,R=[],sc=0,cnt=0;
function add(l,v,s){R.push([l,v,s]);sc+=s;cnt++}
function ma(k,name){var m=I[k][i];if(m==null)return;var d=(c/m-1)*100;add("قیمت نسبت به "+name,(d>=0?"بالاتر ":"پایین‌تر ")+cfp(Math.abs(d),1)+"٪ ("+cpr(m)+")",d>=0?1:-1)}
ma("m20","MA20");ma("m50","MA50");ma("m200","MA200");ma("e21","EMA21");
if(I.m50[i]!=null&&I.m200[i]!=null)add("MA50 در برابر MA200",I.m50[i]>=I.m200[i]?"طلایی (روند بلندمدت صعودی)":"مرگ (روند بلندمدت نزولی)",I.m50[i]>=I.m200[i]?1:-1);
var rs=I.rsi[i];if(rs!=null)add("RSI(14)",cfp(rs,1)+(rs>=70?" – اشباع خرید":(rs<=30?" – اشباع فروش":" – محدوده‌ی خنثی")),rs>=70?-1:(rs<=30?1:0));
if(I.mc[i]!=null&&I.ms[i]!=null)add("MACD(12,26,9)","هیستوگرام "+cfp(I.mh[i],2)+(I.mc[i]>=I.ms[i]?" – بالای خط سیگنال":" – زیر خط سیگنال"),I.mc[i]>=I.ms[i]?1:-1);
if(I.sk[i]!=null&&I.sd[i]!=null)add("استوکاستیک",cfp(I.sk[i],0)+" / "+cfp(I.sd[i],0)+(I.sk[i]>=80?" – اشباع خرید":(I.sk[i]<=20?" – اشباع فروش":"")),I.sk[i]>=I.sd[i]?1:-1);
if(I.bu[i]!=null){var pb=(c-I.bl[i])/(I.bu[i]-I.bl[i])*100;add("باند بولینگر",pb>100?"بالای باند بالا":(pb<0?"زیر باند پایین":"داخل باند ("+cfp(pb,0)+"٪ از پایین)"),pb>100?-1:(pb<0?1:0))}
var sa=I.sa[i],sb=I.sb[i];if(sa!=null&&sb!=null){var ct=Math.max(sa,sb),cb=Math.min(sa,sb);add("ایچیموکو (ابر)",c>ct?"بالای ابر":(c<cb?"زیر ابر":"داخل ابر"),c>ct?1:(c<cb?-1:0))}
if(I.sar[i]!=null)add("پارابولیک SAR",cpr(I.sar[i])+(I.sarUp[i]?" – زیر قیمت":" – بالای قیمت"),I.sarUp[i]?1:-1);
if(I.cci[i]!=null)add("CCI(20)",cfp(I.cci[i],0)+(I.cci[i]>100?" – بالای ۱۰۰":(I.cci[i]<-100?" – زیر ۱۰۰-":"")),I.cci[i]>=0?1:-1);
if(I.vma[i]>0)add("حجم نسبت به میانگین ۲۰",cfp(b.v/I.vma[i],1)+" برابر",0);
var t=cnt?sc/cnt:0,lab=t>0.5?"صعودی قوی":(t>0.15?"صعودی":(t<-0.5?"نزولی قوی":(t<-0.15?"نزولی":"خنثی")));
var h='<div class="mt" style="margin-top:4px">خلاصه‌ی وضعیت تکنیکال</div><div style="text-align:center;margin-bottom:6px">برآیند شاخص‌ها: <b style="color:'+(t>0.15?"var(--up)":(t<-0.15?"var(--dn)":"inherit"))+'">'+lab+'</b></div>'+
'<table class="stk"><tr><th>شاخص</th><th>وضعیت</th><th>سیگنال</th></tr>'+R.map(function(r,k){return'<tr'+(k%2?"":' class="zb"')+'><td style="text-align:right;padding-right:6px">'+r[0]+'</td><td>'+r[1]+'</td><td style="font-weight:700;color:'+(r[2]>0?"var(--up)":(r[2]<0?"var(--dn)":"inherit"))+'">'+(r[2]>0?"صعودی":(r[2]<0?"نزولی":"خنثی"))+'</td></tr>'}).join("")+'</table>';
// support / resistance and yearly range
var H=b.h,L=b.l,Pv=(H+L+c)/3,R1=2*Pv-L,S1=2*Pv-H,R2=Pv+(H-L),S2=Pv-(H-L);
var y0=cdj(b.d)[0],hi=-Infinity,lo=Infinity,k,cut=b.d-10000;for(k=n-1;k>=0&&B[k].d>cut;k--){if(B[k].h>hi)hi=B[k].h;if(B[k].l<lo)lo=B[k].l}
h+='<div class="mt" style="font-size:13px">حمایت و مقاومت (پیوت کلاسیک از آخرین کندل)</div><table class="stk"><tr><th>مقاومت ۲</th><th>مقاومت ۱</th><th>پیوت</th><th>حمایت ۱</th><th>حمایت ۲</th></tr><tr class="zb"><td>'+cpr(R2)+'</td><td>'+cpr(R1)+'</td><td><b>'+cpr(Pv)+'</b></td><td>'+cpr(S1)+'</td><td>'+cpr(S2)+'</td></tr></table>'+
'<div class="mut" style="margin-top:6px;line-height:1.9">'+(chIn()?"بازه‌ی داده‌ی موجود: سقف ":"یک سال اخیر: سقف ")+cpr(hi)+' ('+cfp((c/hi-1)*100,1)+'٪ تا سقف) – کف '+cpr(lo)+' (+'+cfp((c/lo-1)*100,1)+'٪ از کف)</div>';
return h}
function chEvHtml(){var ev=CH.ev.slice(0,16),B=CH.B;if(!ev.length)return"";
return'<div class="mt" style="margin-top:4px">سابقه‌ی سیگنال‌های تکنیکال (جدیدترین‌ها)</div><table class="stk"><tr><th>تاریخ</th><th>قیمت</th><th>رویداد</th></tr>'+
ev.map(function(e,k){return'<tr'+(k%2?"":' class="zb"')+'><td>'+chDl(B[e.i])+'</td><td>'+cpr(B[e.i].c)+'</td><td style="text-align:right;padding-right:6px;font-weight:700;color:'+(e.s>0?"var(--up)":"var(--dn)")+'">'+e.t+'</td></tr>'}).join("")+'</table>'}
function chTblHtml(){var B=CH.B,n=B.length,k=Math.min(n,CH.more),rows="",i;
for(i=n-1;i>=n-k;i--){var b=B[i],ch=b.pc>0?(b.c/b.pc-1)*100:0;
rows+='<tr'+((n-1-i)%2?"":' class="zb"')+'><td>'+chDl(b)+'</td><td>'+cpr(b.o)+'</td><td>'+cpr(b.h)+'</td><td>'+cpr(b.l)+'</td><td><b>'+cpr(b.c)+'</b></td><td style="font-weight:700;color:'+(ch>=0?"var(--up)":"var(--dn)")+'">'+cfp(ch,2)+'٪</td><td>'+cvol(b.v)+'</td></tr>'}
return'<div class="mt" style="margin-top:4px">سابقه‌ی قیمت ('+({D:"روزانه",W:"هفتگی",M:"ماهانه"}[CH.P.tf]||("درون‌روز "+CH.P.tf+" دقیقه‌ای"))+')</div><table class="stk chs"><tr><th>تاریخ</th><th>باز</th><th>بالا</th><th>پایین</th><th>پایانی</th><th>تغییر</th><th>حجم</th></tr>'+rows+'</table>'+
(k<n?'<div style="text-align:center;margin-top:8px"><button data-ch="more">نمایش ۴۰ ردیف قدیمی‌تر</button></div>':"")}

// ---------- page ----------
function chBtn(k,t,on){return'<button data-ch="'+k+'"'+(on?' class="on"':"")+'>'+t+'</button>'}
function chartHtml(){
if(!S.ins)return'<div class="card mut">ابتدا نماد را در کادر جستجو وارد کنید.</div>';
var P=CH.P,ready=CH.ins===S.ins&&CH.raw.length>0,sp='<i></i>',h='<div class="card" style="padding:8px">';
h+='<div class="chbw">'+chToolbar()+'</div>';
if(CH.tool)h+='<div class="mut" style="text-align:center;color:var(--dn)">'+chHint()+'</div>';
else if(CH.selDr>=0&&CH.dr[CH.selDr])h+='<div class="mut" style="text-align:center;color:#1565c0">انتخاب شد؛ برای جابه‌جایی خود خط را بکشید، برای تغییر اندازه نقطه‌ها را بکشید، رنگ را عوض کنید یا با سطل از ستون چپ حذفش کنید.</div>'+chPal();
if(ready){chEnsure();if(!CH.B.length){ready=false;h+='<div class="mut" style="padding:24px;text-align:center">'+esc((CH.itl||!CH.itr)?"در حال دریافت داده‌ی درون‌روز…":(CH.itErr||"داده‌ی درون‌روز در دسترس نیست."))+'</div>'}else{h+='<div id="chinfo" class="chi"></div><div id="chrow">'+chTools()+'<div id="chw"><canvas id="chcv" class="chc"></canvas><div id="chax"></div><div id="chdx"></div></div></div>'+chLegend()+''}}
else if(CH.err&&CH.errIns===S.ins)h+='<div class="mut" style="padding:14px;text-align:center">'+esc(CH.err)+'</div>';
else h+='<div class="mut" style="padding:24px;text-align:center">در حال دریافت تاریخچه‌ی '+esc(S.sym)+'…</div>';
h+='</div>';
if(ready){h+='<div class="card">'+chSum()+'<div class="mut" style="margin-top:8px;line-height:1.9">این خلاصه فقط بر پایه‌ی شاخص‌های ریاضی است و توصیه‌ی خرید یا فروش نیست.</div></div>';
var ev=chEvHtml();if(ev)h+='<div class="card">'+ev+'</div>';
h+='<div class="card">'+chTblHtml()+'<div class="mut" style="margin-top:8px;line-height:1.9">'+(P.adj?"قیمت‌ها برای افزایش سرمایه و سود نقدی تعدیل شده‌اند (از روی قیمت پایه‌ی هر روز).":"قیمت‌ها خام و بدون تعدیل‌اند.")+' تاریخچه: '+cjs(CH.raw[0].j,"full")+' تا '+cjs(CH.raw[CH.raw.length-1].j,"full")+' ('+cfp(CH.raw.length)+' روز معاملاتی).</div></div>'}
return h}

// ---------- toolbar: dropdown menus with geometric icons ----------
var ICO={candle:'<path d="M7 3v4M7 17v4M17 7v3M17 18v3"/><rect x="5" y="7" width="4" height="10"/><rect x="15" y="10" width="4" height="8"/>',
heikin:'<path d="M6 3v4M6 18v3M12 6v3M12 20v2M18 2v4M18 15v4"/><rect x="4" y="7" width="4" height="11"/><rect x="10" y="9" width="4" height="11"/><rect x="16" y="6" width="4" height="9"/>',
line:'<polyline points="3,17 9,11 13,14 21,5"/>',
area:'<polyline points="3,17 9,11 13,14 21,5"/><path d="M3 17l6-6 4 3 8-9v13H3z" style="fill:currentColor;opacity:.22;stroke:none"/>',
clock:'<circle cx="12" cy="12" r="9"/><polyline points="12,7 12,12 15,14"/>',
cal:'<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
gear:'<path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/>',
tools:'<path d="M3 21l3-1 12-12-2-2L4 18z"/><path d="M14 6l4 4"/>',
trend:'<line x1="4" y1="19" x2="20" y2="5"/><circle cx="4" cy="19" r="2"/><circle cx="20" cy="5" r="2"/>',
hline:'<line x1="3" y1="12" x2="21" y2="12"/><circle cx="12" cy="12" r="2"/>',
fib:'<path d="M3 5h18M3 10h18M3 15h18M3 20h18"/><line x1="6" y1="20" x2="18" y2="5" stroke-dasharray="2 2"/>',
trash:'<path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/>',
undo:'<path d="M9 14L4 9l5-5"/><path d="M4 9h10a6 6 0 010 12h-3"/>',
refresh:'<path d="M20 11a8 8 0 10-2 6"/><path d="M20 4v7h-7"/>',
wave:'<path d="M3 15c3-8 6-8 9 0s6 8 9 0"/>',
pane:'<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 14h18"/><path d="M7 11l3-3 3 2 4-4"/>',
scale:'<path d="M12 3v18M8 7l4-4 4 4M8 17l4 4 4-4"/>',
sel:'<path d="M5 3l14 8-6 2-2 6z"/>',
dot:'<circle cx="12" cy="12" r="3"/>',seg:'<line x1="5" y1="18" x2="19" y2="6"/><rect x="3" y="16" width="4" height="4"/><rect x="17" y="4" width="4" height="4"/>',vline:'<line x1="12" y1="3" x2="12" y2="21"/><circle cx="12" cy="12" r="2"/>',chan:'<line x1="3" y1="16" x2="21" y2="7"/><line x1="3" y1="21" x2="21" y2="12"/><path d="M3 16v5M21 7v5" opacity=".4"/>',rect:'<rect x="4" y="6" width="16" height="12" rx="1"/>',ruler:'<path d="M3 17L17 3l4 4L7 21z"/><path d="M7 13l2 2M10 10l2 2M13 7l2 2"/>',magnet:'<path d="M6 3v8a6 6 0 0012 0V3"/><path d="M6 7h4M14 7h4"/>'};
function ic(k){return'<svg viewBox="0 0 24 24">'+(ICO[k]||ICO.dot)+'</svg>'}
var CARET='<svg class="cr2" viewBox="0 0 24 24"><polyline points="6,9 12,15 18,9"/></svg>';
function chMenus(){var P=CH.P,pick=function(arr,v){for(var i=0;i<arr.length;i++)if(arr[i][0].split(":")[1]===v)return arr[i];return arr[0]};
var TY=[["ty:c","کندل","candle"],["ty:h","هایکین‌آشی","heikin"],["ty:l","خطی","line"],["ty:a","ناحیه","area"]],
TF=([["tf:1","۱ دقیقه","clock"],["tf:5","۵ دقیقه","clock"],["tf:15","۱۵ دقیقه","clock"],["tf:30","۳۰ دقیقه","clock"],["tf:60","۱ ساعت","clock"]]).concat([["tf:D","روزانه","clock"],["tf:W","هفتگی","clock"],["tf:M","ماهانه","clock"]]),
RG=chIn()?[["rg:1","۱ روز","cal"],["rg:3","۳ روز","cal"],["rg:all","همه","cal"]]:[["rg:30","۱ ماه","cal"],["rg:90","۳ ماه","cal"],["rg:180","۶ ماه","cal"],["rg:365","۱ سال","cal"],["rg:1095","۳ سال","cal"],["rg:all","همه","cal"]],
OV=[["m20","MA20"],["m50","MA50"],["m200","MA200"],["e21","EMA21"],["bb","بولینگر"],["ich","ایچیموکو"],["sar","SAR"],["dn","دانچیان ۲۰"],["st","سوپرترند"]],
SP=[["vol","حجم"],["rsi","RSI"],["macd","MACD"],["sto","استوکاستیک"],["cci","CCI"],["obv","OBV"],["atr","ATR"]];
var tyI=pick(TY,P.ty),tfI=pick(TF,P.tf);
return[
{k:"ty",ic:tyI[2],lb:tyI[1],items:TY.map(function(a){return{a:a[0],t:a[1],i:a[2],on:P.ty===a[0].split(":")[1]}})},
{k:"tf",ic:"clock",lb:tfI[1],items:TF.map(function(a){return{a:a[0],t:a[1],i:a[2],on:P.tf===a[0].split(":")[1]}})},
{k:"rg",ic:"cal",lb:"بازه",items:RG.map(function(a){return{a:a[0],t:a[1],i:a[2],on:false}})},
{k:"st",ic:"gear",lb:"تنظیمات",items:[{a:"adj",t:"تعدیل‌شده",i:"gear",on:!!P.adj},{a:"log",t:"لگاریتمی",i:"gear",on:!!P.log},{a:"dk",t:"نمایش تیره",i:"gear",on:!!P.dk},{a:"evl",t:"فهرست سود و افزایش سرمایه",i:"gear",on:false},{a:"px",t:"قیمت: "+(P.px==="c"?"پایانی":"آخرین"),i:"gear",on:false},{a:"ysr",t:"بازنشانی مقیاس قیمت",i:"scale",on:false},{a:"rl",t:"دریافت مجدد",i:"refresh",on:false}]},
{k:"ov",ic:"wave",lb:"روی نمودار",multi:1,items:OV.map(function(a){return{a:"ov:"+a[0],t:a[1],i:"wave",on:!!P.ov[a[0]]}})},
{k:"sp",ic:"pane",lb:"پایین نمودار",multi:1,items:SP.map(function(a){return{a:"sp:"+a[0],t:a[1],i:"pane",on:!!P.sp[a[0]]}})}]}
function chToolItems(){var P=CH.P;return[{a:"tool:tl",t:"خط روند",i:"trend",on:CH.tool==="tl"},{a:"tool:h",t:"خط افقی",i:"hline",on:CH.tool==="h"},{a:"tool:v",t:"خط عمودی",i:"vline",on:CH.tool==="v"},{a:"tool:ch",t:"کانال موازی",i:"chan",on:CH.tool==="ch"},{a:"tool:fib",t:"فیبوناچی",i:"fib",on:CH.tool==="fib"},{a:"tool:rc",t:"مستطیل",i:"rect",on:CH.tool==="rc"},{a:"tool:rl",t:"خط‌کش (اندازه‌گیری)",i:"ruler",on:CH.tool==="rl"},{sep:1},{a:"mg",t:"مغناطیس به قیمت‌های کندل",i:"magnet",on:!!P.mg},{sep:1},{a:"deldr",t:"حذف انتخاب‌شده",i:"trash",on:false,dis:!(CH.selDr>=0&&CH.dr[CH.selDr])},{a:"undo",t:"حذف آخرین",i:"undo",on:false},{a:"clr",t:"پاک کردن همه",i:"trash",on:false}]}
function chTools(){return'<div class="cht">'+chToolItems().map(function(it){return it.sep?'<hr>':'<button type="button" data-ch="'+it.a+'" title="'+it.t+'" aria-label="'+it.t+'"'+(it.on?' class="on"':'')+(it.dis?' disabled':'')+'>'+ic(it.i)+'</button>'}).join("")+'</div>'}
function chToolbar(){var M=chMenus(),h='<div class="chb">',open=null;
M.forEach(function(m){var on=CH.menu===m.k;if(on)open=m;h+='<div class="dm"><button type="button" title="'+m.lb+'" aria-label="'+m.lb+'" data-ch="menu:'+m.k+'"'+(on?' class="on"':'')+'>'+ic(m.ic)+'<span>'+m.lb+'</span>'+CARET+'</button></div>'});
if(open){h+='<div class="dmp">'+(open.multi?'<div class="gt">چند مورد را می‌توانید هم‌زمان فعال کنید</div>':'')+open.items.map(function(it){return'<button type="button" data-ch="'+it.a+'"'+(it.on?' class="on"':'')+(it.dis?' disabled':'')+'>'+ic(it.i)+'<span>'+it.t+'</span></button>'}).join("")+'</div>'}
return h+'</div>'}
function chFutJ(k){var B=CH.B,n=B.length,L=B[n-1].d,fk=L+"|"+CH.P.tf;if(CH.futK!==fk){CH.futK=fk;CH.fut=[]}
while(CH.fut.length<k){var prev=CH.fut.length?CH.fut[CH.fut.length-1].g:new Date(Math.floor(L/1e4),Math.floor(L/100)%100-1,L%100,12),nx;
if(CH.P.tf==="W")nx=add(prev,7);else if(CH.P.tf==="M")nx=new Date(prev.getFullYear(),prev.getMonth()+1,Math.min(prev.getDate(),28),12);else{nx=add(prev,1);var g2=0;while(off(nx)&&g2++<30)nx=add(nx,1)}
CH.fut.push({g:nx,j:cdj(key(nx))})}
return CH.fut[k-1].j}
var CHNEED={h:2,v:2,tl:2,sg:2,fib:2,rc:2,rl:2,ch:3};
function chHint(){var nd=CHNEED[CH.tool]||2;return nd===1?"روی نمودار یک بار لمس کنید.":"نقطه‌ی "+["اول","دوم","سوم"][CH.pend.length]+" را روی نمودار لمس کنید."}
function chSnap(i,py){var B=CH.B[i];if(CH.P.mg&&B&&CH.Yf){var best=null,bd=22;[B.o,B.h,B.l,B.c].forEach(function(v){var d=Math.abs(CH.Yf(v)-py);if(d<bd){bd=d;best=v}});if(best!=null)return best}return CH.inv(py)}
function chHit(px,py){var X=CH.Xf,Y=CH.Yf,g=CH.geo;if(!X||!Y||!g||py>g.mainH)return-1;
function dseg(x1,y1,x2,y2){var dx=x2-x1,dy=y2-y1,l=dx*dx+dy*dy,t=l?Math.max(0,Math.min(1,((px-x1)*dx+(py-y1)*dy)/l)):0;return Math.hypot(px-(x1+t*dx),py-(y1+t*dy))}
for(var i=CH.dr.length-1;i>=0;i--){var o=CH.dr[i];
if(o.t==="h"){var hy=Y(o.a.p);if(o.b){if(dseg(X(chIdxOfDate(o.a.d)),hy,X(chIdxOfDate(o.b.d)),hy)<16)return i}else if(Math.abs(hy-py)<16)return i;continue}
if(o.t==="v"){var vx=X(chIdxOfDate(o.a.d));if(o.b){if(dseg(vx,Y(o.a.p),vx,Y(o.b.p))<16)return i}else if(Math.abs(vx-px)<16)return i;continue}
var xa=X(chIdxOfDate(o.a.d)),ya=Y(o.a.p),xb=X(chIdxOfDate(o.b.d)),yb=Y(o.b.p);
if(o.t==="tl"){if(dseg(xa,ya,xb,yb)<16)return i}
else if(o.t==="sg"||o.t==="rl"){if(dseg(xa,ya,xb,yb)<16)return i}
else if(o.t==="rc"){var x1=Math.min(xa,xb),x2=Math.max(xa,xb),y1=Math.min(ya,yb),y2=Math.max(ya,yb);if(px>=x1-8&&px<=x2+8&&py>=y1-8&&py<=y2+8)return i}
else if(o.t==="ch"){var xc=X(chIdxOfDate(o.c.d)),yc=Y(o.c.p),m3=xb!==xa?(yb-ya)/(xb-xa):0,xe3=xb,ye3=ya+m3*(xe3-xa),dc=yc-(ya+m3*(xc-xa));
if(dseg(xa,ya,xe3,ye3)<16||dseg(xa,ya+dc,xe3,ye3+dc)<16)return i}
else{if(dseg(xa,ya,xb,yb)<16)return i;var xs=Math.min(xa,xb);if(px>=xs-6&&px<=Math.max(xa,xb)+6)for(var L=0;L<7;L++){var lv=[0,.236,.382,.5,.618,.786,1][L];if(Math.abs(Y(o.b.p+(o.a.p-o.b.p)*lv)-py)<8)return i}}}
return-1}
function chAxis(){var el=document.getElementById("chax");if(!el)return;var y0=0,s0=1,on=false;
el.onpointerdown=function(e){on=true;y0=e.clientY;s0=CH.ys||1;try{el.setPointerCapture(e.pointerId)}catch(_){}e.preventDefault()};
el.onpointermove=function(e){if(!on)return;CH.ys=Math.max(.15,Math.min(8,s0*Math.exp((e.clientY-y0)/160)));chDrawSoon()};
el.onpointerup=el.onpointercancel=function(){on=false};
el.ondblclick=function(){CH.ys=1;CH.yo=0;chDrawSoon()}}
function chTimeAx(){var el=document.getElementById("chdx");if(!el)return;var x0=0,b0=6,on=false;
el.onpointerdown=function(e){on=true;x0=e.clientX;b0=CH.bw;try{el.setPointerCapture(e.pointerId)}catch(_){}e.preventDefault()};
el.onpointermove=function(e){if(!on)return;CH.bw=Math.max(1.2,Math.min(48,b0*Math.exp((e.clientX-x0)/140)));chDrawSoon()};
el.onpointerup=el.onpointercancel=function(){on=false}}
function showBox(t,h){var o=document.getElementById("hb");if(o)o.remove();o=document.createElement("div");o.id="hb";o.innerHTML='<div class="bx"><b class="t">'+t+'</b>'+h+'<button type="button">بستن</button></div>';o.onclick=function(e){if(e.target===o||e.target.tagName==="BUTTON")o.remove()};document.body.appendChild(o)}
function evHtml(e){var h='<div>تاریخ: <b>'+cjs(cdj(e.d),"full")+'</b></div>';
if(e.prev>0&&e.ref>0){h+='<div>قیمت پایانی روز قبل: <b>'+cfp(e.prev)+'</b> ریال</div><div>قیمت پایه‌ی جدید: <b>'+cfp(e.ref)+'</b> ریال</div>';
if(e.type==="div"){var dd=e.prev-e.ref;h+='<div>کاهش قیمت پایه (برآورد سود نقدی هر سهم): <b>'+cfp(dd)+'</b> ریال ('+cfp(dd/e.prev*100,1)+'٪ قیمت)</div>'}}
if(e.cap){h+='<div>تعداد سهام: <b>'+cfp(e.cap.o)+'</b> به <b>'+cfp(e.cap.n)+'</b></div><div>درصد افزایش سرمایه: <b>'+cfp((e.cap.n/e.cap.o-1)*100,1)+'٪</b></div>'}
if(e.type==="both")h+='<div class="mut">در این روز هم‌زمان سود و افزایش سرمایه اعمال شده؛ سهم هر کدام از تغییر قیمت پایه جدا نشده است.</div>';
if(e.type==="div")h+='<div class="mut">این رویداد از روی تعدیل قیمت پایه‌ی سهم در همان روز برآورد شده و مبلغ دقیق سود مصوب مجمع نیست.</div>';
return h}
var EVT={div:"تقسیم سود",cap:"افزایش سرمایه",both:"تقسیم سود و افزایش سرمایه"};
function showCaInfo(e){try{showBox(EVT[e.type]||"رویداد",evHtml(e))}catch(x){showBox("رویداد","<div>اطلاعات این رویداد نمایش داده نشد.</div>")}}
function showEvList(){var L=(CH.ca||[]).slice().sort(function(a,b){return b.d-a.d});
showBox("سود و افزایش سرمایه",L.length?L.map(function(e){return'<div style="padding:6px 0;border-bottom:1px solid var(--ln)"><b style="color:'+(e.type==="div"?"#2563eb":"#b8860b")+'">'+(EVT[e.type]||"")+'</b>'+evHtml(e)+'</div>'}).join(""):'<div class="mut">رویدادی برای این نماد ثبت نشده است.</div>')}
function chPal(){return'<div class="cpal">'+["#f59e0b","#ef4444","#22c55e","#3b82f6","#a855f7","#06b6d4","#111827","#ec4899"].map(function(c){return'<button type="button" data-ch="col:'+c+'" style="background:'+c+'"></button>'}).join("")+'</div>'}
function chLegend(){return CH.ca&&CH.ca.length?'<div class="mut" style="text-align:center;font-size:11px;margin-top:4px"><span style="color:#2563eb">●</span> تقسیم سود &nbsp;&nbsp; <span style="color:#d4a800">●</span> افزایش سرمایه — برای دیدن جزئیات روی نقطه بزنید</div>':""}
function chPaint(){if(tab!=="k"&&tab!=="i")return;var v=document.getElementById(tab==="i"?"igch":"v");if(!v)return;var y=window.pageYOffset||0;v.innerHTML=chartHtml();chBind(false);try{window.scrollTo(0,y)}catch(e){}setHH()}
function chBind(trig){
document.querySelectorAll("[data-ch]").forEach(function(b){b.onclick=function(){chAct(b.dataset.ch)}});
var cv=document.getElementById("chcv");CH.cv=cv||null;
if(cv){chPtr(cv);chAxis();chTimeAx();cv.style.touchAction="none";chDraw();chInfo()}
if(!CH.docH){CH.docH=1;document.addEventListener("click",function(e){if((tab==="k"||tab==="i")&&CH.menu&&!(e.target.closest&&e.target.closest(".chb"))){CH.menu="";chPaint()}})}
if(trig&&S.ins&&!CH.load&&CH.ins!==S.ins&&!(CH.err&&CH.errIns===S.ins))chLoad()}
function chAct(a){var P=CH.P,p=a.split(":"),k=p[0],v=p[1];
if(k==="menu"){CH.menu=CH.menu===v?"":v;chPaint();return}
if(k!=="ov"&&k!=="sp")CH.menu="";
if(k==="tf"||k==="log"||k==="adj"||k==="ty"){CH.ys=1;CH.yo=0}
if(k==="mg"){P.mg=P.mg?0:1;chSave();CH.menu="";chPaint();return}
if(k==="col"){var oc=CH.dr[CH.selDr];if(oc){oc.col=v;chDrSave()}CH.menu="";chPaint();return}
if(k==="evl"){CH.menu="";chPaint();showEvList();return}
if(k==="dk"){P.dk=P.dk?0:1;chSave();CH.menu="";chPaint();return}
if(k==="ty"){P.ty=v}else if(k==="tf"){P.tf=v;CH.sel=-1}else if(k==="adj"){P.adj=P.adj?0:1}else if(k==="log"){P.log=P.log?0:1}else if(k==="px"){P.px=P.px==="c"?"l":"c"}
else if(k==="ov"){P.ov[v]=P.ov[v]?0:1}else if(k==="sp"){P.sp[v]=P.sp[v]?0:1}
else if(k==="rg"){CH.needView=v;CH.ys=1;CH.yo=0;chPaint();return}
else if(k==="ysr"){CH.ys=1;CH.yo=0;chPaint();return}
else if(k==="deldr"){if(CH.selDr>=0){CH.dr.splice(CH.selDr,1);CH.selDr=-1;chDrSave()}chPaint();return}
else if(k==="tool"){CH.tool=CH.tool===v?"":v;CH.pend=[]}
else if(k==="undo"){CH.dr.pop();CH.selDr=-1;chDrSave();chPaint();return}
else if(k==="clr"){CH.dr=[];CH.selDr=-1;chDrSave();chPaint();return}
else if(k==="more"){CH.more+=40}
else if(k==="rl"){CH.ins=null;CH.raw=[];CH.err="";CH.key="";CH.itr=null;chLoad();return}
chSave();chPaint()}
function chInfo(){var el=document.getElementById("chinfo");if(!el||!CH.B.length)return;var B=CH.B,i=CH.sel>=0&&CH.sel<B.length?CH.sel:B.length-1,b=B[i],ch=b.pc>0?(b.c/b.pc-1)*100:0,col=ch>=0?"var(--up)":"var(--dn)";
el.innerHTML='<b>'+chDl(b)+'</b> &nbsp; باز '+cpr(b.o)+' &nbsp; بالا '+cpr(b.h)+' &nbsp; پایین '+cpr(b.l)+' &nbsp; <b style="color:'+col+'">پایانی '+cpr(b.c)+' ('+cfp(ch,2)+'٪)</b>'+(IGX[S.ins]?"":' &nbsp; حجم '+cvol(b.v))}

// ---------- view helpers ----------
function chTags(x,g,pw,T){if(!T||!T.length)return;x.save();x.setLineDash([]);x.textAlign="center";T.forEach(function(t){if(!(t.y>=-4&&t.y<=g.mainH+4))return;var yy=Math.max(8,Math.min(g.mainH-8,t.y)),hx=String(t.c).replace("#",""),lum=hx.length===6?(parseInt(hx.slice(0,2),16)*.299+parseInt(hx.slice(2,4),16)*.587+parseInt(hx.slice(4,6),16)*.114):0,tx=cpr(t.p),fs=10;x.font="bold "+fs+"px Vazirmatn,Tahoma,sans-serif";var w=x.measureText(tx).width;if(w>g.axW-4){fs=Math.max(7,Math.floor(10*(g.axW-4)/w));x.font="bold "+fs+"px Vazirmatn,Tahoma,sans-serif"}x.fillStyle=t.c;x.fillRect(pw+1,yy-8,g.axW-1,16);x.fillStyle=lum>170?"#111":"#fff";x.fillText(tx,pw+1+(g.axW-1)/2,yy+3.5)});x.restore()}
function chGeo(){var cv=CH.cv,P=CH.P,W=Math.max(200,cv.clientWidth||320),subs=[];
["vol","rsi","macd","sto","cci","obv","atr"].forEach(function(k){if(P.sp[k]&&!(k==="vol"&&IGX[S.ins]))subs.push(k)});
var mainH=Math.round(Math.max(250,Math.min(380,(window.innerHeight||700)*.42))),subH=84,xH=20;
return{W:W,H:mainH+subs.length*subH+xH,axW:48,pw:W-48,mainH:mainH,subH:subH,xH:xH,subs:subs}}
function chClamp(pw){var n=CH.B.length,pad=Math.max(CH.P.ov.ich?28:4,Math.round(pw/Math.max(1.2,Math.min(48,CH.bw))*.6));CH.bw=Math.max(1.2,Math.min(48,CH.bw));var vis=pw/CH.bw;
CH.r=Math.max(Math.min(n-1,vis*.25),Math.min(n-1+pad,CH.r))}
function chSetRange(v){var B=CH.B,n=B.length,pw=CH.geo.pw,cnt=n;
if(chIn()){var nd=v==="all"?9999:(+v||1),c2=0,ld=null,dy=0,q2=n-1;while(q2>=0){if(B[q2].d!==ld){dy++;ld=B[q2].d;if(dy>nd)break}c2++;q2--}cnt=Math.max(5,c2)}else if(v!=="all"){var d=B[n-1].d,t=new Date(Math.floor(d/1e4),Math.floor(d/100)%100-1,d%100,12);t.setDate(t.getDate()-(+v));var cut=t.getFullYear()*1e4+(t.getMonth()+1)*100+t.getDate(),i=0;while(i<n&&B[i].d<cut)i++;cnt=Math.max(5,n-i)}
var bl=Math.max(6,Math.round(cnt*.2));CH.bw=Math.max(1.2,Math.min(48,(pw-8)/(cnt+bl+1)));CH.r=n-1+bl}
function chIdxRaw(px){var n=CH.B.length,g=CH.geo,i=Math.round(CH.r-(g.pw-CH.bw/2-px)/CH.bw);return Math.max(0,Math.min(n-1+300,i))}
function chPtDate(i){var n=CH.B.length;if(chIn())return CH.B[Math.max(0,Math.min(i,n-1))].dk;if(i<n)return CH.B[i].d;chFutJ(i-n+1);return key(CH.fut[i-n].g)}
function chIdxAt(px){var n=CH.B.length,g=CH.geo,i=Math.round(CH.r-(g.pw-CH.bw/2-px)/CH.bw);return Math.max(0,Math.min(n-1,i))}
function chIdxOfDate(d){var B=CH.B,n=B.length;if(chIn()){if(!n)return 0;var kk=d>1e10?d:d*10000,lo2=0,hi2=n-1;if(kk>B[n-1].dk)return n-1;while(lo2<hi2){var m2=(lo2+hi2)>>1;if(B[m2].dk>=kk)hi2=m2;else lo2=m2+1}return lo2}if(d>1e10)d=Math.floor(d/1e4);if(n&&d>B[n-1].d){var k=0;while(k<400){chFutJ(k+1);if(key(CH.fut[k].g)>=d)return n+k;k++}return n+399}var lo=0,hi=B.length-1;while(lo<hi){var m=(lo+hi)>>1;if(B[m].d>=d)hi=m;else lo=m+1}return lo}
function chCol(){var dk=CH.P&&CH.P.dk;return dk?{bg:"#000000",tx:"#ffffff",mut:"#d1d5db",ln:"#2b2b2b",up:"#22c55e",dn:"#ef4444",ax:"#ffffff",axbg:"#000000",dk:1}:{bg:"#ffffff",tx:"#111827",mut:"#4b5563",ln:"#e5e7eb",up:"#16a34a",dn:"#dc2626",ax:"#ffffff",axbg:"#000000",dk:0}}
function chDrawSoon(){if(CH.raf)return;CH.raf=requestAnimationFrame(function(){CH.raf=0;chDraw();chInfo()})}

// ---------- the chart ----------
function chDraw(){
var cv=CH.cv;if(!cv||!CH.B.length||CH.ins!==S.ins||(tab!=="k"&&tab!=="i"))return;
chEnsure();var g=chGeo(),B=CH.B,n=B.length,I=CH.I,P=CH.P,C=chCol(),dpr=window.devicePixelRatio||1;CH.geo=g;
cv.width=Math.round(g.W*dpr);cv.height=Math.round(g.H*dpr);cv.style.height=g.H+"px";var axo=document.getElementById("chax");if(axo){axo.style.height=g.mainH+"px";axo.style.width=g.axW+"px"}var dxo=document.getElementById("chdx");if(dxo)dxo.style.width=g.pw+"px";
var x=cv.getContext("2d");x.setTransform(dpr,0,0,dpr,0,0);x.direction="ltr";
if(CH.needView){chSetRange(CH.needView);CH.needView=""}
chClamp(g.pw);
var bw=CH.bw,r=CH.r,pw=g.pw,i,k;
function X(i){return pw-(r-i)*bw-bw/2}
var i0=Math.max(0,Math.floor(r-pw/bw)-1),i1=Math.min(n-1,Math.ceil(r)+1),i1e=Math.ceil(r)+1;
x.fillStyle=C.bg;x.fillRect(0,0,g.W,g.H);x.fillStyle=C.axbg;x.fillRect(pw,0,g.axW,g.H);x.fillRect(0,g.H-g.xH,g.W,g.xH);x.font="10px Vazirmatn,Tahoma,sans-serif";
var D=P.ty==="h"?CH.HA:B,hi=-Infinity,lo=Infinity,line=(P.ty==="l"||P.ty==="a");
for(i=i0;i<=i1;i++){var bb=D[i],bh=line?bb.c:bb.h,bl=line?bb.c:bb.l;if(bh>hi)hi=bh;if(bl<lo)lo=bl;if(P.ov.bb&&I.bu[i]!=null){if(I.bu[i]>hi)hi=I.bu[i];if(I.bl[i]<lo)lo=I.bl[i]}}
if(!(hi>lo)){hi+=1;lo-=1}
var lg=P.log&&lo>0,tr=function(v){return lg?Math.log(v):v},t0=tr(lo),t1=tr(hi),pd=(t1-t0)*.07;t0-=pd;t1+=pd;var ycn=(t0+t1)/2,yhf=(t1-t0)/2*(CH.ys||1);t0=ycn-yhf+(CH.yo||0);t1=ycn+yhf+(CH.yo||0);CH.span=t1-t0;
var top=4,mh=g.mainH-8;
function ok(v){return v!=null&&isFinite(v)&&(!lg||v>0)}
function Y(v){return top+(t1-tr(v))/(t1-t0)*mh}
CH.Yf=Y;CH.Xf=X;CH.inv=function(py){var t=t1-(py-top)/mh*(t1-t0);return lg?Math.exp(t):t};
// horizontal grid + price axis
var ticks=[],v;
if(lg){for(k=0;k<=8;k++)ticks.push(Number(Math.exp(t0+(t1-t0)*k/8).toPrecision(3)))}else{var st=cnice((t1-t0)/9);for(v=Math.ceil(t0/st)*st;v<=t1;v+=st)ticks.push(v)}
x.lineWidth=1;x.strokeStyle=C.ln;x.fillStyle=C.ax;x.textAlign="left";
ticks.forEach(function(tv){var yy=Math.round(Y(tv))+.5;x.beginPath();x.moveTo(0,yy);x.lineTo(pw,yy);x.stroke();x.fillText(cpr(tv),pw+4,yy+3)});
// vertical grid + date axis
var stepB=Math.max(1,Math.ceil(90/bw)),vis=pw/bw,mode=(P.tf==="M"||vis>(P.tf==="D"?150:52))?"ym":"md",ax=g.H-g.xH;
var fx0=X(n-1)+bw/2;if(fx0<pw){x.fillStyle="rgba(128,128,128,.07)";x.fillRect(fx0,0,pw-fx0,ax)}
x.textAlign="center";var i1x=Math.ceil(r)+1;
for(i=Math.max(0,i0);i<=i1x;i++){if(i%stepB)continue;var xx=X(i);if(xx<14||xx>pw-14)continue;x.strokeStyle=C.ln;x.beginPath();x.moveTo(Math.round(xx)+.5,0);x.lineTo(Math.round(xx)+.5,ax);x.stroke();x.fillStyle=i<n?C.ax:"#60a5fa";x.fillText(chXl(i,n,B,mode),xx,g.H-6)}
x.strokeStyle=C.ln;x.beginPath();x.moveTo(pw+.5,0);x.lineTo(pw+.5,ax);x.moveTo(0,ax+.5);x.lineTo(g.W,ax+.5);x.stroke();
// ---- main panel (clipped)
x.save();x.beginPath();x.rect(0,0,pw,g.mainH);x.clip();
function PL(arr,col,w){x.beginPath();var s=false,e=Math.min(arr.length-1,i1e),q;for(q=Math.max(0,i0-1);q<=e;q++){var vv=arr[q];if(!ok(vv)){s=false;continue}var px=X(q),py=Y(vv);if(!s){x.moveTo(px,py);s=true}else x.lineTo(px,py)}x.strokeStyle=col;x.lineWidth=w||1.2;x.stroke()}
if(P.ov.ich){var q2,e2=Math.min(n+25,i1e);for(q2=Math.max(0,i0-1);q2<e2;q2++){var a1=I.sa[q2],b1=I.sb[q2],a2=I.sa[q2+1],b2=I.sb[q2+1];if(a1==null||b1==null||a2==null||b2==null||!ok(a1)||!ok(b1)||!ok(a2)||!ok(b2))continue;
x.beginPath();x.moveTo(X(q2),Y(a1));x.lineTo(X(q2+1),Y(a2));x.lineTo(X(q2+1),Y(b2));x.lineTo(X(q2),Y(b1));x.closePath();x.fillStyle=a1>=b1?"rgba(34,160,80,.16)":"rgba(210,60,50,.16)";x.fill()}
PL(I.sa,"rgba(34,160,80,.7)",1);PL(I.sb,"rgba(210,60,50,.7)",1);PL(I.tk,"#ef4444",1.2);PL(I.kj,"#2563eb",1.2)}
if(P.ov.bb){x.beginPath();var s2=false,q3;for(q3=i0;q3<=i1;q3++){if(I.bu[q3]==null||!ok(I.bu[q3])||!ok(I.bl[q3]))continue;var px3=X(q3);if(!s2){x.moveTo(px3,Y(I.bu[q3]));s2=true}else x.lineTo(px3,Y(I.bu[q3]))}
for(q3=i1;q3>=i0;q3--){if(I.bl[q3]==null||!ok(I.bl[q3])||!ok(I.bu[q3]))continue;x.lineTo(X(q3),Y(I.bl[q3]))}x.closePath();x.fillStyle="rgba(100,116,139,.12)";x.fill();PL(I.bu,"#64748b",1);PL(I.bl,"#64748b",1)}
if(line){x.beginPath();for(i=i0;i<=i1;i++){if(i===i0)x.moveTo(X(i),Y(B[i].c));else x.lineTo(X(i),Y(B[i].c))}x.strokeStyle="#2563eb";x.lineWidth=1.6;x.stroke();
if(P.ty==="a"){x.lineTo(X(i1),g.mainH);x.lineTo(X(i0),g.mainH);x.closePath();var gr=x.createLinearGradient(0,0,0,g.mainH);gr.addColorStop(0,"rgba(37,99,235,.28)");gr.addColorStop(1,"rgba(37,99,235,.02)");x.fillStyle=gr;x.fill()}}
else{var cw=Math.max(1,Math.floor(bw*.72));for(i=i0;i<=i1;i++){var d=D[i],cx=Math.round(X(i)),up=d.c>=d.o,col=up?C.up:C.dn;x.strokeStyle=col;x.fillStyle=col;x.lineWidth=1;
x.beginPath();x.moveTo(cx+.5,Y(d.h));x.lineTo(cx+.5,Y(d.l));x.stroke();
var yt=Y(Math.max(d.o,d.c)),yb=Y(Math.min(d.o,d.c));x.fillRect(Math.round(cx-cw/2),Math.round(yt),cw,Math.max(1,Math.round(yb-yt)))}}
if(P.ov.m20)PL(I.m20,"#f59e0b",1.3);if(P.ov.m50)PL(I.m50,"#3b82f6",1.3);if(P.ov.m200)PL(I.m200,"#8b5cf6",1.5);if(P.ov.e21)PL(I.e21,"#14b8a6",1.3);
if(P.ov.dn){PL(I.dh,"#0ea5e9",1.1);PL(I.dl,"#0ea5e9",1.1)}
if(P.ov.st){for(i=Math.max(1,i0);i<=i1;i++){if(I.st[i]==null||I.st[i-1]==null||!ok(I.st[i])||I.su[i]!==I.su[i-1])continue;x.strokeStyle=I.su[i]?C.up:C.dn;x.lineWidth=1.7;x.beginPath();x.moveTo(X(i-1),Y(I.st[i-1]));x.lineTo(X(i),Y(I.st[i]));x.stroke()}}
if(P.ov.sar){for(i=i0;i<=i1;i++){if(I.sar[i]==null||!ok(I.sar[i]))continue;x.fillStyle=I.sarUp[i]?C.up:C.dn;x.beginPath();x.arc(X(i),Y(I.sar[i]),1.7,0,6.2832);x.fill()}}
// drawings
CH.hp=[];var TG=[];var dcol={rc:"#a855f7",ch:"#06b6d4",rl:"#64748b"};
function HD(px,py,w,sl){if(!sl)return;CH.hp.push({x:px,y:py,w:w});x.fillStyle="#2563eb";x.strokeStyle="#fff";x.lineWidth=1.5;x.beginPath();x.arc(px,py,6,0,6.2832);x.fill();x.stroke()}
CH.dr.forEach(function(o,di){var sl=di===CH.selDr,cl=o.col||dcol[o.t]||"#f59e0b",xa,ya,xb,yb2,yc2,xc;x.strokeStyle=cl;x.fillStyle=cl;x.lineWidth=sl?2.4:1.4;x.setLineDash([]);
