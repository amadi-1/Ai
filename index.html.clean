else if(/آخرین|پایانی|قیمت/.test(p)&&/درصد|مثبت|منفی|٪|%/.test(p)){var f=/پایانی/.test(p)?"(pc)":"(pl)",n=N(p,null),dn=/منفی|کاهش|افت|ضرر/.test(p)||(n!=null&&n<0);
if(n==null)add(p,f+(dn?"<":">")+"(py)");else{n=Math.abs(n);var r=dn?(1-n/100):(1+n/100),dd=dir(p,">");if(dn)dd=dir(p,"<")==="<"||/بیش/.test(p)?"<":">";add(p,f+dd+"(py)*"+(Math.round(r*10000)/10000))}}
else if(/قیمت/.test(p)&&/\d/.test(p)){var mul=/تومان/.test(p)?10:1;add(p,"(pl)"+dir(p,"<")+N(p,0)*mul)}
