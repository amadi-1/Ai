var rows=it.map(function(x,i){var at=x.u?' data-cu="'+esc(x.u)+'" style="cursor:pointer"':tcA(x);return'<tr'+at+'><td class="drw">'+(i+1).toLocaleString("fa-IR")+'</td><td style="font-weight:700">'+esc(x.n)+'</td>'+D.cols.map(function(c){var v="—";try{v=c[1](x)}catch(e){}return'<td>'+v+'</td>'}).join("")+'</tr>'}).join("");
var tb=it.length?'<div class="sc scv"><table class="stk"><tr><th class="drw">ردیف</th><th>نماد</th>'+D.cols.map(function(c){return'<th>'+c[0]+'</th>'}).join("")+'</tr>'+rows+'</table></div>':'<div class="mut" style="padding:8px">'+(C.cl?"لیست خالی است.":(C.ft?"نمادی با شرط‌های این فیلتر پیدا نشد.":"فیلتر هنوز اجرا نشده؛ ▶ را بزنید."))+'</div>';
var lvn=["خیلی ملایم","ملایم","","سخت","خیلی سخت"][(+(C.cfg&&C.cfg.lv)||0)+2];return'<div class="card" style="padding:6px;margin-top:8px"><b>جزئیات '+esc(C.name)+'</b>'+(lvn?' <span class="dkc" style="background:var(--acb);color:var(--tx)">سخت‌گیری: '+lvn+'</span>':'')+'<div class="mut" style="font-size:11px;line-height:1.8">'+esc(wpMsg(C))+(C.dg?" | "+esc(C.dg):"")+(C.tot>it.length?" — "+C.tot.toLocaleString("fa-IR")+" نماد مطابق فیلتر؛ "+it.length.toLocaleString("fa-IR")+" مورد اول نمایش داده شده":"")+'</div>'+tb+'</div>'+
'<div class="card" style="padding:8px;margin-top:8px;line-height:2;font-size:12px"><b>توضیح کامل '+esc(D.name)+'</b><br>'+D.help+'<br><b>لمس نمادها:</b> لمس هر ردیف لیست بالا صفحه‌ی عمق بازار'+(D.codal?' و لمس هر ردیف جدول جزئیات اطلاعیه‌ی کدال':' و لمس هر ردیف جدول جزئیات صفحه‌ی TSE')+' همان نماد را باز می‌کند.<br><b>نکته‌ی کلی:</b> این فیلتر ابزار آماری است و توصیه‌ی خرید یا فروش نیست.</div>'}
document.getElementById("v").addEventListener("click",function(e){if(!wlOn())return;var r=e.target.closest&&e.target.closest("tr[data-cu]");if(!r)return;var u=r.getAttribute("data-cu");if(u)openIn("com.android.chrome",u)});
// افزودن فیلترهای جدید به لیست‌ها (یک‌بار)

// ===== فیلترهای اختلاف قیمت آپشن: فاصله‌ی قیمت سرخط خرید و سرخط فروش (بهترین سطح تابلو) =====
// «اختلاف قیمت تک»: آپشن‌های یک نماد (پیش‌فرض نمادِ کادر جستجو) ؛ «اختلاف قیمت همه»: آپشن‌های همه‌ی نمادها
function oqDef(){try{var ins=String(S.ins||"");if(UL.some(function(u){return String(u.c)===ins}))return ins;if(S.un&&String(S.un.ins)===ins&&S.un.ua)return String(S.un.ua);var k=nz(S.sym||""),u=UL.filter(function(x){return nz(x.n)===k})[0];return u?String(u.c):""}catch(e){return""}}
function oqIs(f){return f==="oq2"||f==="oq3"}
function oqN(C){var n=+(C.cfg&&C.cfg.n);return n>0?Math.min(50,n):(C.flt==="oq2"?10:15)}
function oqRun(C,raw,single){return(async function(){
 var R=parseOptMW(raw),OB=nxOBof(raw),res=[],act=0,cf=C.cfg||{},md=(cf.oqm==="c"||cf.oqm==="p")?cf.oqm:"a",mx=oqN(C),us=single?String(oqDef()||cf.oqs||""):String(cf.oqs||""),set=null,un="";
 if(single&&!us)return{res:[],dg:"نماد آپشن‌دار انتخاب نشده؛ نماد را در کادر جستجو بنویسید یا از «تنظیمات فیلتر» انتخاب کنید."};
 if(us){var u0=UL.filter(function(x){return String(x.c)===us})[0];un=u0?u0.n:"";var rows=await getOpts();set={};
  rows.forEach(function(r){var hit=uaCode(r)===us;if(!hit&&u0){for(var k in r){if(/ua/i.test(k)&&typeof r[k]==="string"&&nz(ar(r[k]))===nz(u0.n)){hit=true;break}}}if(!hit)return;strs(r).forEach(function(t){if(/^[ضط][^\s\d]*\d+$/.test(t))set[nz(t)]=1})})}
 var tot=0;
 R.forEach(function(r){var sd=/^ض/.test(r.n)?"c":(/^ط/.test(r.n)?"p":(/^اختیارخ/.test(nz(r.nm))?"c":(/^اختیارف/.test(nz(r.nm))?"p":"")));
  if(md!=="a"&&sd!==md)return;if(set&&!set[nz(r.n)])return;tot++;
  var o=OB[r.c]||{},qd=o.qd1||0,qo=o.qo1||0,pd=o.pd1||0,po=o.po1||0;if(!(qd>0||qo>0))return;act++;
  if(!(qd>0&&qo>0&&pd>0&&po-pd>1))return;
  var sp=po-pd,p=r.pl>0?r.pl:r.pc;
  res.push({c:r.c,n:r.n,nm:r.nm,pd:pd,po:po,qd:qd,qo:qo,sp:sp,spp:sp/((po+pd)/2)*100,p:p,chg:r.py>0&&p>0?(p/r.py-1)*100:null})});
 res.sort(function(a,c){return c.sp-a.sp||c.spp-a.spp});
 var two=res.length;
 return{res:res.slice(0,mx),dg:(un?("نماد: "+un+" — "):"")+"نماد آپشن: "+tot.toLocaleString("fa-IR")+" — دارای سفارش: "+act.toLocaleString("fa-IR")+" — دارای خرید و فروش هم‌زمان: "+two.toLocaleString("fa-IR")}})()}
var OQ_COLS=[["قیمت خرید",function(x){return cfp(x.pd)}],["قیمت فروش",function(x){return cfp(x.po)}],["اختلاف",function(x){return'<b style="color:var(--up)">'+cfp(x.sp)+'</b>'}],["درصد اختلاف",function(x){return cfp(x.spp,1)}]];
var OQ_HELP="<b>این لیست چیست؟</b> نمادهای اختیار خرید و فروشی که فاصله‌ی قیمت سرخط صف خرید (بهترین قیمت خرید) و سرخط صف فروش (بهترین قیمت فروش) در آن‌ها از همه بیشتر است.<br><b>روش:</b> برای هر نماد آپشن، بهترین قیمت خرید و بهترین قیمت فروش در تابلو خوانده می‌شود. اختلاف = قیمت سرخط فروش − قیمت سرخط خرید (ریال). زیر نام هر نماد در لیست، همین اختلاف با رنگ بنفش نوشته می‌شود.<br><b>چه نمادهایی نمی‌آیند؟</b> نمادی که فقط خریدار یا فقط فروشنده دارد (صف خرید یا صف فروش) اختلاف قیمتی ندارد و وارد لیست نمی‌شود. اختلاف ۱ ریال یا کمتر هم نمایش داده نمی‌شود.<br><b>تنظیمات:</b> با «⚙ تنظیمات فیلتر» نماد آپشن‌دار، نوع قرارداد (خرید، فروش یا هر دو) و حداکثر تعداد را عوض کنید.<br><b>کاربرد:</b> اختلاف زیاد یعنی نماد کم‌عمق است؛ هم فرصت قیمت‌گذاری میان دو سرخط هست و هم ریسک اجرای سفارش با قیمت بد.<br><b>نکته:</b> تابلو لحظه‌ای است و با لغو یا اجرای سفارش‌ها سریع عوض می‌شود. فقط بهترین سطح تابلو بررسی می‌شود و وقتی بازار بسته است لیست خالی می‌ماند. این فیلتر آماری است و توصیه‌ی خرید یا فروش نیست.";
NX.oq2={name:"اختلاف قیمت تک",custom:function(C,list,raw,b){return oqRun(C,raw,true)},cols:OQ_COLS,help:OQ_HELP};
NX.oq3={name:"اختلاف قیمت همه",custom:function(C,list,raw,b){return oqRun(C,raw,false)},cols:OQ_COLS,help:OQ_HELP};
// ===== فیلترهای ویژه‌ی بازار آپشن (صف، سقف و کف، حجم غیرعادی، ارزش، رشد و افت، تک‌طرفه، سررسید نزدیک، در سود و بی‌ارزش) =====
var OF_ORDER=["ofb","ofs","ofh","ofl","ofv","oft","ofu","ofd","of1","ofe","ofi"];
function ofIs(f){return OF_ORDER.indexOf(f)>=0}
function ofSide(r){return /^ض/.test(r.n)?"c":(/^ط/.test(r.n)?"p":(/^اختیارخ/.test(nz(r.nm))?"c":(/^اختیارف/.test(nz(r.nm))?"p":"")))}
function ofN(C){var n=+(C.cfg&&C.cfg.n);return n>0?Math.min(100,n):20}
function ofP(C,k){var D=NX[C.flt],c=C.cfg||{},p=null;(D.P||[]).forEach(function(x){if(x[0]===k)p=x});if(c[k]!=null&&c[k]!=="")return c[k];return p?p[2]:null}
// ریال ← متن کوتاه به تومان
function ofT(v){if(!(v>0))return"—";var t=v/10;if(t>=1e9)return cfp(t/1e9,t>=1e10?0:1)+" میلیارد";if(t>=1e6)return cfp(t/1e6,t>=1e7?0:1)+" میلیون";return cfp(t)}
function ofPc(v,d){return v==null||!isFinite(v)?"—":'<span dir="ltr">'+(v>0?"+":(v<0?"−":""))+cfp(Math.abs(v),d==null?1:d)+'٪</span>'}
// ضریب قرارداد (تعداد سهم هر قرارداد): از نسبت ارزش به حجم × قیمت، وگرنه از مشخصات قرارداد، وگرنه ۱۰۰۰
function ofMul(r,mt){if(r.vol>0&&r.pl>0&&r.val>0){var q=r.val/(r.vol*r.pl),p=Math.pow(10,Math.round(Math.log(q)/Math.LN10));if(p>=1&&p<=1e4)return p}return(mt&&mt.z>0)?mt.z:1000}
// مشخصات قراردادها از دیده‌بان آپشن TSETMC: اعمال، سررسید، روز مانده، نماد پایه، قیمت پایه، موقعیت باز
var OFM={t:0,m:null};
async function ofMeta(f){if(!f&&OFM.m&&Date.now()-OFM.t<3e5)return OFM.m;
 if(OFM.m)_opt=null;var rows=await getOpts(),M={c:{},s:{}},t0=new Date();t0.setHours(0,0,0,0);
 rows.forEach(function(r){var ua=uaCode(r),e=null,st=0,rd=null,uap=0,uac=0,k,i,ss=strs(r);
  for(k in r){if(/end.*date|date.*end|expir/i.test(k)){var v=String(r[k]).replace(/\D/g,"");if(v.length===8){e=jIso(+v.slice(0,4),+v.slice(4,6),+v.slice(6,8));break}}}
  for(i=0;i<ss.length&&!e;i++){var mm=/-(1[34]\d{2})(\d{2})(\d{2})$/.exec(ss[i]);if(mm)e=jIso(+mm[1],+mm[2],+mm[3])}
  for(k in r){if(/strike/i.test(k)&&+r[k]>0){st=+r[k];break}}
  for(i=0;i<ss.length&&!st;i++){var m2=/-(\d{2,7})-/.exec(ss[i]);if(m2)st=+m2[1]}
  for(k in r){var kk=k.toLowerCase(),v2=+r[k];if(!(v2>0))continue;if(/remain/.test(kk))rd=v2;if(/_ua$/.test(kk)||/^ua/.test(kk)){if(/drcot|lasttrad|lastprice/.test(kk))uap=v2;else if(/pclosing|closingprice/.test(kk))uac=v2}}
  var dd=rd!=null?rd:(e?Math.round((new Date(e+"T00:00:00")-t0)/864e5):null),z=csz(r);
  ss.forEach(function(t){if(!/^[ضط][^\s\d]*\d+$/.test(t))return;var sd=t.charAt(0)==="ض"?"c":"p",sfx=sd==="c"?/(_c|call)$/:/(_p|put)$/,code="",oi=0,vo=0;
   for(k in r){var kl=k.toLowerCase(),v3=r[k];if(!sfx.test(kl))continue;if(/inscode/.test(kl)&&/^\d{8,}$/.test(String(v3)))code=String(v3);if((/^op_?[cp]$/.test(kl)||/openpos|openint/.test(kl))&&+v3>0)oi=+v3;if(/tran5j|tvol|totvol|volume/.test(kl)&&!/base|avg|val/.test(kl)&&+v3>0)vo=+v3}
   var o={ua:ua,k:st,e:e,dd:dd,uap:uap,uac:uac,z:z,oi:oi,sd:sd,n:t,vo:vo,pr:premium(r,sd)};M.s[nz(t)]=o;if(code)M.c[code]=o})});
 OFM={t:Date.now(),m:M};return M}
// آخرین قیمت همه‌ی نمادهای تابلو (برای قیمت سهم پایه، از جمله صندوق‌ها)
function ofPx(raw){var m={};String(raw).split("@").forEach(function(sg){sg.split(";").forEach(function(r){var f=r.split(",");if(f.length<21)return;var pl=num(f[7]),pc=num(f[6]),py=num(f[13]);if(pl>0||pc>0)m[f[0].trim()]={pl:pl,pc:pc,py:py}})});return m}
function ofRun(C,raw){return(async function(){
 var D=NX[C.flt],cf=C.cfg||{},md=(cf.oqm==="c"||cf.oqm==="p")?cf.oqm:"a",us=String(cf.oqs||""),R=parseOptMW(raw),OB=nxOBof(raw),M=null,res=[],tot=0,PX=D.px?ofPx(raw):null;
 if(D.meta||us){WP.msg="دریافت مشخصات قراردادهای آپشن…";if(wlOn())wlPaint();try{M=await ofMeta()}catch(e){if(D.meta||us)throw e}}
 var un="";if(us){var u0=UL.filter(function(x){return String(x.c)===us})[0];un=u0?u0.n:""}
 var miss=0;
 R.forEach(function(r){var sd=ofSide(r);if(md!=="a"&&sd!==md)return;var mt=M?(M.c[r.c]||M.s[nz(r.n)]||null):null;if(us&&!(mt&&String(mt.ua)===us))return;if(D.meta&&!mt){miss++;return}tot++;
  var x=null;try{x=D.pick(r,OB[r.c]||{},mt,C,PX,sd)}catch(e){x=null}if(x){x.c=r.c;x.n=r.n;x.nm=r.nm;x.sd=sd;res.push(x)}});
 res.sort(D.sort);var all=res.length;
 return{res:res.slice(0,ofN(C)),dg:(un?("نماد پایه: "+un+" — "):"")+"آپشن‌های بررسی‌شده: "+tot.toLocaleString("fa-IR")+" — مطابق شرط: "+all.toLocaleString("fa-IR")+(miss?" — بدون مشخصات قرارداد: "+miss.toLocaleString("fa-IR"):"")}})()}
// متن بنفش زیر نام نماد در لیست
function ofSub(C,it){var D=C&&NX[C.flt];if(!D||!ofIs(C.flt)||!D.sub)return"";var s="",c="#7b1fa2";try{var z=D.sub(it,C);if(z&&typeof z==="object"){s=z.t;c=z.c||c}else s=z}catch(e){s=""}return s?'<span class="hv" style="color:'+c+'">'+s+'</span>':""}
function ofHelp(a,b,c,d){return"<b>این لیست چیست؟</b> "+a+"<br><b>روش:</b> "+b+"<br><b>تنظیمات:</b> با «⚙ تنظیمات فیلتر» نماد پایه (همه یا یک نماد)، نوع قرارداد (خرید، فروش یا هر دو)، حداکثر تعداد"+(c?"، "+c:"")+" را عوض کنید.<br><b>کاربرد:</b> "+d+"<br><b>نکته:</b> داده‌ها از تابلوی لحظه‌ای بورس خوانده می‌شود و تا وقتی صفحه باز است هر ۵ دقیقه تازه می‌شود؛ بیرون از ساعت بازار آخرین تابلوی موجود ملاک است. این فیلتر آماری است و توصیه‌ی خرید یا فروش نیست."}
var OF_MV=["mv","حداقل ارزش (میلیون تومان، ۰ = بدون حد)",0,0,1e7];
NX.ofb={name:"صف خرید آپشن",P:[OF_MV],
 pick:function(r,o,mt,C){var qd=o.qd1||0,qo=o.qo1||0,pd=o.pd1||0;if(!(r.smx>0&&qd>0&&pd>=r.smx-0.5&&!(qo>0)))return null;var qv=qd*pd*ofMul(r,mt);if(qv/1e7<(+ofP(C,"mv")||0))return null;return{q:qd,z:o.zd1||0,p:pd,qv:qv}},
 sort:function(a,b){return b.qv-a.qv},sub:function(x){return{t:"صف "+ofT(x.qv),c:"var(--up)"}},
 cols:[["حجم صف",function(x){return cfp(x.q)}],["ارزش صف (تومان)",function(x){return ofT(x.qv)}]],
 help:ofHelp("آپشن‌هایی که الان در صف خرید هستند: بهترین قیمت خرید روی سقف مجاز روز است و هیچ فروشنده‌ای در تابلو نیست. زیر نام هر نماد ارزش صف نوشته شده است.","حجم صف = تعداد قرارداد سرخط خرید؛ ارزش صف = حجم صف × قیمت سقف × اندازه‌ی قرارداد (معمولاً ۱۰۰۰ سهم). لیست از بیشترین ارزش صف مرتب می‌شود.","حداقل ارزش صف","صف سنگین نشان می‌دهد تقاضا از سقف مجاز روز بیشتر است. صف کم‌حجم با یک سفارش فروش باز می‌شود.")};
NX.ofs={name:"صف فروش آپشن",P:[OF_MV],
 pick:function(r,o,mt,C){var qd=o.qd1||0,qo=o.qo1||0,po=o.po1||0;if(!(r.smn>0&&qo>0&&po>0&&po<=r.smn+0.5&&!(qd>0)))return null;var qv=qo*po*ofMul(r,mt);if(qv/1e7<(+ofP(C,"mv")||0))return null;return{q:qo,z:o.zo1||0,p:po,qv:qv}},
 sort:function(a,b){return b.qv-a.qv},sub:function(x){return{t:"صف "+ofT(x.qv),c:"var(--dn)"}},
 cols:[["حجم صف",function(x){return cfp(x.q)}],["ارزش صف (تومان)",function(x){return ofT(x.qv)}]],
 help:ofHelp("آپشن‌هایی که الان در صف فروش هستند: بهترین قیمت فروش روی کف مجاز روز است و هیچ خریداری در تابلو نیست. زیر نام هر نماد ارزش صف فروش نوشته شده است.","حجم صف = تعداد قرارداد سرخط فروش؛ ارزش صف = حجم صف × قیمت کف × اندازه‌ی قرارداد. لیست از بیشترین ارزش صف مرتب می‌شود.","حداقل ارزش صف","صف فروش سنگین یعنی عرضه از کف مجاز روز بیشتر است؛ در آپشن‌های نزدیک سررسید معمولاً یعنی بازار آن قرارداد را بی‌ارزش می‌بیند.")};
var OF_TR=["tr","نمادها",["y","فقط معامله‌شده‌های امروز"],null,null,[["y","فقط معامله‌شده‌های امروز"],["a","همه (با قیمت دیروز)"]]];
function ofPr(r){return r.pl>0?r.pl:(r.pc>0?r.pc:r.py)}
NX.ofh={name:"نزدیک سقف مجاز",P:[["d","حداکثر فاصله تا سقف مجاز (٪)",3,0,100],OF_TR],
 pick:function(r,o,mt,C){if(ofP(C,"tr")!=="a"&&!(r.tr>0))return null;var p=ofPr(r);if(!(p>0&&r.smx>0&&r.smx>=p))return null;var d=(r.smx/p-1)*100;if(d>(+ofP(C,"d")))return null;return{p:p,mx:r.smx,ds:d,val:r.val,chg:r.py>0?(p/r.py-1)*100:null}},
 sort:function(a,b){return a.ds-b.ds||b.val-a.val},sub:function(x){return x.ds<0.05?{t:"روی سقف",c:"var(--up)"}:cfp(x.ds,1)+"٪ تا سقف"},
 cols:[["قیمت",function(x){return cfp(x.p)}],["سقف مجاز",function(x){return cfp(x.mx)}],["فاصله",function(x){return cfp(x.ds,1)+"٪"}]],
 help:ofHelp("آپشن‌هایی که آخرین قیمتشان کمتر از درصد تنظیمی با سقف مجاز روز فاصله دارد (پیش‌فرض ۳٪).","فاصله = (سقف مجاز ÷ آخرین قیمت − ۱) × ۱۰۰. آپشنی که روی سقف است با فاصله‌ی صفر می‌آید. لیست از نزدیک‌ترین به سقف مرتب می‌شود.","حداکثر فاصله و اینکه فقط نمادهای معامله‌شده‌ی امروز بیایند","نمادی که به سقف نزدیک است ممکن است به‌زودی صف خرید شود؛ خرید نزدیک سقف هم ریسک برگشت قیمت دارد.")};
NX.ofl={name:"نزدیک کف مجاز",P:[["d","حداکثر فاصله تا کف مجاز (٪)",3,0,100],OF_TR],
 pick:function(r,o,mt,C){if(ofP(C,"tr")!=="a"&&!(r.tr>0))return null;var p=ofPr(r);if(!(p>0&&r.smn>0&&r.smn<=p))return null;var d=(1-r.smn/p)*100;if(d>(+ofP(C,"d")))return null;return{p:p,mn:r.smn,ds:d,val:r.val,chg:r.py>0?(p/r.py-1)*100:null}},
 sort:function(a,b){return a.ds-b.ds||b.val-a.val},sub:function(x){return x.ds<0.05?{t:"روی کف",c:"var(--dn)"}:cfp(x.ds,1)+"٪ تا کف"},
 cols:[["قیمت",function(x){return cfp(x.p)}],["کف مجاز",function(x){return cfp(x.mn)}],["فاصله",function(x){return cfp(x.ds,1)+"٪"}]],
 help:ofHelp("آپشن‌هایی که آخرین قیمتشان کمتر از درصد تنظیمی با کف مجاز روز فاصله دارد (پیش‌فرض ۳٪).","فاصله = (۱ − کف مجاز ÷ آخرین قیمت) × ۱۰۰. آپشنی که روی کف است با فاصله‌ی صفر می‌آید. لیست از نزدیک‌ترین به کف مرتب می‌شود.","حداکثر فاصله و اینکه فقط نمادهای معامله‌شده‌ی امروز بیایند","نمادی که به کف نزدیک است ممکن است صف فروش شود؛ برای فروشنده‌ی اختیار یا کسی که دنبال خرید ارزان است قابل توجه است.")};
NX.ofv={name:"حجم غیرعادی آپشن",meta:1,P:[["k","حداقل چند برابر مبنا",3,1,1000],["rb","مبنای مقایسه",["a","خودکار"],null,null,[["a","خودکار (حجم مبنا، وگرنه موقعیت‌های باز)"],["b","حجم مبنا"],["o","موقعیت‌های باز"]]]],
 pick:function(r,o,mt,C){if(!(r.vol>0))return null;var rb=ofP(C,"rb"),ref=0,rk="";if(rb==="b"||(rb!=="o"&&r.bv>1)){ref=r.bv;rk="حجم مبنا"}else{ref=mt&&mt.oi>0?mt.oi:0;rk="موقعیت باز"}if(!(ref>0))return null;var rt=r.vol/ref;if(rt<(+ofP(C,"k")||3))return null;return{vol:r.vol,ref:ref,rk:rk,rt:rt,val:r.val}},
 sort:function(a,b){return b.rt-a.rt},sub:function(x){return"×"+cfp(x.rt,x.rt<10?1:0)+" "+x.rk},
 cols:[["حجم امروز",function(x){return cfp(x.vol)}],["مبنا",function(x){return cfp(x.ref)}],["چند برابر",function(x){return cfp(x.rt,1)}]],
 help:ofHelp("آپشن‌هایی که حجم معاملات امروزشان چند برابر حجم مبنا است (پیش‌فرض حداقل ۳ برابر).","نسبت = حجم امروز ÷ حجم مبنا. حجم مبنای بیشتر آپشن‌ها ۱ قرارداد است و مقایسه با آن معنا ندارد؛ برای همین در حالت «خودکار» اگر حجم مبنا ۱ یا کمتر باشد، تعداد موقعیت‌های باز قرارداد ملاک می‌شود. نوع مبنا زیر نام هر نماد نوشته شده است.","حداقل نسبت و نوع مبنا","حجم چند برابرِ معمول یعنی معامله‌گرهای بزرگ وارد یا خارج شده‌اند؛ جهت قیمت را کنار حجم ببینید.")};
NX.oft={name:"بیشترین ارزش معاملات",P:[OF_MV],
 pick:function(r,o,mt,C){if(!(r.val>0))return null;if(r.val/1e7<(+ofP(C,"mv")||0))return null;var p=ofPr(r);return{val:r.val,vol:r.vol,tr:r.tr,chg:r.py>0&&p>0?(p/r.py-1)*100:null}},
 sort:function(a,b){return b.val-a.val},sub:function(x){return ofT(x.val)+" ت"},
 cols:[["ارزش (تومان)",function(x){return ofT(x.val)}],["حجم",function(x){return cfp(x.vol)}],["تعداد معامله",function(x){return cfp(x.tr)}]],
 help:ofHelp("پرمعامله‌ترین آپشن‌های امروز بر اساس ارزش معاملات (ریال معامله‌شده).","ارزش معاملات هر نماد از تابلوی بورس خوانده و از زیاد به کم مرتب می‌شود. زیر نام هر نماد ارزش معاملات به تومان نوشته شده است.","حداقل ارزش معاملات","نقدشونده‌ترین قراردادها را نشان می‌دهد؛ اختلاف قیمت خرید و فروش در آن‌ها معمولاً کمتر است.")};
var OF_MT=["mt","حداقل تعداد معاملات امروز",1,1,1e6];
function ofChg(r,C){if(!(r.tr>=(+ofP(C,"mt")||1)&&r.py>0&&r.pl>0))return null;return(r.pl/r.py-1)*100}
NX.ofu={name:"بیشترین رشد آپشن",P:[OF_MT],
 pick:function(r,o,mt,C){var c=ofChg(r,C);if(c==null||!(c>0))return null;return{p:r.pl,py:r.py,chg:c,tr:r.tr}},
 sort:function(a,b){return b.chg-a.chg},sub:function(x){return{t:"+"+cfp(x.chg,1)+"٪",c:"var(--up)"}},
 cols:[["آخرین قیمت",function(x){return cfp(x.p)}],["دیروز",function(x){return cfp(x.py)}],["تغییر",function(x){return ofPc(x.chg)}]],
 help:ofHelp("آپشن‌هایی که آخرین قیمتشان بیشترین رشد را نسبت به قیمت پایانی دیروز داشته است.","تغییر = (آخرین قیمت ÷ قیمت دیروز − ۱) × ۱۰۰. فقط نمادهایی می‌آیند که امروز حداقل به تعداد تنظیمی معامله داشته‌اند (پیش‌فرض ۱).","حداقل تعداد معاملات","اهرم آپشن باعث می‌شود درصد تغییرها چند برابر سهم پایه باشد؛ قیمت‌های خیلی کوچک با یک معامله درصد بزرگ می‌سازند، پس تعداد معاملات را هم ببینید.")};
NX.ofd={name:"بیشترین افت آپشن",P:[OF_MT],
 pick:function(r,o,mt,C){var c=ofChg(r,C);if(c==null||!(c<0))return null;return{p:r.pl,py:r.py,chg:c,tr:r.tr}},
 sort:function(a,b){return a.chg-b.chg},sub:function(x){return{t:"−"+cfp(Math.abs(x.chg),1)+"٪",c:"var(--dn)"}},
 cols:[["آخرین قیمت",function(x){return cfp(x.p)}],["دیروز",function(x){return cfp(x.py)}],["تغییر",function(x){return ofPc(x.chg)}]],
 help:ofHelp("آپشن‌هایی که آخرین قیمتشان بیشترین افت را نسبت به قیمت پایانی دیروز داشته است.","تغییر = (آخرین قیمت ÷ قیمت دیروز − ۱) × ۱۰۰. فقط نمادهایی می‌آیند که امروز حداقل به تعداد تنظیمی معامله داشته‌اند (پیش‌فرض ۱).","حداقل تعداد معاملات","افت تند اغلب از افت سهم پایه یا نزدیک شدن سررسید می‌آید؛ ارزش زمانی آپشن هر روز کم می‌شود.")};
NX.of1={name:"تک‌طرفه آپشن",P:[["ws","طرف تابلو",["a","هر دو"],null,null,[["a","هر دو (فقط خریدار یا فقط فروشنده)"],["b","فقط خریدار دارد"],["s","فقط فروشنده دارد"]]],OF_MV],
 pick:function(r,o,mt,C){var qd=o.qd1||0,qo=o.qo1||0,ws=ofP(C,"ws"),k="";if(qd>0&&!(qo>0))k="b";else if(qo>0&&!(qd>0))k="s";if(!k||(ws!=="a"&&ws!==k))return null;var p=k==="b"?o.pd1:o.po1,q=k==="b"?qd:qo,qv=q*(p||0)*ofMul(r,mt);if(qv/1e7<(+ofP(C,"mv")||0))return null;return{k:k,p:p,q:q,qv:qv,qe:k==="b"?(r.smx>0&&p>=r.smx-0.5):(r.smn>0&&p<=r.smn+0.5)}},
 sort:function(a,b){return b.qv-a.qv},sub:function(x){return{t:(x.k==="b"?"فقط خریدار":"فقط فروشنده")+(x.qe?" (صف)":""),c:x.k==="b"?"var(--up)":"var(--dn)"}},
 cols:[["طرف",function(x){return x.k==="b"?"خریدار":"فروشنده"}],["قیمت سرخط",function(x){return cfp(x.p)}],["حجم سرخط",function(x){return cfp(x.q)}],["ارزش",function(x){return ofT(x.qv)}]],
 help:ofHelp("آپشن‌هایی که در تابلو فقط خریدار یا فقط فروشنده دارند؛ برعکس فیلترهای «اختلاف قیمت» که هر دو طرف را لازم دارند.","سرخط خرید و سرخط فروش تابلو خوانده می‌شود؛ اگر فقط یکی از آن‌ها سفارش داشته باشد نماد وارد لیست می‌شود. اگر سفارش روی سقف یا کف مجاز باشد کنار طرف «(صف)» نوشته می‌شود. ترتیب از بیشترین ارزش سفارش سرخط است.","طرف تابلو و حداقل ارزش سفارش","قرارداد تک‌طرفه یعنی طرف مقابل نیست؛ برای فروشنده‌ی اختیار (بازارگردان) فرصت قیمت‌گذاری است و برای خریدار یعنی خروج سخت.")};
NX.ofe={name:"سررسید نزدیک پرمعامله",meta:1,P:[["d0","حداقل روز مانده تا سررسید",0,0,400],["d1","حداکثر روز مانده تا سررسید",10,0,400],OF_MV],
 pick:function(r,o,mt,C){if(!mt||mt.dd==null||!(r.val>0))return null;var a=+ofP(C,"d0")||0,b=+ofP(C,"d1");if(!(b>=0))b=10;if(mt.dd<a||mt.dd>b)return null;if(r.val/1e7<(+ofP(C,"mv")||0))return null;return{dd:mt.dd,e:mt.e,k:mt.k,val:r.val,vol:r.vol}},
 sort:function(a,b){return b.val-a.val},sub:function(x){return cfp(x.dd)+" روز — "+ofT(x.val)},
 cols:[["روز مانده",function(x){return cfp(x.dd)}],["اعمال",function(x){return cfp(x.k)}],["ارزش (تومان)",function(x){return ofT(x.val)}],["حجم",function(x){return cfp(x.vol)}]],
 help:ofHelp("آپشن‌هایی که چند روز بیشتر به سررسیدشان نمانده (پیش‌فرض ۰ تا ۱۰ روز) ولی هنوز معامله‌ی زیادی دارند.","روز مانده تا سررسید از مشخصات قرارداد در دیده‌بان آپشن بورس خوانده می‌شود و فقط نمادهایی که امروز معامله داشته‌اند می‌آیند؛ ترتیب از بیشترین ارزش معاملات است. زیر نام هر نماد روز مانده و ارزش معاملات نوشته شده است.","بازه‌ی روز مانده و حداقل ارزش معاملات","نزدیک سررسید ارزش زمانی تند کم می‌شود و نوسان قیمت آپشن زیاد است؛ این لیست جاهایی را نشان می‌دهد که معامله‌گرها هنوز فعال‌اند.")};
NX.ofi={name:"در سود و بی‌ارزش",meta:1,px:1,P:[["st","وضعیت",["i","در سود"],null,null,[["i","در سود (قیمت سهم پایه از اعمال گذشته)"],["o","بی‌ارزش (بدون ارزش ذاتی)"],["a","هر دو"]]],["so","ترتیب",["d","عمق در سود"],null,null,[["d","عمق در سود (بیشترین اول)"],["t","ارزش زمانی (کمترین اول)"],["v","ارزش معاملات (بیشترین اول)"]]],OF_TR],
 pick:function(r,o,mt,C,PX,sd){if(!mt||!(mt.k>0)||!sd)return null;if(ofP(C,"tr")!=="a"&&!(r.tr>0))return null;var u=PX&&PX[String(mt.ua)],S=u?(u.pl>0?u.pl:u.pc):0;if(!(S>0))S=mt.uap||mt.uac;var p=ofPr(r);if(!(S>0&&p>0))return null;
  var K=mt.k,iv=sd==="c"?Math.max(0,S-K):Math.max(0,K-S),mon=sd==="c"?(S/K-1)*100:(K/S-1)*100,st=ofP(C,"st"),itm=iv>0;if(st==="i"&&!itm)return null;if(st==="o"&&itm)return null;
  return{S:S,K:K,p:p,iv:iv,tv:p-iv,mon:mon,dd:mt.dd,val:r.val,itm:itm?1:0}},
 sort:function(a,b){var s=NXCUR&&NXCUR.cfg&&NXCUR.cfg.so;if(s==="t")return a.tv-b.tv;if(s==="v")return b.val-a.val;return b.mon-a.mon},
 sub:function(x){return x.itm?{t:"در سود ("+cfp(x.mon,1)+"٪)",c:"var(--up)"}:{t:"بی‌ارزش ("+cfp(Math.abs(x.mon),1)+"٪)",c:"var(--dn)"}},
 cols:[["قیمت پایه",function(x){return cfp(x.S)}],["اعمال",function(x){return cfp(x.K)}],["ارزش ذاتی",function(x){return cfp(x.iv)}],["ارزش زمانی",function(x){return'<span style="color:'+(x.tv<0?"var(--dn)":"inherit")+'">'+(x.tv<0?"−":"")+cfp(Math.abs(x.tv))+'</span>'}],["روز",function(x){return x.dd==null?"—":cfp(x.dd)}]],
 help:ofHelp("آپشن‌هایی که قیمت سهم پایه از قیمت اعمالشان گذشته (در سود) یا هنوز نگذشته (بی‌ارزش)، همراه با ارزش ذاتی و ارزش زمانی.","برای اختیار خرید: ارزش ذاتی = قیمت سهم پایه − قیمت اعمال (اگر مثبت باشد)؛ برای اختیار فروش: قیمت اعمال − قیمت سهم پایه. ارزش زمانی = قیمت آپشن − ارزش ذاتی. عمق در سود = فاصله‌ی قیمت سهم پایه از اعمال به درصد. قیمت سهم پایه آخرین قیمت تابلو است. زیر نام هر نماد وضعیت و درصد فاصله نوشته شده است.","وضعیت (در سود، بی‌ارزش یا هر دو)، ترتیب لیست و اینکه فقط نمادهای معامله‌شده‌ی امروز بیایند","ارزش زمانی منفی یعنی آپشن زیر ارزش ذاتی‌اش معامله می‌شود. با لمس هر نماد، صفحه‌ی عمق بازار آن باز می‌شود و نماد پایه با قیمتش بالای صفحه نمایش داده می‌شود.")};
OF_ORDER.forEach(function(k){NX[k].custom=function(C,list,raw){return ofRun(C,raw)}});
// در این فیلترها جدول جزئیات (ستون‌های محاسبه‌شده) هم زیر لیست نمایش داده می‌شود
function ofDetail(C){var D=NX[C.flt],it=C.items||[];if(!it.length)return"";
 return'<div class="card" style="padding:6px;margin-top:8px"><b>جزئیات '+esc(D.name)+'</b><div class="sc scv"><table class="stk"><tr><th class="drw">ردیف</th><th>نماد</th>'+D.cols.map(function(c){return'<th>'+c[0]+'</th>'}).join("")+'</tr>'+it.map(function(x,i){return'<tr data-ofr="'+i+'" style="cursor:pointer"><td class="drw">'+(i+1).toLocaleString("fa-IR")+'</td><td style="font-weight:700">'+esc(x.n)+'</td>'+D.cols.map(function(c){var v="—";try{v=c[1](x)}catch(e){}return'<td>'+v+'</td>'}).join("")+'</tr>'}).join("")+'</table></div></div>'}
document.getElementById("v").addEventListener("click",function(e){if(!wlOn()||!e.target.closest)return;var r=e.target.closest("tr[data-ofr]");if(!r)return;var C=wlCur(),it=C&&C.items&&C.items[+r.getAttribute("data-ofr")];if(it){e.stopPropagation();openDepth(it.c,it.n)}},true);
// تنظیمات فیلترهای ویژه‌ی آپشن
function ofSet(C,tried){
 if(!UL.length&&!tried){try{getOpts().then(function(){ofSet(C,1)}).catch(function(){ofSet(C,1)})}catch(e){ofSet(C,1)}return}
 var D=NX[C.flt],o=document.getElementById("hb");if(o)o.remove();o=document.createElement("div");o.id="hb";
 var c=C.cfg||{},us=String(c.oqs||""),md=(c.oqm==="c"||c.oqm==="p")?c.oqm:"a",ul=UL.slice().sort(function(a,b){return a.n<b.n?-1:1});
 var blk=function(t,body){return'<div style="margin:8px 0"><div style="font-size:13px;margin-bottom:4px">'+t+'</div>'+body+'</div>'};
 var prm=(D.P||[]).map(function(p){var v=ofP(C,p[0]);if(p[5]){var cur=(v&&typeof v==="object")?v[0]:v;return blk(p[1],'<select data-ofp="'+p[0]+'" style="width:100%;max-width:none">'+p[5].map(function(q){return'<option value="'+q[0]+'"'+(q[0]===cur?" selected":"")+'>'+q[1]+'</option>'}).join("")+'</select>')}
  return blk(p[1],'<input data-ofp="'+p[0]+'" inputmode="decimal" value="'+esc(String(v))+'" style="width:100%;box-sizing:border-box">')}).join("");
 o.innerHTML='<div class="bx"><b class="t">تنظیمات «'+esc(C.name)+'»</b>'+
 blk("نماد پایه",'<select id="of_s" style="width:100%;max-width:none"><option value="">همه نمادها</option>'+ul.map(function(u){return'<option value="'+esc(u.c)+'"'+(String(u.c)===us?" selected":"")+'>'+esc(u.n)+'</option>'}).join("")+'</select>'+(ul.length?'':'<div class="mut" style="font-size:11px;margin-top:3px">فهرست نمادهای آپشن‌دار دریافت نشد؛ اینترنت را بررسی کنید.</div>'))+
 blk("قرارداد آپشن",'<select id="of_m" style="width:100%;max-width:none"><option value="a"'+(md==="a"?" selected":"")+'>هر دو (خرید و فروش)</option><option value="c"'+(md==="c"?" selected":"")+'>اختیار خرید</option><option value="p"'+(md==="p"?" selected":"")+'>اختیار فروش</option></select>')+
 prm+blk("حداکثر تعداد در لیست (۱ تا ۱۰۰)",'<input id="of_n" inputmode="numeric" value="'+ofN(C)+'" style="width:100%;box-sizing:border-box">')+
 '<div class="mut" style="font-size:11px;line-height:1.8">بعد از تغییر، «اعمال و اجرا» را بزنید تا لیست از نو ساخته شود.</div>'+
 '<button type="button" id="of_ok">اعمال و اجرا</button> <button type="button" id="of_x">بستن</button></div>';
 o.onclick=function(e){if(e.target.id==="of_ok"){var k=C.cfg=C.cfg||{};k.oqs=o.querySelector("#of_s").value||"";k.oqm=o.querySelector("#of_m").value||"a";k.n=Math.max(1,Math.min(100,+wlD(o.querySelector("#of_n").value)||20));
  (D.P||[]).forEach(function(p){var el=o.querySelector('[data-ofp="'+p[0]+'"]');if(!el)return;if(p[5]){k[p[0]]=el.value;return}var v=parseFloat(wlD(el.value).replace(/[٫,]/g,"."));if(!isFinite(v))v=p[2];k[p[0]]=Math.max(p[3],Math.min(p[4],v))});
  o.remove();C.cl=0;C.rt=Date.now();wlSave();wpRun(C);return}if(e.target===o||e.target.id==="of_x")o.remove()};
 document.body.appendChild(o);try{enhSel(o)}catch(e){}}
// مقدار پیش‌فرض پارامترهای انتخابی ([مقدار, متن]) به مقدار ساده
OF_ORDER.forEach(function(k){(NX[k].P||[]).forEach(function(p){if(p[2]&&typeof p[2]==="object")p[2]=p[2][0]})});
function ofGuide(){return'<div style="margin-top:4px"><b>صف خرید / صف فروش آپشن:</b> آپشن‌هایی که الان روی سقف (یا کف) مجاز در صف هستند، با حجم و ارزش صف.</div>'+
'<div style="margin-top:4px"><b>نزدیک سقف / کف مجاز:</b> آپشن‌هایی که فاصله‌ی آخرین قیمتشان تا سقف (یا کف) مجاز روز کمتر از درصد تنظیمی است (پیش‌فرض ۳٪).</div>'+
'<div style="margin-top:4px"><b>حجم غیرعادی آپشن:</b> حجم امروز چند برابر حجم مبنا (یا موقعیت‌های باز، وقتی حجم مبنا ۱ است).</div>'+
'<div style="margin-top:4px"><b>بیشترین ارزش معاملات:</b> پرمعامله‌ترین قراردادهای امروز به ترتیب ارزش.</div>'+
'<div style="margin-top:4px"><b>بیشترین رشد / بیشترین افت آپشن:</b> بر اساس درصد تغییر آخرین قیمت نسبت به دیروز.</div>'+
'<div style="margin-top:4px"><b>تک‌طرفه آپشن:</b> آپشن‌هایی که فقط خریدار یا فقط فروشنده دارند؛ برعکس فیلترهای اختلاف قیمت.</div>'+
'<div style="margin-top:4px"><b>سررسید نزدیک پرمعامله:</b> آپشن‌های چند روز مانده به سررسید (پیش‌فرض ۰ تا ۱۰ روز) که هنوز معامله دارند.</div>'+
'<div style="margin-top:4px"><b>در سود و بی‌ارزش:</b> مقایسه‌ی قیمت سهم پایه با قیمت اعمال، همراه با ارزش ذاتی و ارزش زمانی هر آپشن.</div>'+
'<div style="margin-top:4px"><b>تنظیمات:</b> همه‌ی این فیلترها در «⚙ تنظیمات فیلتر» انتهای لیست نماد پایه، نوع قرارداد، حداکثر تعداد و حد مخصوص خودشان را دارند.</div>'}

// در فیلترهای آپشن جدول «جزئیات» (لیست دوم) نمایش داده نمی‌شود؛ فقط کارت توضیح
(function(){var d0=nxDetail;nxDetail=function(C){var D=C&&NX[C.flt];if(C&&C.opt===1&&D){return'<div class="card" style="padding:8px;margin-top:8px;line-height:2;font-size:12px"><b>توضیح کامل '+esc(D.name)+'</b><br>'+D.help+'<br><b>لمس نمادها:</b> لمس هر ردیف لیست بالا صفحه‌ی عمق بازار همان نماد را باز می‌کند.</div>'}return d0(C)}})();
function optEnsure(){var L=WL.lists;if(!L)return false;var ch=false;
try{for(var q=L.length-1;q>=0;q--){if(L[q].flt==="oq1"){L.splice(q,1);ch=true}}if(ch)WL.cur=Math.max(0,Math.min(WL.cur||0,L.length-1))}catch(e){}
try{if(!L.some(function(l){return l.flt==="oq2"})){L.push({name:"اختلاف قیمت تک",flt:"oq2",opt:1,items:[]});ch=true}
if(!L.some(function(l){return l.flt==="oq3"})){L.push({name:"اختلاف قیمت همه",flt:"oq3",opt:1,items:[]});ch=true}
OF_ORDER.forEach(function(k){if(NX[k]&&!L.some(function(l){return l.flt===k})){L.push({name:NX[k].name,flt:k,opt:1,items:[]});ch=true}});
if(!L.some(function(l){return l.flt==="fx1"&&l.opt===1})){L.push({name:"فیلتر ساز آپشن",flt:"fx1",opt:1,items:[],fx:{m:"and",mk:"a",c:[]}});ch=true}}catch(e){}
return ch}
(function(){var w0=wlInit;wlInit=async function(){await w0();try{if(WL.lists&&optEnsure())wlSave()}catch(e){}}})();
function nxAdd(L,K){var ch=false;(K||NX_ORDER).forEach(function(k){if(!L.some(function(l){return l.flt===k})){L.push({name:NX[k].name,flt:k,items:[]});ch=true}});return ch}

// ===== تنظیمات یکسان برای همه‌ی فیلترها (بازار، نحوه‌ی بررسی، حداکثر تعداد نماد) =====
var LV_NO={oq1:1,oq2:1,oq3:1,ca1:1,as1:1,tp1:1,wr1:1,lr1:1,kc1:1,fq1:1,mq1:1},LV_OLD={qb1:1,bo1:1,rs1:1};function fsHasLv(C){return !!((NX[C.flt]&&!LV_NO[C.flt])||LV_OLD[C.flt])}
var FS_MK={ci2:1,pb1:1,bo1:1,qb1:1,gb1:1,gm1:1,rs1:1,dv1:1,hm1:1,ca1:1,mv1:1,sr1:1,qg1:1,qn1:1,tq1:1,pt1:1,tp1:1,wr1:1,as1:1,mc1:1,md1:1,bb1:1,hi1:1,en1:1,ws1:1,gp1:1,lr1:1,kc1:1,lg1:1,vcp1:1,rl1:1,ac1:1,sq1:1,db1:1,tc1:1,cap1:1,fq1:1,mq1:1,dvn1:1,dt1:1,se1:1,bq5:1,lc1:1,sm2:1,rq1:1,wh1:1,ar1:1,ec1:1,el1:1,fn1:1},FS_POST={wp1:1,wp2:1,kk1:1,sm1:1,sc1:1,sx1:1},FS_MODE={ci2:1,pb1:1};
function fsHasMk(C){return !!(FS_MK[C.flt]||FS_POST[C.flt])}
function fsSet(C){var o=document.getElementById("hb");if(o)o.remove();o=document.createElement("div");o.id="hb";var cf=ciCfg(C);
var sel=function(k,t,a){return'<div style="margin:8px 0"><div style="font-size:13px;margin-bottom:4px">'+t+'</div><select id="fs_'+k+'" style="width:100%;max-width:none">'+a.map(function(v){return'<option value="'+v[0]+'"'+(cf[k]===v[0]?" selected":"")+'>'+v[1]+'</option>'}).join("")+'</select></div>'};
o.innerHTML='<div class="bx"><b class="t">تنظیمات «'+esc(C.name)+'»</b>'+
(fsHasMk(C)?sel("mkt","بازار",[["bf","بورس و فرابورس"],["b","بازار بورس"],["f","بازار فرابورس"],["p","بازار پایه"],["e","بورس انرژی"]]):'')+
(fsHasLv(C)?'<div style="margin:8px 0"><div style="font-size:13px;margin-bottom:4px">سخت‌گیری شرط‌ها</div><select id="fs_lv" style="width:100%;max-width:none">'+[[-2,"خیلی ملایم (نتیجه‌ی بیشتر)"],[-1,"ملایم"],[0,"معمولی (پیش‌فرض)"],[1,"سخت"],[2,"خیلی سخت (نتیجه‌ی کمتر و دقیق‌تر)"]].map(function(v){return'<option value="'+v[0]+'"'+((+(C.cfg&&C.cfg.lv)||0)===v[0]?" selected":"")+'>'+v[1]+'</option>'}).join("")+'</select><div class="mut" style="font-size:11px;line-height:1.7;margin-top:3px">ملایم‌تر یعنی حدهای عددی فیلتر (درصدها، نسبت‌ها و فاصله‌ها) شل‌تر می‌شوند و نمادهای بیشتری می‌آیند؛ سخت‌تر یعنی فقط نمونه‌های قوی‌تر.</div></div>':'')+(FS_MODE[C.flt]?sel("mode","نمادهای بررسی‌شده",[["traded","فقط نمادهای معامله‌شده‌ی امروز"],["all","همه‌ی نمادها"]]):'')+
'<div style="margin:8px 0"><div style="font-size:13px;margin-bottom:4px">حداکثر تعداد نماد در لیست (۰ = همه)</div><input id="fs_n" inputmode="numeric" value="'+(cf.n||0)+'" style="width:100%;box-sizing:border-box"></div>'+
(NX[C.flt]&&NX[C.flt].pct?'<div style="margin:8px 0"><div style="font-size:13px;margin-bottom:4px">حداقل درصد از ارزش شرکت</div><input id="fs_pct" inputmode="decimal" value="'+nxPctCfg(C)+'" style="width:100%;box-sizing:border-box"></div>':'')+(NX[C.flt]&&NX[C.flt].amt?'<div style="margin:8px 0"><div style="font-size:13px;margin-bottom:4px">مبلغ (میلیارد تومان)</div><input id="fs_amt" inputmode="decimal" value="'+nxAmt(C)+'" style="width:100%;box-sizing:border-box"></div>':'')+(NX[C.flt]&&NX[C.flt].codal?'<div style="margin:8px 0"><div style="font-size:13px;margin-bottom:4px">تعداد صفحه‌های آخر کدال که بررسی می‌شود (هر صفحه ۲۰ اطلاعیه)</div><input id="fs_pg" inputmode="numeric" value="'+((C.cfg&&C.cfg.pg)||40)+'" style="width:100%;box-sizing:border-box"></div>':'')+(C.flt==="fx1"?'<div class="mut" style="font-size:11px;line-height:1.8">بازار و کد این فیلتر بالای همین صفحه تنظیم می‌شود.</div>':'')+
'<div class="mut" style="font-size:11px;line-height:1.8">بعد از تغییر، «اعمال و اجرا» را بزنید تا لیست از نو ساخته شود.</div>'+
'<button type="button" id="fs_ok">اعمال و اجرا</button> <button type="button" id="fs_x">بستن</button></div>';
o.onclick=function(e){if(e.target.id==="fs_ok"){var c=C.cfg=C.cfg||{},m=o.querySelector("#fs_mkt"),d=o.querySelector("#fs_mode");if(m)c.mkt=m.value;if(d)c.mode=d.value;var pq2=o.querySelector("#fs_pct");if(pq2){var pv=parseFloat(wlD(pq2.value).replace(/[٫,]/g,"."));if(pv>0)c.pct=Math.min(100,pv)}var lq=o.querySelector("#fs_lv");if(lq)c.lv=+lq.value||0;var am=o.querySelector("#fs_amt");if(am){var av=parseFloat(wlD(am.value).replace(/[٫,]/g,"."));if(av>0)c.amt=Math.min(100000,av)}var pq=o.querySelector("#fs_pg");if(pq)c.pg=Math.max(5,Math.min(200,+wlD(pq.value)||40));c.n=Math.max(0,Math.min(500,+wlD(o.querySelector("#fs_n").value)||0));o.remove();C.cl=0;C.rt=Date.now();wlSave();wpRun(C);return}if(e.target===o||e.target.id==="fs_x")o.remove()};
document.body.appendChild(o)}

// ===== تنظیمات فیلترهای «اختلاف قیمت تک / همه»: نماد آپشن‌دار، قرارداد (خرید/فروش/هر دو)، حداکثر تعداد =====
function oqSet(C,tried){
 if(!UL.length&&!tried){try{getOpts().then(function(){oqSet(C,1)}).catch(function(){oqSet(C,1)})}catch(e){oqSet(C,1)}return}
 var o=document.getElementById("hb");if(o)o.remove();o=document.createElement("div");o.id="hb";
 var one=C.flt==="oq2",c=C.cfg||{},us=one?oqDef():String(c.oqs||""),md=(c.oqm==="c"||c.oqm==="p")?c.oqm:"a",ul=UL.slice().sort(function(a,b){return a.n<b.n?-1:1});
 if(one&&!us&&c.oqs)us=String(c.oqs);
 var row=function(t,body){return'<div style="display:flex;align-items:center;gap:8px;margin:8px 0"><div style="flex:0 0 auto;font-size:13px">'+t+'</div><div style="flex:1;min-width:0">'+body+'</div></div>'};
 o.innerHTML='<div class="bx"><b class="t">تنظیمات «'+esc(C.name)+'»</b>'+
