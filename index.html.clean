// ---------- قالب ستون‌های دیده‌بان (حذف/افزودن/جابه‌جایی + ذخیره با نام) ----------
var WLC_DEF=["pc","cp","cd","lp","pl","ls"],WLC_DN="پیش‌فرض",
WLC_ALL={pc:["درصد پایانی","درصد","wpc"],cp:["قیمت پایانی","پایانی",""],cd:["کندل روز","کندل",""],lp:["قیمت آخرین","آخرین",""],pl:["درصد آخرین","درصد","wpc"],ls:["تابلو (۴ ستون، فقط حالت افقی)","",""],dv:["حجم تقاضا","حجم تقاضا",""],dp:["قیمت تقاضا","قیمت تقاضا",""],op:["قیمت عرضه","قیمت عرضه",""],ov:["حجم عرضه","حجم عرضه",""],
vol:["حجم معاملات","حجم",""],val:["ارزش معاملات","ارزش",""],tr:["تعداد معاملات","تعداد",""],fi:["قیمت اولین","اولین",""],fip:["درصد اولین","درصد","wpc"],lo:["کمترین قیمت","کمترین",""],hi:["بیشترین قیمت","بیشترین",""],thr:["حد نوسان مجاز","حد نوسان",""],fl:["درصد شناوری","شناوری",""]},
WLC_SK={pc:1,cp:1,cd:1,lp:1,pl:1,vol:1,val:1,tr:1,fi:1,fip:1,lo:1,hi:1,thr:1,fl:1,dv:1,dp:1,op:1,ov:1},_wlc=null;
function wlcG(){if(_wlc)return _wlc;var o=null;try{o=JSON.parse(localStorage.getItem("wlc1")||"null")}catch(e){}
if(!o||typeof o!=="object"||!o.t||typeof o.t!=="object")o={cur:WLC_DN,t:{}};
var t={};t[WLC_DN]=WLC_DEF.slice();Object.keys(o.t).forEach(function(k){if(k===WLC_DN||!Array.isArray(o.t[k]))return;var seen={};t[k]=o.t[k].filter(function(c){if(!WLC_ALL[c]||seen[c])return false;seen[c]=1;return true})});
_wlc={cur:t[o.cur]?o.cur:WLC_DN,t:t};return _wlc}
function wlcSave(){try{localStorage.setItem("wlc1",JSON.stringify(_wlc))}catch(e){}}
function wlcCols(){var g=wlcG();return g.t[g.cur]||WLC_DEF}
function wlcHead(){var h='<th data-sk="nm">نماد'+(WL.sk==="nm"?(WL.sd>0?" ▲":" ▼"):"")+'</th>';
wlcCols().forEach(function(k){if(k==="ls"){h+=["حجم تقاضا","قیمت تقاضا","قیمت عرضه","حجم عرضه"].map(function(x){return'<th class="lsc">'+x+'</th>'}).join("");return}
var d=WLC_ALL[k];h+='<th data-sk="'+k+'"'+(d[2]?' class="'+d[2]+'"':'')+'>'+d[1]+(WL.sk===k?(WL.sd>0?" ▲":" ▼"):"")+'</th>'});return h}
function wlcX(k,q,W,py,it,qf){var n=function(v,t){return'<td>'+(v>0?t:"—")+'</td>'};
if(k==="vol")return n(q.vol,dxBM(q.vol));if(k==="val")return n(W.val,dxBM(W.val));if(k==="tr")return n(W.tr,cfp(W.tr));
if(k==="fi")return n(q.fi,cfp(q.fi));if(k==="fip")return wlPct(q.fi,py,qf);if(k==="lo")return n(q.lo,cfp(q.lo));if(k==="hi")return n(q.hi,cfp(q.hi));
if(k==="thr"){var a=WL.thr[it.c]||0;return n(a,cfp(a,1)+"٪")}
if(k==="fl"){var f=WL.fl[it.c]||0;return n(f,cfp(f,1)+"٪")}return"<td>—</td>"}
function wlcRow(o,q,W,py,it,qf){var h="";wlcCols().forEach(function(k){h+=o[k]?o[k]():wlcX(k,q,W,py,it,qf)});return h}
function wlcSV(k,q,it,py){var W=WL.q[it.c]||{},n=null;
if(k==="vol")n=q.vol;else if(k==="val")n=W.val;else if(k==="tr")n=W.tr;else if(k==="fi")n=q.fi;else if(k==="fip")n=(py>0&&q.fi>0)?q.fi/py-1:null;
else if(k==="lo")n=q.lo;else if(k==="hi")n=q.hi;else if(k==="thr")n=WL.thr[it.c];else if(k==="fl")n=WL.fl[it.c];else if(k==="dv"||k==="dp"||k==="op"||k==="ov"){var hv0=wlHv(q.bl);n=k==="dv"?hv0.b:(k==="dp"?hv0.pb:(k==="op"?hv0.ps:hv0.s))}
if(k!=="fip"&&!(n>0))return null;return n}
