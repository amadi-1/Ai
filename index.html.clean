function dxUpd(){var h="";[dxChartCard,dxRetCard,(DX.ins===S.ins&&DX.O)?dxOiCard:dxOpCard].forEach(function(f){try{h+=f()}catch(e){}});DX.h=h;try{DX.hs=dxSuppCard()}catch(e){DX.hs=""}try{depthPaint()}catch(e){}}
function dxTail(){return DX.ins===S.ins?(DX.hs||""):""}
function dxSections(){if(DX.ins!==S.ins)return"";return DX.h+(DX.busy?'<div class="mut" style="text-align:center;padding:8px;font-size:12px">در حال دریافت اطلاعات تکمیلی…</div>':"")}
async function dxRun(force){var ins=S.ins;if(!ins)return;
if(DX.ins!==ins)DX={ins:ins,I:null,T:null,H:null,CT:null,U:null,O:null,OI:null,oChk:0,rg:DX.rg||"d",busy:false,t:0,h:"",hs:""};
var d=DX;if(d.busy)return;if(!force&&d.I&&Date.now()-d.t<(liveWin()?45000:900000))return;d.busy=true;
var alive=function(){return DX===d&&S.ins===ins},J=function(p){return GET(TS+p).then(function(t){return JSON.parse(t)})};
try{
// ۱) اطلاعات نماد (+ تشخیص آپشن و قیمت نماد پایه)
try{var ji=await J("Instrument/GetInstrumentInfo/"+ins);if(alive())d.I=ji.instrumentInfo||ji}catch(e){}
if(!alive())return;
if(!d.oChk||d.O){if(d.O&&liveWin())_opt=null;var o=await dxFindOpt(ins);if(o!==null){d.oChk=1;d.O=o||null}}
if(d.O&&d.O.r){var oi=dxOiKey(d.O.r,d.O.side);if(oi!=null){d.OI=oi;dxOiRec(ins,oi)}}
if(!alive())return;
var hb1=key(today)+"|"+(liveWin()?Math.floor(tehMin()):Math.floor(tehMin()/30));if(!d.OP||d.opB!==hb1){var ua1=dxOpUa();if(ua1){try{var MM1=await ofMeta(!!d.OP&&liveWin());if(alive()){d.OP=dxOpBuild(MM1,ua1);d.opB=hb1;d.opT=Date.now();var tm1=tehMin();d.opL=faD(("0"+Math.floor(tm1/60)).slice(-2)+":"+("0"+tm1%60).slice(-2));d.opErr=0}}catch(e){if(alive())d.opErr=1}}}
if(!alive())return;
if(d.O){try{var u=await dxUnder(d.O);if(alive())d.U=u}catch(e){}}
if(!alive())return;dxUpd();
// ۲) نمودار (روز: معاملات امروز)
if(d.rg==="d"){try{var jt=await J("Trade/GetTrade/"+ins);if(alive())d.T=firstArr(jt.trade||jt)}catch(e){}if(!alive())return;dxUpd()}
try{var jh=await J("ClosingPrice/GetClosingPriceDailyList/"+ins+"/400");if(alive())d.H=dxHist(firstArr(jh.closingPriceDaily||jh))}catch(e){}
if(!alive())return;dxUpd();
// ۳) ورود و خروج پول حقیقی و حقوقی
try{var jc=await J("ClientType/GetClientType/"+ins+"/1/0");if(alive())d.CT=jc.clientType||jc}catch(e){}
if(!alive())return;d.t=Date.now();
}finally{d.busy=false;if(DX===d)dxUpd()}}
