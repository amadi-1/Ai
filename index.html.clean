var hab=document.getElementById("ha");if(hab)hab.onclick=function(){var v=(document.getElementById("hn").value||"").trim();if(!/^\d{4}-\d{2}-\d{2}$/.test(v))return;S.hx=(S.hx||[]).filter(function(x){return x!==v});if(S.hol.indexOf(v)<0)S.hol.push(v);save();view()};
