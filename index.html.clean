return rows}).catch(function(e){_opt=null;throw e});return _opt}
// last traded price of an option (else closing price) from the exchange row; paired rows use _C/_P suffixes
function premium(r,side,single){var last=0,cl=0;
for(var k in r){var v=+r[k];if(!(v>0))continue;var kk=k.toLowerCase();if(/_ua$/.test(kk)||/^ua/.test(kk))continue;
var sfx=side==="c"?/(_c|call)$/.test(kk):/(_p|put)$/.test(kk);
if(!(sfx||(single&&!/(_c|_p|call|put)$/.test(kk))))continue;
if(/pdrcotval|drcot|lasttrad|lastprice/.test(kk))last=v;else if(/pclosing|closingprice/.test(kk))cl=v}
return last||cl}
// traded volume (contracts) of one side today: -1 = the row has no volume column at all
function vol(r,side,single){var a=-1;
for(var k in r){var kk=k.toLowerCase(),v=+r[k];if(r[k]===null||r[k]===""||isNaN(v)||v<0||/_ua$/.test(kk)||/^ua/.test(kk)||/avg|mean|base|multipl/.test(kk))continue;
var sfx=side==="c"?/(_c|call)$/.test(kk):/(_p|put)$/.test(kk);
if(!(sfx||(single&&!/(_c|_p|call|put)$/.test(kk))))continue;
if(/qtottran5j|tradevol|volume/.test(kk))a=Math.max(a,v)}
return a}
// yesterday's reference price of one side (to colour the last price green / red)
function yest(r,side,single){var y=0;
for(var k in r){var kk=k.toLowerCase(),v=+r[k];if(!(v>0)||/_ua$/.test(kk)||/^ua/.test(kk))continue;
