try{var cet=deep(j,"cEtaval"),cat=deep(j,"cEtavalTitle");if(cet===undefined&&ij){cet=deep(ij,"cEtaval");cat=deep(ij,"cEtavalTitle")}
var cd=String(cet==null?"":cet).trim().toUpperCase();S.stt=cat?String(cat).trim():({I:"ممنوع",IS:"ممنوع-متوقف",IG:"ممنوع-مسدود",IR:"ممنوع-محفوظ",AS:"مجاز-متوقف",AG:"مجاز-مسدود"}[cd]||cd);
S.cl=!!cd&&(cd.charAt(0)==="I"||cd==="AS"||/ممنوع|متوقف/.test(S.stt))}catch(e){S.cl=false}
try{var t=deep(ij,"staticThreshold"),mx=+t.psGelStaMax,mn=+t.psGelStaMin,r=(mx-mn)/(mx+mn);
if(mx>mn&&mn>0&&r>0.004&&r<0.25&&!S.pm){S.pct=Math.min(10,Math.max(1,Math.round(r*100)));S.pa=true}}catch(e){}
if(!S.pa&&!S.pm)ST.p="درصد تغییر از بورس دریافت نشد؛ در تنظیمات وارد کنید";
save()}
