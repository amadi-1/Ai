else if(/حقیقی\s*به\s*حقوقی/.test(p)){add(p,"(ct).Sell_I_Volume>(ct).Buy_I_Volume && (ct).Buy_N_Volume>(ct).Sell_N_Volume")}
else if(/حقوقی\s*به\s*حقیقی/.test(p)){add(p,"(ct).Buy_I_Volume>(ct).Sell_I_Volume && (ct).Sell_N_Volume>(ct).Buy_N_Volume")}
