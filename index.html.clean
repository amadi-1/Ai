var id=0,tmo=setTimeout(function(){if(id)delete _cb[id];rej(mkErr("timeout","","timeout:js"))},35000),res0=res,rej0=rej;res=function(v){clearTimeout(tmo);res0(v)};rej=function(e){clearTimeout(tmo);rej0(e)};
if(window.Android&&Android.fetch){id=++_id;_cb[id]=function(ok,b){if(ok)res(b);else{var m=/^(timeout|dns|conn|http):(.*)$/.exec(String(b));rej(mkErr(m?m[1]:"conn",(m&&m[1]==="http")?m[2]:"",String(b)))}};Android.fetch(String(id),url)}
else fetch(url).then(function(r){if(!r.ok)throw mkErr("http",r.status,"HTTP "+r.status);return r.text()}).then(res,function(e){rej(e.kind?e:mkErr("conn","",e.message))})})}
