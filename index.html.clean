function getOpts(){if(!_opt)_opt=GET(TS+"Instrument/GetInstrumentOptionMarketWatch/0").then(function(t){
var rows=firstArr(JSON.parse(t)),m={};OR=rows;
rows.forEach(function(r){var c=uaCode(r);if(!c||m[c])return;
var ns=[];for(var k in r){if(/ua/i.test(k)&&!/code|id|ins/i.test(k)&&typeof r[k]==="string"){var v=ar(r[k].trim());if(v&&!/^\d+$/.test(v))ns.push(v)}}
if(ns.length){ns.sort(function(a,b){return a.length-b.length});m[c]={c:c,n:ns[0],ns:ns}}});
var l=Object.keys(m).map(function(c){return m[c]});
