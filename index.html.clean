// ---- نمودار ----
function dxDay(){var T=DX.T;if(!T||!T.length)return null;var m={},ks=[];
T.forEach(function(t){var p=num(t.pTran),h=num(t.hEven),q=num(t.qTitTran);if(!(p>0)||!(h>0)||t.canceled==1||t.canceled===true)return;var mi=Math.floor(h/10000)*60+Math.floor(h/100)%100,o=m[mi];if(!o){o=m[mi]={v:p,q:0,n:h};ks.push(mi)}if(h>=o.n){o.v=p;o.n=h}o.q+=q});
ks.sort(function(a,b){return a-b});if(ks.length<2)return null;
return ks.map(function(mi){var o=m[mi],p=function(x){return(x<10?"0":"")+x};return{l:faD(p(Math.floor(mi/60))+":"+p(mi%60)),f:cjs(cdj(key(today)),"full")+" "+faD(p(Math.floor(mi/60))+":"+p(mi%60)),v:o.v,q:o.q}})}
function dxRange(rg){var H=DX.H;if(!H||!H.length)return null;var days={w:7,m:31,q:93,y:366}[rg],cut=key(add(today,-days)),a=H.filter(function(x){return x.d>=cut});if(a.length<2)return null;
return a.map(function(x){return{l:cjs(cdj(x.d),"md"),f:cjs(cdj(x.d),"full"),v:x.c,q:x.v}})}
var DXC=null,DXCA=false;
function dxcShow(e){var sv=document.querySelector("svg[data-dxc]");if(!sv||!DXC)return;var r=sv.getBoundingClientRect();if(!r.width)return;var D=DXC,n=D.P.length,vx=(e.clientX-r.left)/r.width*D.W,k=Math.round((vx-D.L)/(D.R-D.L)*(n-1));k=Math.max(0,Math.min(n-1,k));
var X=D.L+(n>1?k/(n-1):.5)*(D.R-D.L),Y=D.T+(D.mx-D.P[k].v)/(D.mx-D.mn)*(D.B-D.T),g=sv.querySelector("#dxcr");if(!g)return;
var t1=D.P[k].f||D.P[k].l,t2=cfp(D.P[k].v),bw=Math.max(96,t1.length*5.2+10),bx=Math.max(2,Math.min(D.W-bw-2,X-bw/2)),by=Y>52?Y-44:Y+10;
g.innerHTML='<line x1="'+X+'" x2="'+X+'" y1="'+D.T+'" y2="'+D.B+'" stroke="#3b7ea1" stroke-dasharray="3 3"/><circle cx="'+X+'" cy="'+Y+'" r="3.5" fill="#3b7ea1" stroke="#fff" stroke-width="1.5"/><rect x="'+bx+'" y="'+by+'" width="'+bw+'" height="34" rx="5" fill="#fff" stroke="#3b7ea1"/><text x="'+(bx+bw/2)+'" y="'+(by+13)+'" text-anchor="middle" font-size="9.5" fill="#444">'+t1+'</text><text x="'+(bx+bw/2)+'" y="'+(by+27)+'" text-anchor="middle" font-size="11.5" font-weight="700" fill="#111">'+t2+'</text>'}
document.addEventListener("pointerdown",function(e){if(e.target.closest&&e.target.closest("svg[data-dxc]")){DXCA=true;dxcShow(e)}});
document.addEventListener("pointermove",function(e){if(DXCA||e.pointerType==="mouse"){if(e.target.closest&&e.target.closest("svg[data-dxc]"))dxcShow(e)}});
document.addEventListener("pointerup",function(){DXCA=false});document.addEventListener("pointercancel",function(){DXCA=false});
function dxChartSvg(P,ref){var n=P.length,W=320,Ht=196,L=46,R=316,T=8,B=148,VB=190,mn=Infinity,mx=-Infinity,qm=0,i;
P.forEach(function(a){if(a.v<mn)mn=a.v;if(a.v>mx)mx=a.v;if(a.q>qm)qm=a.q});if(ref>0){mn=Math.min(mn,ref);mx=Math.max(mx,ref)}if(mx<=mn)mx=mn+1;var pd=(mx-mn)*.08;mn-=pd;mx+=pd;
var X=function(k){return L+(n>1?k/(n-1):.5)*(R-L)},Y=function(v){return T+(mx-v)/(mx-mn)*(B-T)},g="";
for(i=0;i<5;i++){var v=mn+(mx-mn)*i/4,y=Y(v);g+='<line x1="'+L+'" x2="'+R+'" y1="'+y.toFixed(1)+'" y2="'+y.toFixed(1)+'" stroke="var(--ln)"/><text x="'+(L-4)+'" y="'+(y+3).toFixed(1)+'" text-anchor="end" font-size="9" fill="var(--mut)">'+cfp(v)+'</text>'}
var bw=Math.max(1,Math.min(4,(R-L)/n*.7));
if(qm>0)P.forEach(function(a,k){var h=a.q/qm*(VB-B-6),up0=k===0||a.v>=P[k-1].v;g+='<rect x="'+(X(k)-bw/2).toFixed(1)+'" y="'+(VB-h).toFixed(1)+'" width="'+bw.toFixed(1)+'" height="'+h.toFixed(1)+'" fill="'+(up0?"var(--up)":"var(--dn)")+'" opacity=".55"/>'});
g+='<path d="'+P.map(function(a,k){return(k?"L":"M")+X(k).toFixed(1)+" "+Y(a.v).toFixed(1)}).join(" ")+'" fill="none" stroke="#3b7ea1" stroke-width="2" stroke-linejoin="round"/>';
if(ref>0){var yr=Y(ref);g+='<line x1="'+L+'" x2="'+R+'" y1="'+yr.toFixed(1)+'" y2="'+yr.toFixed(1)+'" stroke="#3b7ea1" stroke-dasharray="3 3"/><rect x="0" y="'+(yr-8).toFixed(1)+'" width="'+(L-1)+'" height="16" rx="2" fill="#3b7ea1"/><text x="'+((L-1)/2)+'" y="'+(yr+3.5).toFixed(1)+'" text-anchor="middle" font-size="9.5" fill="#fff" font-weight="700">'+cfp(ref)+'</text>'}
var ix=[0,Math.round((n-1)/3),Math.round((n-1)*2/3),n-1];ix.forEach(function(k,j){if(j&&ix[j-1]===k)return;g+='<text x="'+X(k).toFixed(1)+'" y="'+(Ht-1)+'" text-anchor="'+(j===0?"start":(j===3?"end":"middle"))+'" font-size="9" fill="var(--mut)">'+P[k].l+'</text>'});
DXC={P:P,W:W,L:L,R:R,T:T,B:B,mn:mn,mx:mx};return'<svg data-dxc="1" viewBox="0 0 '+W+' '+(Ht+4)+'" style="width:100%;height:auto;direction:ltr;display:block;touch-action:pan-y">'+g+'<g id="dxcr" pointer-events="none"></g></svg>'}
function dxLast(){var c=(DPT.ins===S.ins&&DPT.c)?DPT.c:{};return num(c.pClosing)||num(c.pDrCotVal)||num(c.priceYesterday)}
function dxChartCard(){var rg=DX.rg,B=[["d","روز"],["w","هفته"],["m","ماه"],["q","۳ ماه"],["y","سال"]],P=rg==="d"?dxDay():dxRange(rg);
var bar='<div style="display:flex;gap:6px;margin:2px 0 8px;flex-wrap:wrap">'+B.map(function(b){var on=b[0]===rg;return'<button type="button" data-dxr="'+b[0]+'" style="padding:5px 12px;font-size:12px;border-radius:9px;border:1px solid '+(on?"var(--ac)":"var(--ln)")+';background:'+(on?"var(--ac)":"var(--bg)")+';color:'+(on?"#fff":"var(--tx)")+'">'+b[1]+'</button>'}).join("")+'</div>';
var body=P?dxChartSvg(P,dxLast()):'<div class="mut" style="text-align:center;padding:22px 6px;line-height:2">'+(rg==="d"?(DX.T?"برای امروز معامله‌ی کافی برای رسم نمودار ثبت نشده است.":(DX.busy?"در حال دریافت معاملات امروز…":"داده‌ی معاملات امروز از بورس دریافت نشد؛ بازه‌ی «هفته» یا «ماه» را بزنید.")):(DX.busy&&!DX.H?"در حال دریافت…":"داده‌ی این بازه در دسترس نیست."))+'</div>';
return'<div class="card dxz"><b>نمودار</b>'+'<div style="margin-top:8px">'+bar+body+'</div></div>'}
// ---- بازدهی ----
function dxRetCard(){var H=DX.H;if(!H||!H.length)return"";var last=dxLast();if(!(last>0))return"";
function ret(days){var cut=key(add(today,-days)),b=null,i;for(i=H.length-1;i>=0;i--){if(H[i].d<=cut){b=H[i];break}}return b&&b.c>0?(last/b.c-1)*100:null}
var R=[["یک‌ماهه",ret(30)],["سه‌ماهه",ret(91)],["یک‌ساله",ret(365)]],mx=0;R.forEach(function(r){if(r[1]!=null)mx=Math.max(mx,Math.abs(r[1]))});
var rows=R.map(function(r){var v=r[1],w=(v!=null&&mx>0)?Math.max(3,Math.abs(v)/mx*100):0,pos=v!=null&&v>=0,col=pos?"var(--up)":"var(--dn)",
bar='<i style="display:block;height:100%;width:'+w+'%;background:'+col+';opacity:.38;border-radius:8px"></i>',txt=v==null?"—":dxPct(v);
return'<div style="display:flex;align-items:center;direction:ltr;gap:6px;margin:7px 0"><div style="flex:1;height:22px;background:var(--bg);border-radius:8px;display:flex;justify-content:flex-end;position:relative">'+(v!=null&&!pos?bar:"")+(v!=null&&!pos?'<b style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:12px">'+txt+'</b>':'')+'</div><div style="flex:none;width:58px;text-align:center;font-size:12px" class="mut">'+r[0]+'</div><div style="flex:1;height:22px;background:var(--bg);border-radius:8px;display:flex;justify-content:flex-start;position:relative">'+(v!=null&&pos?bar:"")+(v==null||pos?'<b style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:12px">'+txt+'</b>':'')+'</div></div>'}).join("");
return'<div class="card dxz"><b>بازدهی</b><div style="margin-top:6px">'+rows+'</div><div class="mut" style="font-size:11px;line-height:1.8">بر پایه‌ی قیمت‌های پایانی ثبت‌شده (بدون تعدیل افزایش سرمایه).</div></div>'}
// دریافت حقیقی و حقوقی: اول امروز؛ اگر امروز معامله‌ای نبود (یا بازار بسته است) آخرین جلسه از سابقه
function rlSum(o){var g=function(a,b){var v=num(deep(o,a));return v>0?v:num(deep(o,b))};return g("buy_I_Volume")+g("buy_N_Volume")+g("sell_I_Volume")+g("sell_N_Volume")}
async function rlLoad(ins){var ok=false;
try{var j=JSON.parse(await GET(TS+"ClientType/GetClientType/"+ins+"/1/0")),c=j.clientType||j;if(S.ins!==ins)return;if(rlSum(c)>0){DPT.ct=c;DPT.ctI=ins;DPT.ctD="";DPT.ctE="";ok=true}}catch(e){DPT.ctE=why(e,"حقیقی و حقوقی")}
if(!ok){try{var h=JSON.parse(await GET(TS+"ClientType/GetClientTypeHistory/"+ins)),a=firstArr(h.clientType||h).filter(function(x){return rlSum(x)>0}).sort(function(x,y){return num(y.recDate)-num(x.recDate)});if(S.ins!==ins)return;
if(a.length){DPT.ct=a[0];DPT.ctI=ins;var d=String(num(a[0].recDate));DPT.ctD=d.length===8?JD.format(new Date(+d.slice(0,4),+d.slice(4,6)-1,+d.slice(6,8))):"آخرین جلسه";DPT.ctE="";ok=true}
else if(!DPT.ctE)DPT.ctE="امروز معامله‌ای ثبت نشده است."}catch(e){if(!DPT.ctE)DPT.ctE=why(e,"حقیقی و حقوقی")}}
if(!ok){DPT.ctT=Date.now()-10000;if(DPT.ctI!==ins){DPT.ct=null;DPT.ctI=ins}}
DPT.ph="";if(tab==="w")try{depthPaint()}catch(e){}}
// ---- حقیقی و حقوقی + تحرکات حقیقی‌ها (زیر تابلوی عمق بازار) ----
var RLC={c1:0,c2:0};try{var _rl=JSON.parse(localStorage.getItem("rlc1")||"{}");RLC.c1=_rl.c1?1:0;RLC.c2=_rl.c2?1:0}catch(e){}
function rlE(v,d){return(+v).toLocaleString("en-US",{minimumFractionDigits:d||0,maximumFractionDigits:d||0})}
function rlM(v){var a=Math.abs(v);return a>=1e9?rlE(v/1e9,2)+" B":(a>=1e6?rlE(v/1e6,1)+" M":(a>=1e3?rlE(v/1e3,1)+" K":rlE(v)))}
function rlPct(v){return rlE(v,1)+'<span>%</span>'}
function rlCards(){var CT=(DPT.ctI===S.ins&&DPT.ct)?DPT.ct:(DX.ins===S.ins&&DX.CT&&rlSum(DX.CT)>0?DX.CT:null);
var chev=function(k,c){return'<span class="chev'+(c?" cl":"")+'" data-obc="'+k+'">⌃</span>'};
if(!CT)return'<div class="card rl2"><div class="rlh"><b>حقیقی و حقوقی</b></div><div class="mut" style="padding:6px 2px;font-size:12px">'+esc(DPT.ctI===S.ins&&DPT.ctE?DPT.ctE:"در حال دریافت اطلاعات حقیقی و حقوقی…")+'</div></div>';
var g=function(a,b){var v=num(deep(CT,a));return v>0||!b?v:num(deep(CT,b))},bI=g("buy_I_Volume"),bN=g("buy_N_Volume"),sI=g("sell_I_Volume"),sN=g("sell_N_Volume"),cbI=g("buy_CountI","buy_I_Count"),cbN=g("buy_CountN","buy_N_Count"),csI=g("sell_CountI","sell_I_Count"),csN=g("sell_CountN","sell_N_Count"),pr=dxLast();
var vbI=g("buy_I_Value"),vsI=g("sell_I_Value");if(!(vbI>0))vbI=bI*pr;if(!(vsI>0))vsI=sI*pr;var dl=DPT.ctI===S.ins&&DPT.ctD?DPT.ctD:"";
if(!(bI+bN+sI+sN>0))return'<div class="card rl2"><div class="rlh"><b>حقیقی و حقوقی</b></div><div class="mut" style="padding:6px 2px;font-size:12px">امروز معامله‌ای ثبت نشده است.</div></div>';var tb=bI+bN,ts=sI+sN;
var pill=function(lb,v,pc,cls){var w=Math.max(24,Math.min(100,pc));return'<div class="rlp"><div class="rlf '+cls+'" style="width:'+w.toFixed(1)+'%"><span>'+lb+'</span></div><b class="rlv">'+rlM(v)+'</b></div>'};
var sub=function(cnt,pc){return'<div class="rls"><span><span class="mut">تعداد</span> <b>'+rlE(cnt)+'</b></span><span class="mut">'+rlPct(pc)+'</span></div>'};
var col=function(t,bv,bc,sv,sc){var pb=tb>0?bv/tb*100:0,ps=ts>0?sv/ts*100:0;return'<div class="rlc"><b class="rlt" data-obc="1">'+t+'</b>'+(RLC.c1?'':pill("خرید",bv,pb,"g")+sub(bc,pb)+pill("فروش",sv,ps,"r")+sub(sc,ps))+'</div>'};
var h='<div class="card rl2">'+'<div class="rlg">'+col("حقیقی",bI,cbI,sI,csI)+col("حقوقی",bN,cbN,sN,csN)+'</div>'+chev(1,RLC.c1)+'</div>';
var ab=cbI>0?vbI/cbI/1e7:0,as=csI>0?vsI/csI/1e7:0,pw=as>0?ab/as:0,net=(vbI-vsI)/1e10,pc=pw>=1?"var(--up)":"var(--dn)",nc=net>=0?"var(--up)":"var(--dn)";
h+='<div class="card mv2"><div class="rlh"><b data-obc="2">تحرکات حقیقی‌ها</b>'+chev(2,RLC.c2)+'</div>'+(RLC.c2?'':
'<div class="mvg"><div><span class="mut">میانگین هر خرید</span><b>'+rlE(ab,ab<10?1:0)+'</b><span class="mut">میلیون تومان</span></div>'+
'<div><span class="mut">قدرت خریدار به فروشنده</span><b style="color:'+pc+'">'+rlE(pw,2)+'</b><span class="mut">'+(pw>=1?"برتری خریداران":"برتری فروشندگان")+'</span></div>'+
'<div><span class="mut">میانگین هر فروش</span><b>'+rlE(as,as<10?1:0)+'</b><span class="mut">میلیون تومان</span></div></div>'+
'<div class="mvf"><span>'+(net>=0?"ورود پول حقیقی":"خروج پول حقیقی")+'</span><span><b dir="ltr" style="color:'+nc+'">'+(net<0?"-":"")+rlE(Math.abs(net),1)+'</b> <span class="mut">میلیارد تومان</span></span><span class="inf" data-obi="1">i</span></div>')+'</div>';
return h}
document.getElementById("v").addEventListener("click",function(e){if(tab!=="w"||!e.target.closest)return;var c=e.target.closest("[data-obc]");if(c){var k="c"+c.getAttribute("data-obc");RLC[k]=RLC[k]?0:1;try{localStorage.setItem("rlc1",JSON.stringify(RLC))}catch(x){}DPT.ph="";depthPaint();return}
if(e.target.closest("[data-obi]"))showBox("تحرکات حقیقی‌ها",'<div style="line-height:2;font-size:13px;margin:6px 0"><b>میانگین هر خرید</b> = ارزش خرید حقیقی ÷ تعداد خریداران حقیقی (قیمت پایانی × حجم)، به میلیون تومان.<br><b>میانگین هر فروش</b> = ارزش فروش حقیقی ÷ تعداد فروشندگان حقیقی.<br><b>قدرت خریدار به فروشنده</b> = میانگین هر خرید ÷ میانگین هر فروش؛ بیشتر از ۱ یعنی خریدارهای حقیقی درشت‌ترند (برتری خریداران) و کمتر از ۱ یعنی فروشنده‌ها درشت‌ترند.<br><b>ورود / خروج پول حقیقی</b> = (حجم خرید حقیقی − حجم فروش حقیقی) × قیمت پایانی، به میلیارد تومان؛ مثبت یعنی پول حقیقی وارد سهم شده و منفی یعنی خارج شده.<br>درصدهای کارت حقیقی و حقوقی سهم هر گروه از کل حجم خرید (یا فروش) امروز است.</div>')});
// ---- ورود و خروج پول حقیقی و حقوقی ----
