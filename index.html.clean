h+='</div><div class="fpbot">'+(FP.ed?'<button type="button" data-fpa="new">+ فیلتر ساز جدید</button><button type="button" data-fpa="ed" class="ok">✔ پایان ویرایش</button>':'<button type="button" data-fpa="ed">✎ ویرایش فیلترها</button>')+'</div>'+(FP.ed?'':fpGuide());
return h}
function fpGuideO(){return'<div class="card fpgd" style="padding:10px;line-height:2;font-size:12px"><b style="font-size:13.5px">راهنمای فیلترهای آپشن</b>'+
'<div style="margin-top:4px"><b>اختلاف قیمت تک:</b> فاصله‌ی قیمت سرخط خرید و سرخط فروش آپشن‌های یک نماد (پیش‌فرض نمادِ کادر جستجو) را از زیاد به کم نشان می‌دهد. در «تنظیمات فیلتر» نماد، نوع قرارداد (خرید، فروش یا هر دو) و حداکثر تعداد (پیش‌فرض ۱۰) را انتخاب کنید.</div>'+
'<div style="margin-top:4px"><b>اختلاف قیمت همه:</b> همین فیلتر روی آپشن‌های همه‌ی نمادها (یا یک نماد دلخواه)؛ حداکثر تعداد پیش‌فرض ۱۵ است. نمادهایی که فقط یک طرف تابلو دارند نمی‌آیند.</div>'+
ofGuide()+
'<div style="margin-top:4px"><b>فیلتر ساز آپشن:</b> مثل «فیلتر ساز» صفحه‌ی فیلترها، ولی فقط روی نمادهای آپشن اجرا می‌شود؛ کد فیلتر یا شرط‌های ساده را بنویسید و نتیجه را «ذخیره بنام» کنید.</div>'+
'<div style="margin-top:4px"><b>اجرا:</b> ▶ فیلتر را از نو اجرا می‌کند. تا وقتی صفحه باز است هر ۵ دقیقه خودکار تازه می‌شود. بیرون از ساعت بازار، آخرین تابلوی موجود ملاک است.</div>'+
'<div class="mut" style="margin-top:4px">این فیلترها ابزار آماری‌اند و توصیه‌ی خرید یا فروش نیستند.</div></div>'}
function fpGuide(){if(tab==="j")return fpGuideO();var b=function(c,t){return'<span class="fpchip" style="'+c+'">'+t+'</span>'};
return'<div class="card fpgd" style="padding:10px;line-height:2;font-size:12px"><b style="font-size:13.5px">راهنمای صفحه‌ی فیلترها</b>'+
'<div><b>رنگ دکمه‌ها:</b></div>'+
'<div>'+b("background:#d32f2f;color:#fff","قرمز")+' فیلتر معمولی.</div>'+
'<div>'+b("background:linear-gradient(135deg,#b8860b,#e0a800);color:#fff","★ طلایی")+' فیلتر ویژه‌ی حرفه‌ای؛ چند نشانه را با هم می‌سنجد و معمولاً نتیجه‌ی کمتر ولی دقیق‌تری دارد.</div>'+
'<div>'+b("background:#0a5c1f;color:#fff","سبز")+' آخرین فیلتری که باز کرده‌اید.</div>'+
'<div>'+b("background:#fff;color:#0a5c1f;border:1px solid #0a5c1f","۱۲")+' عدد روی دکمه = تعداد نمادهای آخرین اجرای آن فیلتر.</div>'+
'<div style="margin-top:4px"><b>اجرا و به‌روزرسانی:</b> با لمس هر دکمه صفحه‌ی همان فیلتر باز می‌شود. ▶ فیلتر را از نو با داده‌ی لحظه‌ای بورس اجرا می‌کند و پاک‌کن لیست را خالی می‌کند. فیلترهای سبک (تابلو، صف، حقیقی و حقوقی) تا صفحه باز است هر ۵ دقیقه خودشان تازه می‌شوند؛ فیلترهای سنگین (سابقه‌ی قیمت، الگوها، کدال) فقط بار اول خودکار اجرا می‌شوند و بعد با ▶. اجرای سنگین‌ها ممکن است یک تا چند دقیقه طول بکشد و حدود چند مگابایت اینترنت مصرف کند؛ سابقه‌ی قیمت بین فیلترها مشترک است، پس اجرای دوم سریع‌تر است.</div>'+
'<div style="margin-top:4px"><b>تنظیمات فیلتر</b> (دکمه‌ی ⚙ پایین صفحه‌ی هر فیلتر): بازار (بورس، فرابورس، پایه، انرژی)، سخت‌گیری شرط‌ها از «خیلی ملایم» تا «خیلی سخت»، حداکثر تعداد نماد، و برای بعضی فیلترها مبلغ، درصد یا تعداد صفحه‌ی کدال. اگر فیلتری نمادی نشان نداد، سخت‌گیری را ملایم‌تر کنید.</div>'+
'<div style="margin-top:4px"><b>دو جدول هر فیلتر:</b> لمس ردیف‌های جدول بالا صفحه‌ی عمق بازار نماد را باز می‌کند و لمس ردیف‌های جدول «جزئیات» صفحه‌ی TSE نماد (یا اطلاعیه‌ی کدال) را. توضیح کامل شرط‌های هر فیلتر پایین صفحه‌ی همان فیلتر است.</div>'+
'<div style="margin-top:4px"><b>ویرایش:</b> با «✎ ویرایش فیلترها» ترتیب، نام و حذف فیلترها را تغییر دهید یا «فیلتر ساز» تازه بسازید. «فیلتر ساز» همیشه آخر فهرست است و با آن می‌توانید کد فیلتر به سبک سایت TSETMC بنویسید.</div>'+
'<div style="margin-top:4px"><b>منبع داده:</b> دیده‌بان و سابقه‌ی معاملات سایت بورس تهران (TSETMC) و اطلاعیه‌های کدال؛ بیرون از ساعت بازار، آخرین جلسه‌ی معاملاتی ملاک است. اگر VPN روشن باشد ممکن است دریافت داده انجام نشود.</div>'+
'<div class="mut" style="margin-top:4px">همه‌ی فیلترها ابزار آماری‌اند و توصیه‌ی خرید یا فروش نیستند.</div></div>'}
function fpBind(){if(!WL.lists){WL.fpe=0;var f=function(){WL.fpe=WL.lists?0:1;if(isFx())view()};wlInit().then(f,f)}}
// جابه‌جایی/حذف یک لیست؛ دیده‌بان انتخاب‌شده‌ی صفحه‌ی دیده‌بان (WL.cur) همان لیست می‌ماند
function fpSwap(i,j){var L=WL.lists,x=L[i];L[i]=L[j];L[j]=x;if(WL.cur===i)WL.cur=j;else if(WL.cur===j)WL.cur=i;if(FP.last===i)FP.last=j;else if(FP.last===j)FP.last=i}
function fpDel(i){var L=WL.lists;if(!L[i]||fpIsMain(L[i],i)||L.length<2)return;L.splice(i,1);if(WL.cur===i)WL.cur=0;else if(WL.cur>i)WL.cur--;if(FP.last===i)FP.last=-1;else if(FP.last>i)FP.last--}
document.getElementById("v").addEventListener("click",function(e){if(!isFx()||!WL.lists)return;var t=e.target;if(!t.closest)return;
var a=t.closest("[data-fpa]");if(a){var k=a.getAttribute("data-fpa");
if(k==="back"){fpClose();return}
if(FP.o)return;
if(k==="ed"){FP.ed=FP.ed?0:1;FP.del=-1;view();return}
if(k==="new"){askText("نام فیلتر ساز جدید","فیلتر ساز "+(WL.lists.filter(function(l){return l.flt==="fx1"}).length+1).toLocaleString("fa-IR"),function(nm){WL.lists.push(tab==="j"?{name:nm,flt:"fx1",opt:1,items:[],fx:{m:"and",mk:"a",c:[]}}:{name:nm,flt:"fx1",items:[],fx:{m:"and",mk:"b",c:[]}});wlSave();view()});return}
var m=/^([udnx]):(\d+)$/.exec(k);if(!m)return;var i=+m[2],L=WL.lists;if(!L[i])return;
var vis=L.map(function(l,j){return j}).filter(function(j){return!fpIsMain(L[j],j)}),p=vis.indexOf(i);
if(m[1]!=="x")FP.del=-1;
if(m[1]==="u"&&p>0)fpSwap(i,vis[p-1]);
else if(m[1]==="d"&&p>=0&&p<vis.length-1)fpSwap(i,vis[p+1]);
else if(m[1]==="n"){askText("نام فیلتر",L[i].name,function(n2){if(n2==="اصلی")return;L[i].name=n2;wlSave();view()});return}
else if(m[1]==="x"){if(FP.del===i){FP.del=-1;fpDel(i)}else{FP.del=i;view();return}}
wlSave();view();return}
if(FP.o)return;var b=t.closest("[data-fp]");if(b)fpOpen(+b.getAttribute("data-fp"))});
// لمس دوباره‌ی «فیلترها» در منو و دکمه‌ی بازگشت گوشی: از فیلتر باز شده به فهرست فیلترها
["x","o"].forEach(function(k){var b=document.querySelector('[data-t="'+k+'"]');if(b)b.addEventListener("click",function(){if(tab===(k==="o"?"j":k)&&FP.o)fpClose()})});
(function(){var ob=window.onBack;window.onBack=function(){if(isFx()&&FP.o){fpClose();return"handled"}if(isFx()&&FP.ed){FP.ed=0;FP.del=-1;view();return"handled"}return ob?ob():"exit"}})();

// ===== فیلترهای جدید (موتور مشترک nxRun): واگرایی مثبت، مستعد رشد، افزایش سرمایه، حجم مشکوک، حمایت و مقاومت،
// کاهش صف خرید/فروش، صف‌های فردا، الگوها، اختیار فروش تبعی، حق تقدم، مجمع =====
// سخت‌گیری شرط‌ها: LVZ از ۲− (خیلی ملایم) تا ۲+ (خیلی سخت)؛ G = حد «حداقل» (سخت‌تر = بزرگ‌تر)، Lm = حد «حداکثر» (سخت‌تر = کوچک‌تر)
var LVZ=0,LVF=1;function lvSetC(C){var z=+(C&&C.cfg&&C.cfg.lv)||0;LVZ=Math.max(-2,Math.min(2,z));LVF=[0.6,0.8,1,1.25,1.5][LVZ+2]}
function G(v){return v*LVF}function Lm(v){return v/LVF}
var NXH={};// کش سابقه‌ی روزانه‌ی نمادها برای امروز: {c:{k:روز,n:تعداد,a:ردیف‌ها}}
async function nxHist(c,n){var k=key(today),o=NXH[c];if(o&&o.k===k&&o.n>=n)return o.a.slice();var j=JSON.parse(await GET(TS+"ClosingPrice/GetClosingPriceDailyList/"+c+"/"+n)),a=firstArr(j.closingPriceDaily||j).slice();NXH[c]={k:k,n:n,a:a};return a.slice()}
// سری زمانی از قدیم به جدید، روز آخر = امروز (یا آخرین جلسه): {o,h,l,c,v,py}
function nxSeries(a,r){var tk=key(today);a.sort(function(x,y){return num(y.dEven)-num(x.dEven)});
var live=r.vol>0&&r.hg>0&&r.lw>0;if(live&&a.length&&(num(a[0].dEven)>=tk||num(a[0].qTotTran5J)===r.vol))a.shift();
var S=a.filter(function(q){return num(q.qTotTran5J)>0&&num(q.priceMax)>0&&num(q.pClosing)>0}).map(function(q){var c=num(q.pClosing),o=num(q.priceFirst)||c;return{o:o,h:num(q.priceMax),l:num(q.priceMin),c:c,v:num(q.qTotTran5J),py:num(q.priceYesterday)}}).reverse();
if(live)S.push({o:r.pf>0?r.pf:r.py,h:r.hg,l:r.lw,c:r.pl>0?r.pl:r.pc,v:r.vol,py:r.py,live:1});return{live:live,s:S}}
function nxRSI(c,p){var r=[],g=0,l=0,i;for(i=0;i<c.length;i++)r.push(null);if(c.length<=p)return r;for(i=1;i<=p;i++){var d=c[i]-c[i-1];if(d>0)g+=d;else l-=d}g/=p;l/=p;r[p]=l===0?100:100-100/(1+g/l);
for(i=p+1;i<c.length;i++){var e=c[i]-c[i-1];g=(g*(p-1)+(e>0?e:0))/p;l=(l*(p-1)+(e<0?-e:0))/p;r[i]=l===0?100:100-100/(1+g/l)}return r}
function nxSlope(y){var n=y.length,sx=0,sy=0,sxy=0,sxx=0;for(var i=0;i<n;i++){sx+=i;sy+=y[i];sxy+=i*y[i];sxx+=i*i}var d=n*sxx-sx*sx;return d?(n*sxy-sx*sy)/d:0}
function nxAvg(a){var s=0;a.forEach(function(x){s+=x});return a.length?s/a.length:0}
// همه‌ی ردیف‌های دیده‌بان بازار (بدون حذف حق تقدم و اختیار) برای «حق تقدم» و «اختیار فروش تبعی»
function nxRaw(t){var segs=String(t).split("@"),best=null,bn=0;segs.forEach(function(sg){var r=sg.split(";"),n=0;for(var i=0;i<Math.min(r.length,40);i++){if(r[i].split(",").length>=20)n++}if(n>bn){bn=n;best=r}});
var out=[];(best||[]).forEach(function(r){var f=r.split(",");if(f.length<21)return;out.push({c:f[0].trim(),isin:(f[1]||"").trim(),n:ar((f[2]||"").trim()),nm:ar((f[3]||"").trim()),pl:num(f[7]),pc:num(f[6]),vol:num(f[9]),val:num(f[10]),py:num(f[13]),fl:(f[17]||"").trim()})});return out}
function nxSymKey(s){return ar(String(s||"")).replace(/[‌\s]/g,"")}
// کدال: نامه‌های اخیر (مشترک بین «افزایش سرمایه» و «مجمع»، ۱۰ دقیقه کش)
var NXC={t:0,pg:0,L:[]};
async function nxCodal(pg){if(NXC.L.length&&NXC.pg>=pg&&Date.now()-NXC.t<6e5)return NXC.L;var L=[],er=0,pages=[];for(var i=1;i<=pg;i++)pages.push(i);
await pool(pages,4,async function(p){try{var j=JSON.parse(await GET(cdUrl(p,""))),a=j.Letters||firstArr(j);if(Array.isArray(a))a.forEach(function(x){L.push({s:ar(x.Symbol||""),t:ar(x.Title||""),d:pdg(x.PublishDateTime||x.SentDateTime||""),u:cdAbs(x.Url||""),no:x.TracingNo})})}catch(e){er++}},function(d){WP.msg="دریافت اطلاعیه‌های کدال… صفحه‌ی "+d.toLocaleString("fa-IR")+" از "+pg.toLocaleString("fa-IR");if(wlOn())wlPaint()});
if(!L.length&&er)throw mkErr("net",0,"codal");L.sort(function(a,b){return(b.no||0)-(a.no||0)});NXC={t:Date.now(),pg:pg,L:L};return L}
async function nxCodalPick(C,list,b,re,kind){var pg=Math.max(5,Math.min(200,+(C.cfg&&C.cfg.pg)||40)),L=await nxCodal(pg),bySym={},seen={},res=[];
b.inM.forEach(function(r){bySym[nxSymKey(r.n)]=r});
L.forEach(function(x){if(!re.test(x.t))return;var r=bySym[nxSymKey(x.s)];if(!r||seen[r.c])return;seen[r.c]=1;res.push({c:r.c,n:r.n,nm:r.nm,t:x.t,d:x.d,u:x.u,k:kind(x.t),chg:r.py>0&&r.pl>0?(r.pl/r.py-1)*100:null})});
return{res:res,dg:"اطلاعیه‌های بررسی‌شده: "+L.length.toLocaleString("fa-IR")+" (از "+pg.toLocaleString("fa-IR")+" صفحه‌ی آخر کدال)"}}
function nxOBof(raw){try{return fxOB(raw)}catch(e){return{}}}
var NX={
dv1:{name:"واگرایی مثبت",hist:70,once:1,
 pick:function(r,S){var s=S.s,n=s.length;if(n<35)return null;var C0=s.map(function(x){return x.c}),L=s.map(function(x){return x.l}),R=nxRSI(C0,14),pv=[];
 for(var i=Math.max(16,n-40);i<=n-2;i++){var ok=L[i]<=L[i-1]&&L[i]<=L[i-2]&&L[i]<=L[i+1]&&(i+2>=n||L[i]<=L[i+2]);if(ok&&R[i]!=null)pv.push(i)}
 if(pv.length<2)return null;var p2=pv[pv.length-1],p1=-1;for(var k=pv.length-2;k>=0;k--)if(p2-pv[k]>=5){p1=pv[k];break}
 if(p1<0||p2<n-6)return null;if(!(L[p2]<L[p1]&&R[p2]>R[p1]&&R[p1]<40-5*LVZ&&C0[n-1]>L[p2]))return null;
 return{rn:R[n-1],r1:R[p1],r2:R[p2],dl:(L[p2]/L[p1]-1)*100,k:R[p2]-R[p1]}},
 sort:function(a,b){return b.k-a.k},
 cols:[["RSI امروز",function(x){return cfp(x.rn,1)}],["RSI کف قبلی",function(x){return cfp(x.r1,1)}],["RSI کف جدید",function(x){return cfp(x.r2,1)}],["افت کف ٪",function(x){return cfp(Math.abs(x.dl),1)}]],
 help:"<b>این لیست چیست؟</b> واگرایی مثبت (صعودی) RSI: قیمت کف پایین‌تری از کف قبلی ساخته ولی RSI کف بالاتری ساخته است؛ یعنی فشار فروش در حال ضعیف شدن است و احتمال برگشت قیمت بیشتر می‌شود.<br><b>شرط‌ها:</b> ۱) دو کف آخر قیمت (کف = پایین‌ترین قیمت روز که از دو روز قبل و بعد پایین‌تر است) در ۴۰ روز معاملاتی اخیر، با فاصله‌ی حداقل ۵ روز. ۲) کف جدید قیمت پایین‌تر از کف قبلی و RSI ۱۴ روزه در کف جدید بالاتر از کف قبلی. ۳) RSI در کف قبلی زیر ۴۰. ۴) کف جدید در ۵ روز اخیر و قیمت فعلی بالای آن.<br><b>چیدن:</b> بیشترین اختلاف RSI دو کف بالاتر است."},
hm1:{name:"مستعد رشد",hist:70,once:1,
 pick:function(r,S){var s=S.s,n=s.length;if(n<25)return null;var t=s[n-1],o=t.o,c=t.c,h=t.h,l=t.l,rg=h-l,body=Math.abs(c-o);if(!(c>o&&rg>0&&t.py>0&&rg/t.py>=G(0.015)))return null;
 var lw=Math.min(o,c)-l,up=h-Math.max(o,c);if(!(lw>=G(2)*body&&up<=Math.max(body,rg*Lm(0.15))&&body>=rg*0.05))return null;
 var prev=s.slice(Math.max(0,n-61),n-1),sup=Math.min.apply(null,prev.map(function(x){return x.l})),s20=Math.min.apply(null,prev.slice(-20).map(function(x){return x.l}));
 var near=function(v){return l<=v*(1+Lm(0.03))&&l>=v*(1-Lm(0.03))};if(!(near(sup)||near(s20)))return null;var sp=near(s20)?s20:sup;
 return{sp:sp,ds:(c/sp-1)*100,sh:body>0?lw/body:99,k:-Math.abs(l/sp-1)}},
 sort:function(a,b){return b.k-a.k},
 cols:[["حمایت",function(x){return cfp(x.sp)}],["فاصله تا حمایت ٪",function(x){return cfp(x.ds,1)}],["سایه÷بدنه",function(x){return"×"+cfp(Math.min(x.sh,99),1)}]],
 help:"<b>این لیست چیست؟</b> نمادهایی که نزدیک خط حمایت، کندل چکش سبز ثبت کرده‌اند؛ الگویی که اغلب نشانه‌ی برگشت قیمت از حمایت است.<br><b>شرط‌ها:</b> ۱) کندل امروز سبز (آخرین قیمت بالاتر از قیمت اولین معامله). ۲) سایه‌ی پایین حداقل ۲ برابر بدنه و سایه‌ی بالا کوچک. ۳) دامنه‌ی کندل حداقل ۱٫۵٪ قیمت دیروز. ۴) کف امروز در فاصله‌ی ۳٪ از حمایت (کمترین قیمت ۲۰ یا ۶۰ روز معاملاتی قبل).<br><b>نکته:</b> کندل امروز تا پایان بازار ممکن است تغییر کند."},
ca1:{name:"افزایش سرمایه",codal:1,once:1,
 custom:async function(C,list,raw,b){return nxCodalPick(C,list,b,/افزایش\s*سرمایه/,function(t){return /ثبت|اصلاح اساسنامه/.test(t)?"ثبت":(/مجمع/.test(t)?"مجمع":(/پیشنهاد|بازرس|حسابرس/.test(t)?"پیشنهاد":(/پذیره|حق تقدم/.test(t)?"پذیره‌نویسی":"سایر")))})},
 cols:[["مرحله",function(x){return esc(x.k)}],["عنوان",function(x){return'<span style="font-size:11px;white-space:normal">'+esc(x.t)+'</span>'}],["تاریخ",function(x){return esc(String(x.d).split(" ")[0])}]],
 help:"<b>این لیست چیست؟</b> نمادهایی که اخیراً اطلاعیه‌ای درباره‌ی افزایش سرمایه در کدال منتشر کرده‌اند (پیشنهاد هیئت مدیره، گزارش بازرس، دعوت به مجمع، پذیره‌نویسی یا ثبت افزایش سرمایه).<br><b>روش:</b> آخرین صفحه‌های کدال (پیش‌فرض ۴۰ صفحه، از «تنظیمات فیلتر» قابل تغییر) خوانده و عنوان‌هایی که «افزایش سرمایه» دارند انتخاب می‌شوند. از هر نماد فقط تازه‌ترین اطلاعیه می‌آید.<br><b>لمس ردیف:</b> اطلاعیه در کدال باز می‌شود."},
mv1:{name:"حجم مشکوک",hist:40,once:1,
 pick:function(r,S){var s=S.s,n=s.length;if(n<15)return null;var p=s.slice(Math.max(0,n-31),n-1),av=nxAvg(p.map(function(x){return x.v}));if(!(av>0))return null;var k=s[n-1].v/av;if(k<G(4))return null;return{k:k,av:av,v:s[n-1].v,chg:r.py>0?((r.pl>0?r.pl:r.pc)/r.py-1)*100:0}},
 sort:function(a,b){return b.k-a.k},
 cols:[["حجم÷میانگین ماه",function(x){return"×"+cfp(x.k,1)}],["حجم امروز",function(x){return wlK(x.v)}],["میانگین ماه",function(x){return wlK(x.av)}],["درصد",function(x){return'<span style="color:'+xCol(x.chg)+';font-weight:700">'+cfp(Math.abs(x.chg),2)+'</span>'}]],
 help:"<b>این لیست چیست؟</b> نمادهایی که حجم معامله‌ی امروزشان بیشتر از ۴ برابر میانگین حجم ماهانه (۳۰ روز معاملاتی قبل) است. حجم غیرعادی اغلب نشانه‌ی خبر، ورود یا خروج پول درشت یا شروع یک حرکت است.<br><b>چیدن:</b> بیشترین نسبت حجم بالاتر است. رنگ ستون درصد جهت قیمت امروز را نشان می‌دهد."},
sr1:{name:"حمایت و مقاومت",hist:130,once:1,
 pick:function(r,S){var s=S.s,n=s.length;if(n<25)return null;var p=s[n-1].c,best=null;
 [20,60,120].forEach(function(R){if(n-1<R*0.8)return;var w=s.slice(Math.max(0,n-1-R),n-1),sp=Math.min.apply(null,w.map(function(x){return x.l})),rs=Math.max.apply(null,w.map(function(x){return x.h}));
 var ds=(p/sp-1)*100,dr=(rs/p-1)*100;if(ds>=-1&&ds<=Lm(2)&&(!best||Math.abs(ds)<Math.abs(best.d)))best={t:"حمایت",R:R,v:sp,d:ds};if(dr>=-1&&dr<=Lm(2)&&(!best||Math.abs(dr)<Math.abs(best.d)))best={t:"مقاومت",R:R,v:rs,d:dr}});
 if(!best)return null;best.k=-Math.abs(best.d);return best},
 sort:function(a,b){return b.k-a.k},
 cols:[["وضعیت",function(x){return'<span style="color:'+(x.t==="حمایت"?"var(--up)":"var(--dn)")+';font-weight:700">'+x.t+" "+x.R.toLocaleString("fa-IR")+" روزه</span>"}],["سطح",function(x){return cfp(x.v)}],["فاصله ٪",function(x){return cfp(Math.abs(x.d),1)}]],
 help:"<b>این لیست چیست؟</b> نمادهایی که قیمتشان نزدیک خط حمایت یا مقاومت در بازه‌های ۲۰، ۶۰ و ۱۲۰ روز معاملاتی است.<br><b>تعریف:</b> حمایت = کمترین قیمت بازه و مقاومت = بیشترین قیمت بازه (بدون امروز). «نزدیک» یعنی آخرین قیمت حداکثر ۲٪ بالای حمایت یا ۲٪ زیر مقاومت باشد (تا ۱٪ عبور هم پذیرفته می‌شود). اگر چند سطح نزدیک باشد، نزدیک‌ترین نشان داده می‌شود.<br><b>کاربرد:</b> نزدیک حمایت محل احتمالی برگشت و نزدیک مقاومت محل احتمالی برخورد یا شکست است."},
qg1:{name:"کاهش صف خرید",ob:1,
 pickOB:function(r,o){var qd=o.qd1||0,qo=o.qo1||0,pd=o.pd1||0;if(!(r.smx>0&&r.vol>0))return null;
 if(r.pl>=r.smx&&qd>0&&!(qo>0)&&(!(pd>0)||pd>=r.smx)){var k=qd/r.vol;if(k>=Lm(0.5))return null;return{t:"در حال کاهش",q:qd,k:k,z:o.zd1||0}}
 if(r.hg>=r.smx&&r.pl<r.smx)return{t:"صف ریخت",q:qd,k:-1,z:o.zd1||0};return null},
 sort:function(a,b){return a.k-b.k},
 cols:[["وضعیت",function(x){return'<span style="color:var(--dn);font-weight:700">'+x.t+'</span>'}],["حجم صف",function(x){return x.q>0?wlK(x.q):"—"}],["صف÷حجم امروز",function(x){return x.k>=0?cfp(x.k*100,0)+"٪":"—"}],["خریداران صف",function(x){return x.z>0?cfp(x.z):"—"}]],
 help:"<b>این لیست چیست؟</b> پیش‌بینی نمادهایی که صف خریدشان در حال از بین رفتن است.<br><b>شرط‌ها:</b> «در حال کاهش» = آخرین قیمت روی سقف مجاز و صف خرید برقرار، ولی حجم صف کمتر از نصف حجم معامله‌شده‌ی امروز است (صف دارد خورده می‌شود). «صف ریخت» = امروز قیمت به سقف رسیده ولی آخرین قیمت زیر سقف است.<br><b>منبع:</b> تابلوی سفارش‌ها در دیده‌بان بورس؛ با هر اجرا تازه می‌شود."},
qn1:{name:"کاهش صف فروش",ob:1,
 pickOB:function(r,o){var qd=o.qd1||0,qo=o.qo1||0,po=o.po1||0;if(!(r.smn>0&&r.vol>0))return null;
 if(r.pl>0&&r.pl<=r.smn&&qo>0&&!(qd>0)&&(!(po>0)||po<=r.smn)){var k=qo/r.vol;if(k>=Lm(0.5))return null;return{t:"در حال کاهش",q:qo,k:k,z:o.zo1||0}}
 if(r.lw>0&&r.lw<=r.smn&&r.pl>r.smn)return{t:"صف جمع شد",q:qo,k:-1,z:o.zo1||0};return null},
 sort:function(a,b){return a.k-b.k},
 cols:[["وضعیت",function(x){return'<span style="color:var(--up);font-weight:700">'+x.t+'</span>'}],["حجم صف",function(x){return x.q>0?wlK(x.q):"—"}],["صف÷حجم امروز",function(x){return x.k>=0?cfp(x.k*100,0)+"٪":"—"}],["فروشندگان صف",function(x){return x.z>0?cfp(x.z):"—"}]],
 help:"<b>این لیست چیست؟</b> پیش‌بینی نمادهایی که صف فروششان در حال از بین رفتن است.<br><b>شرط‌ها:</b> «در حال کاهش» = آخرین قیمت روی کف مجاز و صف فروش برقرار، ولی حجم صف کمتر از نصف حجم معامله‌شده‌ی امروز است (خریدارها صف را می‌خورند). «صف جمع شد» = امروز قیمت به کف رسیده ولی آخرین قیمت بالای کف است."},
tq1:{name:"صف‌های فردا",ob:1,
 pickOB:function(r,o){if(!(r.py>0&&r.vol>0&&r.pc>0))return null;var qd=o.qd1||0,qo=o.qo1||0;
 if(r.smx>0&&r.pl>=r.smx&&qd>0&&!(qo>0)){var gp=(r.smx-r.pc)/r.py*100,k=qd/r.vol;if(gp<=Lm(1)&&k>=G(0.3))return{t:"صف خرید",gp:gp,k:k,s:1}}
 if(r.smn>0&&r.pl>0&&r.pl<=r.smn&&qo>0&&!(qd>0)){var gn=(r.pc-r.smn)/r.py*100,kn=qo/r.vol;if(gn<=Lm(1)&&kn>=G(0.3))return{t:"صف فروش",gp:gn,k:kn,s:-1}}return null},
 sort:function(a,b){return(b.s-a.s)||(b.k-a.k)},
 cols:[["پیش‌بینی",function(x){return'<span style="color:'+(x.s>0?"var(--up)":"var(--dn)")+';font-weight:700">'+x.t+'</span>'}],["فاصله پایانی تا حد ٪",function(x){return cfp(x.gp,2)}],["صف÷حجم امروز",function(x){return"×"+cfp(x.k,1)}]],
 help:"<b>این لیست چیست؟</b> نمادهایی که احتمالاً فردا صف خرید یا فروش تشکیل می‌دهند.<br><b>شرط‌ها:</b> ۱) امروز در صف خرید (یا فروش) هستند. ۲) قیمت پایانی تا سقف (یا کف) مجاز کمتر از ۱٪ فاصله دارد؛ یعنی بیشتر معاملات روز روی صف انجام شده. ۳) حجم صف حداقل ۳۰٪ حجم معامله‌شده‌ی امروز است، یعنی صف هنوز سنگین است.<br><b>نکته:</b> نزدیک پایان بازار دقیق‌تر است و پیش‌بینی قطعی نیست."},
pt1:{name:"الگوها",hist:70,once:1,
 pick:function(r,S){var s=S.s,n=s.length;if(n<40)return null;var w=s.slice(n-20),H=w.map(function(x){return x.h}),L=w.map(function(x){return x.l}),m=nxAvg(w.map(function(x){return x.c}));if(!(m>0))return null;
 var sh=nxSlope(H)/m*100,sl=nxSlope(L)/m*100,r0=nxAvg(w.slice(0,5).map(function(x){return x.h-x.l})),r1=nxAvg(w.slice(-5).map(function(x){return x.h-x.l})),ct=r0>0?r1/r0:1,last=s[n-1].c,res=null;
 var hiW=Math.max.apply(null,H),loW=Math.min.apply(null,L);
 // پرچم صعودی: میله (رشد ≥۱۵٪ در حداکثر ۸ روز) و سپس ۵ تا ۱۰ روز استراحت کم‌دامنه
 for(var f=5;f<=10&&!res;f++){var pole=s.slice(n-1-f-8,n-1-f+1),fl=s.slice(n-f);if(pole.length<5)continue;var pl0=Math.min.apply(null,pole.map(function(x){return x.l})),ph=Math.max.apply(null,pole.map(function(x){return x.h}));
 if(!(pl0>0&&ph/pl0-1>=G(0.15)))continue;var fh=Math.max.apply(null,fl.map(function(x){return x.h})),fn=Math.min.apply(null,fl.map(function(x){return x.l}));
 if((fh-fn)<=Lm(0.5)*(ph-pl0)&&nxSlope(fl.map(function(x){return x.c}))<=0&&last>(ph+pl0)/2&&fh<=ph*1.02)res={t:"پرچم صعودی",d:"میله "+cfp((ph/pl0-1)*100,0)+"٪، استراحت "+f.toLocaleString("fa-IR")+" روز"}}
 if(!res&&sh<0&&sl<0&&sh<sl*1.3&&ct<Lm(0.7))res={t:"کنج نزولی",d:"شیب سقف‌ها "+cfp(sh,2)+"٪ و کف‌ها "+cfp(sl,2)+"٪ در روز"};
 if(!res&&ct<Lm(0.75)){if(sh<-G(0.1)&&sl>G(0.1))res={t:"مثلث متقارن",d:"سقف‌ها نزولی و کف‌ها صعودی"};else if(Math.abs(sh)<Lm(0.06)&&sl>G(0.15))res={t:"مثلث صعودی",d:"سقف‌ها افقی و کف‌ها صعودی"};else if(sh<-G(0.15)&&Math.abs(sl)<Lm(0.06))res={t:"مثلث نزولی",d:"سقف‌ها نزولی و کف‌ها افقی"}}
 if(!res)return null;res.ct=ct;res.up=hiW>0?(hiW/last-1)*100:0;res.k={"پرچم صعودی":3,"کنج نزولی":2,"مثلث صعودی":1.5,"مثلث متقارن":1,"مثلث نزولی":0.5}[res.t]-ct;return res},
 sort:function(a,b){return b.k-a.k},
 cols:[["الگو",function(x){return'<b>'+x.t+'</b>'}],["توضیح",function(x){return'<span style="font-size:11px">'+x.d+'</span>'}],["فشردگی",function(x){return cfp(x.ct*100,0)+"٪"}]],
 help:"<b>این لیست چیست؟</b> نمادهایی که در ۲۰ روز معاملاتی اخیر الگوی پرچم، کنج نزولی یا مثلث ساخته‌اند (تشخیص خودکار و تقریبی).<br><b>تعریف‌ها:</b> «پرچم صعودی» = رشد حداقل ۱۵٪ در حداکثر ۸ روز (میله) و سپس ۵ تا ۱۰ روز استراحت با دامنه‌ی کمتر از نصف میله و بدون شکست کف میله. «کنج نزولی» = سقف‌ها و کف‌ها هر دو نزولی ولی سقف‌ها تندتر پایین می‌آیند و دامنه جمع می‌شود. «مثلث» = دامنه‌ی نوسان جمع شده؛ متقارن (سقف نزولی، کف صعودی)، صعودی (سقف افقی، کف صعودی) یا نزولی (سقف نزولی، کف افقی). شیب‌ها با خط رگرسیون سقف‌ها و کف‌های روزانه محاسبه می‌شود.<br><b>فشردگی:</b> میانگین دامنه‌ی ۵ روز آخر ÷ ۵ روز اول؛ هرچه کمتر، الگو فشرده‌تر.<br><b>نکته:</b> الگو تا شکسته نشود تأیید نشده است."},
tp1:{name:"اختیار فروش تبعی",
 custom:async function(C,list,raw,b){var R=nxRaw(raw),bySym={},g={},res=[];b.inM.forEach(function(r){bySym[nxSymKey(r.n)]=r});
 R.forEach(function(x){if(!(/تبعی/.test(x.nm)||(/^ه/.test(x.n)&&/^اختیار/.test(x.nm))))return;var base=null,m=/اختیار\s*ف(?:روش)?\s*ت(?:بعی)?\s*([^\s\-]+)/.exec(x.nm);if(m&&bySym[nxSymKey(m[1])])base=bySym[nxSymKey(m[1])];
 if(!base){var s2=nxSymKey(x.n).replace(/^ه/,"").replace(/[\d۰-۹]+$/,"");if(bySym[s2])base=bySym[s2]}if(!base)return;
 var st=(/-(\d+)-/.exec(lat(x.nm))||[])[1],o=g[base.c]||(g[base.c]={c:base.c,n:base.n,nm:base.nm,ss:[],st:[],v:0,pr:base.pl>0?base.pl:base.pc});o.ss.push(x.n);if(st)o.st.push(+st);o.v+=x.vol});
 for(var k in g){var o=g[k];o.st.sort(function(a,c){return a-c});o.k=o.ss.length;res.push(o)}return{res:res,dg:"اوراق تبعی پیدا شده: "+res.reduce(function(s,x){return s+x.k},0).toLocaleString("fa-IR")}},
 sort:function(a,b){return b.v-a.v||b.k-a.k},
 cols:[["اوراق",function(x){return'<span style="font-size:11px">'+esc(x.ss.slice(0,3).join("، "))+(x.ss.length>3?" …":"")+'</span>'}],["تعداد سری",function(x){return cfp(x.k)}],["قیمت اعمال",function(x){return x.st.length?cfp(x.st[0])+(x.st.length>1&&x.st[x.st.length-1]!==x.st[0]?" تا "+cfp(x.st[x.st.length-1]):""):"—"}],["قیمت سهم",function(x){return cfp(x.pr)}],["حجم امروز",function(x){return x.v>0?wlK(x.v):"—"}]],
 help:"<b>این لیست چیست؟</b> نمادهایی که اوراق اختیار فروش تبعی (بیمه‌ی سهم) منتشر کرده‌اند و این اوراق در دیده‌بان بورس معامله می‌شود. دارنده‌ی این اوراق می‌تواند در سررسید سهم را به قیمت اعمال به ناشر بفروشد؛ پس قیمت اعمال معمولاً مثل یک کف حمایتی دیده می‌شود.<br><b>ستون‌ها:</b> نام اوراق، تعداد سری‌های فعال، بازه‌ی قیمت اعمال (از نام اوراق)، قیمت فعلی سهم و حجم معامله‌ی امروز اوراق."},
wr1:{name:"حق تقدم",
 custom:async function(C,list,raw,b){var R=nxRaw(raw),bySym={},res=[],seen={};b.inM.forEach(function(r){bySym[nxSymKey(r.n)]=r});
 R.forEach(function(x){if(!(/^ح[\s.]/.test(x.nm)||/^حق\s*تقدم/.test(x.nm)))return;var s=nxSymKey(x.n);if(!/ح$/.test(s))return;var base=bySym[s.slice(0,-1)];if(!base||seen[base.c])return;seen[base.c]=1;
 var bp=base.pl>0?base.pl:base.pc,hp=x.pl>0?x.pl:x.pc;res.push({c:base.c,n:base.n,nm:base.nm,hn:x.n,hp:hp,bp:bp,v:x.vol,hc:x.c,pm:bp>0&&hp>0?(hp+1000)/bp*100-100:null})});return{res:res,dg:"حق تقدم‌های پیدا شده: "+res.length.toLocaleString("fa-IR")}},
 sort:function(a,b){return b.v-a.v},
 cols:[["نماد حق تقدم",function(x){return'<b>'+esc(x.hn)+'</b>'}],["آخرین حق",function(x){return cfp(x.hp)}],["قیمت سهم",function(x){return cfp(x.bp)}],["حباب ٪",function(x){return x.pm==null?"—":'<span style="color:'+xCol(-x.pm)+'">'+cfp(Math.abs(x.pm),1)+'</span>'}],["حجم حق",function(x){return x.v>0?wlK(x.v):"—"}]],
 help:"<b>این لیست چیست؟</b> نمادهایی که حق تقدم (پذیره‌نویسی افزایش سرمایه) آنها در بازار عرضه شده است.<br><b>ستون‌ها:</b> نماد حق تقدم (نماد سهم + «ح»)، آخرین قیمت حق تقدم، قیمت سهم و «حباب ٪» = (قیمت حق + ۱۰۰۰ ریال آورده) ÷ قیمت سهم − ۱. حباب مثبت (قرمز) یعنی خرید حق تقدم گران‌تر از خرید خود سهم تمام می‌شود و منفی (سبز) یعنی ارزان‌تر.<br><b>نکته:</b> مبلغ آورده‌ی ۱۰۰۰ ریال برای اغلب نمادهاست؛ برای نمادهای با ارزش اسمی دیگر حباب را دستی بررسی کنید."},
as1:{name:"مجمع",codal:1,once:1,
 custom:async function(C,list,raw,b){return nxCodalPick(C,list,b,/دعوت\s*به\s*(?:برگزاری\s*)?مجمع/,function(t){return /فوق\s*العاده|فوق‌العاده/.test(t)?(/سرمایه/.test(t)?"فوق‌العاده (افزایش سرمایه)":"فوق‌العاده"):(/سالیانه|سالانه/.test(t)?"عادی سالیانه":"عادی")})},
 cols:[["نوع مجمع",function(x){return'<b>'+esc(x.k)+'</b>'}],["عنوان",function(x){return'<span style="font-size:11px;white-space:normal">'+esc(x.t)+'</span>'}],["تاریخ انتشار",function(x){return esc(String(x.d).split(" ")[0])}]],
 help:"<b>این لیست چیست؟</b> نمادهایی که به‌زودی مجمع عمومی (عادی سالیانه یا فوق‌العاده‌ی افزایش سرمایه) برگزار می‌کنند؛ یعنی «آگهی دعوت به مجمع» آنها اخیراً در کدال منتشر شده است.<br><b>روش:</b> آخرین صفحه‌های کدال (پیش‌فرض ۴۰ صفحه، از «تنظیمات فیلتر» قابل تغییر) خوانده می‌شود. تاریخ دقیق برگزاری داخل متن آگهی است؛ با لمس ردیف، آگهی در کدال باز می‌شود."}
};

// ===== فیلترهای آپشن: نمادهای اختیار خرید/فروش از دیده‌بان بورس (parseMW آن‌ها را حذف می‌کند چون نامشان عدد دارد) =====
function ocIs(n,nm){var k=String(nm||"").replace(/[‌\s]/g,"");if(/تبعی/.test(k))return false;return /^اختیار[خف]/.test(k)||(/^[ضط]/.test(String(n||""))&&/\d/.test(String(n||""))&&/اختیار/.test(k))}
function parseOptMW(t){var segs=String(t).split("@"),best=null,bn=0;segs.forEach(function(sg){var r=sg.split(";"),n=0;for(var i=0;i<Math.min(r.length,40);i++){if(r[i].split(",").length>=20)n++}if(n>bn){bn=n;best=r}});
var out=[];(best||[]).forEach(function(r){var f=r.split(",");if(f.length<21)return;var sym=ar((f[2]||"").trim()),nm=ar((f[3]||"").trim());if(!sym||!ocIs(sym,nm))return;
out.push({c:f[0].trim(),st:(f[4]||"").trim().toUpperCase(),n:sym,nm:nm,pl:num(f[7]),pc:num(f[6]),tr:num(f[8]),vol:num(f[9]),val:num(f[10]),lw:num(f[11]),hg:num(f[12]),py:num(f[13]),eps:num(f[14]),bv:num(f[15]),smx:num(f[19]),smn:num(f[20]),fl:(f[17]||"").trim(),sc:(f[18]||"").trim(),pf:num(f[5]),hv:num(f[4]),vc:num(f[16]),z:num(f[21]),yv:num(f[22])})});return out}
var NX_ORDER=["dv1","hm1","ca1","mv1","sr1","qg1","qn1","tq1","pt1","tp1","wr1","as1"];
// ===== دسته‌ی دوم فیلترها: کراس طلایی، کراس MACD، فشردگی بولینگر، سقف ۶ ماهه، پوشای صعودی، سه سرباز سفید،
// گپ صعودی، برگشت از کف مجاز، عبور از ابر ایچیموکو، خرید حقوقی =====
function nxSMA(a,p){var r=[],s=0;for(var i=0;i<a.length;i++){s+=a[i];if(i>=p)s-=a[i-p];r.push(i>=p-1?s/p:null)}return r}
function nxEMA(a,p){var r=[],k=2/(p+1),e=null;for(var i=0;i<a.length;i++){if(a[i]==null){r.push(null);continue}e=e==null?a[i]:a[i]*k+e*(1-k);r.push(e)}return r}
function nxCl(s){return s.map(function(x){return x.c})}
function nxPct(v){return'<span style="color:'+xCol(v)+';font-weight:700">'+cfp(Math.abs(v),2)+'</span>'}
function nxVr(s,n){var p=s.slice(Math.max(0,s.length-1-n),s.length-1).map(function(x){return x.v}),a=nxAvg(p);return a>0?s[s.length-1].v/a:0}
function nxHL(s,a,b){var h=0,l=1e15;for(var i=a;i<=b;i++){if(s[i].h>h)h=s[i].h;if(s[i].l<l)l=s[i].l}return(h+l)/2}
var NX2={
mc1:{name:"کراس طلایی",hist:70,once:1,
 pick:function(r,S){var s=S.s,n=s.length;if(n<55)return null;var c=nxCl(s),a=nxSMA(c,20),b=nxSMA(c,50),d=-1;
 for(var k=n-1;k>=n-Math.max(1,Math.round(3/LVF));k--)if(a[k]>b[k]&&a[k-1]!=null&&b[k-1]!=null&&a[k-1]<=b[k-1]){d=n-1-k;break}
 if(d<0||!(c[n-1]>a[n-1]))return null;return{a:a[n-1],b:b[n-1],d:d,g:(a[n-1]/b[n-1]-1)*100}},
 sort:function(x,y){return x.d-y.d||y.g-x.g},
 cols:[["MA20",function(x){return cfp(x.a)}],["MA50",function(x){return cfp(x.b)}],["روز از کراس",function(x){return x.d?x.d.toLocaleString("fa-IR"):"امروز"}]],
 help:"<b>این لیست چیست؟</b> نمادهایی که میانگین متحرک ساده‌ی ۲۰ روزه‌شان در ۳ روز معاملاتی اخیر میانگین ۵۰ روزه را از پایین به بالا قطع کرده و قیمت فعلی هم بالای میانگین ۲۰ روزه است (کراس طلایی کوتاه‌مدت).<br><b>کاربرد:</b> نشانه‌ی رایج تغییر روند از نزولی یا خنثی به صعودی.<br><b>چیدن:</b> کراس‌های تازه‌تر بالاتر می‌آیند.<br><b>محدودیت:</b> میانگین‌ها با تأخیر واکنش می‌دهند و در بازار بی‌روند سیگنال کاذب زیاد است."},
md1:{name:"کراس MACD",hist:90,once:1,
 pick:function(r,S){var s=S.s,n=s.length;if(n<45)return null;var c=nxCl(s),e1=nxEMA(c,12),e2=nxEMA(c,26),m=c.map(function(_,i){return e1[i]-e2[i]}),g=nxEMA(m,9);
 if(!(m[n-1]>g[n-1]))return null;var d=-1;for(var k=n-1;k>=n-Math.max(1,Math.round(2/LVF));k--)if(m[k]>g[k]&&m[k-1]<=g[k-1]){d=n-1-k;break}if(d<0)return null;
 return{m:m[n-1]/c[n-1]*100,z:m[n-1]<0?1:0,d:d}},
 sort:function(x,y){return y.z-x.z||x.d-y.d},
 cols:[["وضعیت",function(x){return x.z?'<b style="color:var(--up)">زیر صفر (زودهنگام)</b>':"بالای صفر"}],["MACD٪",function(x){return cfp(x.m,2)}],["روز از کراس",function(x){return x.d?x.d.toLocaleString("fa-IR"):"امروز"}]],
 help:"<b>این لیست چیست؟</b> نمادهایی که امروز یا دیروز خط MACD (اختلاف میانگین نمایی ۱۲ و ۲۶ روزه) خط سیگنال (میانگین نمایی ۹ روزه‌ی MACD) را رو به بالا قطع کرده است.<br><b>وضعیت:</b> «زیر صفر» یعنی کراس در محدوده‌ی منفی MACD رخ داده؛ معمولاً زودتر از شروع روند صعودی دیده می‌شود و بالاتر چیده می‌شود. «MACD٪» = مقدار MACD نسبت به قیمت."},
bb1:{name:"فشردگی بولینگر",hist:130,once:1,
 pick:function(r,S){var s=S.s,n=s.length;if(n<70)return null;var c=nxCl(s),bw=[],pb=0;
 for(var i=19;i<n;i++){var w=c.slice(i-19,i+1),m=nxAvg(w),sd=Math.sqrt(nxAvg(w.map(function(v){return(v-m)*(v-m)})));bw[i]=m>0?4*sd/m*100:null;if(i===n-1)pb=sd>0?(c[i]-(m-2*sd))/(4*sd)*100:50}
 var lo=1e9;for(var j=Math.max(19,n-100);j<n-1;j++)if(bw[j]!=null&&bw[j]<lo)lo=bw[j];var t=bw[n-1];if(!(t>0)||t>lo*(1+Lm(0.05))||t>Lm(15))return null;
 return{w:t,pb:pb,k:-t}},
 sort:function(x,y){return y.k-x.k},
 cols:[["پهنای باند ٪",function(x){return cfp(x.w,1)}],["جای قیمت در باند ٪",function(x){return cfp(x.pb,0)}]],
 help:"<b>این لیست چیست؟</b> نمادهایی که پهنای باند بولینگر (۲۰ روزه، ۲ انحراف معیار) امروز در کمترین حد ۱۰۰ روز اخیرشان است؛ یعنی نوسان بسیار جمع شده و معمولاً بعد از آن حرکت تندی (به هر دو جهت) شروع می‌شود.<br><b>ستون‌ها:</b> پهنای باند = فاصله‌ی باند بالا تا پایین ÷ میانگین. «جای قیمت در باند» صفر یعنی روی باند پایین و ۱۰۰ یعنی روی باند بالا؛ بالای ۵۰ یعنی قیمت در نیمه‌ی بالایی است."},
hi1:{name:"سقف ۶ ماهه",hist:130,once:1,
 pick:function(r,S){var s=S.s,n=s.length;if(n<100)return null;var t=s[n-1],pm=0;for(var i=Math.max(0,n-121);i<n-1;i++)if(s[i].h>pm)pm=s[i].h;var vr=nxVr(s,20);
 if(!(t.c>pm&&vr>=G(1)))return null;return{pm:pm,b:(t.c/pm-1)*100,vr:vr}},
 sort:function(x,y){return y.vr-x.vr},
 cols:[["سقف قبلی",function(x){return cfp(x.pm)}],["عبور ٪",function(x){return cfp(x.b,1)}],["حجم×",function(x){return"×"+cfp(x.vr,1)}]],
 help:"<b>این لیست چیست؟</b> نمادهایی که آخرین قیمتشان امروز از بالاترین قیمت ۶ ماه گذشته (۱۲۰ روز معاملاتی) بالاتر رفته و حجم امروزشان حداقل برابر میانگین ۲۰ روزه است.<br><b>کاربرد:</b> سهم‌های قوی که از محدوده‌ی عرضه‌ی چندماهه عبور کرده‌اند.<br><b>چیدن:</b> حجم نسبی بیشتر بالاتر است؛ شکست با حجم معتبرتر است."},
en1:{name:"پوشای صعودی",hist:40,once:1,
 pick:function(r,S){var s=S.s,n=s.length;if(n<10)return null;var y=s[n-2],t=s[n-1],by=y.o-y.c,bt=t.c-t.o;
 if(!(by>0&&bt>0&&t.o<=y.c&&t.c>=y.o&&bt>=G(1.2)*by))return null;var dr=(s[n-2].c/s[n-6].c-1)*100;if(dr>-G(3))return null;
 return{bt:t.py>0?bt/t.py*100:0,dr:dr,vr:nxVr(s,20)}},
 sort:function(x,y){return y.bt-x.bt},
 cols:[["بدنه امروز ٪",function(x){return cfp(x.bt,1)}],["افت ۴ روز قبل ٪",function(x){return cfp(Math.abs(x.dr),1)}],["حجم×",function(x){return"×"+cfp(x.vr,1)}]],
 help:"<b>این لیست چیست؟</b> کندل پوشای صعودی (Bullish Engulfing) بعد از یک افت: کندل دیروز قرمز، کندل امروز سبز و بدنه‌ی امروز کل بدنه‌ی دیروز را پوشانده (حداقل ۱٫۲ برابر آن). قیمت در ۴ روز قبل از امروز حداقل ۳٪ افت کرده است.<br><b>کاربرد:</b> از الگوهای شمعی برگشتی رایج؛ با حجم بالاتر معتبرتر است.<br><b>نکته:</b> کندل امروز تا پایان بازار ممکن است تغییر کند."},
ws1:{name:"سه سرباز سفید",hist:40,once:1,
 pick:function(r,S){var s=S.s,n=s.length;if(n<25)return null;for(var i=n-3;i<n;i++){var x=s[i],p=s[i-1],rg=x.h-x.l;if(!(x.c>x.o&&x.c>p.c&&rg>0&&(x.h-x.c)<=Lm(0.3)*rg&&(x.c-x.o)>=G(0.4)*rg))return null;if(i>n-3&&!(x.o>=Math.min(p.o,p.c)*0.995&&x.o<=p.c*1.005))return null}
 var ma=nxSMA(nxCl(s),20);if(!(s[n-4].c<=ma[n-4]*1.01))return null;return{g:(s[n-1].c/s[n-4].c-1)*100,vr:nxVr(s,20)}},
 sort:function(x,y){return y.vr-x.vr},
 cols:[["رشد ۳ روز ٪",function(x){return cfp(x.g,1)}],["حجم×",function(x){return"×"+cfp(x.vr,1)}]],
 help:"<b>این لیست چیست؟</b> الگوی شمعی «سه سرباز سفید»: سه کندل سبز پشت سر هم که هر کدام بالاتر از قبلی بسته شده، بدنه‌ی بلند دارد (حداقل ۴۰٪ دامنه) و نزدیک سقف روز بسته شده است؛ قیمت شروع هر کندل هم داخل بدنه‌ی کندل قبلی است. قبل از الگو قیمت زیر یا نزدیک میانگین ۲۰ روزه بوده است.<br><b>کاربرد:</b> نشانه‌ی ورود خریدار پیوسته بعد از دوره‌ی ضعف."},
gp1:{name:"گپ صعودی",hist:20,once:1,
 pick:function(r,S){var s=S.s,n=s.length;if(n<3)return null;var y=s[n-2],t=s[n-1];if(!(y.h>0&&t.o>y.h*(1+G(0.01))&&t.l>y.h))return null;return{g:(t.o/y.h-1)*100,yh:y.h,ch:t.py>0?(t.c/t.py-1)*100:0}},
 sort:function(x,y){return y.g-x.g},
 cols:[["گپ ٪",function(x){return cfp(x.g,1)}],["سقف دیروز",function(x){return cfp(x.yh)}],["آخرین ٪",function(x){return nxPct(x.ch)}]],
 help:"<b>این لیست چیست؟</b> نمادهایی که امروز با گپ صعودی باز شده‌اند: قیمت اولین معامله‌ی امروز حداقل ۱٪ بالاتر از سقف دیروز است و تا این لحظه کف امروز هم پایین‌تر از سقف دیروز نیامده (گپ پر نشده).<br><b>کاربرد:</b> گپ پرنشده نشانه‌ی تقاضای قوی است؛ اگر قیمت به زیر سقف دیروز برگردد گپ پر شده و سیگنال ضعیف می‌شود."},
lr1:{name:"برگشت از کف",ob:1,
 pickOB:function(r){if(!(r.smn>0&&r.lw>0&&r.lw<=r.smn&&r.py>0&&r.vol>0))return null;var p=r.pl>0?r.pl:r.pc;if(!(p>=r.py))return null;return{lo:(r.lw/r.py-1)*100,ch:(p/r.py-1)*100,rb:(p-r.lw)/r.py*100}},
 sort:function(x,y){return y.rb-x.rb},
 cols:[["کف روز ٪",function(x){return nxPct(x.lo)}],["آخرین ٪",function(x){return nxPct(x.ch)}],["برگشت ٪",function(x){return'<b>'+cfp(x.rb,1)+'</b>'}]],
 help:"<b>این لیست چیست؟</b> نمادهایی که امروز تا کف مجاز روزانه (صف فروش) پایین رفته‌اند ولی آخرین قیمتشان به بالای قیمت دیروز (مثبت) برگشته است؛ یعنی فروش سنگین با خرید قوی جمع شده.<br><b>چیدن:</b> بیشترین فاصله‌ی آخرین قیمت از کف روز (برگشت) بالاتر است.<br><b>منبع:</b> دیده‌بان بورس؛ با هر اجرا تازه می‌شود."},
kc1:{name:"عبور از ابر",hist:110,once:1,
 pick:function(r,S){var s=S.s,n=s.length;if(n<80)return null;var top=function(i){var j=i-26;if(j<51)return null;var a=(nxHL(s,j-8,j)+nxHL(s,j-25,j))/2,b=nxHL(s,j-51,j);return Math.max(a,b)};
 var t1=top(n-1),t0=top(n-2);if(t1==null||t0==null)return null;if(!(s[n-1].c>t1&&s[n-2].c<=t0))return null;return{t:t1,d:(s[n-1].c/t1-1)*100,vr:nxVr(s,20)}},
 sort:function(x,y){return y.vr-x.vr},
 cols:[["سقف ابر",function(x){return cfp(x.t)}],["فاصله ٪",function(x){return cfp(x.d,1)}],["حجم×",function(x){return"×"+cfp(x.vr,1)}]],
 help:"<b>این لیست چیست؟</b> نمادهایی که امروز قیمتشان از بالای ابر ایچیموکو (کومو) عبور کرده؛ دیروز داخل یا زیر ابر بوده و امروز بالای آن است.<br><b>محاسبه:</b> سنکو A = میانگین تنکان (۹) و کیجون (۲۶)، سنکو B = میانه‌ی سقف و کف ۵۲ روز؛ هر دو ۲۶ روز جلو برده می‌شوند. سقف ابر = بیشترِ این دو.<br><b>کاربرد:</b> عبور از ابر در ایچیموکو نشانه‌ی ورود به روند صعودی است؛ با حجم بیشتر معتبرتر است."},
lg1:{name:"خرید حقوقی",
 custom:async function(C,list,raw,b){WP.msg="دریافت حقیقی و حقوقی…";if(wlOn())wlPaint();var t=await getAny("/tsev2/data/ClientTypeAll.aspx"),m={},res=[];
 String(t).split(";").forEach(function(r){var f=r.split(",");if(f.length<9)return;m[f[0].trim()]={bl:num(f[4]),sl:num(f[8])}});
 b.inM.forEach(function(r){var x=m[r.c];if(!x||!(r.vol>0))return;var ln=x.bl-x.sl,p=r.pc>0?r.pc:r.pl;if(!(x.bl/r.vol>=G(0.3)&&ln/r.vol>=G(0.2)))return;res.push({c:r.c,n:r.n,nm:r.nm,bp:x.bl/r.vol*100,nv:ln*p/1e10,ch:r.py>0?((r.pl>0?r.pl:r.pc)/r.py-1)*100:0})});
 return{res:res,dg:"بررسی‌شده: "+b.inM.length.toLocaleString("fa-IR")+" نماد"}},
 sort:function(x,y){return y.nv-x.nv},
 cols:[["خرید حقوقی ٪",function(x){return cfp(x.bp,0)}],["خالص حقوقی (B)",function(x){return cfp(x.nv,1)}],["درصد",function(x){return nxPct(x.ch)}]],
 help:"<b>این لیست چیست؟</b> نمادهایی که امروز حقوقی‌ها خریدار خالص سنگین بوده‌اند: حداقل ۳۰٪ حجم معاملات را حقوقی خریده و خالص خرید حقوقی (خرید − فروش) حداقل ۲۰٪ حجم روز است.<br><b>ستون‌ها:</b> خرید حقوقی ٪ = حجم خرید حقوقی ÷ حجم روز. خالص حقوقی = (خرید − فروش حقوقی) × قیمت پایانی، به میلیارد تومان.<br><b>احتیاط:</b> صندوق‌ها و بازارگردان‌ها هم حقوقی‌اند؛ خرید بازارگردان برای حمایت از قیمت هم در این لیست دیده می‌شود."}
};
for(var _k in NX2)NX[_k]=NX2[_k];
var NX2_ORDER=["mc1","md1","bb1","hi1","en1","ws1","gp1","lr1","kc1","lg1"];NX_ORDER=NX_ORDER.concat(NX2_ORDER);
// ===== فیلترهای ویژه‌ی حرفه‌ای (ترکیب چند نشانه): VCP، رهبران بازار، انباشت پنهان، انفجار نوسان، کف دوقلو، امتیاز ترکیبی =====
// ClientTypeAll: insCode, buyCountReal, buyCountLegal, buyVolReal, buyVolLegal, sellCountReal, sellCountLegal, sellVolReal, sellVolLegal
function nxCT(t){var m={};String(t).split(";").forEach(function(r){var f=r.split(",");if(f.length<9)return;var bc=num(f[1]),bv=num(f[3]),sc=num(f[5]),sv=num(f[7]);m[f[0].trim()]={pw:(bc>0&&sc>0&&sv>0)?(bv/bc)/(sv/sc):null,net:bv-sv,bl:num(f[4]),sl:num(f[8]),slc:num(f[6]),bc:bc,sc:sc,bv:bv,sv:sv}});return m}
function nxBand(c,i){var w=c.slice(i-19,i+1),m=nxAvg(w),sd=Math.sqrt(nxAvg(w.map(function(v){return(v-m)*(v-m)})));return{m:m,sd:sd,bw:m>0?4*sd/m*100:null,up:m+2*sd}}
function nxMx(s,a,b,k){var v=k==="l"?1e15:0;for(var i=Math.max(0,a);i<=b;i++){if(k==="l"){if(s[i].l<v)v=s[i].l}else if(s[i].h>v)v=s[i].h}return v}
var NX3={
vcp1:{name:"الگوی VCP",vip:1,hist:130,once:1,
 pick:function(r,S){var s=S.s,n=s.length;if(n<110)return null;var c=nxCl(s),m50=nxSMA(c,50),m100=nxSMA(c,100),t=c[n-1];
 if(!(t>m50[n-1]&&m50[n-1]>m100[n-1]))return null;var hi=nxMx(s,n-120,n-1,"h");if(!(t>=hi*(1-Lm(0.1))))return null;
 var dp=function(a,b){var h=nxMx(s,a,b,"h"),l=nxMx(s,a,b,"l");return h>0?(h-l)/h*100:99},d1=dp(n-30,n-21),d2=dp(n-20,n-11),d3=dp(n-10,n-1);
 if(!(d1>d2&&d2>d3&&d3<=Lm(10)&&d1>=d3*G(1.5)))return null;var v10=nxAvg(s.slice(n-10).map(function(x){return x.v})),v50=nxAvg(s.slice(n-50).map(function(x){return x.v}));if(!(v50>0&&v10<v50*(1-G(0.15))))return null;
 return{d1:d1,d2:d2,d3:d3,th:(hi/t-1)*100,vd:v10/v50,k:-d3}},
 sort:function(a,b){return b.k-a.k},
 cols:[["انقباض‌ها ٪",function(x){return cfp(x.d1,0)+" ← "+cfp(x.d2,0)+" ← <b>"+cfp(x.d3,1)+"</b>"}],["تا سقف ٪",function(x){return cfp(x.th,1)}],["حجم ۱۰÷۵۰",function(x){return"×"+cfp(x.vd,2)}]],
 help:"<b>این لیست چیست؟</b> الگوی VCP (Volatility Contraction Pattern) که مارک مینروینی معرفی کرده: سهم در روند صعودی است و اصلاح‌هایش پشت سر هم کوچک‌تر می‌شود، هم‌زمان حجم خشک می‌شود؛ یعنی عرضه تمام شده و سهم برای شکست سقف آماده است.<br><b>شرط‌ها (همه با هم):</b> ۱) روند صعودی: آخرین قیمت بالای میانگین ۵۰ روزه و میانگین ۵۰ بالای میانگین ۱۰۰ روزه. ۲) قیمت حداکثر ۱۰٪ زیر سقف ۱۲۰ روزه. ۳) دامنه‌ی نوسان سه بازه‌ی ۱۰ روزه‌ی اخیر پشت سر هم کم شده، آخری حداکثر ۱۰٪ و اولی حداقل ۱٫۵ برابر آخری. ۴) میانگین حجم ۱۰ روز اخیر کمتر از ۸۵٪ میانگین ۵۰ روزه (خشک شدن حجم).<br><b>نقطه‌ی ورود کلاسیک:</b> شکست سقف آخرین انقباض با حجم بالا. <b>حد ضرر کلاسیک:</b> زیر کف آخرین انقباض."},
rl1:{name:"رهبران بازار",vip:1,hist:70,once:1,
 pick:function(r,S){var s=S.s,n=s.length;if(n<62)return null;var c=nxCl(s),m50=nxSMA(c,50),t=c[n-1];return{r20:(t/c[n-21]-1)*100,r60:(t/c[n-61]-1)*100,ok:t>m50[n-1]&&t>=nxMx(s,n-60,n-1,"h")*(1-Lm(0.07)),th:(nxMx(s,n-60,n-1,"h")/t-1)*100}},
 post:function(R){if(R.length<20)return[];var rk=function(k){var a=R.map(function(x){return x[k]}).sort(function(a,b){return a-b});R.forEach(function(x){var lo=0,hi=a.length;while(lo<hi){var md=(lo+hi)>>1;if(a[md]<x[k])lo=md+1;else hi=md}x["p"+k]=lo/(a.length-1)*99})};
 rk("r20");rk("r60");R.forEach(function(x){x.rs=x.pr20*0.4+x.pr60*0.6});return R.filter(function(x){return x.ok&&x.rs>=Math.min(97,85+5*LVZ)})},
 sort:function(a,b){return b.rs-a.rs},
 cols:[["رتبه RS",function(x){return'<b style="color:var(--up)">'+cfp(x.rs,0)+'</b>'}],["بازده ۲۰ روز ٪",function(x){return nxPct(x.r20)}],["بازده ۶۰ روز ٪",function(x){return nxPct(x.r60)}],["تا سقف ٪",function(x){return cfp(x.th,1)}]],
 help:"<b>این لیست چیست؟</b> سهم‌هایی که از نظر قدرت نسبی (Relative Strength) جزو قوی‌ترین‌های کل بازارند؛ همان روش انتخاب «رهبران» در سبک CAN SLIM.<br><b>محاسبه:</b> بازده ۲۰ و ۶۰ روز معاملاتی همه‌ی نمادهای بازار انتخابی حساب و رتبه‌ی صدکی هر نماد پیدا می‌شود. رتبه RS = ۴۰٪ رتبه‌ی ۲۰ روزه + ۶۰٪ رتبه‌ی ۶۰ روزه (۰ تا ۹۹).<br><b>شرط‌ها:</b> رتبه RS حداقل ۸۵ (بهتر از ۸۵٪ بازار)، آخرین قیمت بالای میانگین ۵۰ روزه و حداکثر ۷٪ زیر سقف ۶۰ روزه.<br><b>کاربرد:</b> در بازار صعودی، رهبران معمولاً بیشترین رشد را می‌کنند؛ در اصلاح بازار هم دیرتر و کمتر افت می‌کنند."},
ac1:{name:"انباشت پنهان",vip:1,hist:70,ct:1,once:1,
 pick:function(r,S,ct){if(!ct||!(ct.pw>=1+G(0.2))||!(ct.net>0))return null;var s=S.s,n=s.length;if(n<60)return null;
 var v10=nxAvg(s.slice(n-10).map(function(x){return x.v})),v60=nxAvg(s.slice(n-60,n-10).map(function(x){return x.v}));if(!(v60>0&&v10>=v60*(1+G(0.5))))return null;
 var h=nxMx(s,n-10,n-1,"h"),l=nxMx(s,n-10,n-1,"l"),rg=l>0?(h-l)/l*100:99;if(rg>Lm(10))return null;var t=s[n-1],ch=t.py>0?(t.c/t.py-1)*100:0;if(Math.abs(ch)>Lm(3))return null;
 return{vr:v10/v60,rg:rg,pw:ct.pw,ch:ch}},
 sort:function(a,b){return(b.vr*b.pw)-(a.vr*a.pw)},
 cols:[["حجم ۱۰ روز×",function(x){return"×"+cfp(x.vr,1)}],["دامنه ۱۰ روز ٪",function(x){return cfp(x.rg,1)}],["قدرت خریدار",function(x){return cfp(x.pw,2)}],["امروز ٪",function(x){return nxPct(x.ch)}]],
 help:"<b>این لیست چیست؟</b> ردپای «انباشت» یا جمع‌آوری آرام سهم توسط خریدار بزرگ، قبل از شروع حرکت: حجم معاملات چند روز است بالا رفته ولی قیمت هنوز در یک محدوده‌ی باریک مانده است.<br><b>شرط‌ها (همه با هم):</b> ۱) میانگین حجم ۱۰ روز اخیر حداقل ۱٫۵ برابر میانگین ۵۰ روز قبل از آن. ۲) دامنه‌ی قیمت ۱۰ روز اخیر حداکثر ۱۰٪. ۳) تغییر قیمت امروز بین ۳٪− و ۳٪+ (هنوز حرکت نکرده). ۴) امروز سرانه‌ی خرید حقیقی حداقل ۱٫۲ برابر سرانه‌ی فروش و خرید حقیقی بیشتر از فروش حقیقی.<br><b>چیدن:</b> حاصل‌ضرب حجم نسبی و قدرت خریدار؛ بزرگ‌تر بالاتر."},
sq1:{name:"انفجار نوسان",vip:1,hist:130,once:1,
 pick:function(r,S){var s=S.s,n=s.length;if(n<110)return null;var c=nxCl(s),bw=[];for(var i=19;i<n;i++)bw[i]=nxBand(c,i).bw;
 var rec=Math.min(bw[n-2],bw[n-3],bw[n-4]),old=1e9;for(var j=Math.max(19,n-100);j<n-4;j++)if(bw[j]!=null&&bw[j]<old)old=bw[j];if(!(rec<=old*(1+Lm(0.1))))return null;
 var B=nxBand(c,n-2),t=s[n-1],vr=nxVr(s,20);if(!(t.c>B.up&&vr>=1+G(1)&&t.c>t.o))return null;return{bw:rec,br:(t.c/B.up-1)*100,vr:vr}},
 sort:function(a,b){return b.vr-a.vr},
 cols:[["پهنای باند قبل ٪",function(x){return cfp(x.bw,1)}],["عبور از باند ٪",function(x){return cfp(x.br,1)}],["حجم×",function(x){return"×"+cfp(x.vr,1)}]],
 help:"<b>این لیست چیست؟</b> شکست صعودی بعد از فشردگی بولینگر (Squeeze Breakout): چند روز نوسان سهم به کمترین حد ۱۰۰ روز اخیر رسیده و امروز قیمت با حجم سنگین از باند بالای بولینگر بیرون زده است.<br><b>شرط‌ها (همه با هم):</b> ۱) کمترین پهنای باند بولینگر در ۳ روز قبل حداکثر ۱۰٪ بیشتر از کمترین پهنای ۱۰۰ روز اخیر. ۲) آخرین قیمت امروز بالای باند بالای دیروز. ۳) کندل امروز سبز. ۴) حجم امروز حداقل ۲ برابر میانگین ۲۰ روزه.<br><b>کاربرد:</b> شروع حرکت‌های تند بعد از دوره‌ی آرامش؛ تفاوتش با «فشردگی بولینگر» این است که شکست اتفاق افتاده و جهت مشخص است."},
db1:{name:"کف دوقلو",vip:1,hist:70,once:1,
 pick:function(r,S){var s=S.s,n=s.length;if(n<55)return null;var i1=-1,L1=1e15,i;for(i=n-45;i<=n-15;i++)if(s[i].l<L1){L1=s[i].l;i1=i}
 var i2=-1,L2=1e15;for(i=i1+8;i<=n-2;i++)if(s[i].l<L2){L2=s[i].l;i2=i}if(i2<0||Math.abs(L2/L1-1)>Lm(0.03))return null;
 var P=nxMx(s,i1,i2,"h");if(!(P>=Math.max(L1,L2)*(1+G(0.08))))return null;if(!(nxMx(s,i1-20,i1,"h")>=L1*(1+G(0.1))))return null;
 var t=s[n-1].c;if(!(t>=P*(1-Lm(0.03))&&t>L2*1.04))return null;return{l1:L1,l2:L2,p:P,br:t>P?1:0,d:(t/P-1)*100}},
 sort:function(a,b){return b.br-a.br||b.d-a.d},
 cols:[["کف اول",function(x){return cfp(x.l1)}],["کف دوم",function(x){return cfp(x.l2)}],["خط گردن",function(x){return cfp(x.p)}],["وضعیت",function(x){return x.br?'<b style="color:var(--up)">شکسته شد</b>':"نزدیک گردن"}]],
 help:"<b>این لیست چیست؟</b> الگوی برگشتی «کف دوقلو» (W): بعد از یک افت، قیمت دو بار به یک کف رسیده و برگشته و حالا به خط گردن (سقف بین دو کف) رسیده یا آن را شکسته است.<br><b>شرط‌ها:</b> ۱) کف اول بین ۴۵ تا ۱۵ روز معاملاتی پیش و قبل از آن حداقل ۱۰٪ افت. ۲) کف دوم حداقل ۸ روز بعد از کف اول و حداکثر ۳٪ اختلاف با آن. ۳) سقف بین دو کف (خط گردن) حداقل ۸٪ بالاتر از کف‌ها. ۴) آخرین قیمت حداکثر ۳٪ زیر خط گردن یا بالای آن.<br><b>هدف کلاسیک:</b> خط گردن + فاصله‌ی کف تا خط گردن. <b>حد ضرر کلاسیک:</b> زیر کف دوم."},
tc1:{name:"امتیاز ترکیبی",vip:1,hist:70,ct:1,once:1,
 pick:function(r,S,ct){var s=S.s,n=s.length;if(n<55)return null;var c=nxCl(s),t=s[n-1],m20=nxSMA(c,20),m50=nxSMA(c,50),e1=nxEMA(c,12),e2=nxEMA(c,26),md=c.map(function(_,i){return e1[i]-e2[i]}),sg=nxEMA(md,9),R=nxRSI(c,14),rsi=R[n-1],vr=nxVr(s,20),rg=t.h-t.l,sc=0,why=[];
 var add=function(ok,w){if(ok){sc++;why.push(w)}};
 add(t.c>m20[n-1],"بالای MA20");add(m20[n-1]>m50[n-1],"MA20>MA50");add(md[n-1]>sg[n-1],"MACD مثبت");add(rsi>=50&&rsi<=70,"RSI سالم");add(vr>=1.2,"حجم بالا");
 add(rg>0&&(t.c-t.l)/rg>=0.7,"بسته شدن نزدیک سقف");add(ct&&ct.pw>=1.2,"قدرت خریدار");add(ct&&ct.net>0,"ورود پول حقیقی");
 if(sc<Math.max(5,Math.min(8,7+LVZ)))return null;return{sc:sc,rsi:rsi,pw:ct?ct.pw:null,vr:vr,w:why}},
 sort:function(a,b){return b.sc-a.sc||b.vr-a.vr},
 cols:[["امتیاز",function(x){return'<b style="color:var(--up)">'+x.sc.toLocaleString("fa-IR")+' از ۸</b>'}],["RSI",function(x){return cfp(x.rsi,0)}],["قدرت خریدار",function(x){return x.pw==null?"—":cfp(x.pw,2)}],["حجم×",function(x){return"×"+cfp(x.vr,1)}]],
 help:"<b>این لیست چیست؟</b> به‌جای یک نشانه، ۸ نشانه‌ی مثبت روند، مومنتوم، حجم و پول با هم سنجیده می‌شود و نمادهایی که حداقل ۷ امتیاز از ۸ گرفته‌اند می‌آیند.<br><b>امتیازها (هر کدام ۱):</b> ۱) آخرین قیمت بالای میانگین ۲۰ روزه. ۲) میانگین ۲۰ بالای میانگین ۵۰ روزه. ۳) MACD بالای خط سیگنال. ۴) RSI ۱۴ روزه بین ۵۰ و ۷۰ (قوی ولی نه اشباع). ۵) حجم امروز حداقل ۱٫۲ برابر میانگین ۲۰ روزه. ۶) بسته شدن در ۳۰٪ بالایی دامنه‌ی امروز. ۷) سرانه‌ی خرید حقیقی حداقل ۱٫۲ برابر سرانه‌ی فروش. ۸) خرید حقیقی بیشتر از فروش حقیقی.<br><b>کاربرد:</b> هم‌راستایی چند نشانه، احتمال سیگنال کاذب را کمتر از هر نشانه‌ی تنها می‌کند."}
};
for(var _k3 in NX3)NX[_k3]=NX3[_k3];
var NX3_ORDER=["vcp1","rl1","ac1","sq1","db1","tc1"];NX_ORDER=NX_ORDER.concat(NX3_ORDER);
// ===== دسته‌ی چهارم: ظرفیت ورود سرمایه، صف خرید شکننده، صف‌های چندروزه، واگرایی منفی، سقف دوقلو =====
var NXCUR=null;// فیلتری که الان اجرا می‌شود (برای مبلغ تنظیم‌شده)
function nxAmt(C){var a=+(C&&C.cfg&&C.cfg.amt);return a>0?a:((C&&NX[C.flt]&&NX[C.flt].amtD)||10)}
var NX4={
cap1:{name:"ظرفیت سرمایه",amt:1,hist:40,once:1,
 pick:function(r,S){var s=S.s,n=s.length;if(n<20)return null;var p=s.slice(Math.max(0,n-31),n-1),av=nxAvg(p.map(function(x){return x.v*x.c}));if(!(av>0))return null;
 var A=nxAmt(NXCUR)*1e10,sh=A/av*100;if(sh>Lm(10))return null;return{av:av,sh:sh,d:A/(av*0.1)}},
 sort:function(a,b){return b.sh-a.sh},
 cols:[["میانگین ارزش روزانه (B)",function(x){return cfp(x.av/1e10,1)}],["سهم از معاملات روز ٪",function(x){return cfp(x.sh,1)}],["روز لازم برای ورود",function(x){return cfp(Math.max(1,x.d),1)}]],
 help:"<b>این لیست چیست؟</b> نمادهایی که می‌توان با مبلغ تعیین‌شده (پیش‌فرض ۱۰ میلیارد تومان، از «تنظیمات فیلتر» قابل تغییر) در آنها وارد شد بدون اینکه خرید شما بخش بزرگی از معاملات روزانه باشد و قیمت را جابه‌جا کند؛ یعنی ابزار تعیین اندازه‌ی پوزیشن و ریسک نقدشوندگی.<br><b>محاسبه:</b> میانگین ارزش معاملات روزانه‌ی ۳۰ روز اخیر. «سهم از معاملات روز» = مبلغ شما ÷ میانگین ارزش روزانه؛ فقط نمادهایی می‌آیند که این عدد حداکثر ۱۰٪ است. «روز لازم برای ورود» = تعداد روز لازم اگر هر روز حداکثر ۱۰٪ معاملات نماد را بخرید (در خروج هم همین‌قدر زمان لازم است).<br><b>چیدن:</b> کوچک‌ترین نمادهایی که هنوز ظرفیت مبلغ شما را دارند بالاتر می‌آیند."},
fq1:{name:"صف شکننده",amt:1,ob:1,
 pickOB:function(r,o){var qd=o.qd1||0,qo=o.qo1||0;if(!(r.smx>0&&r.vol>0&&r.pl>=r.smx&&qd>0&&!(qo>0)))return null;var qv=qd*r.smx,A=nxAmt(NXCUR)*1e10;if(qv>=A)return null;return{qv:qv,z:o.zd1||0,tv:r.vol*r.smx,k:qv/(r.vol*r.smx)}},
 sort:function(a,b){return a.qv-b.qv},
 cols:[["ارزش صف (B)",function(x){return'<b style="color:var(--dn)">'+cfp(x.qv/1e10,2)+'</b>'}],["خریداران صف",function(x){return x.z>0?cfp(x.z):"—"}],["صف÷معاملات امروز ٪",function(x){return cfp(x.k*100,0)}]],
 help:"<b>این لیست چیست؟</b> صف‌های خریدی که ارزششان از مبلغ تعیین‌شده (پیش‌فرض ۱۰ میلیارد تومان، از «تنظیمات فیلتر» قابل تغییر) کمتر است؛ یعنی یک فروشنده با همین مقدار سهم می‌تواند کل صف را بخورد و صف بریزد.<br><b>کاربرد:</b> هشدار برای کسی که پشت صف خرید ایستاده یا سهم صف‌دار دارد: صف کم‌ارزش شکننده است و ممکن است ساختگی یا هیجانی باشد. هرچه «صف÷معاملات امروز» کمتر باشد، صف زودتر تمام می‌شود.<br><b>منبع:</b> تابلوی سفارش‌ها در دیده‌بان بورس؛ با هر اجرا تازه می‌شود."},
mq1:{name:"صف چندروزه",
 custom:async function(C,list,raw,b){var OB=nxOBof(raw),cand=b.inM.filter(function(r){var o=OB[r.c]||{};return r.smx>0&&r.py>0&&r.pl>=r.smx&&(o.qd1||0)>0&&!((o.qo1||0)>0)}),res=[],er=0;
 await pool(cand,6,async function(r){var a;try{a=await nxHist(r.c,20)}catch(e){er++;return}var S=nxSeries(a,r),s=S.s,n=s.length,th=(r.smx/r.py-1)*100-0.6,k=0;
 for(var i=n-2;i>=0;i--){var x=s[i];if(x.py>0&&(x.c/x.py-1)*100>=th&&x.c>=x.h*0.995)k++;else break}
 var o=OB[r.c]||{};res.push({c:r.c,n:r.n,nm:r.nm,k:k+1,qv:(o.qd1||0)*r.smx,z:o.zd1||0,g:s.length>k+1?(r.smx/s[n-2-k].c-1)*100:null})},nfProg(cand));
 return{res:res.filter(function(x){return x.k>=2}),dg:"نمادهای در صف خرید امروز: "+cand.length.toLocaleString("fa-IR")+(er?" — خطای دریافت: "+er.toLocaleString("fa-IR"):"")}},
 sort:function(a,b){return b.k-a.k||b.qv-a.qv},
 cols:[["روزهای صف",function(x){return'<b style="color:var(--up)">'+x.k.toLocaleString("fa-IR")+' روز</b>'}],["ارزش صف امروز (B)",function(x){return cfp(x.qv/1e10,1)}],["رشد در این روزها ٪",function(x){return x.g==null?"—":cfp(x.g,1)}]],
 help:"<b>این لیست چیست؟</b> نمادهایی که امروز در صف خریدند و چند روز معاملاتی پشت سر هم روی سقف مجاز بسته شده‌اند (حداقل ۲ روز با امروز).<br><b>محاسبه:</b> روزهای قبل وقتی «صف» حساب می‌شوند که قیمت پایانی تقریباً به اندازه‌ی دامنه‌ی مجاز امروز مثبت باشد و نزدیک سقف روز بسته شده باشد.<br><b>کاربرد و احتیاط:</b> صف‌های چندروزه معمولاً خبر یا هیجان پشتشان است. هر چه روزها بیشتر و ارزش صف امروز کمتر باشد، ریسک ریختن صف و برگشت تند قیمت بیشتر است؛ «صف خرید شکننده» و «کاهش صف خرید» را هم ببینید."},
dvn1:{name:"واگرایی منفی",hist:70,once:1,
 pick:function(r,S){var s=S.s,n=s.length;if(n<35)return null;var C0=nxCl(s),H=s.map(function(x){return x.h}),R=nxRSI(C0,14),pv=[];
 for(var i=Math.max(16,n-40);i<=n-2;i++){if(H[i]>=H[i-1]&&H[i]>=H[i-2]&&H[i]>=H[i+1]&&(i+2>=n||H[i]>=H[i+2])&&R[i]!=null)pv.push(i)}
 if(pv.length<2)return null;var p2=pv[pv.length-1],p1=-1;for(var k=pv.length-2;k>=0;k--)if(p2-pv[k]>=5){p1=pv[k];break}
 if(p1<0||p2<n-6)return null;if(!(H[p2]>H[p1]&&R[p2]<R[p1]&&R[p1]>60+5*LVZ&&C0[n-1]<H[p2]))return null;
 return{rn:R[n-1],r1:R[p1],r2:R[p2],dh:(H[p2]/H[p1]-1)*100,k:R[p1]-R[p2]}},
 sort:function(a,b){return b.k-a.k},
 cols:[["RSI امروز",function(x){return cfp(x.rn,1)}],["RSI سقف قبلی",function(x){return cfp(x.r1,1)}],["RSI سقف جدید",function(x){return cfp(x.r2,1)}],["رشد سقف ٪",function(x){return cfp(x.dh,1)}]],
 help:"<b>این لیست چیست؟</b> واگرایی منفی (نزولی) RSI: قیمت سقف بالاتری از سقف قبلی ساخته ولی RSI سقف پایین‌تری ساخته؛ یعنی قدرت خریدارها در حال کم شدن است. برای تصمیم فروش یا مراقبت از سود سهم‌هایی که دارید.<br><b>شرط‌ها:</b> دو سقف آخر قیمت در ۴۰ روز اخیر با فاصله‌ی حداقل ۵ روز، سقف جدید بالاتر و RSI آن پایین‌تر، RSI سقف قبلی بالای ۶۰، سقف جدید در ۵ روز اخیر و قیمت فعلی زیر آن."},
dt1:{name:"سقف دوقلو",hist:70,once:1,
 pick:function(r,S){var s=S.s,n=s.length;if(n<55)return null;var i1=-1,H1=0,i;for(i=n-45;i<=n-15;i++)if(s[i].h>H1){H1=s[i].h;i1=i}
 var i2=-1,H2=0;for(i=i1+8;i<=n-2;i++)if(s[i].h>H2){H2=s[i].h;i2=i}if(i2<0||Math.abs(H2/H1-1)>Lm(0.03))return null;
 var V=nxMx(s,i1,i2,"l");if(!(V<=Math.min(H1,H2)*(1-G(0.08))))return null;if(!(H1>=nxMx(s,i1-20,i1,"l")*(1+G(0.1))))return null;
 var t=s[n-1].c;if(!(t<=V*(1+Lm(0.03))&&t<H2*0.96))return null;return{h1:H1,h2:H2,v:V,br:t<V?1:0}},
 sort:function(a,b){return b.br-a.br},
 cols:[["سقف اول",function(x){return cfp(x.h1)}],["سقف دوم",function(x){return cfp(x.h2)}],["خط گردن",function(x){return cfp(x.v)}],["وضعیت",function(x){return x.br?'<b style="color:var(--dn)">شکسته شد</b>':"نزدیک گردن"}]],
 help:"<b>این لیست چیست؟</b> الگوی برگشتی نزولی «سقف دوقلو» (M): بعد از یک رشد، قیمت دو بار به یک سقف رسیده و برگشته و حالا به خط گردن (کف بین دو سقف) رسیده یا آن را رو به پایین شکسته است.<br><b>شرط‌ها:</b> سقف اول بین ۴۵ تا ۱۵ روز پیش و قبل از آن حداقل ۱۰٪ رشد، سقف دوم حداقل ۸ روز بعد با حداکثر ۳٪ اختلاف، کف بین دو سقف حداقل ۸٪ پایین‌تر، و آخرین قیمت حداکثر ۳٪ بالای خط گردن یا زیر آن.<br><b>کاربرد:</b> هشدار فروش یا حد سود برای سهم‌هایی که دارید."}
};
for(var _k4 in NX4)NX[_k4]=NX4[_k4];
var NX4_ORDER=["cap1","fq1","mq1","dvn1","dt1"];NX_ORDER=NX_ORDER.concat(NX4_ORDER);
// ===== عرضه‌ی تمام‌شده (فروشنده‌ها خسته شده‌اند) + ظرفیت مبلغ شما =====
NX.se1={name:"عرضه تمام‌شده",vip:1,amt:1,hist:40,ct:1,obh:1,once:1,
 pick:function(r,S,ct,o){var s=S.s,n=s.length;if(n<25||!o)return null;var w=s.slice(n-15),up=[],dn=[];w.forEach(function(x){if(x.py>0){if(x.c>x.py)up.push(x.v);else if(x.c<x.py)dn.push(x.v)}});
 if(up.length<2||dn.length<2)return null;var ud=nxAvg(dn)/nxAvg(up);if(!(ud<=Lm(0.75)))return null;
 var l5=nxMx(s,n-5,n-1,"l"),l20=nxMx(s,n-20,n-6,"l");if(!(l5>l20))return null;
 var av=nxAvg(s.slice(Math.max(0,n-31),n-1).map(function(x){return x.v*x.c}));if(!(av>0))return null;var A=nxAmt(NXCUR)*1e10,sh=A/av*100;if(sh>Lm(20))return null;
 var sb=0;for(var i=1;i<=5;i++)sb+=(o["qo"+i]||0)*(o["po"+i]||0);var sr=sb/av*100;if(sr>Lm(30))return null;
 if(!ct||!(ct.pw>=1+0.1*LVZ))return null;var t=s[n-1];if(t.py>0&&t.c<t.py*(1-Lm(0.02)))return null;
 return{ud:ud,sr:sr,pw:ct.pw,sh:sh,k:ud+sr/100}},
 sort:function(a,b){return a.k-b.k},
 cols:[["حجم منفی÷مثبت",function(x){return'<b style="color:var(--up)">'+cfp(x.ud,2)+'</b>'}],["عرضه تابلو÷ارزش روز ٪",function(x){return cfp(x.sr,1)}],["قدرت خریدار",function(x){return cfp(x.pw,2)}],["سهم مبلغ شما ٪",function(x){return cfp(x.sh,1)}]],
 help:"<b>این لیست چیست؟</b> سهم‌هایی که نشانه‌های «تمام شدن عرضه» دارند: فروشنده‌ها خسته شده‌اند، فروش دیگر قیمت را پایین نمی‌برد و تابلوی فروش خلوت است. هم‌زمان نقدشوندگی سهم آن‌قدر هست که مبلغ شما (پیش‌فرض ۱۰ میلیارد تومان، از «تنظیمات فیلتر» قابل تغییر) فقط بخش کوچکی از معاملات روزانه باشد؛ پس خرید شما خودش قیمت را بالا نمی‌برد و در زمان فروش هم خریدار پیدا می‌کنید.<br><b>شرط‌ها (همه با هم):</b> ۱) در ۱۵ روز اخیر میانگین حجم روزهای منفی حداکثر ۷۵٪ حجم روزهای مثبت (فروش کم‌حجم، خرید پرحجم). ۲) کف ۵ روز اخیر بالاتر از کف ۱۵ روز قبل از آن (کف جدید ساخته نشده). ۳) ارزش کل سفارش‌های فروش ۵ ردیف تابلو حداکثر ۳۰٪ میانگین ارزش معاملات روزانه. ۴) امروز سرانه‌ی خرید حقیقی حداقل برابر سرانه‌ی فروش و قیمت امروز بیش از ۲٪ منفی نیست. ۵) مبلغ شما حداکثر ۲۰٪ میانگین ارزش معاملات روزانه‌ی ۳۰ روز اخیر.<br>همه‌ی این حدها با «سخت‌گیری شرط‌ها» در تنظیمات فیلتر شل یا سفت می‌شوند. اگر نمادی نیامد، اول سخت‌گیری را «ملایم» کنید یا مبلغ را کمتر کنید؛ با ۱۰ میلیارد تومان فقط سهم‌هایی جواب می‌دهند که روزانه حداقل حدود ۵۰ میلیارد تومان معامله می‌شوند.<br><b>چیدن:</b> هرچه «حجم منفی÷مثبت» و عرضه‌ی تابلو کمتر، بالاتر.<br><b>روش خرید:</b> برای اینکه خرید شما قیمت را جابه‌جا نکند، مبلغ را در چند روز و چند سفارش تقسیم کنید؛ ستون «سهم مبلغ شما» نشان می‌دهد کل مبلغ چند درصد معاملات یک روز است."};
NX_ORDER.push("se1");
// ===== تقاضای سنگین: مجموع ارزش ۵ ردیف خرید ≥ درصدی از ارزش بازار شرکت =====
function nxPctCfg(C){var v=+(C&&C.cfg&&C.cfg.pct);return v>0?v:0.5}
NX.bq5={name:"تقاضای سنگین",ob:1,pct:1,
 pickOB:function(r,o){var z=r.z,p=r.pl>0?r.pl:(r.pc>0?r.pc:r.py);if(!(z>0&&p>0))return null;var bv=0,bz=0,sv=0;for(var i=1;i<=5;i++){bv+=(o["qd"+i]||0)*(o["pd"+i]||0);bz+=o["zd"+i]||0;sv+=(o["qo"+i]||0)*(o["po"+i]||0)}
 if(!(bv>0))return null;var mc=z*p,pc=bv/mc*100;if(pc<G(nxPctCfg(NXCUR)))return null;return{bv:bv,pc:pc,mc:mc,bz:bz,sr:sv>0?bv/sv:null,q:r.smx>0&&r.pl>=r.smx}},
 sort:function(a,b){return b.pc-a.pc},
 cols:[["٪ از ارزش شرکت",function(x){return'<b style="color:var(--up)">'+cfp(x.pc,2)+'</b>'}],["ارزش ۵ ردیف خرید (B)",function(x){return cfp(x.bv/1e10,1)}],["ارزش شرکت (B)",function(x){return cfp(x.mc/1e10,0)}],["خرید÷فروش تابلو",function(x){return x.sr==null?"فقط خریدار":"×"+cfp(x.sr,1)}],["صف",function(x){return x.q?'<span style="color:var(--up)">صف خرید</span>':"—"}]],
 help:"<b>این لیست چیست؟</b> نمادهایی که مجموع ارزش سفارش‌های خرید در ۵ ردیف اول تابلو (حجم × قیمت هر ردیف) حداقل ۰٫۵٪ ارزش بازار کل شرکت (تعداد کل سهام × آخرین قیمت) است؛ یعنی تقاضای نشسته در تابلو نسبت به اندازه‌ی شرکت سنگین است. درصد مرز از «تنظیمات فیلتر» قابل تغییر است و «سخت‌گیری» هم آن را بالا و پایین می‌برد.<br><b>ستون‌ها:</b> «٪ از ارزش شرکت» = ارزش ۵ ردیف خرید ÷ ارزش بازار شرکت. «خرید÷فروش تابلو» = ارزش ۵ ردیف خرید ÷ ارزش ۵ ردیف فروش؛ بزرگ‌تر از ۱ یعنی تابلو خریدارتر است. «صف» نشان می‌دهد نماد الان در صف خرید است یا نه.<br><b>احتیاط:</b> سفارش‌های تابلو تا معامله نشوند قطعی نیستند و ممکن است حذف شوند؛ در شرکت‌های کوچک، چند سفارش درشت هم کافی است.<br><b>منبع:</b> دیده‌بان بورس (تابلوی ۵ ردیفه و تعداد سهام)؛ با هر اجرا تازه می‌شود."};
NX_ORDER.push("bq5");
// ===== سقف حقوقی: حقوقی در یک قیمت مشخص می‌فروشد و اجازه‌ی عبور نمی‌دهد (نماد در صف نیست) =====
NX.lc1={name:"سقف حقوقی",vip:1,hist:20,ct:1,obh:1,
 pick:function(r,S,ct,o){var s=S.s,n=s.length;if(n<8||!ct||!o||!S.live)return null;var t=s[n-1],p=r.pl>0?r.pl:r.pc;
 if(!(r.smx>0&&r.smn>0&&p>0&&p<r.smx*0.999&&p>r.smn*1.001))return null;// صف خرید یا فروش نیست
 if(!(r.vol>0&&ct.sl>=G(0.25)*r.vol&&ct.sl>ct.bl))return null;// فروشنده‌ی خالص حقوقی
 var L=t.h,tol=0.004,w=s.slice(Math.max(0,n-10)),tc=0,over=false;w.forEach(function(x){if(Math.abs(x.h/L-1)<=tol)tc++;if(x.h>L*(1+tol))over=true});if(over)tc=1;
 var av=nxAvg(s.slice(Math.max(0,n-21),n-1).map(function(x){return x.v})),wall=null;
 for(var i=1;i<=5;i++){var po=o["po"+i]||0,qo=o["qo"+i]||0,zo=o["zo"+i]||0;if(po>0&&qo>0&&Math.abs(po/L-1)<=tol&&av>0&&qo>=G(0.15)*av&&(zo<=0||qo/zo>=av*0.02)){wall={p:po,q:qo,z:zo};break}}
 if(!(tc>=2||wall))return null;if(!(p>=L*(1-Lm(0.025))))return null;
 return{L:L,tc:tc,wall:wall,sp:ct.sl/r.vol*100,d:(L/p-1)*100,k:(wall?2:0)+tc}},
 sort:function(a,b){return b.k-a.k||b.sp-a.sp},
 cols:[["سقف",function(x){return'<b>'+cfp(x.L)+'</b>'}],["برخورد ۱۰ روز",function(x){return x.tc.toLocaleString("fa-IR")+" بار"}],["دیوار فروش",function(x){return x.wall?wlK(x.wall.q)+(x.wall.z>0?" / "+cfp(x.wall.z)+" سفارش":""):"—"}],["فروش حقوقی ٪",function(x){return cfp(x.sp,0)}],["تا سقف ٪",function(x){return cfp(x.d,1)}]],
 help:"<b>این لیست چیست؟</b> نمادهایی که حقوقی‌ها در یک قیمت مشخص فروشنده‌اند و نمی‌گذارند قیمت از آن بالاتر برود؛ یعنی یک «سقف» یا مقاومت ساختگی که با صف خرید یا فروش فرق دارد (قیمت وسط دامنه‌ی مجاز است).<br><b>شرط‌ها:</b> ۱) نماد در صف خرید یا فروش نیست (آخرین قیمت بین کف و سقف مجاز). ۲) امروز حقوقی‌ها حداقل ۲۵٪ حجم را فروخته‌اند و فروش حقوقی از خرید حقوقی بیشتر است. ۳) سقف = بالاترین قیمت امروز؛ و یکی از این دو: الف) در ۱۰ روز معاملاتی اخیر حداقل ۲ بار قیمت به همین سقف (با تلورانس ۰٫۴٪) رسیده و هیچ روزی از آن بالاتر نرفته، یا ب) در تابلوی فروش، روی همین قیمت یک «دیوار فروش» نشسته: حجم آن ردیف حداقل ۱۵٪ میانگین حجم روزانه و میانگین حجم هر سفارش آن درشت (حداقل ۲٪ حجم روزانه؛ نشانه‌ی سفارش حقوقی). ۴) آخرین قیمت حداکثر ۲٫۵٪ زیر سقف است.<br><b>ستون‌ها:</b> سقف، تعداد روزهایی که به سقف خورده، دیوار فروش (حجم / تعداد سفارش)، درصد فروش حقوقی از حجم امروز و فاصله‌ی آخرین قیمت تا سقف.<br><b>کاربرد:</b> تا وقتی فروشنده‌ی حقوقی در آن قیمت هست، رشد سهم محدود است؛ شکسته شدن سقف با حجم بالا (تمام شدن دیوار فروش) معمولاً شروع حرکت است. «سخت‌گیری» حدهای ۲۵٪، ۱۵٪ و ۲٫۵٪ را تغییر می‌دهد.<br><b>محدودیت:</b> سایت بورس معاملات را به تفکیک قیمت و نوع خریدار نمی‌دهد؛ اینکه فروش «در همان قیمت» حقوقی بوده از ترکیب فروش حقوقی امروز، برخورد مکرر به سقف و درشتی سفارش‌های تابلو برداشت می‌شود و قطعی نیست. این فیلتر فقط در ساعت بازار معنا دارد."};
NX_ORDER.push("lc1");
// ===== شکار پول هوشمند: حجم مشکوک + ورود پول درشت حقیقی =====
NX.sm2={name:"شکار پول هوشمند",vip:1,hist:40,ct:1,once:1,
 pick:function(r,S,ct){if(!ct||!(ct.pw>0))return null;var s=S.s,n=s.length;if(n<15)return null;var t=s[n-1],p=t.c,av=nxAvg(s.slice(Math.max(0,n-31),n-1).map(function(x){return x.v}));if(!(av>0))return null;
 var vr=t.v/av;if(vr<G(3))return null;if(!(ct.pw>=1+G(0.5)))return null;var val=t.v*p,net=ct.net*p;if(!(net>=G(0.1)*val))return null;var ch=t.py>0?(p/t.py-1)*100:0;if(ch<-1)return null;
 return{vr:vr,pw:ct.pw,net:net/1e10,ch:ch,k:vr*ct.pw}},
 sort:function(a,b){return b.k-a.k},
 cols:[["حجم÷میانگین ماه",function(x){return"×"+cfp(x.vr,1)}],["قدرت خریدار",function(x){return'<b style="color:var(--up)">'+cfp(x.pw,2)+'</b>'}],["ورود پول حقیقی (B)",function(x){return cfp(x.net,1)}],["درصد",function(x){return nxPct(x.ch)}]],
 help:"<b>این لیست چیست؟</b> ترکیب «حجم مشکوک» و «ورود پول هوشمند»: نمادهایی که امروز هم حجمشان غیرعادی بالاست و هم پول درشت حقیقی واردشان شده؛ یعنی احتمالاً خریدار آگاه یا بزرگ وارد سهم شده است.<br><b>شرط‌ها (همه با هم):</b> ۱) حجم امروز حداقل ۳ برابر میانگین حجم ۳۰ روز معاملاتی قبل. ۲) قدرت خریدار حقیقی (سرانه‌ی خرید ÷ سرانه‌ی فروش) حداقل ۱٫۵. ۳) ورود پول حقیقی (خرید − فروش حقیقی × قیمت) حداقل ۱۰٪ ارزش معاملات امروز. ۴) قیمت امروز بیش از ۱٪ منفی نیست.<br><b>چیدن:</b> حاصل‌ضرب حجم نسبی و قدرت خریدار؛ بزرگ‌تر بالاتر. «سخت‌گیری» حدهای ۳ برابر، ۱٫۵ و ۱۰٪ را تغییر می‌دهد."};
// ===== ریسک صف‌سازی (برای نظارت): نمادهایی که با بودجه‌ی محدود می‌شود قیمتشان را روی سقف نگه داشت =====
NX.rq1={name:"ریسک صف‌سازی",amt:1,amtD:20,hist:40,obh:1,once:1,
 pick:function(r,S,ct,o){var s=S.s,n=s.length;if(n<20||!o)return null;var w=s.slice(Math.max(0,n-31),n-1),avv=nxAvg(w.map(function(x){return x.v*x.c}));if(!(avv>0))return null;
 var bk=0;for(var i=1;i<=5;i++){var po=o["po"+i]||0;if(po>0&&(!(r.smx>0)||po<=r.smx))bk+=(o["qo"+i]||0)*po}
 var est=Math.max(avv,bk),B=nxAmt(NXCUR)*1e10;if(est>B)return null;var th=r.smx>0&&r.py>0?(r.smx/r.py-1)*100-0.6:4.4,qd=0;
 w.forEach(function(x){if(x.py>0&&(x.c/x.py-1)*100>=th&&x.c>=x.h*0.995)qd++});
 return{avv:avv,bk:bk,est:est,dy:B/est,qd:qd,q:r.smx>0&&r.pl>=r.smx,k:qd*1000+Math.min(B/est,99)}},
 sort:function(a,b){return b.k-a.k},
 cols:[["هزینه‌ی تخمینی یک روز (B)",function(x){return'<b>'+cfp(x.est/1e10,1)+'</b>'}],["میانگین ارزش روزانه (B)",function(x){return cfp(x.avv/1e10,1)}],["عرضه تابلو (B)",function(x){return cfp(x.bk/1e10,1)}],["روز با بودجه",function(x){return cfp(Math.min(x.dy,99),1)}],["روزهای صف ۳۰ روز",function(x){return x.qd?'<b style="color:var(--dn)">'+x.qd.toLocaleString("fa-IR")+'</b>':"۰"}],["الان",function(x){return x.q?'<span style="color:var(--up)">صف خرید</span>':"—"}]],
 help:"<b>این لیست چیست؟</b> ابزار نظارتی و مدیریت ریسک: نمادهایی که نقدشوندگی‌شان آن‌قدر کم است که با بودجه‌ی تعیین‌شده (پیش‌فرض ۲۰ میلیارد تومان، از «تنظیمات فیلتر» قابل تغییر) می‌شود کل عرضه‌ی یک روز معمول را جذب کرد؛ یعنی نسبت به صف‌سازی و دستکاری قیمت آسیب‌پذیرند. برای ناظر بازار نشان می‌دهد کجا باید دقیق‌تر نگاه کرد و برای سهامدار نشان می‌دهد صف این نمادها را با احتیاط ببیند.<br><b>محاسبه:</b> «هزینه‌ی تخمینی یک روز» = بیشترِ (میانگین ارزش معاملات روزانه‌ی ۳۰ روز اخیر) و (ارزش سفارش‌های فروش ۵ ردیف تابلو تا سقف مجاز). فقط نمادهایی می‌آیند که این عدد از بودجه کمتر است. «روز با بودجه» = بودجه ÷ هزینه‌ی یک روز. «روزهای صف ۳۰ روز» = تعداد روزهایی که در ۳۰ روز معاملاتی اخیر روی سقف مجاز بسته شده‌اند (صف‌های پرتکرار در نماد کم‌نقد، نشانه‌ی قابل‌پیگیری است).<br><b>چیدن:</b> نمادهای با صف‌های پرتکرار و هزینه‌ی کمتر بالاتر می‌آیند.<br><b>محدودیت:</b> تخمین ساده است؛ هزینه‌ی واقعی به رفتار فروشنده‌ها، خبرها و سهامداران عمده بستگی دارد. صف پرتکرار به‌تنهایی دلیل دستکاری نیست و ممکن است پشتوانه‌ی بنیادی یا خبری داشته باشد."};
NX_ORDER.push("sm2","rq1");
// ===== دسته‌ی پنجم: آماده صعود، پایان اصلاح، خرید نهنگ‌ها، موج صعودی الیوت، بنیادی عالی =====
var NXI={};// کش اطلاعات نماد (EPS، P/E گروه، سود نقدی) برای امروز
async function nxInfo(c){var k=key(today),o=NXI[c];if(o&&o.k===k)return o.I;var j=JSON.parse(await GET(TS+"Instrument/GetInstrumentInfo/"+c)),I=j.instrumentInfo||j;NXI[c]={k:k,I:I};return I}
// زیگزاگ: نقاط برگشت با حداقل حرکت th (نسبت)، از قدیم به جدید: {i,p,t:"h"|"l"}
function nxZig(s,th){var P=[],dir=0,hi=s[0].h,hiI=0,lo=s[0].l,loI=0;
 for(var i=1;i<s.length;i++){var x=s[i];
  if(dir===0){if(x.h>hi){hi=x.h;hiI=i}if(x.l<lo){lo=x.l;loI=i}if(hi>=lo*(1+th)){if(loI<hiI){P.push({i:loI,p:lo,t:"l"});dir=1}else{P.push({i:hiI,p:hi,t:"h"});dir=-1}}}
  else if(dir===1){if(x.h>hi){hi=x.h;hiI=i}else if(x.l<=hi*(1-th)){P.push({i:hiI,p:hi,t:"h"});dir=-1;lo=x.l;loI=i}}
  else{if(x.l<lo){lo=x.l;loI=i}else if(x.h>=lo*(1+th)){P.push({i:loI,p:lo,t:"l"});dir=1;hi=x.h;hiI=i}}}
 P.push(dir===1?{i:hiI,p:hi,t:"h",last:1}:{i:loI,p:lo,t:"l",last:1});return P}
var NX5={
ar1:{name:"آماده صعود",vip:1,hist:70,ct:1,once:1,
 pick:function(r,S,ct){var s=S.s,n=s.length;if(n<55)return null;var c=nxCl(s),t=s[n-1],m20=nxSMA(c,20),m50=nxSMA(c,50),R=nxRSI(c,14),rsi=R[n-1];
 if(!(t.c>m20[n-1]&&m20[n-1]>m20[n-6]&&m20[n-1]>=m50[n-1]))return null;var hi=nxMx(s,n-21,n-2,"h"),ds=(hi/t.c-1)*100;if(!(ds>=0&&ds<=Lm(3)))return null;
 if(!(rsi>=50&&rsi<=65+3*-LVZ))return null;var v3=nxAvg(s.slice(n-3).map(function(x){return x.v})),v20=nxAvg(s.slice(n-23,n-3).map(function(x){return x.v}));if(!(v20>0&&v3>=v20*G(1.2)))return null;
 if(ct&&ct.pw!=null&&ct.pw<1)return null;return{hi:hi,ds:ds,rsi:rsi,vr:v3/v20,pw:ct?ct.pw:null,k:v3/v20-ds/5}},
 sort:function(a,b){return b.k-a.k},
 cols:[["مقاومت ۲۰ روز",function(x){return cfp(x.hi)}],["تا مقاومت ٪",function(x){return cfp(x.ds,1)}],["RSI",function(x){return cfp(x.rsi,0)}],["حجم ۳ روز×",function(x){return"×"+cfp(x.vr,1)}]],
 help:"<b>این لیست چیست؟</b> سهم‌هایی که در روند صعودی‌اند و درست زیر مقاومت با حجم رو به افزایش جمع شده‌اند؛ یعنی آماده‌ی شکست مقاومت و شروع موج صعودی بعدی.<br><b>شرط‌ها (همه با هم):</b> ۱) آخرین قیمت بالای میانگین ۲۰ روزه، میانگین ۲۰ رو به بالا (بالاتر از ۵ روز قبل) و بالای میانگین ۵۰. ۲) قیمت حداکثر ۳٪ زیر سقف ۲۰ روز اخیر (مقاومت). ۳) RSI بین ۵۰ و ۶۵ (قوی ولی هنوز اشباع نشده). ۴) میانگین حجم ۳ روز اخیر حداقل ۱٫۲ برابر ۲۰ روز قبل از آن. ۵) امروز قدرت خریدار حقیقی حداقل ۱.<br><b>نقطه‌ی ورود کلاسیک:</b> شکست مقاومت با حجم. <b>حد ضرر کلاسیک:</b> زیر میانگین ۲۰ روزه."},
ec1:{name:"پایان اصلاح",vip:1,hist:90,ct:1,once:1,
 pick:function(r,S,ct){var s=S.s,n=s.length;if(n<65)return null;var c=nxCl(s),t=s[n-1],hi=nxMx(s,n-61,n-1,"h"),lo=1e15,li=-1;for(var i=n-11;i<n;i++)if(s[i].l<lo){lo=s[i].l;li=i}
 var dd=(1-lo/hi)*100;if(dd<G(15))return null;if(li>n-2||li<n-10)return null;if(!(t.c>=lo*(1+G(0.04))))return null;
 var m5=nxSMA(c,5);if(!(t.c>m5[n-1]&&m5[n-1]>m5[n-2]))return null;var R=nxRSI(c,14),mr=100;for(var j=n-10;j<n;j++)if(R[j]!=null&&R[j]<mr)mr=R[j];if(!(mr<=35+5*-LVZ&&R[n-1]>=40))return null;
 if(ct&&ct.pw!=null&&ct.pw<0.9)return null;return{dd:dd,lo:lo,bk:(t.c/lo-1)*100,rsi:R[n-1],mr:mr,dy:n-1-li}},
 sort:function(a,b){return b.dd-a.dd},
 cols:[["اصلاح از سقف ٪",function(x){return cfp(x.dd,0)}],["کف اصلاح",function(x){return cfp(x.lo)}],["برگشت از کف ٪",function(x){return'<b style="color:var(--up)">'+cfp(x.bk,1)+'</b>'}],["RSI (کف←امروز)",function(x){return cfp(x.mr,0)+" ← "+cfp(x.rsi,0)}]],
 help:"<b>این لیست چیست؟</b> سهم‌هایی که بعد از یک اصلاح عمیق، کف ساخته‌اند و نشانه‌های پایان اصلاح و شروع برگشت را نشان می‌دهند.<br><b>شرط‌ها (همه با هم):</b> ۱) قیمت حداقل ۱۵٪ از سقف ۶۰ روزه افت کرده است. ۲) پایین‌ترین قیمت این اصلاح بین ۲ تا ۱۰ روز معاملاتی پیش ثبت شده (کف تازه ولی نه امروز). ۳) آخرین قیمت حداقل ۴٪ بالاتر از آن کف. ۴) قیمت بالای میانگین ۵ روزه و میانگین ۵ روزه رو به بالا. ۵) RSI در ۱۰ روز اخیر به زیر ۳۵ (اشباع فروش) رسیده و امروز دوباره بالای ۴۰ است. ۶) امروز فروشنده‌های حقیقی خیلی درشت‌تر از خریدارها نیستند (قدرت خریدار حداقل ۰٫۹).<br><b>حد ضرر کلاسیک:</b> زیر کف اصلاح."},
wh1:{name:"خرید نهنگ‌ها",vip:1,hist:40,ct:1,once:1,
 pick:function(r,S,ct){if(!ct||!(ct.bc>0)||!(ct.sc>0))return null;var s=S.s,n=s.length;if(n<15)return null;var t=s[n-1],p=t.c,ab=ct.bv*p/ct.bc/1e7,as=ct.sv*p/ct.sc/1e7;
 if(!(ab>=G(100)&&ab>=as*(1+G(1))))return null;var val=t.v*p,net=(ct.bv-ct.sv)*p;if(!(net>=G(0.2)*val))return null;var vr=nxVr(s,20);if(vr<G(1.5))return null;
 var ch=t.py>0?(p/t.py-1)*100:0,rg=t.h-t.l;if(ch<0||(rg>0&&(t.c-t.l)/rg<0.5))return null;return{ab:ab,pw:as>0?ab/as:0,net:net/1e10,vr:vr,ch:ch}},
 sort:function(a,b){return b.net-a.net},
 cols:[["سرانه خرید (م.ت)",function(x){return'<b style="color:var(--up)">'+cfp(x.ab,0)+'</b>'}],["قدرت خریدار",function(x){return cfp(x.pw,1)}],["ورود پول حقیقی (B)",function(x){return cfp(x.net,1)}],["حجم×",function(x){return"×"+cfp(x.vr,1)}]],
 help:"<b>این لیست چیست؟</b> سیگنال خرید قوی با حضور خریداران بزرگ حقیقی (نهنگ‌ها): امروز خریدهای خیلی درشت حقیقی با حجم بالا وارد سهم شده و قیمت هم مثبت مانده است.<br><b>شرط‌ها (همه با هم):</b> ۱) سرانه‌ی خرید هر خریدار حقیقی حداقل ۱۰۰ میلیون تومان. ۲) سرانه‌ی خرید حداقل ۲ برابر سرانه‌ی فروش. ۳) ورود پول حقیقی حداقل ۲۰٪ ارزش معاملات امروز. ۴) حجم امروز حداقل ۱٫۵ برابر میانگین ۲۰ روزه. ۵) قیمت امروز مثبت و آخرین قیمت در نیمه‌ی بالایی دامنه‌ی روز.<br><b>چیدن:</b> بیشترین ورود پول بالاتر.<br><b>احتیاط:</b> «نهنگ» از روی سرانه‌ی خرید برداشت می‌شود؛ ممکن است چند کد هم‌سو یا یک سهامدار عمده باشد."},
el1:{name:"موج صعودی الیوت",vip:1,hist:130,once:1,
 pick:function(r,S){var s=S.s,n=s.length;if(n<60)return null;var Z=nxZig(s,0.06*LVF);if(Z.length<4)return null;
 // آخرین سه نقطه‌ی برگشت قطعی: کف موج ۱ (L0)، سقف موج ۱ (H1)، کف موج ۲ (L2)؛ و الان قیمت بالای H1 (شروع موج ۳)
 var k=Z.length-2;if(k<2||Z[k].t!=="l"||Z[k+1].t!=="h")return null;var L2=Z[k],H1=Z[k-1],L0=Z[k-2];if(H1.t!=="h"||L0.t!=="l")return null;
 if(!L2||n-1-L2.i>25)return null;var w1=(H1.p/L0.p-1)*100;if(w1<G(10))return null;var rt=(H1.p-L2.p)/(H1.p-L0.p);if(!(L2.p>L0.p&&rt>=[0.25,0.3,0.382,0.42,0.5][LVZ+2]&&rt<=0.786))return null;
 var t=s[n-1].c,bo=(t/H1.p-1)*100;if(!(bo>0&&bo<=Lm(6)))return null;return{w1:w1,rt:rt*100,h1:H1.p,bo:bo,t1:H1.p+(H1.p-L0.p)*1.618-(H1.p-L2.p)}},
 sort:function(a,b){return a.bo-b.bo},
 cols:[["موج ۱ ٪",function(x){return cfp(x.w1,0)}],["اصلاح موج ۲ ٪",function(x){return cfp(x.rt,0)}],["سقف موج ۱",function(x){return cfp(x.h1)}],["عبور ٪",function(x){return cfp(x.bo,1)}],["هدف موج ۳",function(x){return cfp(x.t1)}]],
 help:"<b>این لیست چیست؟</b> تشخیص خودکار شروع موج ۳ الیوت (قوی‌ترین موج صعودی): بعد از یک موج ۱ صعودی و اصلاح موج ۲، قیمت تازه از سقف موج ۱ عبور کرده است.<br><b>روش:</b> نقاط برگشت قیمت با زیگزاگ ۶٪ (حرکت‌های کمتر از ۶٪ نادیده گرفته می‌شوند) پیدا می‌شود. سه نقطه‌ی آخر: کف شروع موج ۱، سقف موج ۱ و کف موج ۲.<br><b>شرط‌ها:</b> ۱) موج ۱ حداقل ۱۰٪ رشد. ۲) موج ۲ بین ۳۸٫۲٪ تا ۷۸٫۶٪ موج ۱ را اصلاح کرده و پایین‌تر از کف شروع موج ۱ نرفته (قانون الیوت). ۳) کف موج ۲ در ۲۵ روز معاملاتی اخیر. ۴) آخرین قیمت از سقف موج ۱ عبور کرده و حداکثر ۶٪ بالای آن است (شروع تازه‌ی موج ۳).<br><b>هدف موج ۳:</b> کف موج ۲ + ۱٫۶۱۸ × طول موج ۱ (هدف کلاسیک فیبوناچی). <b>حد ضرر کلاسیک:</b> زیر کف موج ۲.<br><b>محدودیت:</b> شمارش امواج الیوت تفسیری است و این تشخیص خودکار ساده‌شده است."},
fn1:{name:"بنیادی عالی",vip:1,once:1,
 custom:async function(C,list,raw,b){var cand=b.inM.filter(function(r){var p=r.pl>0?r.pl:(r.pc>0?r.pc:r.py),pe=r.eps>0?p/r.eps:0;return r.vol>0&&pe>0&&pe<=Lm(10)}),res=[],er=0;
 await pool(cand,6,async function(r){var I,a;try{I=await nxInfo(r.c);a=await nxHist(r.c,70)}catch(e){er++;return}var S=nxSeries(a,r),s=S.s,n=s.length;if(n<55)return;
 var e=I.eps||{},eps=num(e.estimatedEPS)||num(e.epsValue)||r.eps,spe=num(e.sectorPE),dps=num(e.dps)||num(I.dps),p=s[n-1].c;if(!(eps>0&&p>0))return;var pe=p/eps;
 if(pe>Lm(10))return;if(spe>0&&pe>spe*Lm(0.8))return;var c=nxCl(s),m50=nxSMA(c,50);if(!(p>m50[n-1]))return;var r20=(p/c[n-21]-1)*100;if(r20<-5)return;var dy=dps>0?dps/p*100:0;
 res.push({c:r.c,n:r.n,nm:r.nm,pe:pe,spe:spe,dy:dy,r20:r20,k:(spe>0?pe/spe:pe/10)-dy/100})},nfProg(cand));
 return{res:res,dg:"نمادهای با P/E مثبت و کمتر از ۱۰: "+cand.length.toLocaleString("fa-IR")+(er?" — خطای دریافت: "+er.toLocaleString("fa-IR"):"")}},
 sort:function(a,b){return a.k-b.k},
 cols:[["P/E",function(x){return'<b style="color:var(--up)">'+cfp(x.pe,1)+'</b>'}],["P/E گروه",function(x){return x.spe>0?cfp(x.spe,1):"—"}],["بازده سود نقدی ٪",function(x){return x.dy>0?cfp(x.dy,1):"—"}],["بازده ۲۰ روز ٪",function(x){return nxPct(x.r20)}]],
 help:"<b>این لیست چیست؟</b> سهم‌های ارزان با بنیاد خوب که روند قیمتشان هم تأیید می‌کند (ترکیب بنیادی و تکنیکال برای اطمینان بیشتر).<br><b>شرط‌های بنیادی:</b> ۱) EPS (سود هر سهم پیش‌بینی‌شده) مثبت. ۲) P/E حداکثر ۱۰. ۳) P/E حداقل ۲۰٪ کمتر از P/E گروه صنعت. <b>شرط‌های تکنیکال:</b> ۴) آخرین قیمت بالای میانگین ۵۰ روزه. ۵) بازده ۲۰ روز اخیر بدتر از ۵٪− نباشد.<br><b>چیدن:</b> کمترین نسبت P/E به P/E گروه و بیشترین بازده سود نقدی بالاتر.<br><b>محدودیت:</b> EPS و سود نقدی از اطلاعات نماد در سایت بورس است و ممکن است قدیمی باشد؛ گزارش‌های کدال (فعالیت ماهانه، صورت‌های مالی) را هم بررسی کنید. «سخت‌گیری» حدهای ۱۰ و ۲۰٪ را تغییر می‌دهد."}
};
