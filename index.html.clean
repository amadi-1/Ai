<script>
// ===== v129 =====
(function(){var d0=depthPaint;depthPaint=function(){d0();try{if(tab==="w"){var v=document.getElementById("v");if(v)enhSel(v)}}catch(e){}}})();
document.addEventListener("change",function(e){var t=e.target;if(tab!=="w"||!t||!t.hasAttribute||!t.hasAttribute("data-dxsel"))return;DX.os=t.value;dxUpd()});

// ===== v130: جابه‌جایی بخش‌ها با نگه‌داشتن (بالا/پایین) =====
(function(){
var LS="cord1:",busy=0,drag=null,pend=null,sup=0,lastY=0,scr=0,V=null;
function gv(){return V||(V=document.getElementById("v"))}
function ckey(c){var b=c.querySelector("b,h1,h2,h3,h4,.cth,.ctt"),x=(b?b.textContent:c.textContent)||"";x=x.replace(/[0-9\u06F0-\u06F9\u0660-\u0669.,:%\/\-+]/g,"").replace(/\s+/g," ").trim().slice(0,32);return x}
function cards(){var v=gv();if(!v)return[];var a=[],seen={};Array.prototype.forEach.call(v.querySelectorAll(".card"),function(c){if(c.parentElement&&c.parentElement.closest(".card"))return;var k=ckey(c);if(!k)return;seen[k]=(seen[k]||0)+1;c._ck=k+(seen[k]>1?"#"+seen[k]:"");a.push(c)});return a}
function getO(){try{return JSON.parse(localStorage.getItem(LS+tab)||"[]")||[]}catch(e){return[]}}
function saveO(){try{localStorage.setItem(LS+tab,JSON.stringify(cards().map(function(c){return c._ck})))}catch(e){}}
function apply(){if(drag)return;var o=getO();if(!o.length)return;var cs=cards(),g=[];cs.forEach(function(c){var r=o.indexOf(c._ck);if(r<0)return;var f=null;for(var i=0;i<g.length;i++)if(g[i].p===c.parentElement){f=g[i];break}if(!f){f={p:c.parentElement,l:[]};g.push(f)}f.l.push({c:c,r:r})});
var did=0;g.forEach(function(f){var cur=f.l.map(function(x){return x.c}),srt=f.l.slice().sort(function(a,b){return a.r-b.r}).map(function(x){return x.c}),same=true;for(var i=0;i<cur.length;i++)if(cur[i]!==srt[i]){same=false;break}if(same)return;
var mk=cur.map(function(c){var m=document.createComment("");c.parentNode.replaceChild(m,c);return m});mk.forEach(function(m,i){m.parentNode.replaceChild(srt[i],m)});did=1});
return did}
var TSEL="b,h1,h2,h3,h4,.cth,.ctt";
function decor(){var cs=cards(),ps=[],cn=[];cs.forEach(function(c){var i=ps.indexOf(c.parentElement);if(i<0){ps.push(c.parentElement);cn.push(1)}else cn[i]++});
var BAD="table,button,select,.cs,.dd,.csp,.mvg,.mvf,.rls,.obr,.dr,.dbk,.dxsq,.obhc,.rlt,.rlg,.chb";
cs.forEach(function(c){if(c.closest("#pft"))return;var t=null,L=c.querySelectorAll(TSEL+",summary");
for(var i=0;i<L.length&&i<6;i++){var e=L[i],x=(e.textContent||"").trim();if(x.length>70||!/[\u0600-\u06FFA-Za-z]{2}/.test(x)||e.closest(BAD))continue;
var pre=0;try{var r=document.createRange();r.setStart(c,0);r.setEndBefore(e);pre=r.toString().trim().length}catch(z){}
if(pre<=60){t=e;break}}
if(!t)return;var m=cn[ps.indexOf(c.parentElement)]>1;if(!t.classList.contains("sect"))t.classList.add("sect");if(t.classList.contains("sectm")!==m)t.classList.toggle("sectm",m)})}
var tm=0;function sched(){if(tm)return;tm=setTimeout(function(){tm=0;if(drag||busy)return;busy=1;try{apply()}catch(e){}try{decor()}catch(e){}try{ob.takeRecords()}catch(e){}busy=0},150)}
var ob=new MutationObserver(function(){if(busy)return;busy=1;try{if(!drag)apply()}catch(e){}try{decor()}catch(e){}try{ob.takeRecords()}catch(e){}busy=0;sched()});
function init(){var v=gv();if(!v)return;ob.observe(v,{childList:true,subtree:true});sched()}
if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",init);else init();
function clr(){if(pend){clearTimeout(pend.t);pend=null}}
function skip(el){return !!(el.closest&&el.closest("input,select,textarea,button,a,svg,canvas,table,summary,label,.cs,.csp,.tabs,[contenteditable]"))}
function go(c){drag=c;c.classList.add("cdrag");try{window.getSelection().removeAllRanges()}catch(e){}try{if(navigator.vibrate)navigator.vibrate(30)}catch(e){}
document.addEventListener("touchmove",mv,{passive:false});document.addEventListener("touchend",en);document.addEventListener("touchcancel",en);
scr=setInterval(function(){if(!drag)return;var h=window.innerHeight;if(lastY<80)window.scrollBy(0,-14);else if(lastY>h-80)window.scrollBy(0,14);else return;place(lastY)},16)}
function place(y){if(!drag)return;var sib=cards().filter(function(c){return c.parentElement===drag.parentElement&&c!==drag}),tg=null;if(!sib.length)return;
for(var i=0;i<sib.length;i++){var r=sib[i].getBoundingClientRect();if(r.top+r.height/2>y){tg=sib[i];break}}
busy=1;try{if(tg){if(drag.nextElementSibling!==tg&&drag.nextSibling!==tg)tg.parentNode.insertBefore(drag,tg)}else{var l=sib[sib.length-1];if(l.nextElementSibling!==drag&&l.nextSibling!==drag)l.parentNode.insertBefore(drag,l.nextSibling)}}catch(e){}try{ob.takeRecords()}catch(e){}busy=0}
function mv(e){if(!drag)return;e.preventDefault();var t=e.touches&&e.touches[0];if(!t)return;lastY=t.clientY;place(lastY)}
function en(){document.removeEventListener("touchmove",mv);document.removeEventListener("touchend",en);document.removeEventListener("touchcancel",en);clearInterval(scr);
if(drag){drag.classList.remove("cdrag");saveO();drag=null;sup=Date.now()+500}}
document.addEventListener("touchstart",function(e){clr();var v=gv();if(!v||!e.target||!v.contains(e.target)||e.touches.length!==1||skip(e.target))return;var c=e.target.closest(".card");if(!c)return;while(c.parentElement&&c.parentElement.closest(".card"))c=c.parentElement.closest(".card");if(!ckey(c))return;
var t=e.touches[0];pend={x:t.clientX,y:t.clientY,t:setTimeout(function(){var c0=c;pend=null;cards();if(c0&&c0.isConnected)go(c0)},(e.target.closest&&e.target.closest(".sectm"))?220:550)}},{passive:true});
document.addEventListener("touchmove",function(e){if(!pend||drag)return;var t=e.touches[0];if(Math.abs(t.clientX-pend.x)>8||Math.abs(t.clientY-pend.y)>8)clr()},{passive:true});
document.addEventListener("touchend",function(){clr()},{passive:true});document.addEventListener("touchcancel",function(){clr()},{passive:true});
document.addEventListener("click",function(e){if(sup&&Date.now()<sup){e.preventDefault();e.stopPropagation()}},true);
document.addEventListener("contextmenu",function(e){if(pend||drag)e.preventDefault()});
var st=document.createElement("style");st.textContent="#v .card{-webkit-user-select:none;user-select:none}#v .card input,#v .card textarea{-webkit-user-select:text;user-select:text}#v .card.cdrag{opacity:.7;outline:2px solid var(--ac);box-shadow:0 8px 24px rgba(0,0,0,.35);position:relative;z-index:5}";document.head.appendChild(st);
})();
</script>
<script>
// ===== v131 =====
// (۱) تنظیمات «صفحه اصلی»  (۲) راهنمای علامت سؤال با لمس کل نوار  (۳) جلوگیری از پرش بخش‌ها هنگام بازنقاشی  (۴) عنوان یکدست بخش‌ها
(function(){var st=document.createElement("style");st.textContent=
"#v .sect{font-size:13px!important;color:var(--rd)!important;font-weight:700!important;line-height:1.7}"+
"#v .sectm::before{content:\"\";display:inline-block;width:10px;height:10px;margin-inline-end:7px;vertical-align:middle;background:radial-gradient(circle,currentColor 1.4px,transparent 1.9px) 0 0/5px 5px}"+
"#v .card.cdrag .sect::before{content:\"\\270A\";width:auto;height:auto;background:none;font-size:16px;line-height:1;margin-inline-end:6px}"+
"#v .card.cdrag .sect::after{content:\" \\21C5\";font-size:15px}"+
"#v th .q,#v th .qm{pointer-events:auto}";
document.head.appendChild(st)})();

var HPK="hp1";
function hpLoad(){var d={o:"T|hm",c:"N|"};try{if(localStorage.getItem("hpm4")!=="1"){localStorage.setItem("hpm4","1");var x4=JSON.parse(localStorage.getItem(HPK)||"null");if(x4&&x4.o==="g|اصلی"){x4.o="T|hm";localStorage.setItem(HPK,JSON.stringify(x4))}}}catch(e){}try{if(localStorage.getItem("hpm2")!=="1"){localStorage.setItem("hpm2","1");localStorage.removeItem(HPK)}if(localStorage.getItem("hpm3")!=="1"){localStorage.setItem("hpm3","1");var xx=JSON.parse(localStorage.getItem(HPK)||"null");if(xx){xx.c="N|";localStorage.setItem(HPK,JSON.stringify(xx))}}}catch(e){}try{var x=JSON.parse(localStorage.getItem(HPK)||"null");if(x){if(x.o)d.o=x.o;if(x.c)d.c=x.c}}catch(e){}var _bad=/^(x\||j\||T\|x$|T\|j$)/;if(_bad.test(d.o))d.o="g|اصلی";if(_bad.test(d.c))d.c="N|";return d}
function hpSave(d){try{localStorage.setItem(HPK,JSON.stringify(d))}catch(e){}}
function hpPages(){var P=[["T|hm","خانه"],["i|b","شاخص - بورس"],["i|f","شاخص - فرابورس"],["i|e","شاخص - هم‌وزن"],["i|m","شاخص - نقشه بازار"]],L=WL.lists||null;
if(L)L.forEach(function(l,i){if(wlInG(l,i))P.push(["g|"+l.name,"دیده‌بان - "+l.name])});else P.push(["g|اصلی","دیده‌بان - اصلی"]);
P.push(["T|d","آپشن - پیش رو"],["T|c","آپشن - زنجیره آپشن"],["T|y","آپشن - بازده آپشن"],["T|v","آپشن - ارزش معاملات"]);
P.push(["T|w","عمق بازار - تابلو"],["T|f","عمق بازار - پیش رو"],["T|sg","عمق بازار - استراتژی"],["T|k","عمق بازار - چارت"],["T|q","عمق بازار - کدال"],["T|e","عمق بازار - TSE"]);
P.push(["T|a","غربال سهام"],["T|r","هشدارها"],["T|m","قیمت لحظه‌ای"],["T|n","اخبار بورس"],["T|t","گفتگو"],["T|s","تنظیمات"]);return P}
function hpOpts(sel,extra){var P=hpPages();if(extra)P.unshift(extra);if(!P.some(function(x){return x[0]===sel}))P.push([sel,sel.replace("|"," - ").replace(/^[A-Za-z] - /,"")]);
return P.map(function(x){return'<option value="'+esc(x[0])+'"'+(x[0]===sel?" selected":"")+'>'+esc(x[1])+'</option>'}).join("")}
function hpCard(){var d=hpLoad();
return'<div class="card"><b>صفحه اصلی</b>'+
'<div class="mut" style="margin:4px 0 6px;line-height:1.9">صفحه‌ای را که هنگام باز شدن برنامه و هنگام بسته‌شدن (رفتن به پس‌زمینه) نمایش داده شود انتخاب کنید. پیش‌فرض باز شدن: خانه؛ پیش‌فرض بسته شدن: بدون تغییر. با «بدون تغییر» برنامه همان صفحه‌ای که بودید می‌ماند.</div>'+
'<div class="row2" style="display:block"><label style="display:block;margin-bottom:3px">هنگام باز شدن برنامه</label><select id="hp_o" class="optsel">'+hpOpts(d.o)+'</select></div>'+
'<div class="row2" style="display:block"><label style="display:block;margin-bottom:3px">هنگام بسته شدن برنامه</label><select id="hp_c" class="optsel">'+hpOpts(d.c,["N|","بدون تغییر (همان صفحه‌ی آخر)"])+'</select></div></div>'}
var _hpW=0;
function hpBind(){var o=document.getElementById("hp_o"),c=document.getElementById("hp_c");
if(o)o.onchange=function(){var d=hpLoad();d.o=this.value;hpSave(d)};
if(c)c.onchange=function(){var d=hpLoad();d.c=this.value;hpSave(d)};
if(!WL.lists&&!_hpW){_hpW=1;var f=function(){_hpW=0;if(WL.lists&&tab==="s")view()};try{wlInit().then(f,f)}catch(e){_hpW=0}}}
function hpGo(k){if(!k||k==="N|")return;var p=k.split("|"),a=p[0],b=p.slice(1).join("|");
try{
if(a==="i"){if(tab==="i"&&document.getElementById("ignav")){var bt=document.querySelector('[data-igt="'+b+'"]');if(bt){bt.click();return}}IG.t=b;goTab("i")}
else if(a==="T"){goTab(b)}
else if(a==="g"){var go=function(){var i=(WL.lists||[]).findIndex(function(l){return l.name===b});if(i>=0){WL.cur=i;WL.sk=null;WL.bs=null}goTab("g")};wlInit().then(go,go)}
else if(a==="x"||a==="j"){goTab(a);var go2=function(){var i=(WL.lists||[]).findIndex(function(l){return l.name===b&&(a==="j"?l.opt===1:l.opt!==1)});if(i>=0)fpOpen(i)};wlInit().then(go2,go2)}
}catch(e){}}
setTimeout(function(){try{var d=hpLoad();if(d.o&&d.o!=="N|"&&!(d.o==="i|b"&&tab==="i"&&IG.t==="b"))hpGo(d.o)}catch(e){}},350);
document.addEventListener("visibilitychange",function(){if(!document.hidden)return;try{var d=hpLoad();if(d.c&&d.c!=="N|")hpGo(d.c)}catch(e){}});

// لمس هر جای نوار سربرگ (ستون‌های قرمز و عنوان بخش‌ها) = همان پیام علامت سؤال؛ سربرگ‌های مرتب‌ساز دست نمی‌خورند
document.addEventListener("click",function(e){var t=e.target;if(!t||!t.closest||t.closest(".q,.qm,[data-nq]"))return;
var h=t.closest("#v th,#v .sect");if(!h)return;
if(h.tagName==="TH"){var at=h.getAttributeNames?h.getAttributeNames():[];for(var i=0;i<at.length;i++)if(at[i].indexOf("data-")===0)return;if(h.onclick)return}
var q=h.querySelector(".q,.qm");if(!q)return;e.stopPropagation();e.preventDefault();q.click()},true);

// بازنقاشی هر ثانیه‌ی صفحه‌ها (ساعت بازار): اسکرول افقی/عمودی نوارها و جدول‌ها از بین نرود
(function(){var v=document.getElementById("v");if(!v)return;var d=Object.getOwnPropertyDescriptor(Element.prototype,"innerHTML");if(!d||!d.set)return;
var SEL=".sc,.scv,.prs,.exb,.exs2,.wlbar,.nwch,.cht,.chb,#wlsc",lt=null;
function sig(e){return e.tagName+"."+e.className+"#"+e.id}
function snap(){var m={},n={};v.querySelectorAll(SEL).forEach(function(e){var s=sig(e);n[s]=(n[s]||0)+1;if(e.scrollLeft||e.scrollTop)m[s+"|"+n[s]]=[e.scrollLeft,e.scrollTop]});return m}
function back(m){var n={};v.querySelectorAll(SEL).forEach(function(e){var s=sig(e);n[s]=(n[s]||0)+1;var r=m[s+"|"+n[s]];if(r){e.scrollLeft=r[0];e.scrollTop=r[1]}})}
Object.defineProperty(v,"innerHTML",{configurable:true,enumerable:true,get:function(){return d.get.call(this)},set:function(h){var same=(lt===tab),m=same?snap():null;d.set.call(this,h);lt=tab;if(m)try{back(m)}catch(e){}}});lt=tab})();
// ===== آپشن - ارزش معاملات: ارزش معاملات روزانه‌ی بازار اختیار با میانگین متحرک ۵، ۱۰ و ۳۰ روزه + موقعیت‌های باز =====
var OV={f:"a",r:30};
function ovData(){var o={};try{if(window.Android&&Android.optGet)o=JSON.parse(Android.optGet()||"{}")||{}}catch(e){o={}}
var ks=Object.keys(o).sort();return ks.map(function(k){var a=o[k]||[];return{k:k,cv:+a[0]||0,pv:+a[1]||0,co:+a[2]||0,po:+a[3]||0,m:+a[4]||0}})}
function ovMa(v,n){return v.map(function(_,i){if(i<n-1)return null;var s=0;for(var j=i-n+1;j<=i;j++)s+=v[j];return s/n})}
function ovLbl(k){var y=+k.slice(0,4),m=+k.slice(4,6),d=+k.slice(6,8);try{return new Date(y,m-1,d).toLocaleDateString("fa-IR",{month:"2-digit",day:"2-digit"})}catch(e){return k.slice(4,6)+"/"+k.slice(6)}}
function ovSvg(days,pick,unit,div){var all=days.map(pick),cut=Date.now()-ovRange()*86400000,idx=[];
days.forEach(function(d,i){var t=new Date(+d.k.slice(0,4),+d.k.slice(4,6)-1,+d.k.slice(6,8)).getTime();if(t>=cut)idx.push(i)});
if(!idx.length)return'<div class="mut" style="text-align:center;padding:14px">برای این بازه هنوز داده‌ای ثبت نشده است.</div>';
var m5=ovMa(all,5),m10=ovMa(all,10),m30=ovMa(all,30),W=360,H=210,L=6,R=44,T=10,B=26,pw=W-L-R,ph=H-T-B,n=idx.length;
var mx=0;idx.forEach(function(i){mx=Math.max(mx,all[i]||0,m5[i]||0,m10[i]||0,m30[i]||0)});if(!(mx>0))mx=1;
var sl=Math.max(n,10),bw=pw/sl,g='',X=function(j){return L+bw*(j+.5)},Y=function(v){return T+ph-ph*v/mx};
for(var q=0;q<=4;q++){var yy=T+ph*q/4,val=mx*(4-q)/4/div;g+='<line x1="'+L+'" x2="'+(W-R)+'" y1="'+yy+'" y2="'+yy+'" stroke="#8884" stroke-width=".5"/><text x="'+(W-R+3)+'" y="'+(yy+3)+'" font-size="8" fill="currentColor" opacity=".7">'+(val>=100?Math.round(val):val.toFixed(1)).toLocaleString("fa-IR")+'</text>'}
idx.forEach(function(i,j){var v=all[i]||0,h=ph*v/mx;g+='<rect x="'+(X(j)-Math.max(1,Math.min(bw*.76,16))/2)+'" y="'+(T+ph-h)+'" width="'+Math.max(1,Math.min(bw*.76,16))+'" height="'+Math.max(0,h)+'" fill="#263238" opacity=".88"/>'});
var line=function(a,c){var p='';idx.forEach(function(i,j){if(a[i]==null)return;p+=(p?"L":"M")+X(j).toFixed(1)+","+Y(a[i]).toFixed(1)});return p?'<path d="'+p+'" fill="none" stroke="'+c+'" stroke-width="1.6"/>':''};
g+=line(m30,"#1565c0")+line(m10,"#ef8a17")+line(m5,"#e53935");
var step=Math.max(1,Math.ceil(n/7));idx.forEach(function(i,j){if(j%step===0||j===n-1)g+='<text x="'+X(j)+'" y="'+(H-10)+'" font-size="8" text-anchor="middle" fill="currentColor" opacity=".7">'+ovLbl(days[i].k)+'</text>'});
var lg='<div style="display:flex;gap:10px;justify-content:center;font-size:11px;margin:2px 0 4px"><span style="color:#e53935">▬ MA 5</span><span style="color:#ef8a17">▬ MA 10</span><span style="color:#1565c0">▬ MA 30</span><span>▮ '+unit+'</span></div>';
return lg+'<svg viewBox="0 0 '+W+' '+H+'" style="width:100%;height:auto;direction:ltr">'+g+'</svg>'}
function ovRange(){return OV.r}
function ovBar(){var f=[["a","همه"],["c","اختیار خرید"],["p","اختیار فروش"]],r=[[30,"یک ماه"],[90,"سه ماه"],[180,"شش ماه"],[365,"یک سال"]],b=function(on,at,t){return'<button type="button" '+at+' style="flex:1;padding:5.4px 2px;border-radius:9px;border:1px solid '+(on?"#063d14":"#d32f2f")+';background:'+(on?"#0a5c1f":"#d32f2f")+';color:#fff;font-size:10.8px;font-weight:700">'+t+'</button>'};
return'<div style="display:flex;gap:6px;margin:6px 0">'+f.map(function(x){return b(OV.f===x[0],'data-ovf="'+x[0]+'"',x[1])}).join("")+'</div><div style="display:flex;gap:6px;margin:6px 0 10px">'+r.map(function(x){return b(OV.r===x[0],'data-ovr="'+x[0]+'"',x[1])}).join("")+'</div>'}
function ovHtml(){var D=ovData(),vf=function(d){return(OV.f==="c"?d.cv:OV.f==="p"?d.pv:d.cv+d.pv)},of=function(d){return(OV.f==="c"?d.co:OV.f==="p"?d.po:d.co+d.po)};
var h=optPg("v")+'<div class="card"><b class="sect">نمودار روزانه ارزش معاملات اختیار (میلیارد تومان)</b>'+ovBar();
var lt=D[D.length-1];if(lt)h+='<div class="mut" style="font-size:11.5px;line-height:1.9;margin-bottom:6px">آخرین ثبت: '+ovLbl(lt.k)+(lt.m?' ساعت '+dxHM(lt.m):'')+' — ارزش: '+Math.round((lt.cv+lt.pv)/1e10).toLocaleString('fa-IR')+' م.ت، موقعیت باز: '+(lt.co+lt.po).toLocaleString('fa-IR')+((lt.cv+lt.pv)===0?'<br><span style="color:var(--dn)">ارزش معاملات از داده‌ی بورس خوانده نشد؛ خبرم کنید تا نام ستون اصلاح شود.</span>':'')+'</div>';
if(!D.length)h+='<div class="mut" style="text-align:center;padding:14px;line-height:1.9">هنوز سابقه‌ای ثبت نشده است. برنامه از ساعت ۰۸:۴۵ تا ۱۲:۳۰ هر دقیقه (حتی وقتی بسته است) جمع کل ارزش معاملات و موقعیت‌های باز بازار اختیار را ذخیره می‌کند و نمودار از اولین روز ثبت شروع می‌شود.</div>';
else h+=ovSvg(D,function(d){return vf(d)/1e10},"ارزش معاملات",1)+'</div><div class="card"><b class="sect">نمودار روزانه موقعیت‌های باز (Open Interest)</b>'+ovSvg(D,of,"موقعیت باز",1e6).replace("</svg>","</svg>")+'<div class="mut" style="text-align:center;font-size:11px">عدد محور: میلیون قرارداد</div>';
return h+'</div><div class="mut" style="font-size:11px;line-height:1.8;padding:4px 6px">کاربردش: برای دیدن جریان نقدینگی در بازار اختیار است. اگر MA5 از MA30 به بالا برود، یعنی معاملات دارد زیاد می‌شود. اگر به پایین برود، یعنی نقدینگی دارد خارج می‌شود. این فقط یک سنجه‌ی فعالیت بازار است و خودش سیگنال خرید یا فروش نمی‌دهد.</div>'}
document.getElementById("v").addEventListener("click",function(e){if(tab!=="v"||!e.target.closest)return;var f=e.target.closest("[data-ovf]"),r=e.target.closest("[data-ovr]");if(f){OV.f=f.getAttribute("data-ovf");view()}else if(r){OV.r=+r.getAttribute("data-ovr");view()}});
function oiTick(){try{if(window.Android&&Android.oiTick&&!document.hidden)Android.oiTick()}catch(e){}}
setInterval(oiTick,60000);setTimeout(oiTick,4000);
</script>

<script>
// ===== توضیحات انتهای صفحه‌ها: پیش‌فرض بسته، با لمس باز می‌شود =====
(function(){
var OPEN={};try{OPEN=JSON.parse(localStorage.getItem("hlpo1")||"{}")||{}}catch(e){OPEN={}}
function tx(e){return(e.textContent||"").replace(/\s+/g," ").trim()}
function tabKey(){try{return String(tab)}catch(e){return""}}
function isDone(e){return e.hasAttribute("data-hl")||(e.closest&&e.closest("details.hlpd"))}
function titleB(el){var b=el.querySelector("b");if(!b)return null;if(!/^(توضیح|کارایی|راهنمای)/.test(tx(b)))return null;var p=b.parentNode;if(p!==el&&!(p.parentNode===el&&p===el.firstElementChild))return null;return b}
function isCand(n){if(n.hasAttribute("data-hl"))return true;if(n.nodeType!==1)return false;if(n.classList.contains("card")&&titleB(n))return true;if(n.classList.contains("mut")){var st=n.getAttribute("style")||"";if(/font-size:11px/.test(st)&&/line-height:1\.8/.test(st)&&tx(n).length>=70)return true}return false}
function trailing(el){for(var n=el.nextElementSibling;n;n=n.nextElementSibling){if(!isCand(n))return false}return true}
function mk(el,label,drop){var key=tabKey()+"|"+label,d=document.createElement("details"),s=document.createElement("summary"),b=document.createElement("div");
d.className="hlpd";d.setAttribute("data-hk",key);s.textContent=label;d.appendChild(s);b.className="hlpb";
while(el.firstChild)b.appendChild(el.firstChild);
if(drop&&drop.parentNode){var nx=drop.nextSibling;drop.parentNode.removeChild(drop);while(nx&&nx.nodeName==="BR"){var n2=nx.nextSibling;nx.parentNode.removeChild(nx);nx=n2}}
d.appendChild(b);if(OPEN[key])d.open=true;el.appendChild(d);el.setAttribute("data-hl","1")}
function run(){var v=document.getElementById("v");if(!v)return;
var all=v.querySelectorAll(".card,.mut"),list=[];for(var i=0;i<all.length;i++){var e=all[i];if(isDone(e)||!isCand(e))continue;list.push(e)}
list.forEach(function(e){if(isDone(e))return;if(!trailing(e))return;
if(e.classList.contains("card")){var b=titleB(e);mk(e,tx(b).replace(/[:：]\s*$/,""),b)}else mk(e,"توضیحات",null)})}
function start(){var v=document.getElementById("v");if(!v)return;
new MutationObserver(function(){try{run()}catch(e){}}).observe(v,{childList:true,subtree:true});
v.addEventListener("toggle",function(e){var d=e.target;if(d&&d.classList&&d.classList.contains("hlpd")){var k=d.getAttribute("data-hk");if(d.open)OPEN[k]=1;else delete OPEN[k];try{localStorage.setItem("hlpo1",JSON.stringify(OPEN))}catch(x){}}},true);
try{run()}catch(e){}}
if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",start);else start()})();

// ===== راهنمای برنامه (اولین نصب + دکمه‌ی تنظیمات) =====
var GDS=[
["به «آپشن – سینو بورس» خوش آمدید",`<p>این صفحه همه‌ی کارهایی را که برای شروع و استفاده از برنامه لازم است یکجا نشان می‌دهد. هر وقت خواستید به صفحه‌ی <b>«تنظیمات»</b> بروید و در انتهای آن دکمه‌ی <b>«راهنما»</b> را بزنید.</p>
<h4>کادرهای بالای صفحه</h4><ul><li><b>عنوان برنامه:</b> لمس آن به صفحه‌ی اصلی می‌برد. دور کادر عنوان و شاخص یک نوار زرد است و داخل آن یک خط باریک سبز روشن (بازار باز) یا قرمز روشن (بازار بسته) می‌بینید. بالای عدد تغییر شاخص، درصد تغییر با اندازه‌ی کوچک‌تر نوشته می‌شود.</li><li><b>کادر شاخص کل:</b> عدد شاخص با عبارت «شاخص کل» زیرش و کنارش مقدار افزایش یا کاهش (سبز مثبت، قرمز منفی)؛ لمس آن صفحه‌ی «شاخص» را باز می‌کند و کادر نماد عبارت «شاخص» را نشان می‌دهد.</li><li><b>کادر نماد:</b> نام نماد را بنویسید تا عمق بازار، چارت و آپشن همان نماد باز شود.</li></ul>
<h4>برنامه چه می‌کند؟</h4><ul><li>قیمت و تابلوی سهام، شاخص‌ها، اختیار معامله (آپشن) و نمودارهای آن را از داده‌ی عمومی بورس نشان می‌دهد.</li><li>دیده‌بان و فیلترهای آماده دارد که سهم‌ها را بر پایه‌ی شرط‌های آماری لیست می‌کنند.</li><li>هشدار قیمت می‌دهد و در ساعت بازار، حتی وقتی برنامه بسته است، بعضی داده‌ها را برای نمودارهای بعدی ذخیره می‌کند.</li></ul>
<p>همه‌ی اطلاعات فقط ابزار کمک‌تحلیل است و <b>توصیه‌ی خرید یا فروش نیست</b>.</p>`],
["اجازه‌هایی که در اولین اجرا می‌خواهد",`<p>در اولین اجرای برنامه چند پنجره‌ی سیستم باز می‌شود. جواب درست این است:</p>
<h4>۱) اعلان‌ها ← «اجازه بده»</h4><p>برای هشدار قیمت، خلاصه‌ی بازار و خبر نسخه‌ی جدید. بدون آن هیچ اعلانی نمی‌بینید.</p>
<h4>۲) باتری ← «بدون محدودیت» یا «اجازه بده»</h4><p>گوشی‌ها برنامه‌ی بسته را برای صرفه‌جویی در باتری متوقف می‌کنند. اگر این اجازه را ندهید، ثبت دقیقه‌ای موقعیت‌های باز، قدرت خریدار و فروشنده و هشدارها در ساعت بازار قطع می‌شود.</p>
<p>در گوشی‌های شیائومی، سامسونگ، هواوی و اوپو علاوه بر این، گزینه‌ی «شروع خودکار» (Autostart) را روشن کنید و برنامه را در لیست برنامه‌های اخیر «قفل» کنید.</p>
<h4>۳) نصب برنامه‌های ناشناس</h4><p>فقط وقتی نسخه‌ی جدید آماده شود لازم است (بخش «به‌روزرسانی برنامه» همین صفحه).</p>`],
["ساعت بازار و ثبت در پس‌زمینه",`<p>بازار شنبه تا چهارشنبه کار می‌کند. برنامه از <b>۸:۴۵ تا ۱۲:۳۰</b> هر دقیقه این داده‌ها را روی خود گوشی ذخیره می‌کند:</p>
<ul><li>موقعیت باز هر قرارداد آپشن (نمودار «موقعیت باز قرارداد» در صفحه‌ی عمق بازار).</li><li>جمع ارزش معاملات و موقعیت باز کل بازار اختیار (صفحه‌ی آپشن ← ارزش معاملات).</li><li>قدرت خریدار و فروشنده‌ی بورس، فرابورس و هم‌وزن (صفحه‌ی شاخص).</li></ul>
<h4>چرا بعضی نمودارها اول کار خالی یا کوتاه‌اند؟</h4><p>داده از <b>روز نصب</b> شروع به جمع شدن می‌کند و قابل دریافت از گذشته نیست. نمودار ارزش معاملات روز اول فقط یک میله دارد؛ خط‌های MA5، MA10 و MA30 بعد از ۵، ۱۰ و ۳۰ روز ثبت ظاهر می‌شوند. نمودار هفتگی و ماهانه‌ی موقعیت باز هم به همین ترتیب کامل می‌شود.</p>
<p>داده‌ها فقط در حافظه‌ی گوشی شما می‌ماند؛ با پاک کردن اطلاعات برنامه از بین می‌رود.</p>`],
["صفحه‌ها یکی‌یکی",`<ul>
<li><b>شاخص:</b> شاخص بورس، فرابورس و هم‌وزن، نقشه‌ی بازار و نمودار قدرت خریدار و فروشنده.</li>
<li><b>دیده‌بان:</b> لیست نمادهای خودتان و فیلترهای آماده. در همه‌ی لیست‌ها یک بار لمس نماد را در کادر جستجو می‌نشاند و بار دوم به صفحه‌ی آن می‌رود. لیست «اصلی» نمادهای پرتفو را دارد و حذف‌شدنی نیست؛ لمس ستون «نماد» آن اول سهام پرتفو را می‌آورد. با لمس عنوان هر ستون لیست مرتب می‌شود و با لمس هر ردیف صفحه‌ی عمق بازار همان نماد باز می‌شود. گوشی را افقی کنید تا حجم و قیمت تقاضا و عرضه هم دیده شود.</li>
<li><b>آپشن:</b> پیش رو، زنجیره‌ی آپشن، بازده آپشن و ارزش معاملات اختیار.</li>
<li><b>پرتفو:</b> بالا ارزش کل سهام (عدد درشت)، زیرش «سود و زیان امروز» (سبز مثبت، قرمز منفی). هر نوار یک سهم است: یک بار لمس دور نوار انتخاب‌شده خط قرمز باریک می‌اندازد و نام را در کادر جستجوی بالا و کادر افزودن می‌نشاند (می‌ماند)، نام را در کادر جستجوی بالا و کادر افزودن می‌نشاند؛ بار دوم لمس، سهم آپشن‌دار را به «استراتژی» و بقیه را به «عمق بازار» می‌برد. فهرست پایین حذف شد؛ نمادهای پرتفو خودکار در دیده‌بان «اصلی» می‌آیند و آنجا حذف‌شدنی نیستند (فقط از خود پرتفو). کارمزد فروش در همه‌ی ارزش‌ها لحاظ است.</li>
<li><b>ابزارهای چارت:</b> خط افقی قیمتش را روی ستون قیمت (سمت راست) نشان می‌دهد؛ خط عمودی قیمت محل تلاقی‌اش با خط قیمت چارت (پایانی همان کندل) را روی ستون قیمت می‌نویسد. خط روند و مستطیل برچسب قیمت روی ستون ندارند.</li>
<li><b>چارت:</b> برای بازدهی و دید بهتر چارت، گوشی را <b>افقی</b> کنید؛ در حالت افقی همه‌ی منوها و ابزارها در یک سطر بالای نمودار جا می‌گیرند و نمودار بزرگ‌تر دیده می‌شود. منوهای بالا (کندل، روزانه، … پایین نمودار) همیشه در یک سطر هستند و ابزارهای چپ (خط … سطل) داخل قاب چارت می‌مانند. چرخاندن گوشی هرگز شما را از صفحه‌ی فعلی بیرون نمی‌برد. پیش‌فرض بخش پایین نمودار فقط «حجم» است و بقیه‌ی اندیکاتورها را از منو اضافه می‌کنید.</li>
<li><b>عمق بازار:</b> تابلوی سفارش‌ها، اطلاعات تکمیلی، موقعیت باز و نمودارها (روزانه، هفتگی، ماهانه). دکمه‌ی «استراتژی» (بعد از زنجیره آپشن) برای سهام آپشن‌دارِ پرتفوی شما موقعیت‌های کاورد کال، پرریسک، کم‌ریسک، پیشنهادی و ویژه را به تفکیک سررسید می‌سازد.</li>
<li><b>فیلترها:</b> گروه‌های فیلتر آماده؛ عدد روی هر دکمه تعداد نمادهای آخرین اجرای همان فیلتر است.</li>
<li><b>غربال سهام:</b> فیلتر روی همه‌ی سهام بازار از روی یک فهرست لحظه‌ای.</li>
<li><b>هشدارها:</b> قیمت، درصد تغییر، صف خرید و فروش، وضعیت نماد، حجم و قدرت خریدار در یک کارت؛ در ساعت بازار حتی با برنامه‌ی بسته اعلان می‌دهد.</li>
<li><b>قیمت لحظه‌ای:</b> قیمت‌هایی مثل ارز و طلا از tgju که خودتان انتخاب می‌کنید.</li>
<li><b>اخبار بورس و گفتگو:</b> خبرها و پیام‌های ناظر و گفتگوی کاربران.</li>
<li><b>تنظیمات:</b> تم، درصد نوسان، تعطیلات و تنظیمات صفحه‌ی اصلی.</li> <li><b>راهنما:</b> همین صفحه؛ دکمه‌ی آن در انتهای صفحه‌ی تنظیمات است.</li></ul>`],
["کار با دیده‌بان و فیلترها",`<ul><li><b>▶ اجرا:</b> فیلتر را از نو می‌سازد. تا آن لحظه به جای دکمه عبارت «لطفا صبر کنید» می‌بینید؛ بعد از اتمام لیست پر می‌شود.</li>
<li><b>پاک‌کن:</b> لیست فیلتر را خالی می‌کند و تا اجرای دوباره پر نمی‌شود.</li>
<li><b>⚙ تنظیمات فیلتر:</b> بازار (بورس، فرابورس، پایه، انرژی)، سخت‌گیری شرط‌ها و حداکثر تعداد نماد. اگر فیلتری چیزی نشان نداد، سخت‌گیری را ملایم‌تر کنید.</li>
<li><b>؟ کنار ستون‌ها:</b> توضیح همان ستون را نشان می‌دهد.</li>
<li><b>ستون «کندل»:</b> دامنه‌ی امروز نماد و جای آخرین قیمت در آن.</li>
<li><b>صف خرید و فروش (حالت افقی):</b> وقتی نماد در صف خرید است حجم سمت فروش خط تیره می‌شود و برعکس.</li></ul>
<h4>پیش رو و گام قیمت</h4><p>در محاسبه‌ی «پیش رو» گام قیمت بورس رعایت می‌شود: قیمت زیر ۳۰۰۰ ریال با گام ۱ ریال و از ۳۰۰۰ ریال به بالا با گام ۱۰ ریال حرکت می‌کند؛ در هر روز گام از روی قیمت همان روز تعیین می‌شود. ستون اول جدول باریک‌تر است تا ستون قیمت‌ها بازتر دیده شود.</p>
<h4>قطع اینترنت و فیلترشکن</h4><p>اگر اینترنت قطع یا ضعیف شود یا فیلترشکن روشن باشد، برنامه تا جایی که قبلاً دریافت کرده (قیمت‌ها، نمودارها، جدول‌ها) آخرین داده را نشان می‌دهد و در بخش اطلاع‌رسانی با <b style="color:#d32f2f">رنگ قرمز</b> علت را می‌نویسد: «اینترنت ضعیف است»، «فیلترشکن روشن است؛ آن را خاموش کنید» یا «اتصال برقرار نشد؛ لطفاً اینترنت خود را چک کنید». به‌محض وصل شدن، داده‌ها خودکار تازه می‌شوند. چیزی که هیچ‌وقت دریافت نشده باشد در حالت قطع هم خالی می‌ماند.</p>
<h4>صفحه‌ی استراتژی</h4><p>همه‌ی لیست‌های کشویی برنامه (مرتب‌سازی، گروه، انتخاب نماد استراتژی و …) با یک لیست کوچک و یک‌شکل باز می‌شوند، نه لیست درشت اندروید. هر لیست کشویی تازه‌ای که به برنامه اضافه شود خودکار همین ظاهر را می‌گیرد.</p>
<h4>توضیحات پایین هر صفحه</h4><p>متن‌های توضیحی انتهای صفحه‌ها به‌صورت پیش‌فرض بسته‌اند. روی عنوان‌شان بزنید تا باز شوند.</p>`],
["خواندن اطلاعات و محدودیت‌ها",`<ul><li>تابلوی عمق بازار همان <b>۵ بهترین مظنه</b> را نشان می‌دهد که بورس برای همه منتشر می‌کند. عمق بیشتر (مثلاً ۲۰ مظنه) فقط از سامانه‌ی کارگزاری‌ها در دسترس است و در برنامه نیست.</li>
<li>داده از سایت بورس گرفته می‌شود و ممکن است چند ثانیه تأخیر داشته باشد. اگر بورس در شبکه‌ی شما باز نشود، بعضی صفحه‌ها خالی می‌مانند و پیام خطا می‌دهند.</li>
<li>رنگ سبز یعنی مثبت یا خرید و قرمز یعنی منفی یا فروش.</li>
<li>هیچ فیلتر یا نموداری پیش‌بینی نیست؛ فقط وضعیت آماری بازار را نشان می‌دهد.</li></ul>`],
["به‌روزرسانی برنامه",`<p>برنامه هر روز <b>ساعت ۸:۰۰ صبح</b> (به وقت تهران) کانال رسمی را در <b>تلگرام</b> و در صورت نیاز در <b>بله</b> بررسی می‌کند.</p>
<ul><li>اگر نسخه‌ی جدیدتری در کانال پین شده باشد، فایل را دانلود می‌کند و اعلان «نسخه‌ی جدید آماده است» می‌دهد.</li>
<li>برنامه را که باز کنید پنجره‌ی «نصب» می‌آید. بار اول اندروید می‌خواهد در تنظیمات اجازه‌ی «نصب برنامه‌های ناشناس» را برای همین برنامه روشن کنید؛ بعد از برگشتن دوباره «نصب» را بزنید.</li>
<li>نسخه‌ی جدید روی نسخه‌ی قبلی نصب می‌شود و اطلاعات و تنظیمات شما می‌ماند. برنامه را قبل از آپدیت <b>پاک نکنید</b>.</li>
<li>اگر گوشی آن ساعت خاموش یا بی‌اینترنت بود، در اولین باز کردن برنامه بررسی جبران می‌شود.</li></ul>`],
["آماده‌اید",`<p>برای شروع پیشنهاد می‌کنیم:</p><ul><li>در <b>دیده‌بان</b> چند نماد دلخواه اضافه کنید.</li><li>در <b>هشدار قیمت</b> یک هشدار بسازید و اجازه‌ی اعلان را چک کنید.</li><li>یک بار صفحه‌ی <b>عمق بازار</b> یک نماد آپشن را باز کنید تا ثبت موقعیت باز آن شروع شود.</li><li>در ساعت بازار برنامه را یک‌بار باز کنید و اجازه‌ی باتری را بدهید.</li></ul>
<p>موفق باشید.</p>`]];

// ===== صفحه‌ی کامل راهنما (تب «راهنما» بعد از تنظیمات) =====
function gdPageHtml(){var toc='<div class="gpt">'+GDS.map(function(g,i){return'<a href="#" data-gpj="'+i+'">'+(i+1).toLocaleString("fa-IR")+') '+g[0]+'</a>'}).join("")+'</div>';
return'<div class="card gpg"><div style="text-align:center;margin-bottom:6px"><b style="font-size:16px">راهنمای کامل «آپشن – سینو بورس»</b></div>'+toc+
GDS.map(function(g,i){return'<section id="gps'+i+'"><h3>'+(i+1).toLocaleString("fa-IR")+') '+g[0]+'</h3><div class="gdb">'+g[1]+'</div></section>'}).join("")+
'<div style="text-align:center;margin-top:8px"><button type="button" data-gt="1" style="padding:8px 18px;font-weight:700">👆 راهنما روی صفحه</button></div></div>'}
(function(){var st=document.createElement("style");st.textContent='.gpg{margin-bottom:96px;line-height:2;font-size:13.5px}.gpg section{border-top:1px solid var(--ln);padding-top:6px;margin-top:10px}.gpg h3{margin:4px 0;font-size:15px;color:var(--ac)}.gpg h4{margin:10px 0 2px;font-size:14px;color:var(--ac)}.gpg p{margin:2px 0 6px}.gpg ul{margin:2px 0 8px;padding-inline-start:20px}.gpg li{margin:2px 0}.gpt{display:flex;flex-direction:column;gap:2px;margin-bottom:6px}.gpt a{color:var(--tx);text-decoration:none;padding:2px 6px;border-radius:6px;background:var(--bg)}';document.head.appendChild(st)})();
document.addEventListener("click",function(e){var a=e.target&&e.target.closest?e.target.closest("[data-gpj]"):null;if(!a)return;e.preventDefault();var el=document.getElementById("gps"+a.getAttribute("data-gpj"));if(el&&el.scrollIntoView)el.scrollIntoView({block:"start"})},true);
var gdI=0;
function gdPaint(){var o=document.getElementById("gdov");if(!o)return;var s=GDS[gdI];
o.innerHTML='<div class="gdh"><b>'+s[0]+'</b><span>'+(gdI+1).toLocaleString("fa-IR")+' از '+GDS.length.toLocaleString("fa-IR")+'</span></div><div class="gdd">'+GDS.map(function(_,i){return'<i'+(i===gdI?' class="on"':'')+'></i>'}).join("")+'</div><div class="gdb">'+s[1]+'</div><div class="gdn">'+(gdI>0?'<button type="button" class="sec" data-gdn="-1">قبلی</button>':'<button type="button" class="sec" data-gdn="x">رد کردن</button>')+'<button type="button" data-gdn="'+(gdI===GDS.length-1?'t':'1')+'">'+(gdI===GDS.length-1?'نمایش روی صفحه ◂':'بعدی')+'</button></div>';
var b=o.querySelector(".gdb");if(b)b.scrollTop=0}
function gdOpen(i){gdI=i||0;var o=document.getElementById("gdov");if(!o){o=document.createElement("div");o.id="gdov";document.body.appendChild(o)}gdPaint()}
function gdClose(){var o=document.getElementById("gdov");if(o)o.parentNode.removeChild(o);try{localStorage.setItem("gd1","1")}catch(e){}}
function gdCard(){return''}
function gdBtnCard(){return'<div class="card" style="text-align:center"><button type="button" id="gh" style="padding:8px 22px;font-weight:700">📖 راهنما</button><div class="mut" style="font-size:11.5px;margin-top:6px">راهنمای کامل برنامه در یک صفحه</div></div>'}
document.addEventListener("click",function(e){var t=e.target&&e.target.closest?e.target:null;if(!t)return;var g=t.closest("[data-gd]");if(g){gdOpen(0);return}var g2=t.closest("[data-gt]");if(g2){gtOpen(0);return}var tn=t.closest("[data-gtn]");if(tn){var q=tn.getAttribute("data-gtn");if(q==="x"||(q==="1"&&gtI>=GTS.length-1))gtClose();else{gtI=Math.max(0,Math.min(GTS.length-1,gtI+(+q)));gtPaint()}return}var n=t.closest("[data-gdn]");if(n){var d=n.getAttribute("data-gdn");if(d==="x")gdClose();else if(d==="t"){gdClose();gtOpen(0)}else{gdI=Math.max(0,Math.min(GDS.length-1,gdI+(+d)));gdPaint()}}},true);

var GTS=[
["#r1","عنوان برنامه و شاخص","لمس عنوان شما را به صفحه‌ی اصلی می‌برد. نوار زرد دورش و خط باریک داخلش (سبز روشن وقتی بازار باز است، قرمز روشن وقتی بسته است) وضعیت بازار را نشان می‌دهد."],
["#st","بخش اطلاع‌رسانی","پیام‌های وضعیت اینجا می‌آید. اگر اینترنت قطع باشد یا فیلترشکن روشن باشد، با رنگ قرمز هشدار می‌دهد و آخرین داده‌ی ذخیره‌شده نمایش داده می‌شود."],
["#ix","کادر شاخص کل","عدد و درصد شاخص کل بورس (سبز مثبت، قرمز منفی). لمس این کادر صفحه‌ی «شاخص» را باز می‌کند و کادر نماد بالا عبارت «شاخص» را نشان می‌دهد."],
["#sym","جستجوی نماد","نام هر نماد را اینجا بنویسید. صفحه‌های عمق بازار، چارت و آپشن برای همان نماد باز می‌شوند."],
["#r2","تاریخ و ساعت بازار","تاریخ شمسی و ساعت زنده. بازار شنبه تا چهارشنبه از ۸:۴۵ تا ۱۲:۳۰ باز است و در همین ساعت‌ها داده‌ها در پس‌زمینه ثبت می‌شوند."],
['.hmg [data-hm="i"]',"شاخص","شاخص بورس، فرابورس و هم‌وزن، نقشه‌ی بازار و نمودار قدرت خریدار و فروشنده."],
['.hmg [data-hm="g"]',"دیده‌بان","لیست نمادهای شما و فیلترهای آماده. گوشی را افقی کنید تا حجم و قیمت تقاضا و عرضه هم دیده شود."],
['.hmg [data-hm="o"]',"آپشن","پیش رو، زنجیره‌ی آپشن، بازده آپشن و ارزش معاملات اختیار."],
['.hmg [data-hm="w"]',"عمق بازار","تابلوی ۵ مظنه‌ی بورس، اطلاعات تکمیلی و نمودار موقعیت باز با دکمه‌های روزانه، هفتگی و ماهانه."],
['.hmg [data-hm="pf"]',"پرتفو","سهام خودتان با تعداد؛ ارزش کل، سود و زیان امروز و نوار هر سهم. نمادهای پرتفو خودکار در دیده‌بان «اصلی» هم می‌آیند."],
['.hmg [data-hm="x"]',"فیلترها","گروه‌های فیلتر آماده. عدد روی هر دکمه تعداد نمادهای آخرین اجرای همان فیلتر است."],
['.hmg [data-hm="a"]',"غربال سهام","یافتن سهم‌ها با شرط‌های دلخواه روی کل بازار."],
['.hmg [data-hm="r"]',"هشدارها","قیمت، درصد، صف، وضعیت نماد، حجم و قدرت خریدار با شرط شما مقایسه می‌شود و در رسیدن اعلان می‌آید."],
['.hmg [data-hm="sy"]',"سایر","با لمس این دکمه صفحه‌ای باز می‌شود که «قیمت لحظه‌ای»، «اخبار بورس»، «گفتگو» و «تنظیمات» در آن بخش‌بخش‌اند؛ با لمس هر بخش باز و با لمس دوباره بسته می‌شود. نقطه‌ی روی دکمه یعنی پیام تازه در گفتگو."],
['#v .syh[data-sy="s"]',"تنظیمات","تم، درصد نوسان، تعطیلات و تنظیمات صفحه‌ی اصلی؛ در صفحه‌ی «سایر» است.","sy"],
['#gh',"راهنما","راهنمای کامل برنامه در یک صفحه: نصب، اجازه‌ها، ساعت بازار، صفحه‌ها، دیده‌بان و فیلترها، به‌روزرسانی. این دکمه در انتهای صفحه‌ی تنظیمات است.","s"],
["#wlsc","جدول دیده‌بان","یک بار لمس هر نماد آن را در کادر جستجو می‌نشاند؛ بار دوم لمس به همان نماد می‌رود: سهام آپشن‌دار به «استراتژی» و بقیه به «عمق بازار». لمس عنوان ستون «نماد» در لیست «اصلی» اول سهام پرتفوی شما را بالا می‌آورد. نمادهای پرتفو در «اصلی» حذف‌شدنی نیستند.","g"],
["#pft","پرتفو: ارزش کل","بالا ارزش کل سهام، زیرش سود و زیان امروز (سبز مثبت، قرمز منفی) و دکمه‌های «پایانی/آخرین» برای نوع قیمت. با لمس هر نوار سهم، یک بار نام در دو کادر نماد می‌نشیند و بار دوم به صفحه‌ی همان سهم می‌رود.","pf"],
["#pfs","پرتفو: افزودن نماد","نام نماد و تعداد سهام را بنویسید و «افزودن» را بزنید. اگر نماد در پرتفو باشد دکمه «حذف» می‌شود و با وارد کردن تعداد، همان مقدار کم می‌شود.","pf"],
[".chbw","چارت: منوها","نوع کندل، بازه، اندیکاتور و پایین نمودار در یک سطر با آیکون؛ هر آیکون را بزنید تا گزینه‌هایش باز شود. گوشی را افقی کنید تا چارت بزرگ‌تر و منوها با نام دیده شوند.","k"],
["#chrow .cht","چارت: ابزارهای چپ","خط روند، خط افقی و عمودی، کانال، فیبوناچی، مستطیل، خط‌کش، مغناطیس و سطل زباله. اگر ابزارها از ارتفاع نمودار بیشتر بود، همین ستون را بکشید تا ادامه‌اش دیده شود.","k"]];
var gtI=0,gtP={n:0};
function gtOpen(i){gtI=i||0;var o=document.getElementById("gdt");if(!o){o=document.createElement("div");o.id="gdt";document.body.appendChild(o)}gtPaint()}
function gtClose(){var o=document.getElementById("gdt");if(o)o.parentNode.removeChild(o);try{localStorage.setItem("gd1","1")}catch(e){}}
function gtPaint(){var o=document.getElementById("gdt");if(!o)return;var st=GTS[gtI],el=document.querySelector(st[0]);
if(!el&&st[3]&&tab!==st[3]&&(gtP.n||0)<3){gtP.n=(gtP.n||0)+1;try{goTab(st[3])}catch(e){}setTimeout(gtPaint,700);return}gtP.n=0;
if(!el&&st[0].indexOf("data-hm")>=0&&tab!=="hm"){goTab("hm");setTimeout(gtPaint,400);return}
if(!el){if(gtI<GTS.length-1){gtI++;gtPaint()}else gtClose();return}
try{el.scrollIntoView({block:"nearest",inline:"center"})}catch(e){}
setTimeout(function(){var o2=document.getElementById("gdt");if(!o2)return;var r=el.getBoundingClientRect(),W=window.innerWidth,H=window.innerHeight,pd=4,
bx=Math.max(0,r.left-pd),by=Math.max(0,r.top-pd),bw=Math.min(W-bx,r.width+pd*2),bh=r.height+pd*2,below=r.bottom+190<H-80,
bwid=Math.min(300,W-20),cx=r.left+r.width/2,left=Math.max(10,Math.min(W-bwid-10,cx-bwid/2)),ax=Math.max(18,Math.min(bwid-18,cx-left));
o2.innerHTML='<div class="gthl" style="left:'+bx+'px;top:'+by+'px;width:'+bw+'px;height:'+bh+'px"></div><div class="gtb" style="left:'+left+'px;'+(below?'top:'+(r.bottom+14)+'px':'bottom:'+(H-r.top+14)+'px')+';width:'+bwid+'px"><i class="gta '+(below?'up':'dn')+'" style="left:'+(ax-8)+'px"></i><b>'+st[1]+'</b><span class="gtc">'+(gtI+1).toLocaleString("fa-IR")+' از '+GTS.length.toLocaleString("fa-IR")+'</span><p>'+st[2]+'</p><div class="gtn">'+(gtI>0?'<button type="button" class="sec" data-gtn="-1">قبلی</button>':'')+'<button type="button" class="sec" data-gtn="x">بستن</button><button type="button" data-gtn="1">'+(gtI===GTS.length-1?'پایان':'بعدی')+'</button></div></div>';var bx2=o2.querySelector('.gtb');if(bx2){var rb=bx2.getBoundingClientRect(),lim=H-84;if(rb.bottom>lim)bx2.style.top=Math.max(8,lim-rb.height)+'px';bx2.style.bottom='auto'}},260)}
(function(){var ob=window.onBack;window.onBack=function(){if(document.getElementById("gdt")){gtClose();return"handled"}if(document.getElementById("gdov")){if(gdI>0){gdI--;gdPaint()}else gdClose();return"handled"}return ob?ob():"exit"}})();

</script>
<script>
// ============================================================================
// صفحه‌ی «استراتژی» (عمق بازار ← بعد از «زنجیره آپشن»)
// سهام آپشن‌دارِ پرتفوی من ← موقعیت‌های آپشن به تفکیک سررسید و سربرگ
// سربرگ‌ها: کاورد کال / پرریسک / کم‌ریسک / پیشنهادی / ویژه
// ============================================================================
var SG={sel:"",tab:"cc",ex:"all",H:{},busy:false,again:0,rf:30,t:0};
try{var _sg0=JSON.parse(localStorage.getItem("sg1")||"null");if(_sg0){if(_sg0.rf>0&&_sg0.rf<200)SG.rf=_sg0.rf;if(_sg0.sel)SG.sel=String(_sg0.sel)}}catch(e){}
function sgSave(){try{localStorage.setItem("sg1",JSON.stringify({rf:SG.rf,sel:SG.sel}))}catch(e){}}
var SGT=[["cc","کاورد کال"],["bu","کال اسپرد صعودی"],["be","کال اسپرد نزولی"],["hr","پرریسک"],["lr","کم‌ریسک"],["rc","پیشنهادی"],["sp","ویژه"]];
var SGD={cc:"کاورد کال: سهام را نگه می‌دارید و اختیار خرید می‌فروشید.",bu:"کال اسپرد صعودی: خرید کال پایین‌تر و فروش کال بالاتر؛ سود و زیان هر دو محدود.",be:"کال اسپرد نزولی: فروش کال پایین‌تر و خرید کال بالاتر؛ سود و زیان هر دو محدود.",hr:"پرریسک (ولی سودساز): خرید کال اهرمی و فروش پوت.",lr:"کم‌ریسک (ولی مطمئن): قفل سود و کالر با کفِ زیان کوچک.",rc:"پیشنهادی: کاورد کال با لبه‌ی نوسان (امتیاز VRP).",sp:"ویژه: بهینه‌سازی میانگین–CVaR با ۶۰ سناریو."};

// ---------- ریاضی: نرمال، بلک–شولز، نوسان ضمنی ----------
function sgN(x){var t=1/(1+0.2316419*Math.abs(x)),d=0.3989423*Math.exp(-x*x/2),p=d*t*(0.3193815+t*(-0.3565638+t*(1.781478+t*(-1.821256+t*1.330274))));return x>0?1-p:p}
function sgInvN(p){var a=[-39.69683028665376,220.9460984245205,-275.9285104469687,138.357751867269,-30.66479806614716,2.506628277459239],
b=[-54.47609879822406,161.5858368580409,-155.6989798598866,66.80131188771972,-13.28068155288572],
c=[-0.007784894002430293,-0.3223964580411365,-2.400758277161838,-2.549732539343734,4.374664141464968,2.938163982698783],
d=[0.007784695709041462,0.3224671290700398,2.445134137142996,3.754408661907416],q,r;
if(p<=0)return-8;if(p>=1)return 8;
if(p<0.02425){q=Math.sqrt(-2*Math.log(p));return(((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5])/((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1)}
if(p>1-0.02425){q=Math.sqrt(-2*Math.log(1-p));return-(((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5])/((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1)}
q=p-0.5;r=q*q;return(((((a[0]*r+a[1])*r+a[2])*r+a[3])*r+a[4])*r+a[5])*q/(((((b[0]*r+b[1])*r+b[2])*r+b[3])*r+b[4])*r+1)}
function sgBS(S,K,T,r,v,call){if(T<=0||v<=0)return Math.max(call?S-K:K-S,0);var sq=v*Math.sqrt(T),d1=(Math.log(S/K)+(r+v*v/2)*T)/sq,d2=d1-sq;
return call?S*sgN(d1)-K*Math.exp(-r*T)*sgN(d2):K*Math.exp(-r*T)*sgN(-d2)-S*sgN(-d1)}
function sgIV(P,S,K,T,r,call){var lo=0.01,hi=4,i,m,ik=K*Math.exp(-r*T),intr=Math.max(call?S-ik:ik-S,0);
if(!(P>intr+1e-9)||T<=0)return 0;if(sgBS(S,K,T,r,hi,call)<P)return 0;
for(i=0;i<50;i++){m=(lo+hi)/2;if(sgBS(S,K,T,r,m,call)>P)hi=m;else lo=m}return(lo+hi)/2}
function sgCl(v,a,b){return Math.max(a,Math.min(b,v))}

// ---------- نوسان تاریخی (۴۵ روز معاملاتی اخیر، سالانه با ۲۴۰ روز) ----------
async function sgHist(ins){var h=SG.H[ins];if(h&&Date.now()-h.t<216e5)return h;var o={t:Date.now(),sig:0,n:0};
try{var j=JSON.parse(await GETC(TS+"ClosingPrice/GetClosingPriceDailyList/"+ins+"/60",216e5)),a=firstArr(j.closingPriceDaily||j),rows=[],seen={};
a.forEach(function(r){var d=num(r.dEven),c=num(r.pClosing);if(d<19000101||seen[d]||!(c>0))return;seen[d]=1;rows.push({d:d,c:c})});
rows.sort(function(x,y){return x.d-y.d});rows=rows.slice(-46);var rt=[],i;
for(i=1;i<rows.length;i++){var q=Math.log(rows[i].c/rows[i-1].c);if(Math.abs(q)<=0.12)rt.push(q)}
if(rt.length>=12){var m=rt.reduce(function(s,b){return s+b},0)/rt.length,v=rt.reduce(function(s,b){return s+(b-m)*(b-m)},0)/(rt.length-1);o.sig=Math.sqrt(v)*Math.sqrt(240);o.n=rt.length}}catch(e){}
if(!(o.sig>0))o.t=Date.now()-216e5+12e4;SG.H[ins]=o;return o}

// ---------- قالب‌بندی ----------
(function(){if(document.getElementById("sgcss"))return;var st=document.createElement("style");st.id="sgcss";
st.textContent='.sgt{width:100%;border-collapse:separate;border-spacing:0;font-size:10px;text-align:center;table-layout:auto}.sgt th,.sgt td{padding:3px 1px;border-bottom:1px solid var(--ln);line-height:1.4;white-space:nowrap}.sgt th{position:static!important;top:auto!important;background:#0a6b2c;color:#fff;font-size:9.5px;font-weight:700;white-space:normal;cursor:pointer;vertical-align:middle}.sgt tr.zb td{background:var(--acb)}.sgt small{font-size:8.5px;opacity:.75;font-weight:400}.sgq{display:inline-block;width:11px;height:11px;line-height:11px;border-radius:50%;background:#1e6fe0;color:#fff;font-size:8px;font-weight:700;margin-inline-start:2px;vertical-align:middle}.sgsc{overflow-x:auto}#sgsel{position:absolute!important;left:0;top:0;width:100%!important;height:100%!important;min-height:0!important;opacity:0;border:0!important;padding:0!important;font:400 10.5px Vazirmatn,Tahoma,sans-serif!important}#sgsel option{font:400 10.5px Vazirmatn,Tahoma,sans-serif!important}';
document.head.appendChild(st)})();
function sgOkC(x){return !!x.c&&x.cp>0&&x.vc!==0}
function sgOkP(x){return !!x.p&&x.pp>0&&x.vp!==0}
function sgPc(v,d){if(v==null||!isFinite(v))return"—";return'<span dir="ltr" style="color:'+xCol(v)+'">'+igFmt(v*100,d==null?1:d)+'٪</span>'}
function sgPn(v,d){return v==null||!isFinite(v)?"—":'<span dir="ltr">'+igFmt(v*100,d==null?0:d)+'٪</span>'}
function sgM(v){if(v==null||!isFinite(v))return"—";var a=Math.abs(v),s=v<0?"−":"",t,u="";if(a>=1e9){t=igFmt(a/1e9,2);u="میلیارد"}else if(a>=1e6){t=igFmt(a/1e6,1);u="میلیون"}else t=cfp(a);return'<span style="display:inline-block;line-height:1.25"><span dir="ltr">'+s+t+'</span>'+(u?'<br><small>'+u+'</small>':'')+'</span>'}
function sgMi(v){var a=Math.abs(v);return a>=1e9?igFmt(a/1e9,2)+" میلیارد":a>=1e6?igFmt(a/1e6,1)+" میلیون":cfp(a)}
function sgS(v){if(v==null||!isFinite(v))return"—";return'<span dir="ltr" style="color:'+xCol(v)+'">'+(v>0?"+":"")+sgM(v)+'</span>'}
function sgDays(e){return Math.max(1,Math.round((iso(e)-today)/864e5))}
function sgH(t,k){return'<th data-sgh="'+k+'">'+t+'<span class="sgq">?</span></th>'}
function sgTbl(h,rows){return'<div class="sgsc"><table class="sgt"><tr>'+h.map(function(x){return x.indexOf("<th")===0?x:'<th>'+x+'</th>'}).join("")+'</tr>'+
rows.map(function(r,i){return'<tr'+(i%2?"":' class="zb"')+'>'+r.map(function(c){return'<td>'+c+'</td>'}).join("")+'</tr>'}).join("")+'</table></div>'}
function sgSec(e,days,sub,body){return'<div class="mt2s" style="font-size:12px;margin:8px 0 3px">سررسید '+JJ.format(iso(e))+' · '+igFmt(days)+' روز'+(sub?' · '+sub:'')+'</div>'+body}
function sgNote(t){return'<div class="mut" style="font-size:10.5px;line-height:1.8;margin:2px 2px">'+t+'</div>'}
function sgSub(t){return'<div class="mut" style="font-weight:700;font-size:11px;margin:4px 2px 2px">'+t+'</div>'}
function sgStar(s){return'<span style="color:#f59e0b">★</span>'+s}
function sgNm(sym,k,star){return(star?sgStar(""):"")+'<b>'+esc(sym)+'</b><br><small>'+fp(k)+'</small>'}
var SGHELP={
px:["قیمت","قیمت اختیار به ریال برای هر سهم (آخرین معامله یا پایانی همان قرارداد). برای اجرای واقعی تابلوی قرارداد را ببینید."],
cc_ann:["بازده سالانه","بازده مؤثر (اگر ثابت برای اعمال بالاتر از قیمت، وگرنه اگر اعمال) × ۳۶۵ ÷ روز مانده."],
cc_be:["سربه‌سر","قیمت سهم منهای قیمت اختیار: تا قبل از این قیمت، با احتساب درآمد کال زیان نمی‌کنید."],
hr_be:["سربه‌سر","خرید کال: اعمال + قیمت اختیار. فروش پوت: اعمال − قیمت اختیار. قیمت سهم در سررسید باید از این نقطه به سمت سود برود."],
hr_ann:["بازده سالانه","درآمد پوت ÷ قیمت اعمال × ۳۶۵ ÷ روز مانده."],
lr_ty:["نوع","«قفل»: اعمال پوت و کال برابر است و نتیجه مستقل از قیمت سهم است. «کالر»: اعمال‌ها متفاوت است و فقط کف زیان و سقف سود دارید."],
sp_ty0:["نوع","نوع ساختار."],
bu_st:["ساختار","اعمال پایین‌تر (خرید) / اعمال بالاتر (فروش) و نماد کال پایین‌تر زیر آن. سود وقتی سهم بالا برود."],
bu_cost:["هزینه","خالص پرداختی برای کل قراردادها = (قیمت کال خریداری‌شده − قیمت کال فروخته‌شده) × اندازه‌ی قرارداد × تعداد."],
bu_win:["سود حداکثر","(فاصله‌ی دو اعمال − هزینه‌ی هر سهم) × اندازه‌ی قرارداد × تعداد؛ وقتی سهم در سررسید بالاتر از اعمال بالاتر باشد."],
bu_lose:["زیان حداکثر","همان هزینه‌ی خالص؛ وقتی سهم در سررسید پایین‌تر از اعمال پایین‌تر باشد."],
bu_be:["سربه‌سر","اعمال پایین‌تر + هزینه‌ی هر سهم."],
bu_prob:["احتمال سود","احتمال مدلی اینکه قیمت سهم در سررسید بالاتر از سربه‌سر باشد (لگ‌نرمال، نوسان تاریخی و نرخ مرجع). پیش‌بینی قطعی نیست."],
bu_sc:["بازده انتظار","میانگین سود در ۴۰ سناریوی هم‌احتمال ÷ هزینه‌ی هر سهم. بالاتر بهتر؛ منفی یعنی طبق مدل ارزش مورد انتظار منفی است. بدون کارمزد."],
be_cost:["دریافتی","خالص دریافتی برای کل قراردادها = (قیمت کال فروخته‌شده − قیمت کال خریداری‌شده) × اندازه‌ی قرارداد × تعداد. بورس برای کال فروخته‌شده وجه تضمین می‌گیرد."],
be_win:["سود حداکثر","همان دریافتی خالص؛ وقتی سهم در سررسید پایین‌تر از اعمال پایین‌تر باشد."],
be_lose:["زیان حداکثر","(فاصله‌ی دو اعمال − دریافتی هر سهم) × اندازه‌ی قرارداد × تعداد؛ وقتی سهم در سررسید بالاتر از اعمال بالاتر باشد."],
be_be:["سربه‌سر","اعمال پایین‌تر + دریافتی هر سهم."],
be_st:["ساختار","اعمال پایین‌تر (فروش) / اعمال بالاتر (خرید) و نماد کال پایین‌تر زیر آن. سود وقتی سهم بالا نرود."],
be_prob:["احتمال سود","احتمال مدلی اینکه قیمت سهم در سررسید پایین‌تر از سربه‌سر باشد."],
be_sc:["بازده انتظار","میانگین سود در ۴۰ سناریو ÷ بیشترین زیان هر سهم. بالاتر بهتر؛ بدون کارمزد."],
sym:["نماد و اعمال","نام قرارداد در خط اول و قیمت اعمال آن در خط دوم (ریز) نوشته شده است."],
cc_ret:["بازده کاورد کال","خط اول «اگر ثابت»: اگر قیمت سهم تا سررسید زیر قیمت اعمال بماند و اختیار اعمال نشود، بازده = قیمت اختیار ÷ قیمت سهم (فقط وقتی اعمال بالاتر از قیمت سهم است). خط دوم «اگر اعمال»: اگر سهم به قیمت اعمال فروخته شود، بازده = (اعمال + قیمت اختیار − قیمت سهم − کارمزد فروش) ÷ قیمت سهم."],
cc_inc:["درآمد کل","قیمت اختیار × اندازه‌ی قرارداد × تعداد قراردادی که با سهام شما پوشش داده می‌شود، به ریال. واحد (میلیارد یا میلیون) زیر عدد نوشته شده است."],
hr_dist:["فاصله تا سربه‌سر","درصد فاصله‌ی قیمت سهم تا نقطه‌ی سربه‌سر. برای خرید کال مثبت یعنی سهم باید این‌قدر رشد کند؛ برای فروش پوت منفی یعنی سهم تا این‌قدر می‌تواند افت کند و هنوز زیان نمی‌دهید."],
hr_prob:["احتمال سود","احتمال تقریبی (مدل لگ‌نرمال با نوسان تاریخی و نرخ مرجع) اینکه قیمت سهم در سررسید فراتر از سربه‌سر باشد. پیش‌بینی قطعی نیست."],
hr_roi:["سود اگر ۱۰٪ رشد","بازده روی مبلغ پرداختی خرید کال اگر قیمت سهم تا سررسید ۱۰٪ بالا برود: (بیشینه‌ی [قیمت سهم×۱٫۱ − اعمال، ۰] − قیمت اختیار) ÷ قیمت اختیار."],
hr_loss:["زیان حداکثر","در خرید کال، بیشترین زیان همان کل مبلغ پرداختی (قیمت × اندازه‌ی قرارداد × تعداد قرارداد) است."],
hr_mrg:["وجه تضمین","وجه تضمینی که بورس برای نگه‌داشتن موقعیت فروش پوت می‌گیرد؛ اگر در داده‌ی بورس نبود «—» می‌آید. زیان فروش پوت می‌تواند بسیار بزرگ‌تر از درآمد آن باشد."],
lr_put:["پوت (خرید)","اختیار فروشی که می‌خرید تا کف قیمت فروش سهمتان را تضمین کند. بالا: قیمت اعمال؛ پایین: نماد."],
lr_call:["کال (فروش)","اختیار خریدی که می‌فروشید و پولش را می‌گیرید؛ در عوض سقف سود سهم شما قیمت اعمال آن می‌شود. بالا: قیمت اعمال؛ پایین: نماد."],
lr_net:["خالص","درآمد فروش کال منهای هزینه‌ی خرید پوت. سبز و + یعنی خالص دریافتی، قرمز و − یعنی خالص پرداختی."],
lr_wor:["بدترین حالت","بازده در بدترین سناریو (سهم زیر قیمت اعمال پوت) با لحاظ کارمزد فروش. در «قفل سود» با بهترین حالت برابر است."],
lr_bes:["بهترین حالت","بازده در بهترین سناریو (سهم بالای قیمت اعمال کال) با لحاظ کارمزد فروش."],
lr_ann:["سالانه","بهترین حالت × ۳۶۵ ÷ روز مانده. برای «قفل سود» علامت ✓ یعنی از نرخ مرجع سالانه بیشتر است."],
rc_prob:["احتمال اعمال","احتمال مدلی اینکه قیمت سهم در سررسید بالاتر از قیمت اعمال کال باشد و سهم شما فروخته شود."],
rc_iv:["IV / HV","IV نوسان ضمنی همان کال از قیمت بازار؛ HV نوسان تاریخی سهم در ۴۵ روز معاملاتی اخیر. IV بالاتر از HV یعنی اختیار گران‌تر از نوسان واقعی قیمت‌گذاری شده و فروش آن مزیت دارد."],
rc_ann:["بازده سالانه","درآمد مورد انتظار E = (۱−p)×(قیمت اختیار÷سهم) + p×بازده اعمال، سالانه‌شده با ۳۶۵÷روز مانده."],
rc_cnt:["تعداد قرارداد","اندازه‌ی پیشنهادی فروش کال از کل قراردادهای قابل پوشش با سهام شما. هرچه احتمال اعمال بیشتر باشد کمتر می‌فروشید (حداقل ۴۰٪ ظرفیت)."],
rc_sc:["امتیاز","امتیاز = بازده سالانه‌ی E × (۱ + حد [VRP÷HV بین ۰٫۵− و ۱]) × (۱ − ۰٫۶×p). بالاتر بهتر است."],
sp_ty:["نوع ساختار","«کالر»: خرید پوت + فروش کال. «کاورد»: فقط فروش کال. «محافظ»: فقط خرید پوت. قفل‌های هم‌اعمال در این سربرگ نیستند."],
sp_st:["ساختار","قیمت اعمال پوتِ خریداری‌شده و کالِ فروخته‌شده."],
sp_net:["خالص","سبز و + خالص دریافتی، قرمز و − خالص پرداختی برای کل قراردادها."],
sp_avg:["میانگین انتظار","میانگین بازده ساختار در ۶۰ سناریوی هم‌احتمال قیمت سهم تا سررسید (بدون کارمزد)."],
sp_cv:["CVaR ۵٪","میانگین بازده بدترین ۵٪ سناریوها؛ هرچه منفی‌تر، زیان دم بزرگ‌تر."],
sp_imp:["بهبود سالانه","(J ساختار − J نگهداری ساده) × ۳۶۵ ÷ روز مانده، که J = میانگین بازده − ۰٫۵ × CVaR. فقط ساختارهای بهتر از نگهداری ساده می‌آیند."]};
function sgHelp(k){var h=SGHELP[k];if(!h)return;var o=document.getElementById("hb");if(o)o.remove();o=document.createElement("div");o.id="hb";
o.innerHTML='<div class="bx"><b class="t">'+esc(h[0])+'</b>'+esc(h[1])+'<button type="button">بستن</button></div>';
o.onclick=function(e){if(e.target===o||e.target.tagName==="BUTTON")o.remove()};document.body.appendChild(o)}

// ---------- ۱) کاورد کال ----------
function sgCC(o,e,days){var l=o.its.filter(function(x){return x.e===e&&sgOkC(x)}).sort(function(a,b){return a.k-b.k}),rows=[],best=-1,bv=-1e9;
l.forEach(function(x,i){var K=x.k,pm=x.cp,flat=pm/o.S0,asg=(K+pm-o.S0-K*PFF)/o.S0,eff=K>=o.S0?flat:asg,ann=eff*365/days;
if(K>=o.S0*0.98&&ann>bv){bv=ann;best=i}x._a=[K,pm,(K>=o.S0?sgPc(flat,1):"—")+"<br>"+sgPc(asg,1),sgPc(ann,0),fp(o.S0-pm),sgM(pm*o.z*o.nc)]});
l.forEach(function(x,i){rows.push([sgNm(x.c,x.k,i===best)].concat(x._a.slice(1)))});
if(!rows.length)return"";
return sgSec(e,days,o.nc+" قرارداد",sgTbl([sgH("نماد","sym"),sgH("قیمت","px"),sgH("بازده","cc_ret"),sgH("سالانه","cc_ann"),sgH("سربه‌سر","cc_be"),sgH("درآمد","cc_inc")],rows))}

// ---------- کال اسپرد صعودی / نزولی ----------
function sgSprData(o,e,days,bull){var T=days/365,sg=o.sig,Q=40,sc=[],i,a,b,out=[];
for(i=0;i<Q;i++)sc.push(o.S0*Math.exp((o.rf-sg*sg/2)*T+sg*Math.sqrt(T)*sgInvN((i+0.5)/Q)));
var CL=o.its.filter(function(x){return x.e===e&&sgOkC(x)&&x.k>=o.S0*0.85&&x.k<=o.S0*1.3}).sort(function(p,q){return p.k-q.k});
for(a=0;a<CL.length;a++)for(b=a+1;b<CL.length;b++){var c1=CL[a],c2=CL[b],w=c2.k-c1.k,d=c1.cp-c2.cp;if(!(d>0&&d<w))continue;
var be=c1.k+d,pr=bull?1-sgN((Math.log(be/o.S0)-(o.rf-sg*sg/2)*T)/(sg*Math.sqrt(T))):sgN((Math.log(be/o.S0)-(o.rf-sg*sg/2)*T)/(sg*Math.sqrt(T))),E=0;
for(i=0;i<Q;i++){var V=Math.max(sc[i]-c1.k,0)-Math.max(sc[i]-c2.k,0);E+=bull?V-d:d-V}E/=Q;
var win=bull?w-d:d,lose=bull?d:w-d;if(bull?pr<0.2:pr<0.45)continue;
out.push({c1:c1,c2:c2,d:d,be:be,pr:pr,win:win,lose:lose,E:E,sc:E/(bull?d:lose)})}
out.sort(function(p,q){return q.sc-p.sc});return out.slice(0,4)}
function sgSpr(o,e,days,bull){var l=sgSprData(o,e,days,bull);if(!l.length)return"";var k=bull?"bu":"be",m=o.z*o.nc;
var rows=l.map(function(r,i){return[(i?"":sgStar(""))+'<b>'+fp(r.c1.k)+' / '+fp(r.c2.k)+'</b><br><small>'+esc(r.c1.c)+'</small>',sgM(r.d*m),sgM(r.win*m),sgM(-r.lose*m),fp(r.be),sgPn(r.pr,0),sgPc(r.sc,0)]});
return sgSec(e,days,o.nc+" قرارداد",sgTbl([sgH("ساختار",k+"_st"),sgH(bull?"هزینه":"دریافتی",k+"_cost"),sgH("سود+",k+"_win"),sgH("زیان−",k+"_lose"),sgH("سربه‌سر",k+"_be"),sgH("احتمال",k+"_prob"),sgH("بازده",k+"_sc")],rows))}

// ---------- ۲) پرریسک ----------
function sgHR(o,e,days){var T=days/365,sg=o.sig,out="",cl=[],pl=[];
o.its.forEach(function(x){if(x.e!==e)return;
if(sgOkC(x)){var K=x.k,P=x.cp,be=K+P,m=be/o.S0-1;if(m>=-0.03&&m<=0.12&&days>=3){var pay=Math.max(o.S0*1.1-K,0)-P,roi=pay/P,pr=1-sgN((Math.log(be/o.S0)-(o.rf-sg*sg/2)*T)/(sg*Math.sqrt(T)));cl.push({x:x,be:be,m:m,roi:roi,pr:pr,sc:roi*pr})}}
if(sgOkP(x)){var K2=x.k,P2=x.pp,be2=K2-P2,cu=1-be2/o.S0;if(K2<=o.S0&&cu>=0.03&&days>=3){var pr2=1-sgN((Math.log(be2/o.S0)-(o.rf-sg*sg/2)*T)/(sg*Math.sqrt(T))),yl=P2/K2;pl.push({x:x,be:be2,cu:cu,pr:pr2,ann:yl*365/days,sc:yl*365/days*pr2})}}});
cl.sort(function(a,b){return b.sc-a.sc});cl=cl.slice(0,3);pl.sort(function(a,b){return b.sc-a.sc});pl=pl.slice(0,3);
if(cl.length)out+=sgSub("خرید اختیار خرید (اهرمی)")+sgTbl([sgH("نماد","sym"),sgH("قیمت","px"),sgH("سربه‌سر","hr_be"),sgH("فاصله","hr_dist"),sgH("احتمال","hr_prob"),sgH("سود۱۰٪","hr_roi"),sgH("زیان","hr_loss")],
cl.map(function(r,i){return[sgNm(r.x.c,r.x.k,i===0),fp(r.x.cp),fp(r.be),sgPc(r.m,1),sgPn(r.pr,0),sgPc(r.roi,0),sgM(-r.x.cp*o.z*o.nc)]}));
if(pl.length)out+=sgSub("فروش اختیار فروش (نیازمند وجه تضمین)")+sgTbl([sgH("نماد","sym"),sgH("قیمت","px"),sgH("سربه‌سر","hr_be"),sgH("فاصله","hr_dist"),sgH("احتمال","hr_prob"),sgH("سالانه","hr_ann"),sgH("تضمین","hr_mrg")],
pl.map(function(r,i){return[sgNm(r.x.p,r.x.k,i===0),fp(r.x.pp),fp(r.be),sgPc(-r.cu,1),sgPn(r.pr,0),sgPc(r.ann,0),r.x.mp>0?sgM(r.x.mp*o.z*o.nc):"—"]}));
if(!out)return"";return sgSec(e,days,o.nc+" قرارداد",out)}

// ---------- ۳) کم‌ریسک ----------
function sgLR(o,e,days){var CL=o.its.filter(function(x){return x.e===e&&sgOkC(x)}),PL=o.its.filter(function(x){return x.e===e&&sgOkP(x)}),lk=[],co=[],i,j;
for(i=0;i<PL.length;i++)for(j=0;j<CL.length;j++){var p=PL[i],c=CL[j];if(p.k>c.k)continue;if(p.k<o.S0*0.88||c.k>o.S0*1.2)continue;
var net=c.cp-p.pp,worst=(p.k-o.S0+net-p.k*PFF)/o.S0,best=(c.k-o.S0+net-c.k*PFF)/o.S0,ann=best*365/days;
if(p.k===c.k){if(best>0)lk.push({p:p,c:c,net:net,worst:worst,best:best,ann:ann})}else if(worst>=-0.03&&best>0)co.push({p:p,c:c,net:net,worst:worst,best:best,ann:ann})}
lk.sort(function(a,b){return b.ann-a.ann});lk=lk.slice(0,2);co.sort(function(a,b){return b.ann-a.ann});co=co.slice(0,3);
var rows=[],rf=o.rf;
function row(r,ty,ty0){rows.push([ty,'<b>'+fp(r.p.k)+'</b><br><small>'+esc(r.p.p)+'</small>','<b>'+fp(r.c.k)+'</b><br><small>'+esc(r.c.c)+'</small>',sgS(r.net*o.z*o.nc),sgPc(r.worst,1),sgPc(r.best,1),
'<b style="color:'+(ty0&&r.ann>=rf?"var(--up)":"var(--tx)")+'">'+igFmt(r.ann*100,0)+'٪'+(ty0&&r.ann>=rf?"✓":"")+'</b>'])}
lk.forEach(function(r,i){row(r,sgStar("قفل"),1)});co.forEach(function(r){row(r,"کالر",0)});
if(!rows.length)return"";
return sgSec(e,days,o.nc+" قرارداد",sgTbl([sgH("نوع","lr_ty"),sgH("پوت","lr_put"),sgH("کال","lr_call"),sgH("خالص","lr_net"),sgH("بدترین","lr_wor"),sgH("بهترین","lr_bes"),sgH("سالانه","lr_ann")],rows))}

// ---------- ۴) پیشنهادی ----------
function sgRCdata(o,e,days){var T=days/365,sg=o.sig,out=[];
o.its.forEach(function(x){if(x.e!==e||!sgOkC(x))return;var K=x.k,P=x.cp;
if(K<o.S0*0.97||P/o.S0<0.008||days<5)return;
var iv=sgIV(P,o.S0,K,T,o.rf,true);if(!(iv>0))return;
var vrp=iv-sg,p=sgN((Math.log(o.S0/K)+(o.rf-sg*sg/2)*T)/(sg*Math.sqrt(T))),flat=P/o.S0,asg=(K+P-o.S0-K*PFF)/o.S0,
E=(1-p)*flat+p*asg,annE=E*365/days,mult=1+sgCl(vrp/sg,-0.5,1),sc=annE*mult*(1-0.6*p),
size=Math.max(1,Math.floor(o.nc*sgCl(1-p,0.4,1)));
out.push({x:x,iv:iv,vrp:vrp,p:p,annE:annE,sc:sc,size:size,e:e,days:days})});
out.sort(function(a,b){return b.sc-a.sc});return out.slice(0,5)}
function sgRC(o,e,days,topKey){var l=sgRCdata(o,e,days);if(!l.length)return"";
var rows=l.map(function(r){return[sgNm(r.x.c,r.x.k,topKey&&r.x.c===topKey),fp(r.x.cp),sgPn(r.p,0),'<span dir="ltr">'+igFmt(r.iv*100,0)+'/'+igFmt(o.sig*100,0)+'</span>',sgPc(r.annE,0),igFmt(r.size)+'/'+igFmt(o.nc),'<b>'+igFmt(r.sc*100,0)+'</b>']});
return sgSec(e,days,o.nc+" قرارداد",sgTbl([sgH("نماد","sym"),sgH("قیمت","px"),sgH("احتمال","rc_prob"),sgH("IV/HV","rc_iv"),sgH("سالانه","rc_ann"),sgH("تعداد","rc_cnt"),sgH("امتیاز","rc_sc")],rows))}

// ---------- ۵) ویژه ----------
function sgSPdata(o,e,days){var T=days/365,sg=o.sig,Q=60,sc=[],i,j,k;
for(i=0;i<Q;i++){var z=sgInvN((i+0.5)/Q);sc.push(o.S0*Math.exp((o.rf-sg*sg/2)*T+sg*Math.sqrt(T)*z))}
var CL=[null].concat(o.its.filter(function(x){return x.e===e&&sgOkC(x)&&x.k>=o.S0*0.95&&x.k<=o.S0*1.25})),
PL=[null].concat(o.its.filter(function(x){return x.e===e&&sgOkP(x)&&x.k>=o.S0*0.85&&x.k<=o.S0*1.05})),res=[],base=null,LAM=0.5,nT=Math.max(1,Math.round(Q*0.05));
for(j=0;j<PL.length;j++)for(k=0;k<CL.length;k++){var p=PL[j],c=CL[k],R=[],E=0;if(p&&c&&p.k>=c.k)continue;
for(i=0;i<Q;i++){var s=sc[i],g=s-o.S0;if(p)g+=Math.max(p.k-s,0)-p.pp;if(c)g+=c.cp-Math.max(s-c.k,0);g/=o.S0;R.push(g);E+=g}
E/=Q;R.sort(function(a,b){return a-b});var cv=0;for(i=0;i<nT;i++)cv+=R[i];cv=-cv/nT;var J=E-LAM*cv,net=(c?c.cp:0)-(p?p.pp:0);
var r={p:p,c:c,E:E,cv:cv,J:J,net:net};if(!p&&!c)base=r;else res.push(r)}
if(!base)return[];
res.forEach(function(r){r.imp=r.J-base.J;r.ann=r.imp*365/days});
res=res.filter(function(r){return r.imp>0}).sort(function(a,b){return b.ann-a.ann});
return{list:res.slice(0,3),base:base}}
function sgSP(o,e,days,topKey){var d=sgSPdata(o,e,days);if(!d.list||!d.list.length)return sgSec(e,days,o.nc+" قرارداد",sgNote("در این سررسید ساختاری بهتر از «فقط نگهداری سهام» پیدا نشد (بر اساس مدل)."));
var rows=d.list.map(function(r){var ty=r.p&&r.c?"کالر":(r.c?"کاورد":"محافظ"),key=(r.p?r.p.p:"")+"|"+(r.c?r.c.c:""),net=r.net*o.z*o.nc;
return[(topKey&&key===topKey?sgStar(""):"")+ty,(r.p?'پوت '+fp(r.p.k):"")+(r.p&&r.c?"<br>":"")+(r.c?'کال '+fp(r.c.k):""),sgS(net),sgPc(r.E,1),sgPc(-r.cv,1),sgPc(r.ann,0)]});
return sgSec(e,days,o.nc+" قرارداد",sgTbl([sgH("نوع","sp_ty"),sgH("ساختار","sp_st"),sgH("خالص","sp_net"),sgH("میانگین","sp_avg"),sgH("CVaR","sp_cv"),sgH("بهبود","sp_imp")],rows)+
sgNote("نگهداری ساده: میانگین "+sgPc(d.base.E,1)+" · CVaR ۵٪ "+sgPc(-d.base.cv,1)))}

// ---------- بدنه‌ی صفحه ----------
function sgTopKeys(o,ex){var rc=null,rs=-1e9,sp=null,ss=-1e9;
ex.forEach(function(e){var days=sgDays(e),l=sgRCdata(o,e,days);if(l.length&&l[0].sc>rs){rs=l[0].sc;rc=l[0].x.c}
var d=sgSPdata(o,e,days);if(d.list&&d.list.length&&d.list[0].ann>ss){ss=d.list[0].ann;var r=d.list[0];sp=(r.p?r.p.p:"")+"|"+(r.c?r.c.c:"")}});
return{rc:rc,sp:sp}}
function sgBody(o){var t0=ds(today),ex=[];o.its.forEach(function(x){if(x.e>=t0&&ex.indexOf(x.e)<0)ex.push(x.e)});ex.sort();
if(!ex.length)return'<div class="card mut" style="text-align:center">برای این نماد سررسید فعالی پیدا نشد.</div>';
if(SG.ex!=="all"&&ex.indexOf(SG.ex)<0)SG.ex="all";
var bar='<div class="exb2"><span class="l">سررسید</span><div class="exs2"><button type="button" data-sge="all"'+(SG.ex==="all"?' class="on"':'')+'>همه</button>'+ex.map(function(e){return'<button type="button" data-sge="'+e+'"'+(e===SG.ex?' class="on"':'')+'>'+JJ.format(iso(e))+'</button>'}).join("")+'</div></div>';
if(o.nc<1)return bar+'<div class="card mut" style="line-height:2">تعداد سهام شما ('+igFmt(o.q)+') کمتر از اندازه‌ی یک قرارداد ('+igFmt(o.z)+' سهم) است؛ برای ساخت این موقعیت‌ها دست‌کم '+igFmt(o.z)+' سهم لازم است. تعداد سهام را در صفحه‌ی «پرتفو» اصلاح کنید.</div>';
var L=SG.ex==="all"?ex:[SG.ex],h="",top=(SG.tab==="rc"||SG.tab==="sp")?sgTopKeys(o,L):{};
L.forEach(function(e){var d=sgDays(e),s="";
if(SG.tab==="cc")s=sgCC(o,e,d);else if(SG.tab==="bu")s=sgSpr(o,e,d,true);else if(SG.tab==="be")s=sgSpr(o,e,d,false);else if(SG.tab==="hr")s=sgHR(o,e,d);else if(SG.tab==="lr")s=sgLR(o,e,d);else if(SG.tab==="rc")s=sgRC(o,e,d,top.rc);else s=sgSP(o,e,d,top.sp);
h+=s});
if(!h)h='<div class="card mut" style="text-align:center;line-height:2">با داده‌ی فعلی موقعیتی با شرایط این سربرگ پیدا نشد (قرارداد بدون معامله یا بدون قیمت کنار گذاشته می‌شود).</div>';
return bar+'<div class="card" style="padding:4px">'+sgNote(SGD[SG.tab])+h+'</div>'}

function sgPageExplain(){var T={
cc:["کاورد کال","سهام را نگه می‌دارید و روی همان‌ها اختیار خرید می‌فروشید. همین الان پول قیمت اختیار را می‌گیرید؛ در عوض اگر سهم از اعمال بالاتر رفت، سهم شما به قیمت اعمال فروخته می‌شود. هر سطر یک قرارداد (یک قیمت اعمال) است. «بازده» خط اول وقتی اعمال بالاتر از قیمت سهم است و سهم نمی‌رود (اگر ثابت)، خط دوم اگر اعمال شود. ستاره بهترین بازده سالانه‌ی هر سررسید است. مناسب بازار خنثی تا کمی صعودی و کسی است که حاضر است سهمش را در قیمت اعمال بفروشد."],
bu:["کال اسپرد صعودی","وقتی انتظار رشد متوسط سهم را دارید: کال پایین‌تر می‌خرید و کال بالاتر می‌فروشید. ستون «ساختار» دو قیمت اعمال را نشان می‌دهد؛ «هزینه» پرداختی است، «سود+» و «زیان−» سقف سود و زیان کل قراردادها هستند. اگر سهم از اعمال بالاتر رد شود سود به سقف می‌رسد و بیشتر نمی‌شود. «بازده» میانگین سود مدلی نسبت به هزینه است؛ منفی یعنی طبق مدل خرج‌کردن به صرفه نیست."],
be:["کال اسپرد نزولی","وقتی انتظار دارید سهم بالا نرود: کال پایین‌تر می‌فروشید و کال بالاتر می‌خرید. همین الان مبلغ «دریافتی» را می‌گیرید و آن سقف سود شماست؛ اگر سهم از اعمال بالاتر رد شود به سقف زیان می‌رسید. خرید کال بالاتر مانع زیان نامحدود است. برای کال فروخته‌شده بورس وجه تضمین می‌گیرد."],
hr:["پرریسک (ولی سودساز)","دو ابزار اهرمی: «خرید کال» با پرداخت کم، سود بالا در رشد زیاد ولی احتمال از دست رفتن کل مبلغ؛ «فروش پوت» که درآمد می‌دهد ولی اگر سهم ریزش کند زیان بزرگ است و وجه تضمین می‌خواهد. سطرها بر اساس بازده × احتمال سود مرتب‌اند و ستاره‌ی هر جدول برترین است. فقط با مبلغی که توان از دست دادنش را دارید."],
lr:["کم‌ریسک (ولی مطمئن)","روی سهامی که دارید پوت می‌خرید (کف قیمت) و کال می‌فروشید (سقف سود). «قفل»: اعمال هر دو برابر است و نتیجه ثابت و مستقل از قیمت سهم است؛ علامت ✓ یعنی بازده سالانه از نرخ مرجع بالاتر است. «کالر»: اعمال‌ها فرق دارد؛ بدترین حالت از ۳٪− بدتر نیست و بهترین حالت ستون بعدی است. شکاف قیمت خرید و فروش و کارمزد می‌تواند سود را کم کند."],
rc:["پیشنهادی","کاورد کال با لبه‌ی نوسان: از بین کال‌ها آن‌هایی که هم درآمد سالانه‌ی خوب دارند و هم IV بالاتر از HV دارند (اختیار گران‌تر از نوسان واقعی) و احتمال اعمالشان کم است بالا می‌آیند. ستون «تعداد» اندازه‌ی پیشنهادی فروش از ظرفیت شماست و «امتیاز» نتیجه‌ی فرمول است؛ هرچه بالاتر بهتر. ستاره برترین بین سررسیدهای نمایش‌داده‌شده است."],
sp:["ویژه","بین کاورد کال، پوت محافظ و کالر، با ۶۰ سناریو بهترین ترکیب را از نظر «میانگین بازده منهای نیمی از زیان دم (CVaR)» پیدا می‌کند و فقط ساختارهای بهتر از نگهداری ساده را نشان می‌دهد. «بهبود» یعنی چقدر در سال از نگهداری ساده بهتر است. زیر جدول، میانگین و CVaR نگهداری ساده برای مقایسه نوشته شده است."]};
var t=T[SG.tab]||T.cc;return'<div class="card" style="padding:8px;margin-top:8px;line-height:1.9;font-size:12px"><b>توضیح همین صفحه — '+t[0]+'</b><br>'+t[1]+'</div>'}
function sgExplain(){return'<div class="card" style="padding:10px;margin-top:8px;line-height:2.05;font-size:12px"><b>توضیح کامل صفحه‌ی «استراتژی»</b><br>'+
'<b>این صفحه چیست؟</b> نوار رنگی بالا یک لیست کشویی از سهام پرتفوی شماست که بازار اختیار معامله دارد. با لمس آن و انتخاب یک سهم، کل صفحه برای همان سهم ساخته می‌شود: همه‌ی موقعیت‌های آپشن، به تفکیک سررسید و سربرگ و به اندازه‌ی سهامی که دارید. با لمس نوار هر سهم در صفحه‌ی «پرتفو» هم مستقیم به همین صفحه می‌آیید. روی سربرگ‌های جدول‌ها علامت ؟ آبی هست؛ لمس سربرگ توضیح کامل را نشان می‌دهد. مبلغ‌ها به ریال‌اند و واحد (میلیارد یا میلیون) زیر عدد نوشته می‌شود. تعداد قرارداد = سهام شما ÷ اندازه‌ی قرارداد (معمولاً ۱٬۰۰۰ سهم)، با رند به پایین. همه‌ی ارقام برای همین تعداد قرارداد و به ریال است.<br>'+
'<b>داده‌ها:</b> قیمت سهم، آخرین قیمت (در ساعت بازار) یا پایانی؛ قیمت اختیارها آخرین معامله یا پایانی همان قرارداد؛ قراردادِ بدون قیمت یا بدون معامله‌ی امروز کنار گذاشته می‌شود. نوسان تاریخی (HV) از ۴۵ روز معاملاتی اخیر و نوسان ضمنی (IV) از قیمت بازار با مدل بلک–شولز به دست می‌آید. نرخ مرجع سالانه (پیش‌فرض ۳۰٪) را بالای صفحه می‌توانید عوض کنید؛ در مدل نرخ بدون ریسک و معیار مقایسه‌ی «قفل سود» است. کارمزد فروش سهم (۰٫۸۸٪) در حالت‌هایی که سهم به قیمت اعمال فروخته می‌شود لحاظ شده؛ کارمزد خرید و فروش خودِ اختیارها و هزینه‌ی وجه تضمین لحاظ نشده است.<br>'+
'<b>۱) کاورد کال:</b> سهام را نگه می‌دارید و اختیار خرید می‌فروشید. درآمد = قیمت اختیار؛ سربه‌سر = قیمت سهم − قیمت اختیار؛ «اگر ثابت» = قیمت اختیار ÷ قیمت سهم (فقط وقتی اعمال بالاتر از قیمت است)؛ «اگر اعمال» = (قیمت اعمال + قیمت اختیار − قیمت سهم − کارمزد فروش) ÷ قیمت سهم؛ سالانه = بازده × ۳۶۵ ÷ روز مانده. ستاره برای بهترین بازده سالانه‌ی هر سررسید (اعمال دست‌کم ۹۸٪ قیمت سهم) است. خطر: اگر سهم شدید رشد کند سود شما به قیمت اعمال محدود می‌شود و اگر شدید بریزد فقط به اندازه‌ی درآمد اختیار پوشش دارید.<br>'+
'<b>۲) کال اسپرد صعودی (Bull Call Spread):</b> یک کال با اعمال پایین‌تر می‌خرید و یک کال با اعمال بالاتر می‌فروشید (هر دو هم‌سررسید). هزینه = قیمت کالِ خرید − قیمت کالِ فروش؛ سود حداکثر = (فاصله‌ی دو اعمال − هزینه)؛ زیان حداکثر = هزینه؛ سربه‌سر = اعمال پایین‌تر + هزینه. دو سر سود و زیان محدود است و مبلغ پرداختی از خرید تکی کال کمتر است. «احتمال» = احتمال مدلی بالاتر بودن سهم از سربه‌سر. «بازده» = میانگین سود در ۴۰ سناریو ÷ هزینه. جفت‌هایی که احتمال سودشان زیر ۲۰٪ است نمی‌آیند و چهار جفت برتر هر سررسید نمایش داده می‌شود. اگر بازده منفی باشد یعنی طبق مدل ارزش مورد انتظار منفی است.<br>'+
'<b>۳) کال اسپرد نزولی (Bear Call Spread):</b> یک کال با اعمال پایین‌تر می‌فروشید و یک کال با اعمال بالاتر می‌خرید. دریافتی = قیمت کالِ فروش − قیمت کالِ خرید؛ سود حداکثر = همین دریافتی (وقتی سهم زیر اعمال پایین‌تر بماند)؛ زیان حداکثر = فاصله‌ی دو اعمال − دریافتی؛ سربه‌سر = اعمال پایین‌تر + دریافتی. وقتی انتظار دارید سهم بالا نرود یا بریزد مناسب است. بورس برای کال فروخته‌شده وجه تضمین می‌گیرد. «بازده» = میانگین سود در ۴۰ سناریو ÷ بیشترین زیان؛ جفت‌های با احتمال سود زیر ۴۵٪ نمی‌آیند. در هر دو اسپرد، تعداد قرارداد همان تعدادی است که با سهام شما قابل پوشش است (سهام شما برای ساخت اسپرد لازم نیست و فقط اندازه را مشخص می‌کند).<br>'+
'<b>۴) پرریسک (ولی سودساز):</b> دو ابزار. (الف) خرید کال: بیشترین زیان = کل قیمت پرداختی؛ سربه‌سر = اعمال + قیمت؛ «سود اگر ۱۰٪+» بازده روی پرداختی در صورت رشد ۱۰٪ سهم؛ «احتمال سود» = احتمال مدلی رسیدن قیمت سهم به بالاتر از سربه‌سر. رتبه = بازده سناریوی ۱۰٪ × احتمال سود. (ب) فروش پوت: درآمد = قیمت پوت؛ سربه‌سر = اعمال − قیمت؛ اگر سهم زیر سربه‌سر برود زیان دارید و باید وجه تضمین نگه دارید. رتبه = بازده سالانه × احتمال سود. هر دو برای حسابِ پرنوسان‌اند و ممکن است کل پرداختی از دست برود.<br>'+
'<b>۵) کم‌ریسک (ولی مطمئن):</b> روی سهام شما پوت می‌خرید و کال می‌فروشید. اگر قیمت اعمال هر دو برابر باشد «قفل سود» است: نتیجه مستقل از قیمت سهم = (اعمال + قیمت کال − قیمت پوت − قیمت سهم − کارمزد فروش) ÷ قیمت سهم. اگر دو قیمت اعمال فرق کنند «کالر» است: بدترین حالت (سهم زیر اعمال پوت) و بهترین حالت (سهم بالای اعمال کال) نشان داده می‌شود و فقط ترکیب‌هایی که بدترین حالتشان بدتر از ۳٪− نیست می‌آیند. علامت ✓ یعنی بازده سالانه از نرخ مرجع بیشتر است. این‌ها «مطمئن» نیستند مگر با حجم کافی و اجرای هر دو سمت؛ شکاف قیمت خرید و فروش و کارمزدها می‌تواند سود را کم یا صفر کند.<br>'+
'<b>۶) پیشنهادی (کاورد کال با لبه‌ی نوسان):</b> ایده: وقتی IV اختیار از نوسان واقعی سهم (HV) بالاتر است، فروش آن بهتر قیمت‌گذاری شده است. برای هر کال: p = احتمال اعمال (مدل لگ‌نرمال با HV)، درآمد مورد انتظار E = (۱−p)×(قیمت÷سهم) + p×بازدهِ اعمال، سالانه‌شده؛ VRP = IV − HV. فرمول امتیاز: <b>امتیاز = بازده سالانه‌ی E × (۱ + حدِ [VRP÷HV بین ۰٫۵− و ۱]) × (۱ − ۰٫۶×p)</b>. شرط‌ها: اعمال دست‌کم ۹۷٪ قیمت سهم، قیمت اختیار دست‌کم ۰٫۸٪ قیمت سهم، حداقل ۵ روز مانده. «قرارداد» اندازه‌ی پیشنهادی = تعداد قراردادها × (۱−p) با حداقل ۴۰٪؛ هرچه احتمال اعمال بیشتر، کمتر می‌فروشید تا سهمتان را کمتر از دست بدهید. ستاره برترین امتیاز کل سررسیدهای نمایش‌داده‌شده.<br>'+
'<b>۷) ویژه (بهینه‌سازی میانگین–CVaR):</b> برای هر سررسید ۶۰ سناریوی هم‌احتمال قیمت سهم ساخته می‌شود (توزیع لگ‌نرمال با نوسان HV و رشد برابر نرخ مرجع). هر ساختار ممکن روی سهم شما (فقط کاورد کال، فقط پوت محافظ، یا کالر با همه‌ی جفت‌اعمال‌ها) در همه‌ی سناریوها ارزیابی می‌شود. J = میانگین بازده − ۰٫۵ × CVaR؛ CVaR ۵٪ = میانگین بازده بدترین ۵٪ سناریوها (زیان دم). «بهبود سالانه» = (J ساختار − J نگهداری ساده) × ۳۶۵ ÷ روز مانده. فقط ساختارهایی که از نگهداری ساده بهترند نمایش داده می‌شوند، سه تای برتر هر سررسید.<br>'+
'<b>محدودیت‌ها:</b> مدل‌ها ساده‌اند (لگ‌نرمال، بدون جهش و بدون تقسیم سود)؛ حدّ نوسان روزانه‌ی بازار ایران و صف‌های خرید/فروش در عمل توزیع را دم‌کلفت‌تر می‌کند. قیمت‌ها آخرین معامله است نه قیمت قابل اجرا؛ پیش از ورود تابلوی همان قرارداد را ببینید. اختیارهای معامله اروپایی‌اند و فقط در سررسید اعمال می‌شوند. این صفحه ابزار آماری است و توصیه‌ی خرید یا فروش نیست؛ مسئولیت تصمیم با خود شماست.</div>'}

// ---------- رسم صفحه ----------
function sgMsg(t){return'<div class="card mut" style="text-align:center;padding:16px;line-height:2">'+t+'</div>'}
async function sgPaint(force){if(SG.busy){SG.again=1;return}SG.busy=true;
try{await sgPaint0(force)}catch(e){var r=document.getElementById("sgroot");if(r&&tab==="sg"&&!r.querySelector("#sgsel"))r.innerHTML=sgMsg("دریافت اطلاعات انجام نشد؛ اینترنت را بررسی کنید و دوباره وارد صفحه شوید.")}
SG.busy=false;if(SG.again){SG.again=0;if(tab==="sg")sgPaint()}}
async function sgPaint0(force){var root=document.getElementById("sgroot");if(!root||tab!=="sg")return;
var A=xLS("pf1"),l=null,rows=null;
if(!A.length){root.innerHTML=sgMsg("پرتفوی شما خالی است. از صفحه‌ی «پرتفو» سهام و تعداد آن را ثبت کنید تا موقعیت‌های آپشن آن‌ها اینجا ساخته شود.");return}
if(force||Date.now()-SG.t>25000){_opt=null;SG.t=Date.now()}
try{l=await mwGet()}catch(e){}try{rows=await getOpts()}catch(e){}
root=document.getElementById("sgroot");if(!root||tab!=="sg")return;
if(!l||!rows){root.innerHTML=sgMsg("دریافت قیمت‌ها یا فهرست آپشن‌ها انجام نشد؛ اینترنت را بررسی کنید.");return}
var pm=pfMode(),R=A.map(function(x){var r=l.filter(function(z){return z.c===x.c})[0],p=r?(pm==="l"?(r.pl>0?r.pl:r.pc):(r.pc>0?r.pc:r.pl)):0,f=pfFee(r,x.n);return{c:String(x.c),n:x.n,q:x.q,r:r,val:p*x.q*(1-f)}});
R.sort(function(a,b){return b.val-a.val});R.forEach(function(r,i){r.col=PFC[i%PFC.length]});
var O=R.filter(function(r){return r.r&&UL.some(function(u){return u.c===r.c})});
if(!O.length){root.innerHTML=sgMsg("هیچ‌کدام از سهام پرتفوی شما بازار اختیار معامله ندارد.");return}
var sel=O.filter(function(r){return r.c===SG.sel})[0]||O[0];SG.sel=sel.c;
var tot=O.reduce(function(a,r){return a+r.val},0),pc=tot>0?sel.val/tot*100:0,w=Math.max(0,Math.min(100,pc)).toFixed(2),
tx=function(){return'<span><b>▾ '+esc(sel.n)+'</b> <span style="font-weight:400;font-size:11px">'+igFmt(sel.q)+' سهم</span></span><span dir="ltr" style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-size:10.5px;font-weight:400">'+igFmt(pc,1)+'%</span><b dir="ltr" style="font-size:14px">'+cfp(sel.val)+'</b>'},
bs='position:absolute;left:0;right:0;top:0;bottom:0;display:flex;justify-content:space-between;align-items:center;padding:0 10px;font-size:12.5px;white-space:nowrap;gap:6px',
bars='<div style="position:relative;height:40px;border-radius:10px;overflow:hidden;background:rgba('+sel.col+',.18);margin-bottom:6px"><div style="'+bs+';color:var(--tx)">'+tx()+'</div><div style="'+bs+';background:rgb('+sel.col+');color:#fff;clip-path:inset(0 '+(100-w)+'% 0 0)">'+tx()+'</div>'+
'<select id="sgsel" style="position:absolute;left:0;top:0;width:100%;height:100%;opacity:0">'+O.map(function(r){return'<option value="'+esc(r.c)+'"'+(r.c===sel.c?' selected':'')+'>'+esc(r.n)+' — '+igFmt(r.q)+' سهم</option>'}).join("")+'</select></div>';
var ch=chainOf(rows,sel.c,sel.n),its=ch.items,z=1000;
for(var i=0;i<its.length;i++){if(its[i].z>0){z=its[i].z;break}}
var rr=sel.r,S0=preOpen()&&rr.py>0?rr.py:(rr.pl>0?rr.pl:(rr.pc>0?rr.pc:rr.py)),H=SG.H[sel.c],needH=!H||Date.now()-H.t>216e5;
if(needH&&(SG.tab==="rc"||SG.tab==="sp")){H=await sgHist(sel.c);root=document.getElementById("sgroot");if(!root||tab!=="sg")return}
else if(needH){sgHist(sel.c).then(function(){if(tab==="sg")sgPaint()})}
// IV نزدیکِ پول (میانگین کال و پوت نزدیک‌ترین اعمال در نزدیک‌ترین سررسید)
var t0=ds(today),exs=[];its.forEach(function(x){if(x.e>=t0&&exs.indexOf(x.e)<0)exs.push(x.e)});exs.sort();
var rf=SG.rf/100,atm=0,e0=null;
for(i=0;i<exs.length;i++){if(sgDays(exs[i])>=3){e0=exs[i];break}}
if(e0&&S0>0){var T0=sgDays(e0)/365,cs=its.filter(function(x){return x.e===e0&&sgOkC(x)}).sort(function(a,b){return Math.abs(a.k-S0)-Math.abs(b.k-S0)})[0],ps=its.filter(function(x){return x.e===e0&&sgOkP(x)}).sort(function(a,b){return Math.abs(a.k-S0)-Math.abs(b.k-S0)})[0],iv=[];
if(cs){var a1=sgIV(cs.cp,S0,cs.k,T0,rf,true);if(a1>0)iv.push(a1)}if(ps){var a2=sgIV(ps.pp,S0,ps.k,T0,rf,false);if(a2>0)iv.push(a2)}
if(iv.length)atm=iv.reduce(function(s,b){return s+b},0)/iv.length}
var hv=H&&H.sig>0?H.sig:0,sig=hv>0?hv:(atm>0?atm:0.45);
var nc=Math.floor(sel.q/z),o={its:its,S0:S0,z:z,nc:nc,q:sel.q,sig:sig,rf:rf};
var vr=(hv>0&&atm>0)?(atm>hv?'IV بالاتر از HV است ← فروش اختیار (کاورد) از نظر نوسان مزیت دارد.':'IV پایین‌تر از HV است ← خرید اختیار (پوت محافظ) ارزان‌تر است.'):'';
var info='<div class="card" style="padding:6px 8px;line-height:1.9;font-size:11.5px"><div><span><b>'+esc(sel.n)+'</b> · قیمت '+fp(S0)+' ریال · '+igFmt(sel.q)+' سهم · '+igFmt(nc)+' قرارداد ('+igFmt(z)+' سهمی) · ارزش '+sgMi(sel.val)+' ریال ('+igFmt(pc,0)+'٪ سهام آپشن‌دار)</span></div>'+
'<div class="mut" style="font-size:10.5px">نوسان تاریخی (HV): <b dir="ltr">'+(hv>0?igFmt(hv*100,0)+'٪':'—')+'</b> · نوسان ضمنی (IV): <b dir="ltr">'+(atm>0?igFmt(atm*100,0)+'٪':'—')+'</b> · نرخ مرجع سالانه: <input id="sgrf" inputmode="decimal" value="'+esc(String(SG.rf))+'" style="width:44px;text-align:center;padding:1px"> ٪<br>'+vr+'</div></div>';
var tabs='<div id="sgtabs" class="pgnav optrow" style="display:flex;gap:4px;overflow-x:auto;direction:rtl;scrollbar-width:none">'+SGT.map(function(x){return'<button type="button" data-sgt="'+x[0]+'"'+(x[0]===SG.tab?' class="on"':'')+'>'+x[1]+'</button>'}).join("")+'</div>';
var y=window.pageYOffset||0,sc=[].slice.call(root.querySelectorAll(".sgsc")).map(function(e){return e.scrollLeft}),eb=root.querySelector(".exs2"),el=eb?eb.scrollLeft:0;var tbo=document.getElementById("sgtabs"),tl=tbo?tbo.scrollLeft:-1;
root.innerHTML=bars+info+tabs+sgBody(o)+sgPageExplain()+sgExplain();
[].slice.call(root.querySelectorAll(".sgsc")).forEach(function(e,i){if(sc[i])e.scrollLeft=sc[i]});eb=root.querySelector(".exs2");if(eb)eb.scrollLeft=el;tbo=document.getElementById("sgtabs");if(tbo){if(tl>=0)tbo.scrollLeft=tl;var on=tbo.querySelector(".on");if(on&&tl>=0){var tr=tbo.getBoundingClientRect(),or=on.getBoundingClientRect();if(or.left<tr.left||or.right>tr.right)tbo.scrollLeft+=(or.left+or.right)/2-(tr.left+tr.right)/2}}
try{window.scrollTo(0,y)}catch(e){}try{fx(root)}catch(e){}}

function sgClick(e){var t=e.target,b;
if(b=t.closest&&t.closest("[data-sgh]")){sgHelp(b.getAttribute("data-sgh"));return}
if(b=t.closest&&t.closest("[data-sgt]")){SG.tab=b.getAttribute("data-sgt");sgPaint();return}
if(b=t.closest&&t.closest("[data-sge]")){SG.ex=b.getAttribute("data-sge");sgPaint();return}
if(b=t.closest&&t.closest("[data-sgo]")){openDepth(b.getAttribute("data-sgo"),b.getAttribute("data-sgn")||"")}}
function sgChange(e){var t=e.target;if(t&&t.id==="sgsel"){SG.sel=t.value;SG.ex="all";sgSave();sgPaint();return}if(t&&t.id==="sgrf"){var v=xNum(t.value);if(v>0&&v<200){SG.rf=v;sgSave()}sgPaint()}}
function sgHtml(){return pgNav("sg")+'<div id="sgroot">'+sgMsg("در حال دریافت…")+'</div>'}
function sgBind(){var r=document.getElementById("sgroot");if(!r)return;r.onclick=sgClick;r.onchange=sgChange;sgPaint(true)}
setInterval(function(){if(tab==="sg"&&!document.hidden&&!document.activeElement.matches("input"))sgPaint()},30000);
(function(){var g0=goTab;goTab=function(t){if(t==="sg"&&tab!=="sg"){SG.tab="cc";SG.ex="all"}return g0.apply(this,arguments)}})();


// قانون پروژه: هر لیست کشویی (select) تازه خودکار همان ظاهر کوچک بقیه‌ی لیست‌ها را می‌گیرد (فونت ۱۰٫۵). ظاهر دیگر فقط با data-own
(function(){function fx(e){if(e&&e.tagName==="SELECT"&&!e.hasAttribute("data-own")){e.style.setProperty("font","400 10.5px Vazirmatn,Tahoma,sans-serif","important");[].forEach.call(e.options||[],function(o){o.style.setProperty("font","400 10.5px Vazirmatn,Tahoma,sans-serif","important")})}}
function all(n){if(!n||n.nodeType!==1)return;fx(n);if(n.querySelectorAll)[].forEach.call(n.querySelectorAll("select"),fx)}
try{new MutationObserver(function(ms){ms.forEach(function(m){[].forEach.call(m.addedNodes,all)})}).observe(document.documentElement,{childList:true,subtree:true})}catch(e){}all(document.body)})();

// لیست کشویی سفارشی کوچک برای همه‌ی select ها (لیست بومی اندروید درشت است). برای استفاده از لیست بومی: data-native
(function(){var pop=null,cur=null;
function cl(){if(pop&&pop.parentNode)pop.parentNode.removeChild(pop);pop=null;cur=null}
function op(sel){cl();var os=[].slice.call(sel.options||[]);if(!os.length)return;cur=sel;var r=sel.getBoundingClientRect(),W=window.innerWidth,H=window.innerHeight;
var d=document.createElement("div");d.id="cdd";d.innerHTML=os.map(function(o,i){return'<div class="cdo'+(i===sel.selectedIndex?" on":"")+(o.disabled?" dis":"")+'" data-i="'+i+'">'+esc(o.text)+'</div>'}).join("");
document.body.appendChild(d);var w=Math.min(W-16,Math.max(r.width,150));d.style.width=w+"px";var left=Math.max(8,Math.min(W-w-8,r.right-w));d.style.left=left+"px";
var below=H-r.bottom-80,above=r.top-10,mh=Math.max(120,Math.min(320,below>=160||below>=above?below:above));d.style.maxHeight=mh+"px";
if(below>=160||below>=above)d.style.top=(r.bottom+2)+"px";else d.style.bottom=(H-r.top+2)+"px";
var on=d.querySelector(".on");if(on)d.scrollTop=Math.max(0,on.offsetTop-d.clientHeight/2);pop=d}
var st=document.createElement("style");st.textContent="#cdd{position:fixed;z-index:2147483000;background:var(--card);color:var(--tx);border:1px solid var(--ln);border-radius:10px;box-shadow:0 4px 18px rgba(0,0,0,.35);overflow-y:auto;direction:rtl;font:400 11px Vazirmatn,Tahoma,sans-serif}#cdd .cdo{padding:6px 10px;line-height:1.5;border-bottom:1px solid var(--ln);text-align:right}#cdd .cdo:last-child{border-bottom:0}#cdd .cdo.on{background:#0a5c1f;color:#fff}#cdd .cdo.dis{opacity:.4}";document.head.appendChild(st);
function own(t){return t&&t.tagName==="SELECT"&&!t.disabled&&!t.multiple&&!t.hasAttribute("data-native")}
document.addEventListener("mousedown",function(e){if(own(e.target))e.preventDefault()},true);
document.addEventListener("click",function(e){var t=e.target;if(pop&&pop.contains(t)){var o=t.closest(".cdo");if(o&&!o.classList.contains("dis")&&cur){var s0=cur,i=+o.getAttribute("data-i");cl();if(s0.selectedIndex!==i){s0.selectedIndex=i;s0.dispatchEvent(new Event("input",{bubbles:true}));s0.dispatchEvent(new Event("change",{bubbles:true}))}}e.preventDefault();e.stopPropagation();return}
if(own(t)){e.preventDefault();if(cur===t)cl();else op(t);return}if(pop)cl()},true);
window.addEventListener("scroll",function(e){if(pop&&!(e.target&&e.target.nodeType===1&&pop.contains(e.target)))cl()},true);
window.addEventListener("resize",cl);window.addEventListener("orientationchange",cl)})();
</script>
<style>.wlc2 button{box-sizing:border-box!important;height:18px!important;padding-top:0!important;padding-bottom:0!important;line-height:16px!important}</style>
<style>
/* حالت بسته/باز بخش‌های تنظیمات */
#v .card.acc>.acch{cursor:pointer;display:flex;align-items:center;justify-content:space-between;margin:0;-webkit-tap-highlight-color:transparent;user-select:none}
#v .card.acc>.acch::after{content:"▾";opacity:.6;transform:rotate(90deg)}
#v .card.acc.accopen>.acch::after{transform:none}
#v .card.acc>.accb{display:none;margin-top:6px}
#v .card.acc.accopen>.accb{display:block}
/* پرتفو: متن مشکی */
.pfk{color:#000!important}:root[data-theme="dark"] .pfk{color:var(--tx)!important}
/* ارتفاع ۴۰ پیکسل: دکمه‌های دیده‌بان، ناوبری عمق بازار و غربال سهام */
body[data-tab="g"] .wlbar>.chip,.pgnav.dpn button,body[data-tab="a"] #f_go,body[data-tab="a"] .cnt button,body[data-tab="a"] .exb button,body[data-tab="a"] .exs2 button{height:40px!important;min-height:40px!important;box-sizing:border-box!important;zoom:1!important;display:inline-flex!important;align-items:center;justify-content:center;padding-top:0!important;padding-bottom:0!important}
.pgnav.dpn button{display:flex!important}
</style>
<style>
#pft .sect::before,#pft .sect::after{content:none!important;display:none!important}
#pft .pfa{font-size:13px!important}
.chnm{text-align:center;font-weight:700;font-size:15px;margin:2px 0 4px}
body.hmt{position:fixed;left:0;right:0;top:0;bottom:0;margin:0 auto;overflow:hidden;display:flex;flex-direction:column;box-sizing:border-box;width:100%}
body.hmt #v{flex:1 1 auto;min-height:0;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain}
#hmb{overflow:hidden}
.syh{display:flex;justify-content:space-between;align-items:center;margin:6px 0;padding:11px 12px;border:1px solid var(--ln);border-radius:10px;background:var(--card);color:var(--tx);font-size:13px;font-weight:700;cursor:pointer;-webkit-tap-highlight-color:transparent}
.syh b{opacity:.6;transition:transform .15s}.syh.op b{transform:rotate(180deg)}.syh.op{border-color:var(--ac)}
.syd{display:none;width:9px;height:9px;margin-right:6px;border-radius:50%;background:#ff3b30;vertical-align:middle}.syh.dot .syd{display:inline-block}
.syb{margin:0 0 6px}
.syh{background:#d32f2f!important;border-color:#d32f2f!important;color:#fff!important}
.syh b{opacity:.85}.syh.op{border-color:#7f1010!important}
.syh .syd{background:#fff;box-shadow:0 0 0 2px #ffeb3b}
</style>
<script>
// ===== بازگشت گوشی: بستن پنجره‌ی بازشده (+ ✎ ▦) و خروج از حالت ویرایش دیده‌بان =====
(function(){var ob=window.onBack;window.onBack=function(){
var o=document.getElementById("hb");
if(o){try{o.click()}catch(e){}var o2=document.getElementById("hb");if(o2)o2.remove();return"handled"}
try{if(wlOn()&&(WL.edit||WL.le)){WL.edit=false;WL.le=false;view();return"handled"}}catch(e){}
return ob?ob():"exit"}})();
</script>
<script>
// ===== سوابق بازار (sv): تصویر روزانه‌ی کل بازار که برنامه روی گوشی ذخیره می‌کند و بعداً دوباره می‌بینید =====
// این بخش مستقل است: فقط از توابع قبلی می‌خواند (mwGet, openDepth, enhSel, showBox ...) و چیزی از صفحه‌های دیگر را تغییر نمی‌دهد.
// داده را سرویس پس‌زمینه (SnapLog.java) هر روز معاملاتی ذخیره می‌کند؛ خروجی CSV جدول را همان دکمه‌ی عمومی برنامه می‌دهد.
var SV={days:null,day:0,rows:null,meta:null,lmap:{},lt:0,busy:0,err:"",src:"a",q:"",sk:"val",sd:-1,lim:150,tr:1};
(function(){try{var st=document.createElement("style");st.textContent=".svbar{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin:0 0 8px}.svbar input[type=text]{width:120px;height:28px;font-size:11px;padding:0 6px}.svck{font-size:11.5px;display:inline-flex;align-items:center;gap:3px}.svck input{width:auto}"
 +".svt td.nm,.svt th.nm{position:sticky;right:0;z-index:3;background:var(--card);box-shadow:-1px 0 0 var(--ln)}.svt th.nm{background:var(--ac);z-index:6}.svt tr.zb td.nm{background:var(--acb)}"
 +".svn{display:inline-flex;flex-direction:column;align-items:center;line-height:1.15}.svn small{font-size:8.5px;color:var(--mut);font-weight:400}"
 +".svr1{display:flex;gap:4px;align-items:center;flex-wrap:nowrap;margin:0 0 6px}.svr1>*{min-width:0!important;width:auto!important;box-sizing:border-box}.svr1>div:nth-of-type(2) .csp{min-width:190px}"
 +".svsr{position:relative;display:flex;align-items:center;flex:1 1 0}.svsr i{position:absolute;inset-inline-start:6px;font-style:normal;font-size:11px;pointer-events:none;opacity:.75}.svsr input{width:100%!important;height:28px;font-size:11px;box-sizing:border-box;padding:0 6px!important;padding-inline-start:22px!important}"
 +".svr2{display:flex;gap:8px;align-items:center;flex-wrap:nowrap;white-space:nowrap;overflow-x:auto;scrollbar-width:none;font-size:10.5px;margin:0 0 4px}.svr2::-webkit-scrollbar{display:none}.svr2>*{flex:none}.svr2 .svck{font-size:10.5px}"
 +".svr3{display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:10.5px;margin:0 0 6px}";document.head.appendChild(st)}catch(e){}})();
function svAnd(){return !!(window.Android&&Android.snDays&&Android.snGet)}
function svNm(){var o={};try{o=JSON.parse(localStorage.getItem("hsn")||"{}")||{}}catch(e){o={}}return o}
function svPx(r){return r.pl>0?r.pl:(r.pc>0?r.pc:0)}
function svChg(a,b){return a>0&&b>0?(a/b-1)*100:null}
function svRow(a){return{c:String(a[0]),n:String(a[1]),nm:String(a[2]),sc:String(a[3]),fl:String(a[4]),py:+a[5]||0,pl:+a[6]||0,pc:+a[7]||0,vol:+a[8]||0,val:+a[9]||0,tr:+a[10]||0,
 bc:+a[16]||0,bv:+a[17]||0,sn:+a[18]||0,sv:+a[19]||0}}
function svDayFa(d){d=String(d);try{return new Date(+d.slice(0,4),+d.slice(4,6)-1,+d.slice(6,8)).toLocaleDateString("fa-IR")}catch(e){return d}}
function svTm(m){m=+m||0;var h=Math.floor(m/60),mm=m%60;return cfp(h)+":"+(mm<10?cfp(0):"")+cfp(mm)}
// ---- قالب‌بندی عددها (واحد میلیارد / میلیون زیر عدد) ----
function svDash(){return'<span class="mut">—</span>'}
function svFp(v){return v==null||!isFinite(v)?svDash():'<span dir="ltr" style="color:'+xCol(v)+';font-weight:700">'+xSg(v,2)+'٪</span>'}
function svFn(v){return v==null||!isFinite(v)?svDash():cfp(v)}
function svFr(v){return v==null||!isFinite(v)?svDash():cfp(v,2)}
function svUn(n,u,sg){var d=Math.abs(n)>=100?0:1;return'<span class="svn" dir="ltr" style="'+(sg?'color:'+xCol(n)+';font-weight:700':'')+'">'+(sg?xSg(n,d):cfp(n,d))+'<small>'+u+'</small></span>'}
// مبلغ بر حسب «میلیارد تومان»
function svFa(v,sg){if(v==null||!isFinite(v))return svDash();var a=Math.abs(v);if(a>=1000)return svUn(v/1000,"هزار میلیارد",sg);if(a>=1)return svUn(v,"میلیارد",sg);if(a>0)return svUn(v*1000,"میلیون",sg);return'<span class="svn">'+cfp(0)+'</span>'}
function svFas(v){return svFa(v,true)}
// ---- ستون‌ها ----
function svCol(k,t,h,g,f){return{k:k,t:t,h:h,g:g,f:f}}
function svCols(){return[
 svCol("pl","آخرین","قیمت آخرین معامله در آن روز.",function(r){return r.pl>0?r.pl:null},svFn),
 svCol("plp","آخرین ٪","درصد تغییر آخرین معامله نسبت به قیمت پایانی روز قبلِ همان روز.",function(r){return svChg(r.pl,r.py)},svFp),
 svCol("pc","پایانی","قیمت پایانی همان روز.",function(r){return r.pc>0?r.pc:null},svFn),
 svCol("pcp","پایانی ٪","درصد تغییر قیمت پایانی همان روز نسبت به پایانی روز قبل.",function(r){return svChg(r.pc,r.py)},svFp),
 svCol("val","ارزش","ارزش کل معاملات نماد در آن روز (تومان).",function(r){return r.val>0?r.val/1e10:null},svFa),
 svCol("flow","ورود پول","ورود پول حقیقی = (حجم خرید حقیقی − حجم فروش حقیقی) × آخرین قیمت. مثبت یعنی پول حقیقی وارد نماد شده بود.",function(r){return r.bc>0||r.sn>0?(r.bv-r.sv)*svPx(r)/1e10:null},svFas),
 svCol("pw","قدرت خریدار","(میانگین خرید هر خریدار حقیقی) ÷ (میانگین فروش هر فروشنده‌ی حقیقی). بیشتر از ۱ یعنی خریدارها قوی‌تر بودند.",function(r){return r.bc>0&&r.sn>0&&r.sv>0?(r.bv/r.bc)/(r.sv/r.sn):null},svFr),
 svCol("tp","قیمت امروز","آخرین قیمت زنده‌ی همین نماد در حال حاضر.",function(r){var x=SV.lmap[r.c];return x&&svPx(x)>0?svPx(x):null},svFn),
 svCol("trt","بازدهی تا امروز","درصد تغییر قیمت امروز نسبت به قیمت همان روز سوابق؛ برای تمرین معامله و آزمودن یک استراتژی روی روزهای گذشته.",function(r){var x=SV.lmap[r.c],p=svPx(r);return x&&svPx(x)>0&&p>0?(svPx(x)/p-1)*100:null},svFp)]}
// ---- بارگذاری ----
function svLoadDays(){SV.err="";if(!svAnd()){SV.days=[];SV.err="no";return}
 try{SV.days=JSON.parse(Android.snDays())||[]}catch(e){SV.days=[]}if(!SV.days.length)return;
 if(!SV.day||SV.days.indexOf(SV.day)<0)SV.day=SV.days[0];svDay(SV.day)}
function svDay(d){SV.day=+d;var o=null;try{o=JSON.parse(Android.snGet(String(d)))}catch(e){o=null}SV.rows=(o&&o.r)?o.r.map(svRow):null;SV.meta=o&&o.m!=null?{m:+o.m}:null}
async function svLive(force){if(SV.busy)return;if(!force&&SV.lt&&Date.now()-SV.lt<20000)return;SV.busy=1;
 try{var l=await mwGet(),m={};l.forEach(function(r){m[r.c]=r});SV.lmap=m;SV.lt=Date.now()}catch(e){}
 SV.busy=0;if(tab==="sv")svPaint()}
// ---- فیلتر و مرتب‌سازی ----
function svSrcOpts(L){var h='<option value="a"'+(SV.src==="a"?" selected":"")+'>همه‌ی بازار</option><option value="b"'+(SV.src==="b"?" selected":"")+'>بورس</option><option value="f"'+(SV.src==="f"?" selected":"")+'>فرابورس</option>';
 var nm=svNm(),seen={},ls=[];L.forEach(function(r){if(r.sc&&!seen[r.sc]){seen[r.sc]=1;ls.push(r.sc)}});
 var nn=function(c){return nm[c]||("گروه "+c)};ls.sort(function(a,b){return nn(a).localeCompare(nn(b),"fa")});
 ls.forEach(function(c){var v="s:"+c;h+='<option value="'+v+'"'+(SV.src===v?" selected":"")+'>صنعت: '+esc(nn(c))+'</option>'});return h}
function svFilter(L){var s=SV.src,out=L;
 if(s==="b")out=L.filter(function(r){return r.fl==="1"});else if(s==="f")out=L.filter(function(r){return r.fl==="2"||r.fl==="3"||r.fl==="4"});
 else if(s.indexOf("s:")===0){var c=s.slice(2);out=L.filter(function(r){return r.sc===c})}
 if(SV.tr)out=out.filter(function(r){return r.vol>0});
 var q=lat(ar(String(SV.q||""))).trim();if(q)out=out.filter(function(r){return String(r.n).indexOf(q)>=0||String(r.nm).indexOf(q)>=0});return out}
function svSort(R,cols){var cc=null;cols.forEach(function(c){if(c.k===SV.sk)cc=c});if(!cc&&SV.sk==="n")cc={g:function(r){return r.n}};if(!cc)return R;var d=SV.sd;
 return R.map(function(r){return{r:r,v:cc.g(r)}}).sort(function(a,b){var x=a.v,y=b.v;if(x==null&&y==null)return 0;if(x==null)return 1;if(y==null)return -1;if(typeof x==="string"||typeof y==="string")return d*String(x).localeCompare(String(y),"fa");return d*(x-y)}).map(function(a){return a.r})}
// ---- جدول ----
function svTh(k,t,h,extra){return'<th data-svs="'+k+'"'+(extra?' class="'+extra+'"':'')+'>'+t+(SV.sk===k?(SV.sd>0?" ▲":" ▼"):"")+(h?'<span class="qm" data-svh="'+k+'">?</span>':'')+'</th>'}
function svTable(){var cols=svCols(),R=svSort(svFilter(SV.rows||[]),cols),tot=R.length,show=R.slice(0,SV.lim);
 var head='<tr><th class="drw">ردیف</th>'+svTh("n","نماد","","nm")+cols.map(function(c){return svTh(c.k,c.t,c.h)}).join("")+'</tr>';
 var body=show.map(function(r,i){return'<tr data-tc="'+esc(r.c)+'" data-tn="'+esc(r.n)+'" style="cursor:pointer"><td class="drw">'+cfp(i+1)+'</td><td class="nm">'+esc(r.n)+'</td>'+cols.map(function(c){return'<td>'+c.f(c.g(r))+'</td>'}).join("")+'</tr>'}).join("");
 var more=tot>show.length?'<div style="text-align:center;margin:8px 0"><button type="button" data-svm="1">نمایش ردیف‌های بعدی ('+cfp(tot-show.length)+' ردیف مانده)</button></div>':"";
 SV.tot=tot;return'<div class="sc scv"><table class="stk svt">'+head+body+'</table></div>'+more}
function svPaintTbl(){var e=document.getElementById("svtb");if(!e)return;var sc=e.querySelector(".scv"),st=sc?sc.scrollTop:0,sl=sc?sc.scrollLeft:0;e.innerHTML=svTable();svCnt();var s2=e.querySelector(".scv");if(s2){s2.scrollTop=st;s2.scrollLeft=sl}}
function svCnt(){var c=document.getElementById("svcnt");if(c)c.textContent=cfp(SV.tot||0)+" نماد"}
var SVX="<b>درباره‌ی این صفحه:</b> برنامه هر روز معاملاتی از ساعت ۸:۴۵ تا ۱۲:۳۰ تصویر کل بازار را روی خود گوشی ذخیره می‌کند (حتی وقتی برنامه بسته است) و تا ۷۰ روز نگه می‌دارد. اینجا یک روز گذشته را انتخاب می‌کنید و بازار همان روز را می‌بینید، با دو ستون آخر «قیمت امروز» و «بازدهی تا امروز». برای تمرین معامله‌ی کاغذی و آزمودن یک استراتژی روی روزهای قبل مناسب است. با لمس عنوان هر ستون جدول مرتب می‌شود، علامت ? معنی ستون را می‌گوید و لمس هر سطر صفحه‌ی عمق بازار آن نماد را باز می‌کند.<br><b>محدودیت‌ها:</b> سوابق از اولین روز بعد از نصب این نسخه شروع می‌شود؛ برای روزهایی که گوشی خاموش یا بدون اینترنت بوده ممکن است ناقص باشد و سوابق قبل از نصب موجود نیست. ورود پول و قدرت خریدار تقریبی‌اند (حجم‌های حقیقی × آخرین قیمت). این صفحه توصیه‌ی خرید یا فروش نیست.";
function svExplain(){return'<div class="card" style="padding:8px;margin-top:8px;line-height:2;font-size:12px">'+SVX+'</div>'}
function svMsg(t){return'<div class="card mut" style="text-align:center;padding:22px;line-height:2">'+t+'</div>'+svExplain()}
function svBody(){if(SV.err==="no")return svMsg("سوابق بازار فقط در برنامه‌ی اندروید ذخیره می‌شود.");
 if(!SV.days)return svMsg("در حال خواندن سوابق…");
 if(!SV.days.length)return svMsg("هنوز سابقه‌ای ذخیره نشده است.<br>از اولین روز معاملاتی بعد از نصب این نسخه، تصویر بازار هر روز (حتی وقتی برنامه بسته است) ذخیره می‌شود.");
 var opts=SV.days.map(function(d){return'<option value="'+d+'"'+(d===SV.day?" selected":"")+'>'+svDayFa(d)+'</option>'}).join("");
 if(!SV.rows)return'<div class="card" style="padding:8px"><div class="svbar"><select id="svd">'+opts+'</select></div><div class="mut" style="text-align:center;padding:16px">فایل این روز خوانده نشد.</div></div>'+svExplain();
 var fin=SV.meta&&SV.meta.m<745?'<span>این روز تا ساعت '+svTm(SV.meta.m)+' ذخیره شده است (روز کامل نشده).</span>':"";
 var lt=SV.lt?'آخرین قیمت‌های زنده: '+new Date(SV.lt).toLocaleTimeString("fa-IR"):(SV.busy?"در حال دریافت قیمت‌های امروز…":"قیمت امروز دریافت نشد");
 var tb=svTable();
 return'<div class="card" style="padding:8px">'
  +'<div class="svr1"><select id="svd" style="flex:1 1 0">'+opts+'</select><select id="svs" style="flex:1.3 1 0">'+svSrcOpts(SV.rows)+'</select><span class="svsr"><i>🔍</i><input type="text" id="svq" placeholder="نماد" value="'+esc(SV.q)+'" autocomplete="off"></span></div>'
  +'<div class="svr2"><label class="svck"><input type="checkbox" id="svt"'+(SV.tr?" checked":"")+'> فقط معامله‌شده</label><span class="mut">'+lt+' <button type="button" data-svr="1" style="padding:1px 8px;font-size:11px">⟳</button></span><span class="mut" id="svcnt">'+cfp(SV.tot||0)+' نماد</span></div>'
  +'<div class="svr3 mut"><span>روز ذخیره‌شده</span>'+fin+'</div>'
  +'<div id="svtb">'+tb+'</div></div>'+svExplain()}
function svHtml(){return'<div id="svv">'+svBody()+'</div>'}
function svPaint(){if(tab!=="sv")return;var b=document.getElementById("svv");if(!b)return;var ae=document.activeElement;if(ae&&ae.id==="svq"&&document.getElementById("svtb")){svPaintTbl();return}
 var e=b.querySelector(".scv"),st=e?e.scrollTop:0,sl=e?e.scrollLeft:0,y=window.pageYOffset||0;b.innerHTML=svBody();try{enhSel(b)}catch(x){}var s2=b.querySelector(".scv");if(s2){s2.scrollTop=st;s2.scrollLeft=sl}try{window.scrollTo(0,y)}catch(x){}}
// ---- لمس و تغییر ----
function svClick(e){if(tab!=="sv")return;var t=e.target;if(!t.closest)return;
 var h=t.closest("[data-svh]");if(h){e.stopPropagation();var k=h.getAttribute("data-svh"),o=null;svCols().forEach(function(c){if(c.k===k)o=c});if(o)showBox(esc(o.t),'<div>'+esc(o.h)+'</div>');return}
 if(t.closest("[data-svr]")){svLoadDays();svPaint();svLive(true);return}
 if(t.closest("[data-svm]")){SV.lim+=150;svPaintTbl();return}
 var s=t.closest("th[data-svs]");if(s){var k2=s.getAttribute("data-svs");if(SV.sk===k2)SV.sd=-SV.sd;else{SV.sk=k2;SV.sd=k2==="n"?1:-1}svPaintTbl();return}
 var r=t.closest("tr[data-tc]");if(r&&t.closest("#svv")){try{openDepth(r.getAttribute("data-tc"),r.getAttribute("data-tn"))}catch(x){}}}
function svChange(e){if(tab!=="sv")return;var t=e.target,id=t.id;
 if(id==="svd"){svDay(+t.value);SV.lim=150;svPaint()}
 else if(id==="svs"){SV.src=t.value;SV.lim=150;svPaintTbl()}
 else if(id==="svt"){SV.tr=t.checked?1:0;SV.lim=150;svPaintTbl()}}
function svInput(e){if(tab!=="sv"||e.target.id!=="svq")return;SV.q=e.target.value;SV.lim=150;svPaintTbl()}
function svBind(){var v=document.getElementById("v");if(v&&!v._sv){v._sv=1;v.addEventListener("click",svClick);v.addEventListener("change",svChange);v.addEventListener("input",svInput)}
 svLoadDays();svPaint();svLive(false)}
setInterval(function(){if(tab!=="sv"||document.hidden||document.getElementById("hb"))return;try{if(ph()==="mk"||ph()==="ord")svLive(true)}catch(e){}},20000);
</script>
</body>
</html>
