  h+='</div>'});
 var lg=[[-4.5,"−۴"],[-3.5,"−۳"],[-2.5,"−۲"],[-1.5,"−۱"],[-0.5,"−"],[0,"۰"],[0.5,"+"],[1.5,"+۱"],[2.5,"+۲"],[3.5,"+۳"],[4.5,"+۴"]].map(function(z){return'<span style="background:'+mmCol(z[0])+'">'+z[1]+'</span>'}).join("");
 return mmBar()+'<div class="mmzw" id="mmzw" style="max-height:'+H0+'px"><div class="mmap" id="mmap" style="width:'+(z===1?"100%":W+"px")+';height:'+H+'px">'+h+'</div></div><div class="mmlg">'+lg+'</div><div class="mut" style="font-size:11px;line-height:1.8;margin-top:6px">اندازه‌ی هر خانه '+(MM.sz==="c"?"ارزش بازار":"ارزش معاملات امروز")+' نماد و رنگ آن درصد تغییر «آخرین قیمت» نسبت به دیروز است. گروه را از فهرست بالا انتخاب کنید یا با دو انگشت (یا دکمه‌های + و −) زوم کنید و با کشیدن جابه‌جا شوید؛ با لمس هر نماد عمق بازار آن باز می‌شود. '+n.toLocaleString("fa-IR")+' نماد.</div>'}
function mmPaint(){var b=document.getElementById("igb");if(!b)return;MM.w=b.clientWidth;var sc=document.getElementById("mmzw"),sl=sc?sc.scrollLeft:0,st=sc?sc.scrollTop:0,h=mmHtml(),k=h.length+"|"+(IG.ts||0)+"|"+MM.mk+MM.sz+"|"+MM.w+"|"+MM.g+"|"+MM.z;if(k===MM.ph&&b.querySelector(".mmbar"))return;MM.ph=k;b.innerHTML='<div>'+h+'</div>';var s2=document.getElementById("mmzw");if(s2){s2.scrollLeft=sl;s2.scrollTop=st}}
function mmZoom(z){z=Math.max(1,Math.min(6,Math.round(z*100)/100));if(z===MM.z)return;var w=document.getElementById("mmzw"),fx=.5,fy=.5;if(w&&w.scrollWidth>0&&w.scrollHeight>0){fx=(w.scrollLeft+w.clientWidth/2)/w.scrollWidth;fy=(w.scrollTop+w.clientHeight/2)/w.scrollHeight}MM.z=z;MM.ph="";mmPaint();var n=document.getElementById("mmzw");if(n){n.scrollLeft=Math.max(0,fx*n.scrollWidth-n.clientWidth/2);n.scrollTop=Math.max(0,fy*n.scrollHeight-n.clientHeight/2)}}
var MMT=null,MMR=0;
function mmDist(t){var dx=t[0].clientX-t[1].clientX,dy=t[0].clientY-t[1].clientY;return Math.sqrt(dx*dx+dy*dy)||1}
// زوم روان با دو انگشت: در حین حرکت فقط transform (روی GPU)، بعد از برداشتن انگشت نقشه با بزرگنمایی جدید دوباره چیده می‌شود
var MMP=null;function mmMid(t){return{x:(t[0].clientX+t[1].clientX)/2,y:(t[0].clientY+t[1].clientY)/2}}
document.addEventListener("touchstart",function(e){if(e.touches.length!==2){return}var w=e.target.closest&&e.target.closest("#mmzw"),m=document.getElementById("mmap");if(!w||!m)return;
 var r=w.getBoundingClientRect(),zf=(w.offsetWidth?r.width/w.offsetWidth:1)||1,md=mmMid(e.touches),rx=(md.x-r.left)/zf,ry=(md.y-r.top)/zf;
 MMP={m:m,r:r,zf:zf,d:mmDist(e.touches),z:MM.z,px:w.scrollLeft+rx,py:w.scrollTop+ry,rx:rx,ry:ry,k:1,dx:0,dy:0};m.style.transformOrigin=MMP.px+"px "+MMP.py+"px";m.style.willChange="transform"},{passive:true});
document.addEventListener("touchmove",function(e){if(!MMP||e.touches.length!==2)return;if(e.cancelable)e.preventDefault();
 var z=Math.max(1,Math.min(6,MMP.z*mmDist(e.touches)/MMP.d)),md=mmMid(e.touches);MMP.k=z/MMP.z;MMP.dx=(md.x-MMP.r.left)/MMP.zf-MMP.rx;MMP.dy=(md.y-MMP.r.top)/MMP.zf-MMP.ry;
 if(MMR)return;MMR=1;requestAnimationFrame(function(){MMR=0;if(MMP)MMP.m.style.transform="translate("+MMP.dx.toFixed(1)+"px,"+MMP.dy.toFixed(1)+"px) scale("+MMP.k.toFixed(4)+")"})},{passive:false});
function mmPinchEnd(){var P=MMP;if(!P)return;MMP=null;var z=Math.round(P.z*P.k*100)/100;
 if(Math.abs(z-MM.z)<0.01){P.m.style.transform="";P.m.style.willChange="";return}
 MM.z=z;MM.ph="";mmPaint();var n=document.getElementById("mmzw");if(n){var f=z/P.z;n.scrollLeft=Math.max(0,P.px*f-(P.rx+P.dx));n.scrollTop=Math.max(0,P.py*f-(P.ry+P.dy))}
 var m2=document.getElementById("mmap");if(m2){m2.style.transform="";m2.style.willChange=""}}
document.addEventListener("touchend",function(e){if(MMP&&e.touches.length<2)mmPinchEnd()},{passive:true});
document.addEventListener("touchcancel",function(){mmPinchEnd()},{passive:true});
