function apiGet(p){return Promise.reject(new Error("offline"));
if(window.Android&&!ISWEB&&Android.fetch)return GET0(API+p).then(function(b){return JSON.parse(b)});
return fetch(API+p,{headers:{"Accept":"application/json"},cache:"no-store"}).then(function(r){return r.json().then(function(j){if(!r.ok)throw new Error(j.error||"خطای سرور");return j})})}
function apiPost(p,body){return Promise.reject(new Error("offline"));
return fetch(API+p,{method:"POST",headers:{"Content-Type":"application/json","Accept":"application/json"},body:JSON.stringify(body||{})}).then(function(r){return r.json().catch(function(){return{}}).then(function(j){if(!r.ok)throw new Error(j.error||("خطای سرور ("+r.status+")"));return j})},function(){throw new Error("ارتباط با سرور سینو بورس برقرار نشد؛ اینترنت را بررسی کنید.")})}

