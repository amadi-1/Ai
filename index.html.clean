function dxBurn(){var O=DX.O,U=DX.U;if(!O||!U||!(U.px>0)||!(U.pct>0))return null;
var p=U.pct/100,px=U.px,K=O.k,call=O.side!=="p",e=iso(O.e),td=0,d;
for(d=add(today,1);d<=e;d=add(d,1)){if(!off(d))td++}
var cal=Math.round((e-today)/864e5),burnNow=call?px<=K:px>=K,u=px,n=0,back=0,uT=px,i;
if(!burnNow){while(n<300&&(call?u>K:u<K)){u=call?dn(u,p):up(u,p);n++}}else{while(back<300&&(call?u<=K:u>=K)){u=call?up(u,p):dn(u,p);back++}}
for(i=0;i<td;i++)uT=call?dn(uT,p):up(uT,p);
