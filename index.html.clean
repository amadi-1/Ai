function wlcDlg(){var g=wlcG(),cols=g.t[g.cur]||[],o=document.getElementById("hb");if(o)o.remove();o=document.createElement("div");o.id="hb";
var chip=function(a,t,on){return'<span data-wc="'+a+'" style="display:inline-block;margin:2px;padding:3px 10px;border:1px solid var(--ln);border-radius:14px;cursor:pointer;'+(on?'background:#1976d2;color:#fff':'')+'">'+t+'</span>'};
var h='<div class="bx"><b class="t">ستون‌های جدول دیده‌بان</b><div style="font-size:12px;opacity:.75">قالب فعال برای همهٔ دیده‌بان‌ها اعمال می‌شود.</div><div>';
Object.keys(g.t).forEach(function(k,i){h+=chip("t:"+i,esc(k),k===g.cur)});
h+='</div><div style="margin-top:6px"><b>ستون‌ها</b></div><div style="border:1px solid var(--ln);border-radius:8px;padding:2px 8px"><div style="opacity:.6">نماد (ثابت)</div>';
cols.forEach(function(c,i){h+='<div style="display:flex;align-items:center;gap:10px;border-top:1px solid var(--ln)"><span style="flex:1">'+esc(WLC_ALL[c][0])+'</span><span data-wc="u:'+i+'" style="cursor:pointer;padding:0 8px">▲</span><span data-wc="d:'+i+'" style="cursor:pointer;padding:0 8px">▼</span><span data-wc="x:'+i+'" style="cursor:pointer;padding:0 8px;color:var(--dn)">✕</span></div>'});
h+='</div><div style="margin-top:6px"><b>افزودن ستون</b></div><div>';var any=0;
Object.keys(WLC_ALL).forEach(function(c){if(cols.indexOf(c)<0){any=1;h+=chip("a:"+c,"+ "+esc(WLC_ALL[c][0]),0)}});if(!any)h+='<span style="opacity:.6">همه ستون‌ها اضافه شده‌اند</span>';
h+='</div><div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:8px"><button type="button" data-wc="sv" style="margin:0">ذخیره با نام…</button>'+(g.cur!==WLC_DN?'<button type="button" data-wc="rm" style="margin:0">حذف این قالب</button>':'')+'<button type="button" data-wc="ok" style="margin:0">بستن</button></div></div>';
o.innerHTML=h;var fin=function(){o.remove();if(typeof wlPaint==="function")wlPaint()};
o.onclick=function(e){if(e.target===o){fin();return}var b=e.target.closest("[data-wc]");if(!b)return;var a=b.getAttribute("data-wc"),g=wlcG(),p=a.split(":"),k=p[0],v=p[1],ix=+v;
if(a==="ok"){fin();return}
if(k==="t"){var ks=Object.keys(g.t);if(ks[ix]!=null){g.cur=ks[ix];wlcSave()}}
else if(k==="u"){wlcEdit(function(c){if(ix>0){var x=c[ix];c[ix]=c[ix-1];c[ix-1]=x}})}
else if(k==="d"){wlcEdit(function(c){if(ix<c.length-1){var x=c[ix];c[ix]=c[ix+1];c[ix+1]=x}})}
else if(k==="x"){wlcEdit(function(c){c.splice(ix,1)})}
else if(k==="a"){wlcEdit(function(c){if(WLC_ALL[v]&&c.indexOf(v)<0)c.push(v)})}
else if(a==="rm"){if(g.cur!==WLC_DN){delete g.t[g.cur];g.cur=WLC_DN;wlcSave()}}
else if(a==="sv"){askText("نام قالب جدید",g.cur===WLC_DN?"":g.cur,function(nm){nm=String(nm).trim().slice(0,24);if(!nm||nm===WLC_DN){wlcDlg();return}var g2=wlcG();g2.t[nm]=(g2.t[g2.cur]||WLC_DEF).slice();g2.cur=nm;wlcSave();wlcDlg()});return}
wlcDlg()};document.body.appendChild(o)}

// ---------- خروجی CSV (اکسل) از جدول‌ها ----------
(function(){try{var st=document.createElement("style");st.textContent=".csvb{direction:ltr;text-align:left;margin:2px 6px;line-height:1}.csvb span{display:inline-block;font-size:11px;color:#1976d2;cursor:pointer;opacity:.85;padding:2px 8px;border:1px solid var(--ln);border-radius:10px}";document.head.appendChild(st)}catch(e){}})();
function csvNum(t){var x=wlD(t).replace(/[\u200e\u200f\u200c\u066c,\u060c\s]/g,"").replace(/\u066b/g,".").replace(/[\u2212\u2013]/g,"-").replace(/^\+/,"");var m=/^(-?\d+(?:\.\d+)?)[\u066a%]?$/.exec(x);if(m)return m[1];m=/^(-?\d+(?:\.\d+)?)([BMK])$/.exec(x);if(m)return String(Math.round(+m[1]*({B:1e9,M:1e6,K:1e3}[m[2]])));return null}
function csvCell(td){var t=(td.textContent||"").replace(/[\u200e\u200f]/g,"").replace(/\s+/g," ").trim();if(t==="—"||t==="-")return"";var n=csvNum(t);if(n!==null){if(td.classList.contains("wpc")&&/--dn/.test(td.getAttribute("style")||"")&&+n>0)n="-"+n;return n}return t}
function csvQ(v){v=String(v);return/[",\n\r]/.test(v)?'"'+v.replace(/"/g,'""')+'"':v}
function csvOf(t){var rows=[].slice.call(t.rows),out=[],keep=[];if(!rows.length)return null;
var hd=[].map.call(rows[0].cells,function(c){return(c.textContent||"").replace(/[▲▼?]/g,"").replace(/\s+/g," ").trim()});
var body=rows.slice(1).map(function(r){return[].map.call(r.cells,csvCell)});
hd.forEach(function(h,i){keep[i]=body.some(function(r){return r.length>1&&r[i]!==undefined&&r[i]!==""})});
if(!keep.some(function(k){return k}))return null;
out.push(hd.filter(function(h,i){return keep[i]}).map(csvQ).join(","));
body.forEach(function(r){if(r.length<2)return;out.push(r.filter(function(c,i){return i>=hd.length||keep[i]}).map(csvQ).join(","))});
return{txt:out.join("\r\n")+"\r\n",rows:out.length-1,cols:keep.filter(function(k){return k}).length}}
function csvName(t){var d=new Date(),p=function(n){return(n<10?"0":"")+n};return(String(t||"table").replace(/[\\\/:*?"<>|\s]+/g,"_")||"table")+"_"+d.getFullYear()+p(d.getMonth()+1)+p(d.getDate())+"-"+p(d.getHours())+p(d.getMinutes())+".csv"}
function csvGo(name,txt,share){if(window.Android&&Android.saveCsv){try{Android.saveCsv(name,txt,!!share)}catch(e){}return}
try{var a=document.createElement("a");a.href=URL.createObjectURL(new Blob(["\ufeff"+txt],{type:"text/csv"}));a.download=name;document.body.appendChild(a);a.click();a.remove()}catch(e){}}
function csvAsk(t,title){var r=null;try{r=csvOf(t)}catch(e){}
var o=document.getElementById("hb");if(o)o.remove();o=document.createElement("div");o.id="hb";
if(!r){o.innerHTML='<div class="bx"><b class="t">خروجی CSV</b>دادهٔ قابل خروجی در این جدول نیست.<button type="button" data-cv="x">بستن</button></div>'}
else{var nm=csvName(title);o.innerHTML='<div class="bx"><b class="t">خروجی CSV (اکسل)</b>'+r.rows.toLocaleString("fa-IR")+' ردیف، '+r.cols.toLocaleString("fa-IR")+' ستون<div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:6px"><button type="button" data-cv="s" style="margin:0">ذخیره در Download</button><button type="button" data-cv="h" style="margin:0">ارسال / اشتراک‌گذاری</button></div></div>'}
o.onclick=function(e){if(e.target===o){o.remove();return}var b=e.target.closest("[data-cv]");if(!b)return;var a=b.getAttribute("data-cv");o.remove();if(a==="s")csvGo(nm,r.txt,false);else if(a==="h")csvGo(nm,r.txt,true)};document.body.appendChild(o)}
function csvWl(){var t=document.querySelector("#wlsc table"),C=null;try{C=wlCur()}catch(e){}csvAsk(t||document.createElement("table"),C?C.name:"watchlist")}
var _csvT=0;
function csvScan0(){var v=document.getElementById("v");if(!v)return;v.querySelectorAll("table.stk").forEach(function(t){if(t.closest("#wlsc")||t.rows.length<4)return;var w=t.closest(".sc")||t;if(w.closest("#wlsc"))return;var p=w.previousElementSibling;if(p&&p.classList&&p.classList.contains("csvb"))return;var par=w.parentNode;if(!par||par.nodeType!==1)return;var dp="";try{dp=getComputedStyle(par).display}catch(e){}if(dp!=="block"&&dp!=="flow-root")return;var d=document.createElement("div");d.className="csvb";d.innerHTML='<span data-csv="1">⤓ CSV</span>';par.insertBefore(d,w)})}
function csvScan(){if(_csvT)return;_csvT=setTimeout(function(){_csvT=0;try{csvScan0()}catch(e){}},150)}
try{new MutationObserver(csvScan).observe(document.getElementById("v"),{childList:true,subtree:true})}catch(e){}
document.addEventListener("click",function(e){var b=e.target&&e.target.closest?e.target.closest("[data-csv]"):null;if(!b)return;e.stopPropagation();e.preventDefault();var w=b.parentNode.nextElementSibling,t=w?(w.tagName==="TABLE"?w:w.querySelector("table.stk")):null;if(t)csvAsk(t,"table")},true);

