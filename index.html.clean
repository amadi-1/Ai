h+="<tr><td class='"+c+"'>"+(r.i===0?"امروز":(r.i===-1?"دیروز":r.i.toLocaleString("fa-IR")))+"</td><td class='"+c+"'>"+NM[r.d.getDay()]+"</td><td class='"+c+"'>"+JD.format(r.d)+"</td><td class='u'>"+fp(r.e)+"</td><td class='v'>"+fp(r.f)+"</td></tr>"});
