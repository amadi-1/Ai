return{call:call,K:K,px:px,cal:cal,td:td,burnNow:burnNow,n:n,uBurn:u,back:back,uT:uT,pct:U.pct}}
function dxOptX(){var O=DX.ins===S.ins?DX.O:null,U=DX.ins===S.ins?DX.U:null;if(!O)return{pre:"",post:""};var pre="",post="";
if(U&&U.px>0){var ch=(U.py>0&&U.pc>0)?(U.pc-U.py)/U.py*100:null;pre=tsKV("قیمت پایانی نماد پایه"+(U.nm?" ("+esc(U.nm)+")":""),fp(U.pc>0?U.pc:U.px)+(ch==null?"":" <small>("+dxPct(ch)+")</small>"),tsCol(ch))}
