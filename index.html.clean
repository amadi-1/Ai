mkcSave(c);mkcRefresh()});
function mkCol(ch){return ch==null||!isFinite(ch)||ch===0?"":"color:"+(ch>0?"var(--up)":"var(--dn)")+";font-weight:700"}
function mkChg(ch,amt,unit){if(ch==null||!isFinite(ch))return"—";var s=(ch>0?"+":(ch<0?"−":""));return'<span style="'+mkCol(ch)+'">'+s+f1(Math.abs(ch),2)+'٪</span>'+(amt==null?"":'<br><small style="'+mkCol(ch)+'">'+s+amt+'</small>')}
function mkTom(v,ch){return v==null?"—":'<span style="'+mkCol(ch)+'">'+fp(v/10)+'</span> <small>تومان</small>'}
function mkUsd(v,ch,d){return v==null?"—":'<small>$</small><span style="'+mkCol(ch)+'">'+cfp(v,d==null?2:d)+'</span>'}
function mkRowT(name,o){if(!o)return"";return'<tr><td class="nm">'+name+'</td><td class="pcc">'+mkTom(o.v,o.ch)+'</td><td>'+mkChg(o.ch)+'</td></tr>'}
function mkRowU(name,o,d){if(!o)return"";return'<tr><td class="nm">'+name+'</td><td class="pcc">'+mkUsd(o.v,o.ch,d)+'</td><td>'+mkChg(o.ch)+'</td></tr>'}
function mkDiffT(a,b){if(!(a>0&&b>0))return["—",""];var d=a-b,p=(a/b-1)*100,sg=d>0?"+":(d<0?"−":"");return[sg+fp(Math.abs(d)/10)+" تومان <small>("+sg+f1(Math.abs(p),2)+"٪)</small>",d>0?"var(--dn)":"var(--up)"]}
function mkDiff(a,b){if(!(a>0&&b>0))return["—",""];var d=(a/b-1)*100;return[(d>0?"+":(d<0?"−":""))+f1(Math.abs(d),2)+"٪",d>0?"var(--dn)":"var(--up)"]}
function secCls(k){return MK.sec&&MK.sec[k]==="r"?"tt tr":"tt tg"}
function mkKV(a,b,c){return'<div style="display:flex;justify-content:space-between;gap:8px;padding:4px 0;border-bottom:1px solid var(--ln);white-space:nowrap"><span class="mut" style="font-size:11.5px;overflow:hidden;text-overflow:ellipsis;min-width:0">'+a+'</span><b style="font-size:12.5px;flex:none'+(c?";color:"+c:"")+'">'+b+'</b></div>'}
