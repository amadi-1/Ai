cbI=num(deep(CT,"buy_CountI")),cbN=num(deep(CT,"buy_CountN")),csI=num(deep(CT,"sell_CountI")),csN=num(deep(CT,"sell_CountN")),pr=dxLast();
if(!(bI+bN+sI+sN>0))return"";var tb=bI+bN,ts=sI+sN,mxv=Math.max(bI,bN,sI,sN),net=(bI-sI)*pr/1e9,nc=net>0?"var(--up)":(net<0?"var(--dn)":"inherit");
function side(cnt,vol,tot,col,al){var w=mxv>0?Math.max(vol>0?3:0,vol/mxv*100):0;return'<div style="flex:1;min-width:0"><div style="text-align:center;font-size:12.5px;font-weight:700">'+cfp(cnt)+'</div><div style="height:9px;background:var(--bg);border-radius:6px;margin:4px 0;display:flex;justify-content:'+al+'"><i style="display:block;height:100%;width:'+w+'%;background:'+col+';opacity:.45;border-radius:6px"></i></div><div class="mut" style="text-align:center;font-size:10.5px">'+cfp(vol)+' ('+dxPct(tot>0?vol/tot*100:0,1)+')</div></div>'}
function row(l,sc,sv,bc,bv){return'<div style="display:flex;align-items:flex-end;gap:6px;direction:ltr;margin:12px 0 4px">'+side(sc,sv,ts,"var(--dn)","flex-end")+'<div style="flex:none;width:46px;text-align:center;font-weight:700;font-size:13px;padding-bottom:3px">'+l+'</div>'+side(bc,bv,tb,"var(--up)","flex-start")+'</div>'}
return'<div class="card"><div style="display:flex;justify-content:space-between;align-items:baseline;direction:ltr"><b style="color:'+nc+';font-size:14px">'+(net<0?"−":"")+cfp(Math.abs(net),3)+' B</b><b>ورود پول</b></div>'+row("حقیقی",csI,sI,cbI,bI)+row("حقوقی",csN,sN,cbN,bN)+
'<div class="mut" style="font-size:11px;line-height:1.8;margin-top:4px">قرمز = فروش، سبز = خرید (حجم و درصد از کل حجم همان سمت). ورود پول = (حجم خرید − حجم فروش حقیقی) × قیمت.</div></div>'}
// ---- اطلاعات تکمیلی ----
