function pishNote(){var p=Math.round(+S.pct||0).toLocaleString("fa-IR");
return'<div class="card" style="font-size:12.5px">'+
ysec("b","این صفحه چیست؟","«پیش رو» نشان می‌دهد قیمت نمادِ انتخاب‌شده در ۹۰ روز آینده حداکثر تا کجا بالا و حداقل تا کجا پایین می‌تواند برود، اگر هر روز کاری بازار با بیشترین دامنه‌ی مجاز تغییر کند. این صفحه پیش‌بینی نیست؛ بالاترین و پایین‌ترین حالت ریاضی است.")+
ysec("b","ستون‌ها","<b>روز مانده</b>: تعداد روزهای تقویمی از امروز. ردیف اول همیشه روزی است که قیمتش مشخص است: تا ساعت ۹ صبح «دیروز» (تا کشف قیمت امروز) و از ساعت ۹:۰۱ «امروز»؛ ردیف‌های بعدی از روی آن محاسبه می‌شوند. <b>روز</b> و <b>تاریخ</b>: روز هفته و تاریخ شمسی. <b>افزایش</b> (سبز): قیمتی که سهم اگر هر روز کاری به سقف مجاز برسد به آن می‌رسد. <b>کاهش</b> (قرمز): قیمتی که اگر هر روز کاری به کف مجاز برسد به آن می‌رسد.")+
ysec("b","چگونه محاسبه می‌شود؟","شروع از قیمت پایه (قیمت پایانی یا آخرین معامله، طبق تنظیمات). در هر روز کاری، قیمت یک بار در (۱ ± درصد روزانه) ضرب می‌شود؛ درصد فعلی "+p+"٪ است و به‌صورت پیش‌فرض از دامنه‌ی نوسان همان نماد در بورس گرفته می‌شود. چون بورس فقط قیمت‌های روی «گام قیمت» را می‌پذیرد (قیمت زیر ۳۰۰۰ ریال با گام ۱ ریال و از ۳۰۰۰ ریال به بالا با گام ۱۰ ریال)، قیمت افزایش به پایین و قیمت کاهش به بالا روی همان گام گرد می‌شود تا از دامنه‌ی مجاز بیرون نزند. در هر روز، گام از روی قیمت همان روز تعیین می‌شود؛ پس سهمی که از زیر ۳۰۰۰ به بالای آن برسد از آن روز با گام ۱۰ ریال حرکت می‌کند.")+
ysec("b","روزهای تعطیل","پنجشنبه، جمعه و تعطیلات رسمی (ردیف‌های قرمزرنگ) بازار بسته است؛ قیمت در آن روزها تغییر نمی‌کند و درصدی اضافه نمی‌شود. تعطیلات رسمی به‌صورت خودکار از تقویم رسمی ایران (منابع عمومی اینترنتی) دریافت می‌شود.")+
ysec("y","ردیف‌های زرد و کاربرد","<span style=\"display:inline-block;background:#ffe94d;border:1px solid #d9b800;border-radius:6px;padding:0 10px;margin-inline-end:6px\">نمونه ردیف زرد</span>ردیف زرد یعنی آن تاریخ سررسید یکی از اختیارهای نماد است. با دیدن بیشترین و کمترین قیمت ممکن در سررسید می‌توانید قیمت اعمال و راهبرد را در صفحه‌های «زنجیره آپشن» و «بازده آپشن» با دید بازتری انتخاب کنید.")+
ysec("r","محدودیت‌ها (هشدار)","<span style=\"display:inline-block;background:#ffb4ad;border:1px solid #d32f2f;border-radius:6px;padding:0 10px;margin-inline-end:6px;color:#7a0d06\">قرمز = احتیاط</span>سهم معمولاً هر روز به سقف یا کف نمی‌رسد، پس عددها حالت حدی‌اند و نه انتظار واقعی. تغییر درصد دامنه‌ی نوسان، توقف یا بسته‌شدن نماد، افزایش سرمایه، سود نقدی و تعطیلی‌های اعلام‌نشده در محاسبه نیستند. اگر قیمت بروز نیست، «بروزرسانی قیمت» بالای صفحه را بزنید.")+
'</div>'}

// ======================================================================================
// «بازده آپشن»: covered call, cash-secured put sale and conversion, for every option of the selected symbol
// ======================================================================================
var YM="cc";
function yp(x,d){return x==null||!isFinite(x)?"—":x.toLocaleString("fa-IR",{maximumFractionDigits:d==null?1:d})+"٪"}
function yc(x){return x>0?"color:var(--up);font-weight:700":(x<0?"color:var(--dn);font-weight:700":"")}
var YS=[["cc","کاورد کال"],["cp","فروش پوت (کش‌سکیور)"],["cv","کانورژن"],["pp","پروتکتیو پوت"],["co","کالر (Collar)"],["bc","بول کال اسپرد"],["bp","بیر پوت اسپرد"],["ls","لانگ استرادل"],["lg","لانگ استرانگل"],["ab","آربیتراژی"],["all","همه استراتژی‌ها"]];
var YH={cc:'<th>نماد</th><th>اعمال</th><th>پرمیوم</th><th>بازده تا سررسید</th><th>سالانه</th><th>حاشیه امن</th>',
cp:'<th>نماد</th><th>اعمال</th><th>پرمیوم</th><th>بازده تا سررسید</th><th>سالانه</th><th>حاشیه امن</th>',
cv:'<th>اعمال</th><th>کال</th><th>پوت</th><th>سود</th><th>بازده</th><th>سالانه</th>',
pp:'<th>نماد پوت</th><th>اعمال</th><th>پرمیوم</th><th>حداکثر زیان</th><th>سر به سر</th><th>هزینه بیمه</th>',
co:'<th>اعمال پوت</th><th>اعمال کال</th><th>هزینه خالص</th><th>حداقل بازده</th><th>حداکثر بازده</th><th>سالانه (حداکثر)</th>',
bc:'<th>اعمال خرید</th><th>اعمال فروش</th><th>هزینه</th><th>حداکثر سود</th><th>سر به سر</th><th>بازده</th>',
bp:'<th>اعمال خرید</th><th>اعمال فروش</th><th>هزینه</th><th>حداکثر سود</th><th>سر به سر</th><th>بازده</th>',
ls:'<th>اعمال</th><th>کال</th><th>پوت</th><th>هزینه</th><th>سر به سر بالا</th><th>سر به سر پایین</th><th>حرکت لازم</th>',
lg:'<th>اعمال پوت</th><th>اعمال کال</th><th>هزینه</th><th>سر به سر پایین</th><th>سر به سر بالا</th><th>حرکت لازم</th>',
ab:'<th>اعمال پایین</th><th>اعمال بالا</th><th>هزینه</th><th>ارزش سررسید</th><th>سود</th><th>بازده</th><th>سالانه</th>'};
function ytd(t,st){return'<td'+(st?' style="'+st+'"':'')+'>'+t+'</td>'}
function yRows(mode,e,its,St,T){
var A=its.filter(function(x){return x.e===e}).sort(function(a,b){return a.k-b.k}),R=[],i,j,x,y;
function cOK(x){return x.c&&x.cp>0&&x.vc!==0}
function pOK(x){return x.p&&x.pp>0&&x.vp!==0}
function ann(r){return r*365/T}
for(i=0;i<A.length;i++){x=A[i];
if(mode==="cc"&&cOK(x)){var c=x.cp,g=(x.k+c-St)/St*100,o={n:x.c,k:x.k,pm:c,r:g,a:ann(g),s:c/St*100};
R.push({a:o.a,raw:o,h:'<td class="nm" data-sy="'+esc(o.n)+'" style="cursor:pointer">'+esc(o.n)+'</td>'+ytd(fp(o.k))+ytd(fp(o.pm))+ytd(yp(o.r),yc(o.r))+ytd(yp(o.a),yc(o.a))+ytd(yp(o.s),yc(o.s))})}
if(mode==="cp"&&pOK(x)){var p=x.pp,g2=p/x.k*100,o2={n:x.p,k:x.k,pm:p,r:g2,a:ann(g2),s:(St-(x.k-p))/St*100};
R.push({a:o2.a,raw:o2,h:'<td class="nm" data-sy="'+esc(o2.n)+'" style="cursor:pointer">'+esc(o2.n)+'</td>'+ytd(fp(o2.k))+ytd(fp(o2.pm))+ytd(yp(o2.r),yc(o2.r))+ytd(yp(o2.a),yc(o2.a))+ytd(yp(o2.s),yc(o2.s))})}
if(mode==="cv"&&cOK(x)&&pOK(x)){var cost=St+x.pp-x.cp,g3=x.k-cost,o3={k:x.k,c:x.cp,p:x.pp,g:g3,r:g3/cost*100,a:g3/cost*100*365/T};
R.push({a:o3.a,raw:o3,h:ytd(fp(o3.k))+ytd(fp(o3.c))+ytd(fp(o3.p))+ytd(fp(o3.g),yc(o3.g))+ytd(yp(o3.r,2),yc(o3.r))+ytd(yp(o3.a),yc(o3.a))})}
if(mode==="pp"&&pOK(x)){var cs=St+x.pp,w=(x.k-cs)/cs*100;
R.push({a:w,h:'<td class="nm" data-sy="'+esc(x.p)+'" style="cursor:pointer">'+esc(x.p)+'</td>'+ytd(fp(x.k))+ytd(fp(x.pp))+ytd(yp(w,2),yc(w))+ytd(fp(cs))+ytd(yp(x.pp/St*100,2))})}
if(mode==="ls"&&cOK(x)&&pOK(x)){var ct=x.cp+x.pp,up=x.k+ct,dn=x.k-ct,mv=Math.min(Math.abs(up-St),Math.abs(St-dn))/St*100;if(dn<St&&up>St)mv=Math.min(up-St,St-dn)/St*100;
R.push({a:-mv,h:ytd(fp(x.k))+ytd(fp(x.cp))+ytd(fp(x.pp))+ytd(fp(ct))+ytd(fp(up))+ytd(fp(dn))+ytd(yp(mv,1))})}
for(j=i+1;j<A.length;j++){y=A[j];
if(mode==="bc"&&cOK(x)&&cOK(y)){var db=x.cp-y.cp,mp=(y.k-x.k)-db;if(db>0&&mp>0)R.push({a:mp/db,h:ytd(fp(x.k))+ytd(fp(y.k))+ytd(fp(db))+ytd(fp(mp),yc(mp))+ytd(fp(x.k+db))+ytd(yp(mp/db*100,0),yc(mp))})}
if(mode==="bp"&&pOK(x)&&pOK(y)){var db2=y.pp-x.pp,mp2=(y.k-x.k)-db2;if(db2>0&&mp2>0)R.push({a:mp2/db2,h:ytd(fp(y.k))+ytd(fp(x.k))+ytd(fp(db2))+ytd(fp(mp2),yc(mp2))+ytd(fp(y.k-db2))+ytd(yp(mp2/db2*100,0),yc(mp2))})}
if(mode==="co"&&pOK(x)&&cOK(y)){var cn=St+x.pp-y.cp;if(cn>0){var mn=(x.k-cn)/cn*100,mx=(y.k-cn)/cn*100;if(mn>=-15&&mx>0)R.push({a:ann(mx),h:ytd(fp(x.k))+ytd(fp(y.k))+ytd(fp(cn))+ytd(yp(mn,1),yc(mn))+ytd(yp(mx,1),yc(mx))+ytd(yp(ann(mx)),yc(mx))})}}
if(mode==="lg"&&pOK(x)&&cOK(y)&&x.k<=St&&y.k>=St){var c4=x.pp+y.cp,u4=y.k+c4,d4=x.k-c4,m4=Math.min(u4-St,St-d4)/St*100;R.push({a:-m4,h:ytd(fp(x.k))+ytd(fp(y.k))+ytd(fp(c4))+ytd(fp(d4))+ytd(fp(u4))+ytd(yp(m4,1))})}
if(mode==="ab"&&cOK(x)&&pOK(x)&&cOK(y)&&pOK(y)){var co2=(x.cp-y.cp)+(y.pp-x.pp),pf=(y.k-x.k)-co2;if(co2>0){var rr=pf/co2*100;R.push({a:ann(rr),raw:{k1:x.k,k2:y.k,c1:x.cp,c2:y.cp,p1:x.pp,p2:y.pp,co:co2,pf:pf,rr:rr,a:ann(rr)},h:ytd(fp(x.k))+ytd(fp(y.k))+ytd(fp(co2))+ytd(fp(y.k-x.k))+ytd(fp(pf),yc(pf))+ytd(yp(rr,2),yc(rr))+ytd(yp(ann(rr)),yc(rr))})}}}}
return R}
function yTable(mode,St,ex,its,lim){var out="",any=false,FR=null;
ex.forEach(function(e){var T=Math.max(1,Math.round((iso(e)-today)/864e5)),rows=yRows(mode,e,its,St,T);
if(!rows.length)return;any=true;rows.sort(function(a,b){return b.a-a.a});if(lim)rows=rows.slice(0,lim);
if(!FR&&rows[0].raw)FR={r:rows[0].raw,T:T};
out+='<div class="mt">سررسید '+JJ.format(iso(e))+' – '+T.toLocaleString("fa-IR")+' روز مانده</div><table class="stk"><tr>'+YH[mode]+'</tr>'+rows.map(function(r,i){return'<tr'+(i%2?"":' class="zb"')+'>'+r.h+'</tr>'}).join("")+'</table>'});
return{out:out,any:any,FR:FR}}
function yieldHtml(){
var ch=(S.ch&&S.ch.ins===S.ins)?S.ch.items:[],t0=ds(today),its=ch.filter(function(x){return x.e>=t0});
if(!its.length)return'<div class="card mut">'+(/پیدا نشد/.test(ST.o||"")?"برای این نماد اختیار معامله‌ای پیدا نشد.":"داده‌ی آپشن این نماد هنوز دریافت نشده؛ «بروزرسانی قیمت» را بزنید.")+'</div>';
var St=+(S.pc||S.base),ex=[];its.forEach(function(x){if(ex.indexOf(x.e)<0)ex.push(x.e)});ex.sort();
var bar=preBanner()+'<div class="card" style="padding:8px"><div class="row2" style="margin:0"><label style="min-width:56px">استراتژی</label><select id="y_sel" style="flex:1;max-width:none;min-width:0">'+YS.map(function(a){return'<option value="'+a[0]+'"'+(YM===a[0]?" selected":"")+'>'+a[1]+'</option>'}).join("")+'</select></div></div>';
if(YM==="all"){var o="",any=false;
YS.forEach(function(a){if(a[0]==="all")return;var r=yTable(a[0],St,ex,its,3);if(!r.any)return;any=true;
o+='<div class="card" style="padding:8px"><div class="mt" style="margin:2px 0 0;color:var(--ac)">'+a[1]+'</div>'+r.out+'</div>'});
return bar+(any?'<div class="sc scv">'+o+'</div>':'<div class="card mut">آپشنی با معامله و قیمت برای این استراتژی‌ها نیست.</div>')+'<div class="card mut" style="line-height:1.9;font-size:12px">در این نما از هر استراتژی و هر سررسید فقط ۳ ردیف برتر نشان داده می‌شود. برای دیدن همه‌ی ردیف‌ها و توضیح کامل هر استراتژی، آن را از لیست بالا انتخاب کنید. پرمیوم = آخرین قیمت و فقط آپشن‌هایی که امروز معامله دارند آمده‌اند. این محاسبه فقط ابزار کمکی است و توصیه‌ی خرید یا فروش نیست.</div>'}
var lim=(YM==="cc"||YM==="cp"||YM==="cv"||YM==="pp"||YM==="ls")?0:8,r=yTable(YM,St,ex,its,lim);
var note=(YM==="cc"||YM==="cp"||YM==="cv")?yieldNote(YM,St,r.FR):yieldNote2(YM,r.FR,St);
return bar+(r.any?'<div class="sc scv">'+r.out+'</div>':'<div class="card mut">آپشنی با معامله و قیمت برای این حالت نیست.</div>')+note}

// ---------- «?» راهنمای سرستون‌ها ----------
var HELP={
"c:نام نماد":"نام اختیار معامله (کال یا پوت) در بورس.",
"c:آخرین قیمت":"آخرین قیمت معامله‌شده‌ی آپشن (پرمیوم). سبز یعنی بالاتر از قیمت دیروز، قرمز یعنی پایین‌تر.",
"c:مبلغ اعمال":"قیمتی که دارنده‌ی آپشن می‌تواند در سررسید سهم را با آن بخرد (کال) یا بفروشد (پوت).",
"c:سربه‌سر":"قیمتی از سهم در سررسید که خریدار آپشن نه سود می‌کند نه زیان: برای کال = اعمال + پرمیوم و برای پوت = اعمال − پرمیوم. سبز یعنی بالاتر از قیمت سهم و قرمز یعنی پایین‌تر.",
"c:حجم":"حجم معاملات امروز آپشن (تعداد قرارداد). K (آبی) یعنی هزار و M (نارنجی) یعنی میلیون؛ مثلاً ۱۲٫۵ K یعنی ۱۲٬۵۰۰ قرارداد.",
"y:نماد":"نام اختیار معامله‌ای که در این استراتژی استفاده شده است.",
"y:نماد پوت":"نام اختیار فروش (پوت) این استراتژی.",
"y:اعمال":"قیمت اعمال آپشن.",
"y:پرمیوم":"قیمت آپشن (آخرین معامله) به ریال برای هر سهم.",
"y:بازده تا سررسید":"سود یا زیان نسبی تا سررسید، اگر قیمت سهم بالاتر از اعمال بماند (برای کاورد کال) یا پوت اعمال نشود (برای فروش پوت).",
"y:سالانه":"بازده تا سررسید که به‌صورت ساده برای یک سال تبدیل شده است: بازده × ۳۶۵ ÷ روز مانده.",
"y:حاشیه امن":"درصدی که قیمت سهم می‌تواند افت کند و هنوز ضرر نکنید.",
"y:کال":"قیمت (پرمیوم) اختیار خرید.","y:پوت":"قیمت (پرمیوم) اختیار فروش.",
"y:سود":"سود ثابت یا حداکثر سود به ریال برای هر سهم.",
"y:بازده":"سود نسبت به هزینه‌ی ورود یا ریسک پرداختی.",
"y:حداکثر زیان":"بیشترین ضرر درصدی ممکن تا سررسید. مثبت‌بودن یعنی ضرر وجود ندارد.",
"y:سر به سر":"قیمت سهم در سررسید که نه سود و نه زیان دارید.",
"y:هزینه بیمه":"پرمیوم پوت نسبت به قیمت سهم؛ هزینه‌ای که برای محافظت می‌دهید.",
"y:اعمال پوت":"قیمت اعمال اختیار فروش.","y:اعمال کال":"قیمت اعمال اختیار خرید.",
"y:هزینه خالص":"خرج واقعی ورود: سهم + پوت − کال، به ریال برای هر سهم.",
"y:حداقل بازده":"بازده در بدترین حالت تا سررسید.","y:حداکثر بازده":"بازده در بهترین حالت تا سررسید.",
"y:سالانه (حداکثر)":"حداکثر بازده که سالانه (ساده) شده است.",
"y:اعمال خرید":"اعمال آپشنی که می‌خرید.","y:اعمال فروش":"اعمال آپشنی که می‌فروشید.",
"y:هزینه":"مبلغ خالصی که برای ساخت موقعیت می‌پردازید (به ریال برای هر سهم).",
"y:حداکثر سود":"بیشترین سود ممکن این ترکیب.",
"y:سر به سر بالا":"قیمتی بالاتر از اعمال که از آن به بعد سود می‌کنید.",
"y:سر به سر پایین":"قیمتی پایین‌تر از اعمال که از آن به پایین‌تر سود می‌کنید.",
"y:حرکت لازم":"کمترین درصد تغییر قیمت سهم تا رسیدن به سر به سر.",
"y:اعمال پایین":"اعمال کوچک‌تر در باکس اسپرد.","y:اعمال بالا":"اعمال بزرگ‌تر در باکس اسپرد.",
"y:ارزش سررسید":"ارزش قطعی موقعیت در سررسید = فاصله‌ی دو اعمال.",
"a:نماد":"نام نماد؛ با لمس هر ردیف آن نماد برای بقیه‌ی صفحه‌ها انتخاب می‌شود.",
"a:قیمت":"قیمت پایانی (یا آخرین معامله) و درصد تغییر آن نسبت به دیروز.",
"a:P/E":"قیمت ÷ سود هر سهم (EPS). عدد کم یعنی ارزان‌تر به نسبت سود؛ P/E خیلی پایین اغلب سود غیرتکراری است.",
"a:حجم×":"حجم امروز ÷ حجم مبنا (یا میانگین ماه). بالای ۱ یعنی حجم از معمول بیشتر است.",
"a:قدرت":"قدرت خریدار حقیقی: میانگین خرید هر خریدار ÷ میانگین فروش هر فروشنده. بالای ۱ یعنی خریدار قوی‌تر.",
"a:پول حقیقی":"ورود یا خروج پول حقیقی به میلیارد ریال: (خرید − فروش) × قیمت. سبز ورود و قرمز خروج.",
"a:وضعیت":"صف خرید/فروش، یا حباب نسبت به NAV برای صندوق‌ها.",
"a:وجه تضمین":"وجه تضمین اولیه‌ی هر قرارداد آپشن این سهم (برای فروشندگان) که از بورس دریافت می‌شود؛ نزدیک‌ترین اعمال به قیمت سهم. K هزار و M میلیون ریال است. برای سهمی که آپشن ندارد «—» است.",
"a:تا سقف":"فاصله‌ی قیمت فعلی تا سقف یک‌ساله و سقف تاریخی.",
"a:P/E صنعت":"P/E سهم نسبت به میانگین P/E صنعت.","a:EPS":"سود هر سهم طبق گزارش بورس.",
"a:تغییر":"درصد تغییر قیمت امروز.","a:حجم":"حجم معاملات امروز.","a:ارزش معاملات":"ارزش ریالی معاملات امروز.",
"a:تعداد معامله":"تعداد دفعات معامله امروز.","a:پول حقوقی":"ورود یا خروج پول حقوقی به میلیارد ریال.",
"a:سهم خرید حقیقی":"سهم خرید حقیقی از کل حجم خرید.","a:صف":"وضعیت صف خرید یا فروش.",
"a:نوسان روز":"(بیشترین − کمترین قیمت) ÷ قیمت دیروز.",
"a:از کف سال":"فاصله از کف قیمت یک‌ساله.","a:از سقف سال":"فاصله از سقف قیمت یک‌ساله.","a:از سقف تاریخی":"فاصله از بالاترین قیمت ثبت‌شده."};
function helpFor(n){var t=(typeof tab==="string"?tab:"");return HELP[t+":"+n]||HELP[(t==="y"?"y":"a")+":"+n]||null}
function addQ(root){root=root||document.getElementById("v");if(!root)return;
root.querySelectorAll(".stk th").forEach(function(th){if(th.querySelector(".q"))return;var n=th.textContent.trim();if(!n||!helpFor(n))return;
var i=document.createElement("i");i.className="q";i.setAttribute("data-q",n);i.textContent="?";th.appendChild(i)})}
function showHelp(n){var t=helpFor(n);if(!t)return;var o=document.getElementById("hb");if(o)o.remove();
o=document.createElement("div");o.id="hb";o.innerHTML='<div class="bx"><b class="t">'+esc(n)+'</b>'+esc(t)+'<button type="button">بستن</button></div>';
o.onclick=function(e){if(e.target===o||e.target.tagName==="BUTTON")o.remove()};document.body.appendChild(o)}
document.addEventListener("click",function(e){var q=e.target.closest&&e.target.closest(".q");if(q){e.preventDefault();e.stopPropagation();showHelp(q.getAttribute("data-q"))}},true);

function closeCs(){document.querySelectorAll(".csp").forEach(function(p){p.style.display="none"})}
document.addEventListener("click",function(){closeCs()});
// متن هر گزینه در یک سطر جا شود: اندازه‌ی قلم تا ۸٫۵px کوچک می‌شود
function csFit(el){if(!el||!el.style||!el.clientWidth)return;el.style.fontSize="";var f=parseFloat(getComputedStyle(el).fontSize)||12,n=0;while(el.scrollWidth>el.clientWidth+1&&f>8.5&&n<12){f-=0.5;n++;el.style.fontSize=f+"px"}}
function csFitSoon(el){setTimeout(function(){csFit(el)},0)}
window.addEventListener("resize",function(){document.querySelectorAll(".csb span").forEach(csFit)});
function enhSel(root){(root||document).querySelectorAll("select").forEach(function(sl){if(sl.getAttribute("data-enh"))return;sl.setAttribute("data-enh","1");
var st=sl.getAttribute("style")||"",w=document.createElement("div"),b=document.createElement("button"),pn=document.createElement("div"),CA='<svg viewBox="0 0 24 24"><polyline points="6,9 12,15 18,9"/></svg>';
w.className="cs";w.style.cssText=st+(/flex/.test(st)?";width:auto":"");b.type="button";b.className="csb";pn.className="csp";pn.style.display="none";
function lab(){var o=sl.options[sl.selectedIndex];b.innerHTML="<span>"+esc(o?o.text:"")+"</span>"+CA;csFitSoon(b.firstChild)}
lab();
b.onclick=function(e){e.stopPropagation();var open=pn.style.display!=="none";closeCs();if(open)return;pn.innerHTML="";
var lg=null;[].forEach.call(sl.options,function(o,i){var og=o.parentNode&&o.parentNode.tagName==="OPTGROUP"?o.parentNode.label:null;if(og&&og!==lg){var gh=document.createElement("div");gh.className="csg";gh.textContent=og;pn.appendChild(gh)}lg=og;var it=document.createElement("button");it.type="button";it.textContent=o.text;if(i===sl.selectedIndex)it.className="on";
it.onclick=function(ev){ev.stopPropagation();sl.selectedIndex=i;lab();pn.style.display="none";sl.dispatchEvent(new Event("change",{bubbles:true}))};pn.appendChild(it)});
pn.style.display="block";[].forEach.call(pn.children,csFit);var on=pn.querySelector(".on");if(on&&on.scrollIntoView){try{on.scrollIntoView({block:"nearest"})}catch(_){}}};
w.appendChild(b);w.appendChild(pn);sl.style.display="none";sl.parentNode.insertBefore(w,sl.nextSibling)})}
function yieldBind(){var e=document.getElementById("y_sel");if(e)e.onchange=function(){YM=e.value;view()}}
function yieldNote2(mode,FR,St){var h='<div class="card" style="font-size:12.5px">';
if(mode==="pp"){
h+=ysec("b","پروتکتیو پوت چیست؟","سهم را می‌خرید (یا دارید) و هم‌زمان یک اختیار فروش (پوت) می‌خرید. پوت مثل بیمه است: کف قیمت فروش سهم شما را برابر قیمت اعمال می‌کند.");
h+=ysec("g","سود شما","اگر سهم بالا برود، سود نامحدود دارید و فقط هزینه‌ی پرمیوم از آن کم می‌شود. سر به سر شما «قیمت سهم + پرمیوم» است.");
h+=ysec("r","زیان و ریسک","بدترین حالت = اعمال − (قیمت سهم + پرمیوم). اگر ستون «حداکثر زیان» قرمز باشد، حتی با بیمه هم مقداری ضرر ممکن است. پرمیوم هزینه‌ی قطعی است و اگر سهم نیفتد از دست می‌رود.");
h+=ysec("b","ستون‌ها","<b>هزینه بیمه</b> = پرمیوم ÷ قیمت سهم. <b>حداکثر زیان</b> = بیشترین ضرر درصدی تا سررسید. ردیف‌ها از کم‌ضررترین مرتب‌اند.")}
else if(mode==="co"){
h+=ysec("b","کالر چیست؟","خرید سهم + خرید پوت + فروش کال. پرمیوم کالِ فروخته‌شده بخشی از هزینه‌ی بیمه‌ی پوت را پرداخت می‌کند؛ در عوض سود شما سقف دارد.");
h+=ysec("g","سود شما","حداکثر سود = اعمال کال − هزینه‌ی خالص. اگر پرمیوم کال بیشتر از پوت باشد هزینه‌ی خالص کم می‌شود.");
h+=ysec("r","زیان و ریسک","حداکثر زیان = هزینه‌ی خالص − اعمال پوت. فقط ترکیب‌هایی نشان داده می‌شوند که حداقل بازده آن‌ها بدتر از ۱۵٪- نباشد. وجه تضمین کال فروخته‌شده و کارمزد لحاظ نشده است.");
h+=ysec("b","ستون‌ها","<b>هزینه خالص</b> = سهم + پوت − کال. <b>حداقل/حداکثر بازده</b> بازده در بدترین و بهترین حالت. ردیف‌ها بر اساس بازده سالانه‌ی حداکثر مرتب‌اند و ۸ مورد برتر هر سررسید آمده است.")}
else if(mode==="bc"){
h+=ysec("b","بول کال اسپرد چیست؟","خرید کال با اعمال پایین‌تر و فروش کال با اعمال بالاتر در یک سررسید. وقتی انتظار رشد محدود دارید، هزینه‌ی کمتری از خرید ساده‌ی کال می‌دهید.");
h+=ysec("g","سود شما","حداکثر سود = (اعمال فروخته‌شده − اعمال خریداری‌شده) − هزینه، وقتی سهم بالای اعمال بالاتر باشد.");
h+=ysec("r","زیان و ریسک","حداکثر زیان همان هزینه‌ی پرداختی است (وقتی سهم زیر اعمال پایین‌تر بماند). سر به سر = اعمال خرید + هزینه.");
h+=ysec("b","ستون‌ها","<b>بازده</b> = حداکثر سود ÷ هزینه. ۸ ترکیب برتر هر سررسید نشان داده می‌شود.")}
else if(mode==="bp"){
h+=ysec("b","بیر پوت اسپرد چیست؟","خرید پوت با اعمال بالاتر و فروش پوت با اعمال پایین‌تر. برای انتظار افت محدود قیمت است.");
h+=ysec("g","سود شما","حداکثر سود = (اعمال بالاتر − اعمال پایین‌تر) − هزینه، وقتی سهم زیر اعمال پایین‌تر بیاید.");
h+=ysec("r","زیان و ریسک","حداکثر زیان همان هزینه است (وقتی سهم بالای اعمال بالاتر بماند). سر به سر = اعمال بالاتر − هزینه.");
h+=ysec("b","ستون‌ها","<b>اعمال خرید</b> پوتی که می‌خرید (بالاتر)، <b>اعمال فروش</b> پوتی که می‌فروشید (پایین‌تر). <b>بازده</b> = حداکثر سود ÷ هزینه.")}
else if(mode==="ls"){
h+=ysec("b","لانگ استرادل چیست؟","خرید هم‌زمان کال و پوت با یک اعمال و یک سررسید. وقتی انتظار حرکت شدید قیمت دارید ولی جهت آن را نمی‌دانید.");
h+=ysec("g","سود شما","اگر سهم از «سر به سر بالا» بالاتر یا از «سر به سر پایین» پایین‌تر برود سود می‌کنید و سود در بالا بدون سقف است.");
h+=ysec("r","زیان و ریسک","اگر سهم نزدیک اعمال بماند، کل هزینه (مجموع کال و پوت) از دست می‌رود.");
h+=ysec("b","ستون‌ها","<b>حرکت لازم</b> = کمترین درصد تغییر سهم برای رسیدن به سر به سر. ردیف‌ها از کمترین حرکت لازم مرتب‌اند.")}
else if(mode==="lg"){
h+=ysec("b","لانگ استرانگل چیست؟","خرید پوت با اعمال پایین‌تر از قیمت سهم و کال با اعمال بالاتر از آن. مثل استرادل ولی ارزان‌تر و با نیاز به حرکت بزرگ‌تر.");
h+=ysec("g","سود شما","اگر سهم از سر به سر بالا یا پایین عبور کند سود می‌کنید.");
h+=ysec("r","زیان و ریسک","اگر سهم بین دو اعمال بماند کل هزینه از دست می‌رود.");
h+=ysec("b","ستون‌ها","۸ ترکیب با کمترین «حرکت لازم» برای هر سررسید آمده است.")}
else{
var ex2="";if(FR&&FR.r&&FR.r.k1!=null){var q=FR.r;ex2="مثال زنده با اولین ردیف: اعمال پایین "+fp(q.k1)+" و اعمال بالا "+fp(q.k2)+". هزینه = ("+fp(q.c1)+" − "+fp(q.c2)+") + ("+fp(q.p2)+" − "+fp(q.p1)+") = <b>"+fp(q.co)+"</b>. ارزش سررسید = "+fp(q.k2)+" − "+fp(q.k1)+" = <b>"+fp(q.k2-q.k1)+"</b>. سود = "+fp(q.k2-q.k1)+" − "+fp(q.co)+" = <b style=\""+yc(q.pf)+"\">"+fp(q.pf)+"</b> ریال به‌ازای هر سهم؛ یعنی "+yp(q.rr,2)+" تا سررسید و حدود "+yp(q.a)+" سالانه (ساده).";}
h+=ysec("b","آربیتراژی چیست؟","موقعیتی با سود ثابت که به قیمت سهم بستگی ندارد. با چهار آپشن هم‌زمان (باکس اسپرد) ساخته می‌شود: در اعمال پایین (K1) کال می‌خرید و پوت می‌فروشید، و در اعمال بالا (K2) کال می‌فروشید و پوت می‌خرید. ارزش این ترکیب در سررسید همیشه برابر K2 − K1 است.");
h+=ysec("b","فرمول محاسبه","<b>هزینه ورود</b> = (کال K1 − کال K2) + (پوت K2 − پوت K1)<br><b>ارزش سررسید</b> = K2 − K1<br><b>سود</b> = ارزش سررسید − هزینه ورود<br><b>بازده</b> = سود ÷ هزینه ورود × ۱۰۰<br><b>سالانه</b> = بازده × ۳۶۵ ÷ روز مانده (ساده)");
h+=ysec("g","سود شما","اگر هزینه‌ی ورود کمتر از ارزش سررسید باشد (ستون سود سبز)، سود ثابت و بدون ریسک قیمتی قفل می‌شود.");
h+=ysec("r","زیان و ریسک","اگر هزینه بیشتر از ارزش سررسید باشد، زیان قفل می‌شود. کارمزد چهار پا، وجه تضمین پوزیشن‌های فروش، نقدشوندگی و اعمال زودهنگام لحاظ نشده و اغلب سود را کم یا صفر می‌کند.");
if(ex2)h+=ysec("b","مثال",ex2);
h+=ysec("b","ستون‌ها","۸ ترکیب با بیشترین بازده سالانه برای هر سررسید نشان داده می‌شود. کانورژن هم نوعی آربیتراژ است و در لیست جداگانه آمده.")}
return h+'<div class="mut" style="line-height:1.9;margin-top:6px">پرمیوم = آخرین قیمت و فقط آپشن‌هایی که امروز معامله دارند آمده‌اند. این محاسبه فقط ابزار کمکی است و توصیه‌ی خرید یا فروش نیست.</div></div>'}

// ======================================================================================
// two screeners: «غربال آپشن» = every symbol that has an options market + my own list,
//                «غربال سهام» = all stocks of the market (one bulk request)
// ======================================================================================
function Scr(key,vm){var Z={key:key,vm:vm,rows:{},t:0,run:false,done:0,total:0,err:"",msg:"",FL:{sort:"pe|1",pre:"",grp:"",n:20}};
try{var s0=JSON.parse(localStorage.getItem("scr_"+key));if(s0&&s0.r){Z.rows=s0.r;Z.t=s0.t||0}}catch(e){}
try{var f0=JSON.parse(localStorage.getItem("scf_"+key));if(f0&&typeof f0==="object")for(var k in f0)Z.FL[k]=f0[k]}catch(e){}
Z.FL.pre="";
return Z}
var SO=Scr("o","avg"),SA=Scr("a","base"),WLM="";
var SORTS=[["pe",1,"P/E (کم به زیاد)"],["ey",-1,"بیشترین سود سالیانه"],["rel",1,"P/E نسبت به صنعت"],["eps",-1,"EPS بیشتر"],["chg",-1,"بیشترین رشد قیمت امروز"],["pr",-1,"قیمت بیشتر"],["vol",-1,"حجم معاملات بیشتر"],["val",-1,"ارزش معاملات بیشتر"],["trd",-1,"تعداد معاملات بیشتر"],["vr",-1,"حجم نسبی بیشتر"],["pw",-1,"قدرت خریدار بیشتر"],["flow",-1,"ورود پول حقیقی"],["lflow",-1,"ورود پول حقوقی"],["rb",-1,"سهم خرید حقیقی بیشتر"],["q",-1,"صف خرید"],["rng",-1,"نوسان روز بیشتر"],["lo",1,"نزدیک‌تر به کف سال"],["hi",-1,"نزدیک‌تر به سقف سال"],["da",-1,"نزدیک‌تر به سقف تاریخی"]];
var OLDS={pe:"pe|1",pw:"pw|-1",flow:"flow|-1",vr:"vr|-1",lo:"lo|1",hi:"hi|-1",da:"da|-1",bub:"pe|1",chg:"chg|-1"};
function sortOf(F){var v=String(F.sort||"");if(v.indexOf("ey2")===0)v="ey|-1";if(v.indexOf("|")<0)v=OLDS[v]||"pe|1";var a=v.split("|");return{k:a[0],d:+a[1]||1,v:a[0]+"|"+(+a[1]||1)}}
function zstale(Z){var k=Object.keys(Z.rows)[0];return !!k&&Z.rows[k].val===undefined}
function zsave(Z){try{localStorage.setItem("scr_"+Z.key,JSON.stringify({t:Z.t,r:Z.rows}))}catch(e){}}
function zsaveFL(Z){try{localStorage.setItem("scf_"+Z.key,JSON.stringify(Z.FL))}catch(e){}}
function num(x){x=+x;return isFinite(x)?x:0}
function univ(){var m={},l=[];UL.forEach(function(u){if(!m[u.c]){m[u.c]=1;l.push({c:u.c,n:u.n})}});(S.wl||[]).forEach(function(u){if(!m[u.c]){m[u.c]=1;l.push(u)}});return l}
async function pool(list,n,fn,step){var i=0,done=0;
async function w(){while(i<list.length){var x=list[i++];try{await fn(x)}catch(e){}done++;if(step)step(done)}}
var ws=[];for(var k=0;k<n;k++)ws.push(w());await Promise.all(ws)}
// ---- per-symbol data (cdn.tsetmc.com) ----
async function fillInfo(o){var I=JSON.parse(await GET(TS+"Instrument/GetInstrumentInfo/"+o.c));I=I.instrumentInfo||I;var e=I.eps||{},t=I.staticThreshold||{};
var eps=num(e.estimatedEPS)||num(e.epsValue);if(eps)o.eps=eps;
o.spe=num(e.sectorPE);o.sec=I.sector&&I.sector.lSecVal?ar(String(I.sector.lSecVal).trim()):"";o.sc=I.sector&&I.sector.cSecVal!=null?String(I.sector.cSecVal).trim():"";
o.mw=num(I.minWeek);o.xw=num(I.maxWeek);o.my=num(I.minYear);o.xy=num(I.maxYear);o.av=num(I.qTotTran5JAvg);o.nav=num(I.nav);
if(!o.smx){o.smx=num(t.psGelStaMax);o.smn=num(t.psGelStaMin)}o.ok1=1}
// highest price ever recorded (raw daily history, not adjusted for capital increases)
async function fillAth(o){var j=JSON.parse(await GET(TS+"ClosingPrice/GetClosingPriceDailyList/"+o.c+"/0")),a=firstArr(j.closingPriceDaily||j),mx=0;
a.forEach(function(r){var v=num(r.priceMax)||num(r.pClosing);if(v>mx)mx=v});if(mx>0){o.ath=mx;o.ta=Date.now()}}
async function scanOne(u){var o={c:u.c,n:u.n,t:Date.now()},bad=null;
try{await fillInfo(o)}catch(x){bad=bad||x}
try{var C=JSON.parse(await GET(TS+"ClosingPrice/GetClosingPriceInfo/"+u.c));C=C.closingPriceInfo||C;
o.pc=num(C.pClosing);o.pl=num(C.pDrCotVal);o.py=num(C.priceYesterday);o.vol=num(C.qTotTran5J);o.ok2=1}catch(x){bad=bad||x}
try{var T=JSON.parse(await GET(TS+"ClientType/GetClientType/"+u.c+"/1/0")),bv=num(deep(T,"buy_I_Volume")),bc=num(deep(T,"buy_CountI")),sv=num(deep(T,"sell_I_Volume")),sc=num(deep(T,"sell_CountI"));
if(bc>0&&sc>0&&sv>0&&bv>=0){o.pw=(bv/bc)/(sv/sc);o.net=bv-sv;o.ok3=1}}catch(x){}
if(bad)o.bad={kind:bad.kind,code:bad.code,message:String(bad.message)};return o}
async function zloadO(Z,force){
var u=univ().filter(function(x){var r=Z.rows[x.c];return force||!r||!r.t||Date.now()-r.t>18e5});
if(!u.length||Z.run)return;Z.run=true;Z.msg="دریافت نمادها";Z.done=0;Z.total=u.length;Z.err="";zrefresh(Z);var firstBad=null,ok=0;
await pool(u,5,async function(x){var o=await scanOne(x),old=Z.rows[x.c];if(old&&old.ath){o.ath=old.ath;o.ta=old.ta}if(o.bad&&!firstBad)firstBad=o.bad;if(o.ok2)ok++;Z.rows[x.c]=o},function(d){Z.done=d;if(d%3===0)zrefresh(Z)});
Z.run=false;Z.t=Date.now();if(!ok&&firstBad){Z.err=why(firstBad,"داده‌ی سهام");ST.d=firstBad.message}
zsave(Z);zrefresh(Z);zneeds(Z)}
// ---- whole market (legacy bulk tables of the exchange) ----
var HOSTS=["https://old.tsetmc.com","https://cdn.tsetmc.com","https://www.tsetmc.com"];
async function getAny(path){var last=null;for(var i=0;i<HOSTS.length;i++){try{return await GET(HOSTS[i]+path)}catch(e){last=e}}throw last}
// MarketWatchInit rows (after "@" splitting, ";" between rows, "," between fields):
// 0 insCode,1 ISIN,2 symbol,3 name,4 time,5 first,6 last,7 close,8 trades,9 volume,10 value,11 low,12 high,13 yesterday,14 EPS,15 base volume,...,19 max allowed,20 min allowed
function parseMW(t){var segs=String(t).split("@"),best=null,bn=0;
segs.forEach(function(sg){var r=sg.split(";"),n=0;for(var i=0;i<Math.min(r.length,40);i++){if(r[i].split(",").length>=20)n++}if(n>bn){bn=n;best=r}});
if(!best||bn<5)return[];var out=[];
best.forEach(function(r){var f=r.split(",");if(f.length<21)return;
var isin=(f[1]||"").trim(),sym=ar((f[2]||"").trim()),nm=ar((f[3]||"").trim());
if(!/^IRO[13]/.test(isin)||!sym||/\d/.test(sym)||/^ح[\s.]/.test(nm))return;
out.push({c:f[0].trim(),st:(f[4]||"").trim().toUpperCase(),n:sym,nm:nm,pl:num(f[7]),pc:num(f[6]),tr:num(f[8]),vol:num(f[9]),val:num(f[10]),lw:num(f[11]),hg:num(f[12]),py:num(f[13]),eps:num(f[14]),bv:num(f[15]),smx:num(f[19]),smn:num(f[20]),fl:(f[17]||"").trim(),sc:(f[18]||"").trim(),pf:num(f[5]),hv:num(f[4]),vc:num(f[16]),z:num(f[21]),yv:num(f[22])})});
return out}
// ClientTypeAll rows: insCode, buyCountReal, buyCountLegal, buyVolReal, buyVolLegal, sellCountReal, sellCountLegal, sellVolReal, sellVolLegal
function parseCT(t){var m={};String(t).split(";").forEach(function(r){var f=r.split(",");if(f.length<9)return;
var bc=num(f[1]),bv=num(f[3]),sc=num(f[5]),sv=num(f[7]),bl=num(f[4]),sl=num(f[8]);if(bc>0&&sc>0&&sv>0)m[f[0].trim()]={pw:(bv/bc)/(sv/sc),net:bv-sv,lnet:bl-sl,rb:(bv+bl)>0?bv/(bv+bl)*100:null,bc:bc,bv:bv,sc:sc,sv:sv}});return m}
async function zloadA(Z){if(Z.run)return;Z.run=true;Z.msg="دریافت فهرست کل بازار";Z.done=0;Z.total=0;Z.err="";zrefresh(Z);
try{var list=parseMW(await getAny("/tsev2/data/MarketWatchInit.aspx?h=0&r=0"));if(list.length<50)throw mkErr("data",0,"parse");
var old=Z.rows;Z.rows={};list.forEach(function(r){var p=old[r.c]||{};for(var k in r)p[k]=r[k];p.t=Date.now();Z.rows[r.c]=p});
Z.ct=0;try{var ct=parseCT(await getAny("/tsev2/data/ClientTypeAll.aspx"));for(var c in ct){if(Z.rows[c]){Z.rows[c].pw=ct[c].pw;Z.rows[c].net=ct[c].net;Z.rows[c].lnet=ct[c].lnet;Z.rows[c].rb=ct[c].rb;Z.ct++}}}catch(e){}
Z.t=Date.now();zsave(Z)}
catch(e){Z.err=e.kind==="data"?"فهرست کل بازار از بورس خوانده نشد (فرمت داده شناسایی نشد).":why(e,"فهرست سهام");ST.d=String(e.message)}
Z.run=false;zrefresh(Z);if(!Z.err)zneeds(Z)}
// year high / low for the stocks of the whole-market list (one request per liquid symbol, kept for later)
async function zenrich(Z){if(Z.run)return;
var l=Object.keys(Z.rows).filter(function(c){var o=Z.rows[c];return o.vol>0&&(!(o.xy>0)||o.sc===undefined)&&!(o.ie>Date.now()-216e5)});if(!l.length)return;
Z.run=true;Z.msg="تکمیل داده‌ی سقف و کف سال";Z.done=0;Z.total=l.length;zrefresh(Z);
await pool(l,6,async function(c){var o=Z.rows[c];o.ie=Date.now();await fillInfo(o)},function(d){Z.done=d;if(d%10===0)zrefresh(Z)});
Z.run=false;zsave(Z);zrefresh(Z)}
// all-time high only for symbols that could be near it (a stock within 10% of its all-time high is within 10% of its year high)
async function zath(Z){if(Z.run)return;var lim=0.25;
var l=Object.keys(Z.rows).filter(function(c){var o=Z.rows[c],pr=o.pc>0?o.pc:o.pl;return o.xy>0&&pr>0&&pr/o.xy-1>=-lim&&!(o.ath>0)}).sort(function(a,b){var x=Z.rows[a],y=Z.rows[b];return((y.pc||y.pl)/y.xy)-((x.pc||x.pl)/x.xy)}).slice(0,150);
if(!l.length)return;Z.run=true;Z.msg="بررسی سقف تاریخی";Z.done=0;Z.total=l.length;zrefresh(Z);
await pool(l,3,async function(c){await fillAth(Z.rows[c])},function(d){Z.done=d;zrefresh(Z)});
Z.run=false;zsave(Z);zrefresh(Z)}
// run whatever extra data the chosen preset / sort needs
async function zneeds(Z){var k=sortOf(Z.FL).k;
var year=k==="lo"||k==="hi"||k==="da"||!!Z.FL.grp,ath=k==="da";
if(year&&Z.key==="a")await zenrich(Z);
if(ath)await zath(Z)}
// ---- metrics, filters, table ----
var MI=null;
function marginIdx(){if(!OR||!OR.length)return{};if(MI&&MI.n===OR.length)return MI.m;var m={};
OR.forEach(function(r){var c=uaCode(r);if(!c)return;var st=0,mg=0,k;for(k in r){if(/strike/i.test(k)&&+r[k]>0){st=+r[k];break}}
for(k in r){var v=+r[k];if(v>0&&/margin|deposit|tazmin|collat|vajh|wajh|guarant/i.test(k)&&!/_ua$/i.test(k))mg=Math.max(mg,v)}
if(mg>0&&st>0)(m[c]=m[c]||[]).push({k:st,m:mg})});MI={n:OR.length,m:m};return m}
function stkMargin(c,pr){var l=marginIdx()[c];if(!l)return null;var b=null;l.forEach(function(x){if(!b||Math.abs(x.k-pr)<Math.abs(b.k-pr))b=x});return b?b.m:null}
function mrow(o,Z){var pr=(preOpen()&&o.py>0)?o.py:(o.pc>0?o.pc:o.pl),m={n:o.n,c:o.c,pr:pr,sec:o.sec||"",st:o.st||"",tr:o.tr};
m.chg=(o.py>0&&pr>0)?(pr-o.py)/o.py*100:null;m.mg=stkMargin(String(o.c),pr);
m.pe=(o.eps>0&&pr>0)?pr/o.eps:null;m.ey=(o.eps&&pr>0)?o.eps/pr*100:null;m.loss=o.eps<0;
m.rel=(m.pe&&o.spe>0)?m.pe/o.spe:null;
var ref=Z.vm==="base"?o.bv:o.av;m.vr=(ref>0&&o.vol>=0&&(Z.vm==="base"||o.ok2))?o.vol/ref:null;
m.lo=(o.my>0&&pr>0)?(pr/o.my-1)*100:null;m.hi=(o.xy>0&&pr>0)?(pr/o.xy-1)*100:null;m.da=(o.ath>0&&pr>0)?(pr/o.ath-1)*100:null;
var last=(o.pl>0&&!preOpen())?o.pl:pr;m.q=(o.smx>0&&last>=o.smx)?"صف خرید":((o.smn>0&&last>0&&last<=o.smn)?"صف فروش":"");
m.pw=o.pw==null?null:o.pw;m.flow=o.net==null?null:o.net*pr/1e9;
m.bub=(o.nav>0&&pr>0)?(pr/o.nav-1)*100:null;
m.eps=o.eps?o.eps:null;m.vol=o.vol>0?o.vol:null;m.val=o.val!=null?o.val:null;m.trd=o.tr!=null?o.tr:null;m.lflow=o.lnet==null?null:o.lnet*pr/1e9;m.rb=o.rb==null?null:o.rb;
m.rng=(o.hg>0&&o.lw>0&&o.py>0)?(o.hg-o.lw)/o.py*100:null;m.qv=m.q==="صف خرید"?1:(m.q==="صف فروش"?-1:null);return m}
function zfiltered(Z){var F0=Z.FL,k0=(F0.grp||"")+"|"+sortOf(F0).v+"|"+(preOpen()?1:0),fc=Z._fc,nw=Date.now();if(fc&&fc.t>nw-1500&&fc.m[k0])return fc.m[k0];var r=zfiltered0(Z);if(!fc||fc.t<=nw-1500)fc=Z._fc={t:nw,m:{}};fc.m[k0]=r;return r}
function zfiltered0(Z){var F=Z.FL,ids=null;if(Z.key==="o"){ids={};univ().forEach(function(u){ids[u.c]=1})}
var l=[];for(var c in Z.rows){if(ids&&!ids[c])continue;var m=mrow(Z.rows[c],Z);if(!(m.pr>0))continue;
if(F.grp==="__opt"){if(!OPTS()[c])continue}else if(F.grp&&m.sec!==F.grp)continue;
l.push(m)}
var so=sortOf(F),asc=so.d;
function v(m){return so.k==="q"?m.qv:m[so.k==="trd"?"trd":so.k]}
l.sort(function(a,b){var x=v(a),y=v(b);if(x==null&&y==null)return 0;if(x==null)return 1;if(y==null)return-1;return(x-y)*asc});return l}
function sgp(x,d,u){if(x==null||!isFinite(x))return"—";return"\u202a"+(x>0?"+":(x<0?"\u2212":""))+Math.abs(x).toLocaleString("fa-IR",{maximumFractionDigits:d==null?1:d})+(u||"٪")+"\u202c"}
function f1(x,d){return x==null?"—":x.toLocaleString("fa-IR",{maximumFractionDigits:d==null?1:d})}
var SNAME={pe:"P/E",ey:"سود سالیانه",rel:"P/E صنعت",eps:"EPS",chg:"تغییر",pr:"قیمت",vol:"حجم",val:"ارزش معاملات",trd:"تعداد معامله",vr:"حجم×",pw:"قدرت",flow:"پول حقیقی",lflow:"پول حقوقی",rb:"سهم خرید حقیقی",q:"صف",rng:"نوسان روز",lo:"از کف سال",hi:"از سقف سال",da:"از سقف تاریخی"};
function scell(m,k){var x=k==="q"?m.q:m[k],c="",t="—";
if(k==="q"){t=m.q||"—";c=m.q==="صف خرید"?"var(--up)":(m.q==="صف فروش"?"var(--dn)":"")}
else if(x!=null&&isFinite(x)){
if(k==="pe"||k==="vr")t=f1(x);else if(k==="rel")t="×"+f1(x,2);
else if(k==="eps"){t=fp(x);c=x<0?"var(--dn)":""}
else if(k==="chg"){t=(x>0?"+":"")+f1(x,2)+"٪";c=x>0?"var(--up)":(x<0?"var(--dn)":"")}
else if(k==="rng")t=f1(x,2)+"٪";else if(k==="pr")t=fp(x);else if(k==="vol"||k==="trd")t=cvol(x);
else if(k==="val")t=f1(x/1e9,0)+" میلیارد";else if(k==="pw")t=f1(x,2);
