var pc2=premium(r,"c",!!cs&&!ps),pp2=premium(r,"p",!!ps&&!cs),pre0=preOpen();if(pre0){var yy1=yest(r,"c",!!cs&&!ps),yy2=yest(r,"p",!!ps&&!cs);if(yy1>0)pc2=yy1;if(yy2>0)pp2=yy2}
if(cs){it.c=cs;if(pc2>0)it.cp=pc2}if(ps){it.p=ps;if(pp2>0)it.pp=pp2}
var mc2=marginOf(r,"c",!!cs&&!ps),mp2=marginOf(r,"p",!!ps&&!cs),z2=csz(r);
if(cs&&mc2>0)it.mc=mc2;if(ps&&mp2>0)it.mp=mp2;if(z2>0)it.z=z2;
var single=!!cs&&!ps,single2=!!ps&&!cs;
if(cs){var vc2=vol(r,"c",single);if(vc2>=0&&!pre0){it.vc=vc2;OPV[cs]=vc2}else if(pre0&&OPV[cs]!=null)it.vc=OPV[cs];var yc2=yest(r,"c",single);if(yc2>0)it.yc=yc2}
if(ps){var vp2=vol(r,"p",single2);if(vp2>=0&&!pre0){it.vp=vp2;OPV[ps]=vp2}else if(pre0&&OPV[ps]!=null)it.vp=OPV[ps];var yp2=yest(r,"p",single2);if(yp2>0)it.yp=yp2}});
if(liveWin())try{localStorage.setItem("opv1",JSON.stringify(OPV))}catch(e){}
return{items:Object.keys(map).map(function(x){return map[x]}),exp:Object.keys(exp).sort()}}
