try{await wlInit();pfSync();var C=wlCur(),L=C?C.items:[];if(C&&C.flt&&!WP.run&&(((NX[C.flt]&&NX[C.flt].once)||C.flt==="ci2"||C.flt==="pb1"||C.flt==="bo1"||C.flt==="rs1"||C.flt==="gb1"||C.flt==="gm1")?(!(C.ft>0)&&!C.cl):(!(C.ft>0)||Date.now()-C.ft>3e5)))wpRun(C);await Promise.all(L.map(wlItemLoad));wlSortFl();WL.t=Date.now();if(C)WL.ut[C.name]=WL.t;var _ok=0;L.forEach(function(it){var q=WL.q[it.c];if(q&&(q.pl>0||q.pc>0||q.py>0))_ok++});if(_ok&&(WL.cur===0||(C&&C.name==="اصلی")))WL.lu=Date.now();if(L.length&&!_ok){ST.w=why({},"قیمت");showSt()}else if(ST.w){ST.w="";showSt()}}catch(e){}
