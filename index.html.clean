while((m0=re.exec(t))){var piece=t.slice(last,m0.index);if(/\d\s*$/.test(piece)&&/^\s*\d/.test(t.slice(re.lastIndex))&&/[,٬]/.test(m0[0]))continue;parts.push(piece);ops.push(/یا/.test(m0[0])?"||":"&&");last=re.lastIndex}parts.push(t.slice(last));
