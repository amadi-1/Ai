if(okn>0){WL.lists=LL;try{if(!WL.lists.some(function(l){return l.flt==="sx1"}))WL.lists.splice(WL.lists.length?1:0,0,{name:"شاخص ساز",flt:"sx1",items:[]});localStorage.setItem("sx1m","1");var ixq=WL.lists.findIndex(function(l){return l.flt==="sx1"})+1;WL.lists.splice(ixq,0,{name:"صنعت‌های داغ",flt:"hs1",items:[]},{name:"حباب NAV",flt:"nb1",items:[]});localStorage.setItem("hs1m","1");localStorage.setItem("nb1m","1");WL.lists.push({name:"فیلتر ساز",flt:"fx1",items:[],fx:{m:"and",mk:"b",c:[]}});localStorage.setItem("fx1m","1");nxAdd(WL.lists,NX_ORDER.filter(function(k){return!NX[k].vip}));nxAddTop(WL.lists,NX5_ORDER.concat(["sm2","lc1","se1"],NX3_ORDER));localStorage.setItem("nx9m","1");localStorage.setItem("nx8m","1");localStorage.setItem("nx5m","1");localStorage.setItem("nx7m","1");localStorage.setItem("nx6m","1");localStorage.setItem("nx1m","1");localStorage.setItem("nx2m","1");localStorage.setItem("nx3m","1");localStorage.setItem("nx4m","1");localStorage.setItem("v95m","1")}catch(e){}WL.cur=0;if(okn>=tot-2)wlSave()}}
