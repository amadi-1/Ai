function parseCTc(t){var m={};String(t).split(";").forEach(function(r){var f=r.split(",");if(f.length<9)return;m[f[0].trim()]={bI:num(f[1]),bN:num(f[2]),bvR:num(f[3]),sI:num(f[5]),sN:num(f[6]),svR:num(f[7]),bvN:num(f[4]),svN:num(f[8])}});return m}
async function wpRun(C){if(WP.run)return;C=C||wlCur();if(!C||!C.flt)return;lvSetC(C);if(typeof NX!=="undefined"&&NX[C.flt])return nxRun(C);if(C.flt==="ci2")return ciRun(C);if(C.flt==="pb1")return pbRun(C);if(C.flt==="bo1")return boRun(C);if(C.flt==="qb1")return qbRun(C);if(C.flt==="sx1")return sxRun(C);if(C.flt==="fx1")return fxRun(C);if(C.flt==="hs1")return hsRun(C);if(C.flt==="nb1")return nbRun(C);if(C.flt==="gb1")return gxRun(C,"gb");if(C.flt==="gm1")return gxRun(C,"gm");if(C.flt==="rs1")return rsRun(C);if(C.flt==="sm1")return smRun(C);if(C.flt==="sc1")return scRun(C);if(C.flt==="wp2"||C.flt==="kk1")return wxRun(C);WP.run=true;WP.err="";WP.msg="دریافت فهرست کل بازار از بورس…";if(wlOn())wlPaint();
try{var list=parseMW(await getAny("/tsev2/data/MarketWatchInit.aspx?h=0&r=0"));if(list.length<50)throw mkErr("data",0,"parse");
WP.msg="دریافت تعداد و حجم خریدار و فروشنده…";if(wlOn())wlPaint();
var ct=parseCTc(await getAny("/tsev2/data/ClientTypeAll.aspx")),cand=[];
list.forEach(function(r){var t=ct[r.c];if(!t||!(r.vol>0)||!(r.py>0)||!(r.pl>0))return;
var plp=(r.pl/r.py-1)*100,pcp=((r.pc>0?r.pc:r.py)/r.py-1)*100,kpf=(t.sI+t.sN)/(t.bI+t.bN);
if(kpf>1.3&&(plp>pcp||plp>3)){r.kpf=kpf;r.t=t;cand.push(r)}});
var res=[],tk=key(today);
await pool(cand,6,async function(r){var j=JSON.parse(await GET(TS+"ClosingPrice/GetClosingPriceDailyList/"+r.c+"/63")),a=firstArr(j.closingPriceDaily||j).slice();
a.sort(function(x,y){return num(y.dEven)-num(x.dEven)});
if(a.length&&(num(a[0].dEven)>=tk||num(a[0].qTotTran5J)===r.vol))a.shift();
if(a.length<60)return;
var p=r.vol,ww=1,i,n=0,sv=0;for(i=0;i<60;i++){ww++;p+=num(a[i].qTotTran5J)}
var fav=p/ww;for(i=0;i<60;i++){var v=num(a[i].qTotTran5J);if(v>fav){n++;sv+=v}}
var sav=sv/n;if(!(n>0&&r.vol>1*sav))return;
var t=r.t,pr=r.pc>0?r.pc:r.pl,net=(t.bvR-t.svR)*pr,pw=(t.bI>0&&t.sI>0&&t.svR>0)?(t.bvR/t.bI)/(t.svR/t.sI):0;
res.push({c:r.c,n:r.n,nm:r.nm,k:r.vol/sav,net:net,pw:pw,kpf:r.kpf,bc:t.bI+t.bN,sc:t.sI+t.sN,bvR:t.bvR,svR:t.svR})},function(d){WP.msg="بررسی حجم ۶۰ روز گذشته… "+d.toLocaleString("fa-IR")+" از "+cand.length.toLocaleString("fa-IR");if(d%8===0&&wlOn())wlPaint()});
res.sort(function(x,y){return (y.net-x.net)||(y.k-x.k)});
C.items=(C.cfg&&C.cfg.n>0)?res.slice(0,C.cfg.n):res;C.ft=Date.now();WP.stat={m:list.length,c:cand.length};wlSave()}
catch(e){WP.err=e.kind==="data"?"فهرست بازار از بورس خوانده نشد (فرمت داده شناسایی نشد).":why(e,"فهرست سهام")}
WP.run=false;if(wlOn()){wlPaint();setTimeout(wlLoad,50)}}
// ---------- خروج پول (wp2) و کد به کد (kk1) : فیلتر بورس روی کل بازار ----------
// ih[0] = امروز ، ih[1] = دیروز ، ... ؛ [is1] = ۱ میلیارد تومان = 1e10 ریال
var IS1=1e10;
async function wxRun(C){if(WP.run)return;WP.run=true;WP.err="";C.cl=0;WP.msg="دریافت فهرست کل بازار از بورس…";if(wlOn())wlPaint();
try{var list=parseMW(await getAny("/tsev2/data/MarketWatchInit.aspx?h=0&r=0"));if(list.length<50)throw mkErr("data",0,"parse");
WP.msg="دریافت تعداد و حجم خریدار و فروشنده…";if(wlOn())wlPaint();
var ct=parseCTc(await getAny("/tsev2/data/ClientTypeAll.aspx")),cand=[],res=[],kk=C.flt==="kk1",st=[0,0,0,0,0,0,0],g=function(i,ok){if(ok)st[i]++;return ok},nbv=0;
list.forEach(function(r){var t=ct[r.c];if(!t||!(r.vol>0)||!(r.py>0)||!(r.pl>0))return;
var pc=r.pc>0?r.pc:r.pl,plp=(r.pl/r.py-1)*100,tv=r.vol;st[0]++;
if(kk){if(!g(1,t.bvR>0.4*tv))return;if(!g(2,t.svN>0.4*tv))return;
var k=((t.bvR*pc)/(t.svR*pc+1e10))*((t.svN*pc)/(t.bvN*pc+1e10));if(!g(3,k>3))return;
if(!g(4,r.val>1*IS1))return;if(!(t.bI>0&&t.sI>0&&t.svR>0))return;
var cap=(t.bvR*pc)/t.bI;if(!g(5,cap>20e7))return;var rt=(t.bvR/t.bI)/(t.svR/t.sI);if(!g(6,rt>1))return;
res.push({c:r.c,n:r.n,nm:r.nm,k:k,cap:cap,rt:rt,val:r.val})}
else{if(!(r.bv>0))nbv++;if(!g(1,tv>r.bv))return;if(!g(2,r.pl<=pc&&plp<0))return;if(!(t.bI>0&&t.sI>0&&t.svR>0))return;
var rt2=(t.bvR/t.bI)/(t.svR/t.sI);if(!g(3,rt2<1))return;r.t=t;r.rt=rt2;r.pc2=pc;cand.push(r)}});
if(!kk){var tk=key(today);
await pool(cand,6,async function(r){var j=JSON.parse(await GET(TS+"ClosingPrice/GetClosingPriceDailyList/"+r.c+"/40")),a=firstArr(j.closingPriceDaily||j).slice();
a.sort(function(x,y){return num(y.dEven)-num(x.dEven)});
if(a.length&&(num(a[0].dEven)>=tk||num(a[0].qTotTran5J)===r.vol))a.shift();
if(a.length<30)return;
var sm=0,i;for(i=0;i<30;i++)sm+=num(a[i].qTotTran5J);var av=sm/30;
if(!g(4,r.vol>1.5*av))return;
var t=r.t;res.push({c:r.c,n:r.n,nm:r.nm,k:r.vol/av,rt:r.rt,net:(t.bvR-t.svR)*r.pc2})},function(d){WP.msg="بررسی حجم ۳۰ روز گذشته… "+d.toLocaleString("fa-IR")+" از "+cand.length.toLocaleString("fa-IR");if(d%8===0&&wlOn())wlPaint()});
res.sort(function(x,y){return (x.net-y.net)||(y.k-x.k)})}
else res.sort(function(x,y){return y.k-x.k});
C.dg=(kk?"مرحله‌به‌مرحله (تعداد نمادهایی که تا این شرط می‌رسند): کل نمادها "+st[0]+" ← خرید حقیقی>۴۰٪ حجم "+st[1]+" ← فروش حقوقی>۴۰٪ حجم "+st[2]+" ← شدت>۳ "+st[3]+" ← ارزش>۱ میلیارد تومان "+st[4]+" ← سرانه خرید>۲۰ میلیون "+st[5]+" ← نسبت تابلو>۱ "+st[6]:"مرحله‌به‌مرحله (تعداد نمادهایی که تا این شرط می‌رسند): کل نمادها "+st[0]+" ← حجم>حجم مبنا "+st[1]+" ← قیمت منفی و آخرین≤پایانی "+st[2]+" ← سرانه خرید<فروش "+st[3]+" ← حجم>۱٫۵ برابر میانگین ۳۰ روز "+st[4]+" (نماد با حجم مبنای صفر: "+nbv+")");
C.items=(C.cfg&&C.cfg.n>0)?res.slice(0,C.cfg.n):res;C.ft=Date.now();WP.stat={m:list.length,c:kk?res.length:cand.length};wlSave()}
catch(e){WP.err=e.kind==="data"?"فهرست بازار از بورس خوانده نشد (فرمت داده شناسایی نشد).":why(e,"فهرست سهام")}
WP.run=false;if(wlOn()){wlPaint();setTimeout(wlLoad,50)}}
// ---------- پول هوشمند (sm1) : فیلتر سرانه خرید/فروش حقیقی + ستون‌های محاسباتی ----------
// شرط‌ها: bI>0, sI>0, bvR>svR, (bvR/bI)/(svR/sI)>1.5, bvR*pc/bI>5e8 ریال, pl>pc, tvol>100000
async function smRun(C){if(WP.run)return;WP.run=true;WP.err="";C.cl=0;WP.msg="دریافت فهرست کل بازار از بورس…";if(wlOn())wlPaint();
try{var list=parseMW(await getAny("/tsev2/data/MarketWatchInit.aspx?h=0&r=0"));if(list.length<50)throw mkErr("data",0,"parse");
WP.msg="دریافت تعداد و حجم خریدار و فروشنده…";if(wlOn())wlPaint();
var ct=parseCTc(await getAny("/tsev2/data/ClientTypeAll.aspx")),cand=[],res=[],st=[0,0,0,0,0,0,0];
list.forEach(function(r){var t=ct[r.c];if(!t||!(r.py>0)||!(r.pl>0))return;st[0]++;
if(!(t.bI>0&&t.sI>0))return;st[1]++;
if(!(t.bvR>t.svR))return;st[2]++;
var pa=t.bvR/t.bI,pb=t.svR/t.sI;if(!(pb>0&&pa/pb>1.5))return;st[3]++;
var pc=r.pc>0?r.pc:r.py;
if(!(t.bvR*pc/t.bI>5e8))return;st[4]++;
if(!(r.pl>pc))return;st[5]++;
if(!(r.vol>100000))return;st[6]++;
r.t=t;r.pc2=pc;cand.push(r)});
var tk=key(today);
await pool(cand,6,async function(r){var t=r.t,pc=r.pc2,A=Math.round(pc*t.bvR/t.bI/1e6),B=Math.round(pc*t.svR/t.sI/1e6),
Cc=B>0?Math.round(A/B*100)/100:0,E=0,F=0;
try{var j=JSON.parse(await GET(TS+"ClosingPrice/GetClosingPriceDailyList/"+r.c+"/63")),a=firstArr(j.closingPriceDaily||j).slice(),i;
a.sort(function(x,y){return num(y.dEven)-num(x.dEven)});
if(a.length&&(num(a[0].dEven)>=tk||num(a[0].qTotTran5J)===r.vol))a.shift();
if(a.length>=14){var s14=0;for(i=0;i<14;i++)s14+=num(a[i].qTotTran5J);E=s14>0?Math.round(r.vol/(s14/14)*100)/100:0}
var m=Math.min(60,a.length),mn=r.pl,mx=r.pl;
for(i=0;i<m;i++){var lo=num(a[i].priceMin),hi=num(a[i].priceMax);if(lo>0&&lo<mn)mn=lo;if(hi>mx)mx=hi}
F=mx>mn?Math.round((r.pl-mn)/(mx-mn)*100):0}catch(e){}
res.push({c:r.c,n:r.n,nm:r.nm,k:Cc,A:A,B:B,Cc:Cc,D:t.bI,E:E,F:F,net:(t.bvR-t.svR)*pc})},function(d){WP.msg="دریافت سابقه‌ی حجم… "+d.toLocaleString("fa-IR")+" از "+cand.length.toLocaleString("fa-IR");if(d%8===0&&wlOn())wlPaint()});
C.dg="مرحله‌به‌مرحله (تعداد نمادهایی که تا این شرط می‌رسند): کل نمادها "+st[0]+" ← تعداد خریدار و فروشنده حقیقی>۰ "+st[1]+" ← حجم خرید حقیقی>فروش حقیقی "+st[2]+" ← قدرت خریدار>۱٫۵ "+st[3]+" ← سرانه خرید>۵۰ میلیون تومان "+st[4]+" ← آخرین>پایانی "+st[5]+" ← حجم>۱۰۰ هزار "+st[6];
res.sort(function(x,y){return (y.net-x.net)||(y.k-x.k)});
C.items=(C.cfg&&C.cfg.n>0)?res.slice(0,C.cfg.n):res;C.ft=Date.now();WP.stat={m:list.length,c:cand.length};wlSave()}
catch(e){WP.err=e.kind==="data"?"فهرست بازار از بورس خوانده نشد (فرمت داده شناسایی نشد).":why(e,"فهرست سهام")}
WP.run=false;if(wlOn()){wlPaint();setTimeout(wlLoad,50)}}
// ---------- سهام کوچک (sc1): کم‌ارزش‌ترین سهام بازار از نظر ارزش بازار ----------
// ارزش بازار = تعداد سهام × آخرین قیمت (ریال). فقط سهام بورس و فرابورس که امروز معامله شده‌اند؛ صندوق‌ها حذف می‌شوند.
async function scRun(C){if(WP.run)return;WP.run=true;WP.err="";C.cl=0;WP.msg="دریافت فهرست کل بازار از بورس…";if(wlOn())wlPaint();
try{var list=parseMW(await getAny("/tsev2/data/MarketWatchInit.aspx?h=0&r=0"));if(list.length<50)throw mkErr("data",0,"parse");
var st=[0,0,0,0],res=[];
list.forEach(function(r){if(!(r.py>0)||!(r.pl>0))return;st[0]++;
if(["1","2","3","4"].indexOf(r.fl)<0||/^ص[\s.]|صندوق|ETF/i.test(r.nm||r.n))return;st[1]++;
if(!(r.z>1e6))return;st[2]++;
if(!(r.vol>0&&r.tr>0))return;st[3]++;
var mv=r.z*r.pl;if(!(mv>0))return;
res.push({c:r.c,n:r.n,nm:r.nm,mv:mv,pl:r.pl,pc:r.pc>0?r.pc:0,py:r.py,val:r.val,k:mv})});
res.sort(function(a,b){return a.mv-b.mv});
C.dg="مرحله‌به‌مرحله (تعداد نمادها): قیمت معتبر "+st[0]+" ← سهام بورس و فرابورس بدون صندوق "+st[1]+" ← تعداد سهام معتبر "+st[2]+" ← معامله‌شده امروز "+st[3];
var n=(C.cfg&&C.cfg.n>0)?C.cfg.n:20;C.items=res.slice(0,n);C.ft=Date.now();WP.stat={m:list.length,c:res.length};wlSave()}
catch(e){WP.err=e.kind==="data"?"فهرست بازار از بورس خوانده نشد (فرمت داده شناسایی نشد).":why(e,"فهرست سهام")}
WP.run=false;if(wlOn()){wlPaint();setTimeout(wlLoad,50)}}
function scDetail(C){var it=C.items||[],f=function(v){return(v||v===0)?cfp(v,1):"—"};
var rows=it.map(function(x,i){var pp=x.pc>0&&x.py>0?(x.pc/x.py-1)*100:null;return'<tr'+tcA(x)+'><td class="drw">'+(i+1).toLocaleString("fa-IR")+'</td><td style="font-weight:700">'+esc(x.n)+'</td><td>'+f((x.mv||0)/1e10)+'</td><td>'+cfp(x.pl||0)+'</td><td>'+f((x.val||0)/1e10)+'</td></tr>'}).join("");
var tb=it.length?'<div class="sc scv"><table class="stk"><tr><th class="drw">ردیف</th><th>نماد</th><th>ارزش بازار (م.م)</th><th>آخرین</th><th>ارزش معاملات (م.م)</th></tr>'+rows+'</table></div>':'<div class="mut" style="padding:8px">'+(C.cl?"لیست خالی است.":"نمادی پیدا نشد.")+'</div>';
return'<div class="card" style="padding:6px;margin-top:8px"><b>جزئیات سهام کوچک</b><div class="mut" style="font-size:11px;line-height:1.8">'+esc(wpMsg(C))+'</div>'+(C.dg?'<div class="mut" style="font-size:11px;line-height:1.8">'+esc(C.dg)+'</div>':'')+tb+'</div>'}
function smDetail(C){var it=C.items||[],f=function(v){return(v||v===0)?cfp(v,2):"—"};
var rows=it.map(function(x,i){return'<tr'+tcA(x)+'><td class="drw">'+(i+1).toLocaleString("fa-IR")+'</td><td style="font-weight:700">'+esc(x.n)+'</td><td>'+cfp(x.A||0)+'</td><td>'+cfp(x.B||0)+'</td><td>'+f(x.Cc)+'</td><td>'+cfp(x.D||0)+'</td><td>'+f(x.E)+'</td><td>'+cfp(x.F||0)+'٪</td></tr>'}).join("");
var tb=it.length?'<div class="sc scv"><table class="stk"><tr><th class="drw">ردیف</th><th>نماد</th><th>سرانه خرید</th><th>سرانه فروش</th><th>نسبت</th><th>خریدار</th><th>حجم/۱۴روز</th><th>ریسک</th></tr>'+rows+'</table></div>':'<div class="mut" style="padding:8px">'+(C.cl?"لیست خالی است.":"نمادی با شرط‌های این فیلتر پیدا نشد.")+'</div>';
return'<div class="card" style="padding:6px;margin-top:8px"><b>جزئیات پول هوشمند</b><div class="mut" style="font-size:11px;line-height:1.8">'+esc(wpMsg(C))+'</div>'+(C.dg?'<div class="mut" style="font-size:11px;line-height:1.8">'+esc(C.dg)+'</div>':'')+tb+'</div><div class="card" style="padding:8px;margin-top:8px;line-height:2;font-size:12px"><b>توضیح پول هوشمند</b><br>شرط‌های ورود به لیست (همه با هم):<br>۱) تعداد خریدار و فروشنده‌ی حقیقی بیشتر از صفر.<br>۲) حجم خرید حقیقی بیشتر از حجم فروش حقیقی (ورود خالص پول).<br>۳) قدرت خریدار حقیقی بیش از ۱٫۵؛ یعنی سرانه‌ی خرید ÷ سرانه‌ی فروش.<br>۴) سرانه‌ی خرید حقیقی (حجم خرید × قیمت پایانی ÷ تعداد خریدار) بیش از ۵۰ میلیون تومان.<br>۵) آخرین قیمت بالاتر از قیمت پایانی.<br>۶) حجم معاملات بیش از ۱۰۰ هزار.<br>ستون‌ها: سرانه خرید و فروش حقیقی (میلیون ریال)، نسبت سرانه خرید به فروش، تعداد خریدار حقیقی، نسبت حجم امروز به میانگین ۱۴ روز گذشته، و ریسک = جای آخرین قیمت در بازه‌ی کف تا سقف ۶۰ روز (۱۰۰٪ یعنی روی سقف).<br>مرتب‌سازی بر اساس بیشترین ورود پول حقیقی است. این لیست فیلتر آماری است و توصیه‌ی خرید یا فروش نیست.</div>'}
function wxDetail(C){var it=C.items||[],kk=C.flt==="kk1",b=function(v){return cfp(v/1e10,1)};
var rows=it.map(function(x,i){return'<tr'+tcA(x)+'><td class="drw">'+(i+1).toLocaleString("fa-IR")+'</td><td style="font-weight:700">'+esc(x.n)+'</td>'+(kk?'<td style="font-weight:700">×'+cfp(x.k,2)+'</td><td>'+cfp((x.cap||0)/1e7,1)+'</td><td>'+cfp(x.rt||0,2)+'</td><td>'+b(x.val||0)+'</td>':'<td style="color:var(--dn);font-weight:700">−'+b(Math.abs(x.net||0))+'</td><td>×'+cfp(x.k||0,2)+'</td><td>'+cfp(x.rt||0,2)+'</td>')+'</tr>'}).join("");
var th=kk?'<th class="drw">ردیف</th><th>نماد</th><th>شدت</th><th>سرانه خرید (م.ت)</th><th>نسبت تابلو</th><th>ارزش (م.م)</th>':'<th class="drw">ردیف</th><th>نماد</th><th>خروج پول (م.م)</th><th>حجم به میانگین</th><th>نسبت سرانه</th>';
var tb=it.length?'<div class="sc scv"><table class="stk"><tr>'+th+'</tr>'+rows+'</table></div>':'<div class="mut" style="padding:8px">'+(C.cl?"لیست خالی است.":"نمادی با شرط‌های این فیلتر پیدا نشد.")+'</div>';
var ex=kk?'این دیده‌بان هر نماد را با این شرط‌ها می‌سنجد:<br>۱) خرید حقیقی بیش از ۴۰٪ حجم معاملات.<br>۲) فروش حقوقی بیش از ۴۰٪ حجم معاملات.<br>۳) «شدت کد به کد» = (خرید حقیقی ÷ فروش حقیقی) × (فروش حقوقی ÷ خرید حقوقی) به ارزش ریالی، با افزودن ۱ میلیارد تومان به مخرج‌ها برای حذف موارد نزدیک به صفر؛ باید بیشتر از ۳ باشد و هر چه بیشتر، بهتر.<br>۴) ارزش معاملات بیش از ۱ میلیارد تومان.<br>۵) سرانه خرید حقیقی بیش از ۲۰ میلیون تومان.<br>۶) نسبت تابلو: میانگین حجم هر خریدار حقیقی ÷ میانگین حجم هر فروشنده‌ی حقیقی بیشتر از ۱.<br>مرتب‌سازی بر اساس شدت از زیاد به کم است. شرط‌های اختیاری (رنج مثبت و صف خرید سنگین نباشد) اعمال نشده‌اند. فرض شده [is1] برابر ۱ میلیارد تومان است.':'این دیده‌بان هر نماد را با این شرط‌ها می‌سنجد:<br>۱) حجم امروز بیشتر از حجم مبنا.<br>۲) حجم امروز بیش از ۱٫۵ برابر میانگین حجم ۳۰ روز معاملاتی گذشته (بدون امروز).<br>۳) سرانه خرید حقیقی کمتر از سرانه فروش حقیقی (فروشنده‌ها درشت‌ترند).<br>۴) آخرین قیمت کمتر یا برابر قیمت پایانی و درصد آخرین قیمت منفی.<br>مرتب‌سازی بر اساس بیشترین خروج پول حقیقی است؛ یعنی (حجم فروش حقیقی − حجم خرید حقیقی) × قیمت پایانی.';
var lvn=["خیلی ملایم","ملایم","","سخت","خیلی سخت"][(+(C.cfg&&C.cfg.lv)||0)+2];return'<div class="card" style="padding:6px;margin-top:8px"><b>جزئیات '+esc(C.name)+'</b>'+(lvn?' <span class="dkc" style="background:var(--acb);color:var(--tx)">سخت‌گیری: '+lvn+'</span>':'')+'<div class="mut" style="font-size:11px;line-height:1.8">'+esc(wpMsg(C))+'</div>'+(C.dg?'<div class="mut" style="font-size:11px;line-height:1.8">'+esc(C.dg)+'</div>':'')+tb+'</div><div class="card" style="padding:8px;margin-top:8px;line-height:2;font-size:12px"><b>توضیح '+esc(C.name)+'</b><br>'+ex+'<br>داده‌ها از بورس (TSETMC) هنگام اجرا گرفته می‌شود و هر ۵ دقیقه که صفحه باز باشد دوباره ساخته می‌شود. این لیست فیلتر آماری است و توصیه‌ی خرید یا فروش نیست.</div>'}
function wpDetail(C){var it=C.items||[],b=function(v){return cfp(v/1e10,1)};
var rows=it.map(function(x,i){return'<tr'+tcA(x)+'><td class="drw">'+(i+1).toLocaleString("fa-IR")+'</td><td style="font-weight:700">'+esc(x.n)+'</td><td style="color:'+(x.net>=0?"var(--up)":"var(--dn)")+';font-weight:700">'+(x.net>=0?"+":"−")+b(Math.abs(x.net||0))+'</td><td>'+(x.pw>0?cfp(x.pw,2):"—")+'</td><td>'+(x.k>0?"×"+cfp(x.k,2):"—")+'</td><td>'+cfp(x.bc||0)+' / '+cfp(x.sc||0)+'</td><td>'+(x.kpf>0?cfp(x.kpf,2):"—")+'</td></tr>'}).join("");
var tb=it.length?'<div class="sc scv"><table class="stk"><tr><th class="drw">ردیف</th><th>نماد</th><th>ورود پول<span class="qm" data-wl="H:in">?</span></th><th>قدرت<span class="qm" data-wl="H:pw">?</span></th><th>حجم<span class="qm" data-wl="H:vr">?</span></th><th>تعداد<span class="qm" data-wl="H:cn">?</span></th><th>نسبت<span class="qm" data-wl="H:kp">?</span></th></tr>'+rows+'</table></div>':'<div class="mut" style="padding:8px">نمادی با شرط‌های این فیلتر پیدا نشد.</div>';
return'<div class="card" style="padding:6px;margin-top:8px"><b>جزئیات ورود پول<span class="qm" data-wl="H:dt">?</span></b><div class="mut" style="font-size:11px;line-height:1.8">'+esc(wpMsg(C))+'</div>'+tb+'</div>'+
'<div class="card" style="padding:8px;margin-top:8px;line-height:2;font-size:12px"><b>توضیح کامل ورود پول</b><br>'+
'این دیده‌بان خودکار از روی کل بازار بورس ساخته می‌شود و هر نماد باید هر سه شرط زیر را همزمان داشته باشد:<br>'+
'۱) حجم امروز بیشتر از «میانگین حجم روزهای پرحجم»: میانگین حجم ۶۰ روز گذشته به‌همراه امروز حساب می‌شود، سپس فقط روزهایی که حجمشان از این میانگین بیشتر بوده دوباره میانگین‌گیری می‌شود. حجم امروز باید از این عدد بالاتر باشد، یعنی نماد امروز از روزهای پرتراکنش خودش هم پرتراکنش‌تر است («حجم به میانگین» در جدول نشان‌دهنده‌ی همین نسبت است).<br>'+
'۲) تعداد فروشنده‌ها بیش از ۱٫۳ برابر تعداد خریدارها (حقیقی و حقوقی روی هم): یعنی خریدارها کم‌تعداد ولی درشت‌اند و فروش بین افراد زیاد پخش شده. این حالت معمولاً نشانه‌ی جمع شدن سهم در دست خریدارهای بزرگ است.<br>'+
'۳) درصد آخرین قیمت بیشتر از درصد قیمت پایانی، یا بیشتر از ۳٪: یعنی قیمت در حال بالا رفتن است و آخرین معاملات از میانگین روز بالاتر انجام می‌شود.<br>'+
'<b>نحوه‌ی چیدن:</b> نمادها بر اساس «ورود پول حقیقی» مرتب می‌شوند؛ یعنی (حجم خرید حقیقی − حجم فروش حقیقی) × قیمت پایانی به میلیارد تومان. هر چه بالاتر، پول حقیقی بیشتری وارد شده. اگر ورود پول برابر باشد، نماد با نسبت حجم بیشتر بالاتر می‌آید. «قدرت خریدار حقیقی» = میانگین حجم هر خریدار حقیقی ÷ میانگین حجم هر فروشنده‌ی حقیقی؛ عدد بالای ۱ یعنی خریدارها درشت‌تر از فروشنده‌ها هستند.<br>'+
'<b>نکته‌ها:</b> داده‌ها از بورس (TSETMC) هنگام اجرا گرفته می‌شود و به‌روز بودنشان به همان لحظه بستگی دارد؛ لیست هر ۵ دقیقه که صفحه باز باشد دوباره ساخته می‌شود و با دکمه‌ی «اجرای فیلتر» دستی هم قابل بروزرسانی است. نمادی با کمتر از ۶۰ روز سابقه وارد لیست نمی‌شود. این لیست فیلتر آماری است و توصیه‌ی خرید یا فروش نیست.</div>'}

// ---------- کراس ایچی : تقاطع صعودی تنکان و کیجون (ایچیموکو) روی کل بازار ----------
// ih[0] = امروز، ih[1] = دیروز، ... (۶۰ روز) ؛ همان منطق کد فیلتر بورس
function ciHi(ih,p,s){var m=0,i=s,j=0;while(j<p){if(ih[i].PriceMax>m)m=ih[i].PriceMax;if(ih[i].PriceMax!=0)j++;i++;if(i==60)return -1}return m}
function ciLo(ih,p,s){var m=10000000,i=s,j=0;while(j<p){if(ih[i].PriceMin<m&&ih[i].PriceMin!=0)m=ih[i].PriceMin;if(ih[i].PriceMin!=0)j++;i++;if(i==60)return -1}return m}
function ciCalc(ih){var sp=9,lp=26,tt=(ciHi(ih,sp,0)+ciLo(ih,sp,0))/2,ty=(ciHi(ih,sp,1)+ciLo(ih,sp,1))/2,kt=(ciHi(ih,lp,0)+ciLo(ih,lp,0))/2,ky=(ciHi(ih,lp,1)+ciLo(ih,lp,1))/2,st=tt-kt,sy=ty-ky;
return{ok:ciLo(ih,lp,1)>0&&st>0&&sy<=0,tt:tt,kt:kt,st:st,sy:sy}}
async function ciRun(C){if(WP.run)return;WP.run=true;WP.err="";C.cl=0;WP.msg="دریافت فهرست کل بازار از بورس…";if(wlOn())wlPaint();
try{var list=parseMW(await getAny("/tsev2/data/MarketWatchInit.aspx?h=0&r=0"));if(list.length<50)throw mkErr("data",0,"parse");
var cf=ciCfg(C),mk={bf:"1,2",b:"1",f:"2",p:"3,4,5",e:"6"}[cf.mkt];
var inM=list.filter(function(r){return mk.split(",").indexOf(r.fl)>=0});
var fh={},nf=0;list.forEach(function(r){fh[r.fl]=(fh[r.fl]||0)+1});
if(inM.length<(cf.mkt==="bf"?200:1)){inM=list;nf=1}
var cand=inM.filter(function(r){return cf.mode==="all"||(r.vol>0&&r.hg>0&&r.lw>0)}),res=[],tk=key(today),fb=0,er=0,sh=0,fe=null,maxD=0;
if(cf.mode!=="all"&&cand.length<20){cand=inM;fb=1}
await pool(cand,8,async function(r){var j,a;try{j=JSON.parse(await GET(TS+"ClosingPrice/GetClosingPriceDailyList/"+r.c+"/65"));a=firstArr(j.closingPriceDaily||j).slice()}catch(e){er++;if(!fe)fe=e;return}
a.sort(function(x,y){return num(y.dEven)-num(x.dEven)});
var live=r.vol>0&&r.hg>0&&r.lw>0,ih=[],i,d0=0;
if(live){if(a.length&&(num(a[0].dEven)>=tk||num(a[0].qTotTran5J)===r.vol))a.shift();
if(a.length<59){sh++;return}
ih.push({PriceMax:r.hg,PriceMin:r.lw});for(i=0;i<59;i++)ih.push({PriceMax:num(a[i].priceMax),PriceMin:num(a[i].priceMin)})}
else{if(a.length<60){sh++;return}d0=num(a[0].dEven);if(d0>maxD)maxD=d0;for(i=0;i<60;i++)ih.push({PriceMax:num(a[i].priceMax),PriceMin:num(a[i].priceMin)})}
var z=ciCalc(ih);if(!z.ok)return;
res.push({d:d0,c:r.c,n:r.n,nm:r.nm,tt:z.tt,kt:z.kt,st:z.st,sy:z.sy,pc:z.kt>0?z.st/z.kt*100:0})},function(d){WP.msg="بررسی ۶۰ روز گذشته‌ی نمادها… "+d.toLocaleString("fa-IR")+" از "+cand.length.toLocaleString("fa-IR");if(d%10===0&&wlOn())wlPaint()});
res.sort(function(x,y){return y.pc-x.pc});
if(er>cand.length*0.5&&fe)throw fe;
if(cf.mode!=="all")res=res.filter(function(x){return !x.d||x.d>=maxD});
C.dg=(nf?"فیلتر بازار اعمال نشد (کد بازار در داده‌ی بورس شناسایی نشد) — ":"")+"کدهای بازار: "+Object.keys(fh).map(function(k){return(k||"؟")+"="+fh[k]}).join("، ")+" — بررسی‌شده: "+cand.length.toLocaleString("fa-IR")+" نماد"+(fb?" (بازار هنوز باز نشده؛ آخرین جلسه‌ی معاملاتی ملاک «امروز» است)":"")+" — خطای دریافت: "+er.toLocaleString("fa-IR")+" — سابقه‌ی کم: "+sh.toLocaleString("fa-IR");
C.tot=res.length;C.items=res.slice(0,10);C.ft=Date.now();WP.stat={m:list.length,c:cand.length};wlSave()}
catch(e){WP.err=e.kind==="data"?"فهرست بازار از بورس خوانده نشد (فرمت داده شناسایی نشد).":why(e,"فهرست سهام")}
WP.run=false;if(wlOn()){wlPaint();setTimeout(wlLoad,50)}}
// ---------- پول بک (pb1) : پولبک به کیجون تخت — همان کد TSETMC ----------
function pbCalc(ih){var dt=9,dk=26,dlen=Math.min(ih.length,60),dle=0,i,j,prx=[],prn=[],kx,kn,kij=[];
if(!ih.length||!(ih[0].QTotTran5J>0)||!(ih[0].PriceMin>0))return{ok:false};
for(i=0;i<dlen;i++)if(ih[i].QTotTran5J>0)dle++;
if(dle<28)return{ok:false};
j=dle+1;for(i=0;i<dlen;i++)if(ih[i].QTotTran5J>0){j--;prx[j]=ih[i].PriceMax;prn[j]=ih[i].PriceMin}
for(i=dk;i<=dle;i++){kx=0;kn=1e12;for(j=i-dk+1;j<=i;j++){if(prx[j]>kx)kx=prx[j];if(prn[j]<kn)kn=prn[j]}kij[i]=(kx+kn)/2}
var kt=kij[dle],pl=ih[0].PDrCotVal,lo=ih[0].PriceMin;
return{ok:kij[dle]==kij[dle-1]&&kij[dle-1]==kij[dle-2]&&pl>kt&&lo<kt,kt:kt,pl:pl,lo:lo}}
async function pbRun(C){if(WP.run)return;WP.run=true;WP.err="";C.cl=0;WP.msg="دریافت فهرست کل بازار از بورس…";if(wlOn())wlPaint();
try{var list=parseMW(await getAny("/tsev2/data/MarketWatchInit.aspx?h=0&r=0"));if(list.length<50)throw mkErr("data",0,"parse");
var cf=ciCfg(C),mk={bf:"1,2",b:"1",f:"2",p:"3,4,5",e:"6"}[cf.mkt];
var inM=list.filter(function(r){return mk.split(",").indexOf(r.fl)>=0});
var fh={},nf=0;list.forEach(function(r){fh[r.fl]=(fh[r.fl]||0)+1});
if(inM.length<(cf.mkt==="bf"?200:1)){inM=list;nf=1}
var cand=inM.filter(function(r){return cf.mode==="all"||(r.vol>0&&r.hg>0&&r.lw>0)}),res=[],tk=key(today),fb=0,er=0,sh=0,fe=null,maxD=0;
if(cf.mode!=="all"&&cand.length<20){cand=inM;fb=1}
await pool(cand,8,async function(r){var j,a;try{j=JSON.parse(await GET(TS+"ClosingPrice/GetClosingPriceDailyList/"+r.c+"/65"));a=firstArr(j.closingPriceDaily||j).slice()}catch(e){er++;if(!fe)fe=e;return}
a.sort(function(x,y){return num(y.dEven)-num(x.dEven)});
var live=r.vol>0&&r.hg>0&&r.lw>0,ih=[],i,d0=0,row=function(q){return{PriceMax:num(q.priceMax),PriceMin:num(q.priceMin),QTotTran5J:num(q.qTotTran5J),PDrCotVal:num(q.pDrCotVal)||num(q.pClosing)}};
if(live){if(a.length&&(num(a[0].dEven)>=tk||num(a[0].qTotTran5J)===r.vol))a.shift();
if(a.length<27){sh++;return}
ih.push({PriceMax:r.hg,PriceMin:r.lw,QTotTran5J:r.vol,PDrCotVal:r.pl});for(i=0;i<59&&i<a.length;i++)ih.push(row(a[i]))}
else{if(a.length<28){sh++;return}d0=num(a[0].dEven);if(d0>maxD)maxD=d0;for(i=0;i<60&&i<a.length;i++)ih.push(row(a[i]))}
var z=pbCalc(ih);if(!z.ok)return;
res.push({d:d0,c:r.c,n:r.n,nm:r.nm,kt:z.kt,pl:z.pl,lo:z.lo,pc:z.kt>0?(z.pl-z.kt)/z.kt*100:0})},function(d){WP.msg="بررسی ۶۰ روز گذشته‌ی نمادها… "+d.toLocaleString("fa-IR")+" از "+cand.length.toLocaleString("fa-IR");if(d%10===0&&wlOn())wlPaint()});
res.sort(function(x,y){return x.pc-y.pc});
if(er>cand.length*0.5&&fe)throw fe;
if(cf.mode!=="all")res=res.filter(function(x){return !x.d||x.d>=maxD});
C.dg=(nf?"فیلتر بازار اعمال نشد (کد بازار در داده‌ی بورس شناسایی نشد) — ":"")+"بررسی‌شده: "+cand.length.toLocaleString("fa-IR")+" نماد"+(fb?" (بازار هنوز باز نشده؛ آخرین جلسه‌ی معاملاتی ملاک «امروز» است)":"")+" — خطای دریافت: "+er.toLocaleString("fa-IR")+" — سابقه‌ی کم: "+sh.toLocaleString("fa-IR");
C.tot=res.length;C.items=res;C.ft=Date.now();WP.stat={m:list.length,c:cand.length};wlSave()}
catch(e){WP.err=e.kind==="data"?"فهرست بازار از بورس خوانده نشد (فرمت داده شناسایی نشد).":why(e,"فهرست سهام")}
WP.run=false;if(wlOn()){wlPaint();setTimeout(wlLoad,50)}}
function pbDetail(C){var it=C.items||[],f=function(v){return cfp(v,1)};
var rows=it.map(function(x,i){return'<tr'+tcA(x)+'><td class="drw">'+(i+1).toLocaleString("fa-IR")+'</td><td style="font-weight:700">'+esc(x.n)+'</td><td>'+f(x.kt)+'</td><td>'+f(x.lo)+'</td><td>'+f(x.pl)+'</td><td style="color:var(--up);font-weight:700">'+cfp(x.pc,2)+'</td></tr>'}).join("");
var tb=it.length?'<div class="sc scv"><table class="stk"><tr><th class="drw">ردیف</th><th>نماد</th><th>کیجون</th><th>کف امروز</th><th>آخرین</th><th>فاصله ٪</th></tr>'+rows+'</table></div>':'<div class="mut" style="padding:8px">'+(C.cl?"لیست خالی است.":"نمادی با شرط‌های این فیلتر پیدا نشد.")+'</div>';
return'<div class="card" style="padding:6px;margin-top:8px"><b>جزئیات پول بک</b><div class="mut" style="font-size:11px;line-height:1.8">'+esc(wpMsg(C))+(C.dg?" | "+C.dg:"")+(C.tot>0?" — "+C.tot.toLocaleString("fa-IR")+" نماد مطابق فیلتر":"")+'</div>'+tb+'</div>'+
'<div class="card" style="padding:8px;margin-top:8px;line-height:2;font-size:12px"><b>توضیح کامل پول بک</b><br>'+
'<b>این لیست چیست؟</b> «پولبک به کیجون تخت» در ایچیموکو: نمادهایی که قیمتشان امروز به خط کیجون‌سن (که چند روز است ثابت مانده) برخورد کرده و دوباره بالای آن برگشته است. خط کیجون تخت یعنی سقف و کف ۲۶ روز اخیر عوض نشده و بازار در یک محدوده حرکت می‌کند؛ در این حالت کیجون معمولاً مثل حمایت عمل می‌کند.<br>'+
'<b>شرط‌ها (همه با هم):</b> ۱) کیجون‌سن (میانگین بالاترین سقف و پایین‌ترین کف ۲۶ روز معاملاتی، با احتساب امروز) در ۳ روز معاملاتی اخیر دقیقاً یکی باشد. ۲) کف امروز نماد زیر کیجون رفته باشد. ۳) آخرین قیمت معامله بالاتر از کیجون باشد. ۴) امروز معامله داشته باشد و حداقل ۲۸ روز معاملاتی سابقه موجود باشد. روزهای بدون معامله شمرده نمی‌شوند.<br>'+
'<b>نحوه‌ی چیدن:</b> نمادهایی که آخرین قیمتشان به کیجون نزدیک‌تر است بالاتر می‌آیند. «فاصله ٪» = (آخرین قیمت − کیجون) ÷ کیجون. هرچه کمتر باشد، قیمت هنوز نزدیک خط است و فاصله‌ی ریسک تا حمایت کمتر است.<br>'+
'<b>ستون‌ها:</b> کیجون = مقدار امروز خط کیجون‌سن. کف امروز = پایین‌ترین قیمت معامله‌شده‌ی امروز (زیر کیجون است). آخرین = آخرین قیمت معامله. فاصله ٪ = چقدر آخرین قیمت بالای کیجون است.<br>'+
'<b>دکمه‌ها:</b> ▶ لیست را از نو با داده‌ی لحظه‌ی بورس می‌سازد (سابقه‌ی تک‌تک نمادها دریافت می‌شود و چند دقیقه طول می‌کشد). پاک‌کن لیست را خالی می‌کند و تا ▶ را نزنید خودبه‌خود پر نمی‌شود. همه‌ی نمادهای مطابق فیلتر نمایش داده می‌شود.<br>'+
'<b>کاربرد:</b> پیدا کردن سهم‌هایی که در یک محدوده‌ی تقریباً ثابت از حمایت کیجون برگشته‌اند، برای شروع بررسی بیشتر (چارت، حجم، ورود پول).<br>'+
'<b>نکته‌ها:</b> «کف زیر کیجون و آخرین بالای آن» با قیمت‌های لحظه‌ای امروز سنجیده می‌شود و تا پایان روز ممکن است تغییر کند. اگر پایان روز قیمت زیر کیجون بسته شود، پولبک شکست خورده است. محاسبه روی قیمت‌های خام و تعدیل‌نشده انجام می‌شود. این فیلتر ابر ایچیموکو، روند کلی و حجم را نمی‌سنجد و توصیه‌ی خرید یا فروش نیست.</div>'}
// ---------- فیلترهای جدید دیده‌بان: شکست حجمی (bo1) ، صف خرید قوی (qb1) ، RSI اشباع (rs1) ----------
function tcA(x){return' data-tc="'+x.c+'" data-tn="'+esc(x.n)+'" style="cursor:pointer"'}
function nfIn(C,list){var cf=ciCfg(C),mk={bf:"1,2",b:"1",f:"2",p:"3,4,5",e:"6"}[cf.mkt],inM=list.filter(function(r){return mk.split(",").indexOf(r.fl)>=0}),fh={},nf=0;list.forEach(function(r){fh[r.fl]=(fh[r.fl]||0)+1});if(inM.length<(cf.mkt==="bf"?200:1)){inM=list;nf=1}return{inM:inM,fh:fh,nf:nf}}
// تاریخچه‌ی روزانه + امروز: t = امروز (یا آخرین جلسه)، p = روزهای معامله‌شده‌ی قبل (جدید به قدیم)
function nfHist(a,r,tk){a.sort(function(x,y){return num(y.dEven)-num(x.dEven)});
var live=r.vol>0&&r.hg>0&&r.lw>0,row=function(q){return{d:num(q.dEven),vol:num(q.qTotTran5J),hi:num(q.priceMax),lo:num(q.priceMin),pl:num(q.pDrCotVal)||num(q.pClosing),pc:num(q.pClosing)||num(q.pDrCotVal),py:num(q.priceYesterday)}},t,p;
if(live){if(a.length&&(num(a[0].dEven)>=tk||num(a[0].qTotTran5J)===r.vol))a.shift();t={d:0,vol:r.vol,hi:r.hg,lo:r.lw,pl:r.pl,pc:r.pc>0?r.pc:r.pl,py:r.py}}
else{if(!a.length)return null;t=row(a[0]);a=a.slice(1)}
p=a.map(row).filter(function(x){return x.vol>0&&x.hi>0&&x.pc>0});
if(!(t.py>0)&&p.length)t.py=p[0].pc;
return{live:live,t:t,p:p}}
function nfDg(b,cand,fb,er,sh){return(b.nf?"فیلتر بازار اعمال نشد (کد بازار در داده‌ی بورس شناسایی نشد) — ":"")+"بررسی‌شده: "+cand.length.toLocaleString("fa-IR")+" نماد"+(fb?" (بازار هنوز باز نشده؛ آخرین جلسه‌ی معاملاتی ملاک «امروز» است)":"")+" — خطای دریافت: "+er.toLocaleString("fa-IR")+" — سابقه‌ی کم: "+sh.toLocaleString("fa-IR")}
function nfProg(cand){return function(d){WP.msg="بررسی سابقه‌ی نمادها… "+d.toLocaleString("fa-IR")+" از "+cand.length.toLocaleString("fa-IR");if(d%10===0&&wlOn())wlPaint()}}
function nfEnd(e){WP.err=e.kind==="data"?"فهرست بازار از بورس خوانده نشد (فرمت داده شناسایی نشد).":why(e,"فهرست سهام");WP.run=false;if(wlOn()){wlPaint();setTimeout(wlLoad,50)}}
// ---- شکست حجمی ----
async function boRun(C){if(WP.run)return;WP.run=true;WP.err="";C.cl=0;WP.msg="دریافت فهرست کل بازار از بورس…";if(wlOn())wlPaint();
try{var list=parseMW(await getAny("/tsev2/data/MarketWatchInit.aspx?h=0&r=0"));if(list.length<50)throw mkErr("data",0,"parse");
var b=nfIn(C,list),cand=b.inM.filter(function(r){return r.vol>0&&r.hg>0&&r.lw>0&&r.pl>0&&r.py>0&&r.pl>r.py&&r.vol*r.pl>=1e10}),res=[],tk=key(today),fb=0,er=0,sh=0,fe=null,maxD=0;
if(cand.length<20){cand=b.inM;fb=1}
await pool(cand,8,async function(r){var j,a,h;try{j=JSON.parse(await GET(TS+"ClosingPrice/GetClosingPriceDailyList/"+r.c+"/30"));a=firstArr(j.closingPriceDaily||j).slice()}catch(e){er++;if(!fe)fe=e;return}
h=nfHist(a,r,tk);if(!h){sh++;return}var p=h.p.slice(0,20),t=h.t;if(p.length<15){sh++;return}
if(!(t.vol>0&&t.pl>0&&t.vol*t.pl>=1e10))return;
var av=0,hh=0;p.forEach(function(x){av+=x.vol;if(x.hi>hh)hh=x.hi});av/=p.length;
if(!(av>0&&hh>0))return;var vr=t.vol/av;if(!(vr>=1+G(1)&&t.pl>hh))return;
var d=h.live?0:t.d;if(d>maxD)maxD=d;
res.push({d:d,c:r.c,n:r.n,nm:r.nm,vr:vr,hh:hh,pl:t.pl,bk:(t.pl/hh-1)*100,chg:t.py>0?(t.pl/t.py-1)*100:0})},nfProg(cand));
if(er>cand.length*0.5&&fe)throw fe;
res=res.filter(function(x){return !x.d||x.d>=maxD});res.sort(function(x,y){return y.vr-x.vr});
C.dg=nfDg(b,cand,fb,er,sh);C.tot=res.length;C.items=res.slice(0,20);C.ft=Date.now();WP.stat={m:list.length,c:cand.length};wlSave()}
catch(e){return nfEnd(e)}
WP.run=false;if(wlOn()){wlPaint();setTimeout(wlLoad,50)}}
function boDetail(C){var it=C.items||[];
var rows=it.map(function(x,i){return'<tr'+tcA(x)+'><td class="drw">'+(i+1).toLocaleString("fa-IR")+'</td><td style="font-weight:700">'+esc(x.n)+'</td><td style="font-weight:700">×'+cfp(x.vr,1)+'</td><td style="color:var(--up);font-weight:700">'+cfp(x.bk,2)+'</td><td>'+cfp(x.hh)+'</td><td>'+cfp(x.pl)+'</td><td style="color:'+(x.chg>=0?"var(--up)":"var(--dn)")+';font-weight:700">'+cfp(Math.abs(x.chg),2)+'</td></tr>'}).join("");
var tb=it.length?'<div class="sc scv"><table class="stk"><tr><th class="drw">ردیف</th><th>نماد</th><th>حجم×<span class="qm" data-wl="H:bo_v">?</span></th><th>شکست ٪<span class="qm" data-wl="H:bo_b">?</span></th><th>سقف ۲۰ روز<span class="qm" data-wl="H:bo_h">?</span></th><th>آخرین</th><th>تغییر ٪</th></tr>'+rows+'</table></div>':'<div class="mut" style="padding:8px">'+(C.cl?"لیست خالی است.":"نمادی با شرط‌های این فیلتر پیدا نشد.")+'</div>';
return'<div class="card" style="padding:6px;margin-top:8px"><b>جزئیات شکست حجمی<span class="qm" data-wl="H:bo_d">?</span></b><div class="mut" style="font-size:11px;line-height:1.8">'+esc(wpMsg(C))+(C.dg?" | "+C.dg:"")+(C.tot>it.length?" — "+C.tot.toLocaleString("fa-IR")+" نماد مطابق فیلتر؛ ۲۰ مورد اول نمایش داده شده":"")+'</div>'+tb+'</div>'+
'<div class="card" style="padding:8px;margin-top:8px;line-height:2;font-size:12px"><b>توضیح کامل شکست حجمی</b><br>'+
'<b>این لیست چیست؟</b> نمادهایی که امروز قیمتشان از بالاترین سقف ۲۰ روز معاملاتی قبل عبور کرده (شکست مقاومت کوتاه‌مدت) و همزمان حجم امروزشان دست‌کم دو برابر میانگین حجم همان ۲۰ روز است. حجم بالا نشان می‌دهد شکست با مشارکت واقعی معامله‌گران رخ داده و فقط نتیجه‌ی چند معامله‌ی کم‌حجم نیست.<br>'+
'<b>شرط‌ها (همه با هم):</b> ۱) حداقل ۱۵ روز معاملاتی سابقه (روزهای بدون معامله شمرده نمی‌شوند). ۲) آخرین قیمت امروز بالاتر از بیشترین سقف قیمتی ۲۰ روز معاملاتی قبل از امروز. ۳) حجم امروز حداقل ۲ برابر میانگین حجم همان ۲۰ روز. ۴) ارزش معاملات امروز (حجم × آخرین قیمت) بیش از ۱ میلیارد تومان تا نمادهای کم‌معامله حذف شوند.<br>'+
'<b>نحوه‌ی چیدن:</b> بر اساس «حجم×» از زیاد به کم؛ هر چه بالاتر، حجم امروز نسبت به حالت عادی غیرعادی‌تر است. فقط ۲۰ نماد اول نمایش داده می‌شود.<br>'+
'<b>ستون‌ها:</b> حجم× = حجم امروز ÷ میانگین ۲۰ روز. شکست ٪ = (آخرین قیمت − سقف ۲۰ روز) ÷ سقف ۲۰ روز. سقف ۲۰ روز = بالاترین قیمت معامله‌شده‌ی ۲۰ روز قبل. آخرین = آخرین قیمت معامله. تغییر ٪ = تغییر آخرین قیمت نسبت به دیروز.<br>'+
'<b>دکمه‌ها:</b> ▶ لیست را از نو با داده‌ی لحظه‌ی بورس می‌سازد (سابقه‌ی نمادها دریافت می‌شود و ممکن است چند دقیقه طول بکشد). پاک‌کن لیست را خالی می‌کند. با لمس هر ردیف لیست بالا صفحه‌ی عمق بازار و با لمس هر ردیف این جدول صفحه‌ی TSE همان نماد باز می‌شود.<br>'+
'<b>کاربرد:</b> پیدا کردن نمادهایی که با حجم قوی از یک سقف کوتاه‌مدت بالا رفته‌اند؛ نقطه‌ی شروعی برای بررسی چارت، حجم و ورود پول.<br>'+
'<b>نکته‌ها:</b> محاسبه روی قیمت‌های خام و تعدیل‌نشده انجام می‌شود (افزایش سرمایه یا سود نقدی روی سقف قبلی اثر دارد). شکست ممکن است کاذب باشد و قیمت تا پایان روز برگردد. نمادی که با صف خرید حجم کمی دارد ممکن است از شرط حجم رد شود. این لیست فیلتر آماری است و توصیه‌ی خرید یا فروش نیست.</div>'}

// ---- شاخص ساز (sx1): ۱۵ نماد با بیشترین اثر روی شاخص کل بورس ----
function sxShGet(){try{return JSON.parse(localStorage.getItem("sxsh")||"{}")}catch(e){return{}}}
async function sxRun(C){if(WP.run)return;WP.run=true;WP.err="";C.cl=0;WP.msg="دریافت فهرست کل بازار از بورس…";if(wlOn())wlPaint();
try{var list=parseMW(await getAny("/tsev2/data/MarketWatchInit.aspx?h=0&r=0"));if(list.length<50)throw mkErr("data",0,"parse");
var cand=list.filter(function(r){var p=r.pl>0?r.pl:r.pc;return r.fl==="1"&&r.py>0&&p>0&&p!==r.py}).sort(function(x,y){return(y.val||0)-(x.val||0)}).slice(0,300),sh=sxShGet(),now=Date.now(),er=0,fe=null;
await pool(cand.filter(function(r){var o=sh[r.c];return !(o&&o[0]>0&&now-o[1]<6048e5)}),8,async function(r){try{var I=JSON.parse(await GET(TS+"Instrument/GetInstrumentInfo/"+r.c));I=I.instrumentInfo||I;var z=num(I.zTitad);if(z>0)sh[r.c]=[z,now]}catch(e){er++;if(!fe)fe=e}},function(d){WP.msg="دریافت تعداد سهام نمادها… "+d.toLocaleString("fa-IR");if(d%10===0&&wlOn())wlPaint()});
try{localStorage.setItem("sxsh",JSON.stringify(sh))}catch(e){}
if(cand.length&&er>cand.length*0.5&&fe)throw fe;
try{if(IX.v==null)await ixLoad()}catch(e){}
var rows=[],sp=0;cand.forEach(function(r){var z=sh[r.c]&&sh[r.c][0];if(!(z>0))return;var p=r.pl>0?r.pl:r.pc,d=(p-r.py)*z;sp+=r.py*z;rows.push({c:r.c,n:r.n,nm:r.nm,d:d,chg:(p/r.py-1)*100,mc:p*z})});
var base=0;try{var mj=JSON.parse(await GETC(TS+"MarketData/GetMarketOverview/1",30000));base=findNum(mj,[/^marketValue$/i,/marketValue/i],1e9)||0}catch(e){}
C.ap=0;if(!(base>sp)){base=sp;C.ap=1}
var pv=(IX.v!=null&&IX.ch!=null)?IX.v-IX.ch:0;
rows.forEach(function(x){x.imp=pv>0?x.d/base*pv:null;x.sh=x.d/base*100});
rows.sort(function(a,b){return Math.abs(b.d)-Math.abs(a.d)});
C.dg="نمادهای بررسی‌شده: "+rows.length.toLocaleString("fa-IR")+" از "+cand.length.toLocaleString("fa-IR")+" نماد پرمعامله‌ی بورس"+(er?" — خطای دریافت: "+er.toLocaleString("fa-IR"):"")+(C.ap?" — ارزش کل بازار در دسترس نبود؛ عدد اثر تقریبی است":"");
C.tot=rows.length;C.items=rows.slice(0,15);C.ft=Date.now();WP.stat={m:list.length,c:cand.length};wlSave()}
catch(e){return nfEnd(e)}
WP.run=false;if(wlOn()){wlPaint();setTimeout(wlLoad,50)}}
function sxDetail(C){var it=C.items||[],sg=function(v,d){return v==null?"—":(v>0?"+":(v<0?"\u2212":""))+cfp(Math.abs(v),d)};
var rows=it.map(function(x,i){var c=x.d>0?"var(--up)":(x.d<0?"var(--dn)":"inherit"),cc=x.chg>0?"var(--up)":(x.chg<0?"var(--dn)":"inherit");return'<tr'+tcA(x)+'><td class="drw">'+(i+1).toLocaleString("fa-IR")+'</td><td style="font-weight:700">'+esc(x.n)+'</td><td dir="ltr" style="color:'+c+';font-weight:700">'+(x.imp!=null?sg(x.imp,1):sg(x.sh,2)+"٪")+'</td><td dir="ltr" style="color:'+cc+'">'+sg(x.chg,2)+'٪</td><td>'+cfp(x.mc/1e13,1)+'</td></tr>'}).join("");
var tb=it.length?'<div class="sc scv"><table class="stk"><tr><th class="drw">ردیف</th><th>نماد</th><th>اثر در شاخص<span class="qm" data-wl="H:sx_i">?</span></th><th>درصد قیمت<span class="qm" data-wl="H:sx_p">?</span></th><th>ارزش بازار<span class="qm" data-wl="H:sx_m">?</span></th></tr>'+rows+'</table></div>':'<div class="mut" style="padding:8px">'+(C.cl?"لیست خالی است.":"نمادی پیدا نشد؛ شاید بازار هنوز تغییر قیمتی نداشته است.")+'</div>';
return'<div class="card" style="padding:6px;margin-top:8px"><b>جزئیات شاخص ساز<span class="qm" data-wl="H:sx_d">?</span></b><div class="mut" style="font-size:11px;line-height:1.8">'+esc(wpMsg(C))+(C.dg?" | "+C.dg:"")+'</div>'+tb+'</div>'+
'<div class="card" style="padding:8px;margin-top:8px;line-height:2;font-size:12px"><b>توضیح کامل شاخص ساز</b><br>'+
'<b>این لیست چیست؟</b> ۱۵ نمادی از بازار بورس که امروز بیشترین اثر را روی عدد «شاخص کل» گذاشته‌اند؛ هم نمادهایی که شاخص را بالا برده‌اند (سبز) و هم آن‌ها که پایین آورده‌اند (قرمز).<br>'+
'<b>روش محاسبه:</b> برای هر نماد، تغییر ارزش بازار (اختلاف آخرین قیمت و پایانی دیروز × تعداد سهام) را بر ارزش کل بازار بورس تقسیم می‌کنیم و در شاخص دیروز ضرب می‌کنیم. نمادها از بیشترین اثر مطلق به کمترین چیده می‌شوند.<br>'+
'<b>ستون‌ها:</b> اثر در شاخص = برآورد واحدی که نماد به شاخص کل اضافه یا از آن کم کرده است. درصد قیمت = تغییر آخرین قیمت نسبت به پایانی دیروز. ارزش بازار = هزار میلیارد تومان.<br>'+
'<b>محدودیت‌ها:</b> عدد اثر برآوردی است و با عدد سایت بورس دقیقاً برابر نیست (تعدیل سهام شناور، نمادهای خارج از ۳۰۰ نماد پرمعامله و گاهی تأخیر داده). به‌جز بورس، فرابورس را شامل نمی‌شود. این لیست فیلتر آماری است و توصیه‌ی خرید یا فروش نیست.<br>'+
'<b>دکمه‌ها و لمس:</b> ▶ لیست را از نو می‌سازد و هر ۵ دقیقه که صفحه باز باشد خودکار بروز می‌شود. با لمس هر ردیف لیست بالا صفحه‌ی عمق بازار و با لمس هر ردیف جدول صفحه‌ی TSE همان نماد باز می‌شود.</div>'}
// ---- صنعت‌های داغ (hs1): میانگین بازده و ورود پول هر صنعت ----
async function hsRun(C){if(WP.run)return;WP.run=true;WP.err="";C.cl=0;WP.msg="دریافت فهرست کل بازار از بورس…";if(wlOn())wlPaint();
try{var l=parseMW(await getAny("/tsev2/data/MarketWatchInit.aspx?h=0&r=0"));if(l.length<50)throw mkErr("data",0,"parse");
var ct={};try{ct=parseCT(await getAny("/tsev2/data/ClientTypeAll.aspx"))}catch(e){}
var g={};l.forEach(function(r){if(!r.sc||!(r.py>0)||!(r.pl>0)||!(r.val>0))return;var o=g[r.sc]||(g[r.sc]={v:0,w:0,n:0,up:0,dn:0,fl:0,bV:0,bC:0,sV:0,sC:0,sy:[],top:r}),ch=(r.pl/r.py-1)*100,c=ct[r.c];o.v+=r.val;o.w+=ch*r.val;o.n++;if(ch>0)o.up++;else if(ch<0)o.dn++;if(c){o.fl+=c.net*r.pl;o.bV+=c.bv*r.pl;o.bC+=c.bc;o.sV+=c.sv*r.pl;o.sC+=c.sc}o.sy.push({c:r.c,n:r.n,nm:r.nm,ch:ch,val:r.val,fl:c?c.net*r.pl:null});if(r.val>o.top.val)o.top=r});
var nm={};try{nm=JSON.parse(localStorage.getItem("hsn")||"{}")}catch(e){}
await pool(Object.keys(g).filter(function(k){return !nm[k]}),6,async function(k){var I=JSON.parse(await GET(TS+"Instrument/GetInstrumentInfo/"+g[k].top.c));I=I.instrumentInfo||I;var n=I.sector&&I.sector.lSecVal;if(n)nm[k]=ar(String(n).trim())},function(d){WP.msg="دریافت نام صنعت‌ها… "+d.toLocaleString("fa-IR");if(wlOn())wlPaint()});
try{localStorage.setItem("hsn",JSON.stringify(nm))}catch(e){}
HSX={};var rows=Object.keys(g).filter(function(k){return g[k].n>=2}).map(function(k){var o=g[k],nn=nm[k]||("گروه "+k);HSX[nn]=o.sy;return{n:nn,pc:o.w/o.v,vl:o.v,fl:o.fl,up:o.up,dn:o.dn,pb:o.bC>0?o.bV/o.bC:0,ps:o.sC>0?o.sV/o.sC:0,pq:(o.bC>0&&o.sC>0&&o.sV>0&&o.bV>0)?(o.bV/o.bC)/(o.sV/o.sC):0,tc:o.top.c,tn:o.top.n,tm:o.top.nm}});
if(!rows.length)throw mkErr("data",0,"parse");
C.hs=rows;C.hk=C.hk||"pc";C.items=hsItems(C);C.tot=rows.length;C.dg="صنعت‌های بررسی‌شده: "+rows.length.toLocaleString("fa-IR");C.ft=Date.now();WP.stat={m:l.length,c:rows.length};wlSave()}
catch(e){return nfEnd(e)}
WP.run=false;if(wlOn()){wlPaint();setTimeout(wlLoad,50)}}
function hsItems(C){var k=C.hk||"pc";return(C.hs||[]).slice().sort(function(a,b){return(b[k]||0)-(a[k]||0)}).slice(0,15).map(function(x){return{c:x.tc,n:x.tn,nm:x.tm}})}
function hsDetail(C){var k=C.hk||"pc",R=(C.hs||[]).slice().sort(function(a,b){return(b[k]||0)-(a[k]||0)}),sg=function(v,d){return v==null||!isFinite(v)?"—":(v>0?"+":(v<0?"−":""))+cfp(Math.abs(v),d)},cl=function(v){return v>0?"var(--up)":(v<0?"var(--dn)":"inherit")},
th=function(c,t,h){return'<th data-wl="HK:'+c+'" style="cursor:pointer">'+t+(k===c?" ▼":"")+'<span class="qm" data-wl="H:'+h+'">?</span></th>'};
var rows=R.map(function(x,i){return'<tr'+tcA({c:x.tc,n:x.tn})+'><td class="drw">'+(i+1).toLocaleString("fa-IR")+'</td><td data-hsx="'+esc(x.n)+'" style="text-align:right;font-weight:700;text-decoration:underline dotted">'+esc(x.n)+'</td><td dir="ltr" style="color:'+cl(x.pc)+';font-weight:700">'+sg(x.pc,2)+'٪</td><td dir="ltr" style="color:'+cl(x.fl)+'">'+sg(x.fl/1e10,0)+'</td><td>'+cfp(x.vl/1e10,0)+'</td><td>'+(x.pb>0?cfp(x.pb/1e7,1):"—")+'</td><td>'+(x.ps>0?cfp(x.ps/1e7,1):"—")+'</td><td style="color:'+(x.pq>1?"var(--up)":(x.pq>0?"var(--dn)":"inherit"))+'">'+(x.pq>0?cfp(x.pq,2):"—")+'</td><td><span style="color:var(--up)">'+cfp(x.up)+'</span>/<span style="color:var(--dn)">'+cfp(x.dn)+'</span></td><td>'+esc(x.tn)+'</td></tr>'}).join("");
var tb=R.length?'<div class="sc scv"><table class="stk"><tr><th class="drw">ردیف</th><th>صنعت</th>'+th("pc","درصد","hs_p")+th("fl","ورود پول","hs_f")+th("vl","ارزش","hs_v")+th("pb","سرانه خرید","hs_b")+th("ps","سرانه فروش","hs_s")+th("pq","قدرت","hs_q")+'<th>▲/▼<span class="qm" data-wl="H:hs_u">?</span></th><th>نماد برتر<span class="qm" data-wl="H:hs_t">?</span></th></tr>'+rows+'</table></div>':'<div class="mut" style="padding:8px">'+(C.cl?"لیست خالی است.":"صنعتی پیدا نشد؛ شاید بازار هنوز معامله‌ای نداشته است.")+'</div>';
return'<div class="card" style="padding:6px;margin-top:8px"><b>جزئیات صنعت‌های داغ<span class="qm" data-wl="H:hs_d">?</span></b><div class="mut" style="font-size:11px;line-height:1.8;min-height:40px">'+esc(wpMsg(C))+(C.dg?" | "+C.dg:"")+' — برای مرتب‌سازی روی عنوان ستون‌ها بزنید</div>'+tb+'</div>'+
'<div class="card" style="padding:8px;margin-top:8px;line-height:2;font-size:12px"><b>توضیح کامل صنعت‌های داغ</b><br>'+
'<b>این لیست چیست؟</b> صنعت‌های بورس و فرابورس را از نظر بازده، ورود پول حقیقی و ارزش معاملات مقایسه می‌کند. لیست بالا برای هر کدام از ۱۵ صنعت برتر، پرمعامله‌ترین نماد آن صنعت را نشان می‌دهد.<br>'+
'<b>روش محاسبه:</b> درصد = میانگین درصد تغییر آخرین قیمت نمادهای صنعت، وزن‌دهی‌شده با ارزش معاملاتشان. ورود پول = مجموع (خرید − فروش) حقیقی × قیمت، به میلیارد تومان؛ مثبت یعنی پول حقیقی وارد صنعت شده. ارزش = ارزش معاملات به میلیارد تومان. ▲/▼ تعداد نمادهای مثبت و منفی است. فقط صنعت‌های دست‌کم ۲ نماد معامله‌شده نمایش داده می‌شوند. نام صنعت‌ها بار اول از بورس گرفته و در گوشی ذخیره می‌شود.<br>'+
'<b>دکمه‌ها و لمس:</b> ▶ لیست را از نو می‌سازد و هر ۵ دقیقه که صفحه باز باشد خودکار بروز می‌شود. با لمس عنوان ستون «درصد»، «ورود پول» یا «ارزش» ترتیب صنعت‌ها و لیست بالا عوض می‌شود. با لمس هر ردیف لیست بالا صفحه‌ی عمق بازار و با لمس هر ردیف جدول صفحه‌ی TSE نماد برتر همان صنعت باز می‌شود. این لیست فیلتر آماری است و توصیه‌ی خرید یا فروش نیست.</div>'}
// ---- حباب NAV (nb1): صندوق‌های قابل معامله بر پایه‌ی حباب مثبت/منفی و ارزش خرید و فروش ----
var NB={nv:{}};
function nbParse(t){var segs=String(t).split("@"),best=null,bn=0;
segs.forEach(function(sg){var r=sg.split(";"),n=0;for(var i=0;i<Math.min(r.length,40);i++){if(r[i].split(",").length>=20)n++}if(n>bn){bn=n;best=r}});
if(!best||bn<5)return[];var out=[];
best.forEach(function(r){var f=r.split(",");if(f.length<21)return;
var isin=(f[1]||"").trim(),sym=ar((f[2]||"").trim()),nm=ar((f[3]||"").trim()),sc=(f[18]||"").trim();
if(isin.indexOf("IRO1")===0||!sym||/\d/.test(sym)||/^ح[\s.]/.test(nm))return;
if(!(isin.indexOf("IRT")===0||sc==="68"))return;
out.push({c:f[0].trim(),n:sym,nm:nm,pl:num(f[7]),pc:num(f[6]),val:num(f[10]),py:num(f[13])})});
return out}
async function nbRun(C){if(WP.run)return;WP.run=true;WP.err="";C.cl=0;WP.msg="دریافت فهرست صندوق‌ها از بورس…";if(wlOn())wlPaint();
try{var l=nbParse(await getAny("/tsev2/data/MarketWatchInit.aspx?h=0&r=0"));if(l.length<5)throw mkErr("data",0,"parse");
var ct={};try{ct=parseCT(await getAny("/tsev2/data/ClientTypeAll.aspx"))}catch(e){}
var cand=l.filter(function(r){return(r.pl>0||r.pc>0)&&r.val>0}),now=Date.now(),er=0,fe=null;
await pool(cand.filter(function(r){var o=NB.nv[r.c];return !(o&&now-o.t<12e4)}),8,async function(r){var v=0;
try{var I=JSON.parse(await GET(TS+"Instrument/GetInstrumentInfo/"+r.c));I=I.instrumentInfo||I;v=num(I.nav)}catch(e){er++;if(!fe)fe=e}
if(!(v>0)){try{var j=JSON.parse(await GET(TS+"Fund/GetETFByInsCode/"+r.c)),e2=j.etf||j;v=num(e2.pRedTran)||num(e2.nav)||num(e2.pSubTran)}catch(e){}}
NB.nv[r.c]={v:v,t:now}},function(d){WP.msg="دریافت NAV صندوق‌ها… "+d.toLocaleString("fa-IR")+" از "+cand.length.toLocaleString("fa-IR");if(d%10===0&&wlOn())wlPaint()});
if(cand.length&&er>cand.length*0.5&&fe)throw fe;
var rows=[];cand.forEach(function(r){var o=NB.nv[r.c],nv=o&&o.v,p=r.pl>0?r.pl:r.pc;if(!(nv>0&&p>0))return;var c=ct[r.c];rows.push({c:r.c,n:r.n,nm:r.nm,p:p,nav:nv,b:(p/nv-1)*100,val:r.val,net:c?c.net*p:null})});
if(!rows.length)throw mkErr("data",0,"parse");
C.fx=rows;C.nk=C.nk||"bp";C.items=nbItems(C);C.tot=rows.length;
var up=rows.filter(function(x){return x.b>0}).length;
C.dg="صندوق‌های معامله‌شده: "+rows.length.toLocaleString("fa-IR")+" | حباب مثبت: "+up.toLocaleString("fa-IR")+" | حباب منفی: "+(rows.length-up).toLocaleString("fa-IR");C.ft=Date.now();WP.stat={m:l.length,c:rows.length};wlSave()}
catch(e){return nfEnd(e)}
WP.run=false;if(wlOn()){wlPaint();setTimeout(wlLoad,50)}}
function nbSorted(C){var k=C.nk||"bp",R=(C.fx||[]).slice();
if(k==="bp")R=R.filter(function(x){return x.b>0}).sort(function(a,b){return b.b-a.b});
else if(k==="bn")R=R.filter(function(x){return x.b<0}).sort(function(a,b){return a.b-b.b});
else if(k==="by")R=R.filter(function(x){return x.net!=null}).sort(function(a,b){return b.net-a.net});
else if(k==="sl")R=R.filter(function(x){return x.net!=null}).sort(function(a,b){return a.net-b.net});
else R.sort(function(a,b){return b.val-a.val});
return R.slice(0,20)}
function nbItems(C){return nbSorted(C).map(function(x){return{c:x.c,n:x.n,nm:x.nm}})}
function nbDetail(C){var k=C.nk||"bp",R=nbSorted(C),sg=function(v,d){return v==null||!isFinite(v)?"—":(v>0?"+":(v<0?"−":""))+cfp(Math.abs(v),d)},cl=function(v){return v>0?"var(--up)":(v<0?"var(--dn)":"inherit")};
var K=[["bp","حباب مثبت"],["bn","حباب منفی"],["by","ارزش خرید (ورود پول)"],["sl","ارزش فروش (خروج پول)"],["vl","ارزش معاملات"]];
var bt='<div class="nbk">'+K.map(function(z){return'<button type="button" data-wl="NK:'+z[0]+'"'+(k===z[0]?' class="on"':'')+'>'+z[1]+'</button>'}).join("")+'</div>';
var rows=R.map(function(x,i){return'<tr'+tcA(x)+'><td class="drw">'+(i+1).toLocaleString("fa-IR")+'</td><td style="font-weight:700">'+esc(x.n)+'</td><td dir="ltr" style="color:'+cl(x.b)+';font-weight:700">'+sg(x.b,2)+'٪</td><td>'+cfp(x.nav)+'</td><td>'+cfp(x.p)+'</td><td>'+cfp(x.val/1e10,1)+'</td><td dir="ltr" style="color:'+cl(x.net)+'">'+(x.net==null?"—":sg(x.net/1e10,1))+'</td></tr>'}).join("");
var tb=R.length?'<div class="sc scv"><table class="stk"><tr><th class="drw">ردیف</th><th>نماد</th><th>حباب ٪<span class="qm" data-wl="H:nb_b">?</span></th><th>NAV<span class="qm" data-wl="H:nb_n">?</span></th><th>آخرین<span class="qm" data-wl="H:nb_p">?</span></th><th>ارزش معاملات<span class="qm" data-wl="H:nb_v">?</span></th><th>ورود پول<span class="qm" data-wl="H:nb_f">?</span></th></tr>'+rows+'</table></div>':'<div class="mut" style="padding:8px">'+(C.cl?"لیست خالی است.":"صندوقی با این شرط پیدا نشد؛ شاید بازار هنوز معامله‌ای نداشته است.")+'</div>';
return'<div class="card" style="padding:6px;margin-top:8px"><b>جزئیات حباب NAV<span class="qm" data-wl="H:nb_d">?</span></b><div class="mut" style="font-size:11px;line-height:1.8">'+esc(wpMsg(C))+(C.dg?" | "+C.dg:"")+'</div>'+bt+tb+'</div>'+
'<div class="card" style="padding:8px;margin-top:8px;line-height:2;font-size:12px"><b>توضیح کامل حباب NAV</b><br>'+
'<b>این لیست چیست؟</b> صندوق‌های قابل معامله‌ی بورس و فرابورس را بر پایه‌ی «حباب» نشان می‌دهد؛ حباب یعنی فاصله‌ی قیمت بازار صندوق با NAV (ارزش خالص دارایی هر واحد). حباب مثبت یعنی صندوق گران‌تر از ارزش واقعی‌اش معامله می‌شود و حباب منفی یعنی ارزان‌تر.<br>'+
'<b>روش محاسبه:</b> حباب ٪ = (آخرین قیمت ÷ NAV − ۱) × ۱۰۰. فقط صندوق‌هایی که امروز معامله شده‌اند و NAV آن‌ها در دسترس است بررسی می‌شوند و ۲۰ مورد اول از هر مرتب‌سازی نمایش داده می‌شود.<br>'+
'<b>دکمه‌های مرتب‌سازی:</b> «حباب مثبت» بیشترین حباب مثبت را اول می‌آورد، «حباب منفی» بیشترین حباب منفی (ارزان‌ترین نسبت به NAV) را اول. «ارزش خرید» صندوق‌هایی را اول می‌آورد که بیشترین ورود پول حقیقی (خرید حقیقی منهای فروش حقیقی) را دارند و «ارزش فروش» آن‌هایی که بیشترین خروج پول حقیقی را دارند. «ارزش معاملات» بر پایه‌ی ارزش کل معاملات امروز است. ارزش‌ها به میلیارد تومان‌اند.<br>'+
'<b>دکمه‌ها و لمس:</b> ▶ لیست را از نو می‌سازد و هر ۵ دقیقه که صفحه باز باشد خودکار بروز می‌شود. با لمس هر ردیف لیست بالا صفحه‌ی عمق بازار و با لمس هر ردیف جدول صفحه‌ی TSE همان نماد باز می‌کند.<br>'+
'<b>محدودیت‌ها:</b> NAV صندوق‌ها در طول روز تقریبی و با تأخیر بروز می‌شود و ممکن است با عدد سایت صندوق کمی فرق کند. حباب بالا یا پایین به‌تنهایی دلیل خرید یا فروش نیست و این لیست توصیه‌ی خرید یا فروش نیست.</div>'}
// ---- صف خرید قوی ----
async function qbRun(C){if(WP.run)return;WP.run=true;WP.err="";C.cl=0;WP.msg="دریافت فهرست کل بازار از بورس…";if(wlOn())wlPaint();
try{var list=parseMW(await getAny("/tsev2/data/MarketWatchInit.aspx?h=0&r=0"));if(list.length<50)throw mkErr("data",0,"parse");
var b=nfIn(C,list),cand=b.inM.filter(function(r){return r.vol>0&&r.pl>0&&r.smx>0&&r.pl>=r.smx}),res=[],tk=key(today),er=0,sh=0,fe=null;
await pool(cand,6,async function(r){var bl,a,h;try{bl=nbl(firstArr(JSON.parse(await GET(TS+"BestLimits/"+r.c))))}catch(e){er++;if(!fe)fe=e;return}
var f=bl.slice().sort(function(x,y){return num(x.number)-num(y.number)})[0]||{},qd=num(f.qmd),qo=num(f.qmo),pd=num(f.pmd);
if(!(qd>0)||qo>0||(pd>0&&pd<r.smx))return;
try{var j=JSON.parse(await GET(TS+"ClosingPrice/GetClosingPriceDailyList/"+r.c+"/40"));a=firstArr(j.closingPriceDaily||j).slice()}catch(e){er++;if(!fe)fe=e;return}
h=nfHist(a,r,tk);if(!h){sh++;return}var p=h.p.slice(0,30);if(p.length<10){sh++;return}
var av=0;p.forEach(function(x){av+=x.vol});av/=p.length;if(!(av>0))return;
var pr=pd>0?pd:r.pl,qv=qd*pr,qr=qd/av;if(!(qr>=G(1)&&qv>=G(1e10)))return;
res.push({c:r.c,n:r.n,nm:r.nm,qd:qd,qv:qv,qr:qr,vr:r.vol/av,chg:r.py>0?(r.pl/r.py-1)*100:0})},nfProg(cand));
if(cand.length&&er>cand.length*0.5&&fe)throw fe;
res.sort(function(x,y){return y.qr-x.qr});
C.dg=(b.nf?"فیلتر بازار اعمال نشد — ":"")+"نمادهای در صف خرید (آخرین قیمت روی سقف مجاز): "+cand.length.toLocaleString("fa-IR")+" — خطای دریافت: "+er.toLocaleString("fa-IR")+" — سابقه‌ی کم: "+sh.toLocaleString("fa-IR")+(cand.length?"":" (در حال حاضر نمادی در صف خرید نیست یا بازار هنوز معامله‌ای ندارد)");
C.tot=res.length;C.items=res.slice(0,20);C.ft=Date.now();WP.stat={m:list.length,c:cand.length};wlSave()}
catch(e){return nfEnd(e)}
WP.run=false;if(wlOn()){wlPaint();setTimeout(wlLoad,50)}}
function qbDetail(C){var it=C.items||[];
var rows=it.map(function(x,i){return'<tr'+tcA(x)+'><td class="drw">'+(i+1).toLocaleString("fa-IR")+'</td><td style="font-weight:700">'+esc(x.n)+'</td><td>'+wlK(x.qd)+'</td><td>'+cfp(x.qv/1e10,1)+'</td><td style="color:var(--up);font-weight:700">×'+cfp(x.qr,1)+'</td><td>×'+cfp(x.vr,1)+'</td></tr>'}).join("");
var tb=it.length?'<div class="sc scv"><table class="stk"><tr><th class="drw">ردیف</th><th>نماد</th><th>حجم صف<span class="qm" data-wl="H:qb_q">?</span></th><th>ارزش صف<span class="qm" data-wl="H:qb_v">?</span></th><th>صف÷میانگین<span class="qm" data-wl="H:qb_r">?</span></th><th>حجم×<span class="qm" data-wl="H:qb_x">?</span></th></tr>'+rows+'</table></div>':'<div class="mut" style="padding:8px">'+(C.cl?"لیست خالی است.":"نمادی با شرط‌های این فیلتر پیدا نشد.")+'</div>';
return'<div class="card" style="padding:6px;margin-top:8px"><b>جزئیات صف خرید قوی<span class="qm" data-wl="H:qb_d">?</span></b><div class="mut" style="font-size:11px;line-height:1.8">'+esc(wpMsg(C))+(C.dg?" | "+C.dg:"")+(C.tot>it.length?" — "+C.tot.toLocaleString("fa-IR")+" نماد مطابق فیلتر؛ ۲۰ مورد اول نمایش داده شده":"")+'</div>'+tb+'</div>'+
'<div class="card" style="padding:8px;margin-top:8px;line-height:2;font-size:12px"><b>توضیح کامل صف خرید قوی</b><br>'+
'<b>این لیست چیست؟</b> نمادهایی که همین الان در صف خرید هستند (آخرین قیمت روی سقف مجاز روزانه، خریدار در بهترین سطح تابلو و بدون فروشنده) و حجم صف خرید نسبت به حجم معمول روزانه‌ی نماد سنگین است؛ یعنی صف «قوی» است و با یک روز معامله‌ی معمولی خالی نمی‌شود.<br>'+
'<b>شرط‌ها (همه با هم):</b> ۱) آخرین قیمت برابر یا بالاتر از سقف مجاز قیمت امروز. ۲) در بهترین سطح تابلو حجم خرید بیشتر از صفر و حجم فروش صفر. ۳) حجم صف خرید حداقل برابر میانگین حجم ۳۰ روز معاملاتی گذشته (نسبت صف به میانگین ≥ ۱). ۴) ارزش صف (حجم صف × قیمت) بیش از ۱ میلیارد تومان. ۵) حداقل ۱۰ روز معاملاتی سابقه.<br>'+
'<b>نحوه‌ی چیدن:</b> بر اساس «صف÷میانگین» از زیاد به کم. فقط ۲۰ نماد اول نمایش داده می‌شود.<br>'+
'<b>ستون‌ها:</b> حجم صف = تعداد سهم در صف خرید (K هزار، M میلیون). ارزش صف = حجم صف × قیمت به میلیارد تومان. صف÷میانگین = حجم صف ÷ میانگین حجم ۳۰ روز. حجم× = حجم امروز ÷ میانگین ۳۰ روز.<br>'+
'<b>دکمه‌ها:</b> ▶ لیست را از نو می‌سازد. این لیست سبک است (فقط برای نمادهای در صف خرید تابلو و سابقه گرفته می‌شود) و هر ۵ دقیقه که صفحه باز باشد خودکار بروز می‌شود. با لمس هر ردیف لیست بالا صفحه‌ی عمق بازار و با لمس هر ردیف این جدول صفحه‌ی TSE همان نماد باز می‌شود.<br>'+
'<b>کاربرد:</b> پیدا کردن نمادهایی که تقاضای خرید سنگینی پشت سقف قیمت دارند؛ برای شروع بررسی تابلو، قدرت خریدار و ادامه‌ی صف.<br>'+
'<b>نکته‌ها:</b> حجم صف لحظه‌ای است و با لغو سفارش یا فروش سنگین سریع کم می‌شود؛ صف قوی تضمین ادامه‌ی صف یا رشد فردا نیست. وقتی بازار بسته است یا هنوز معامله‌ای ندارد لیست خالی می‌ماند. آستانه‌ها (نسبت ۱ و ارزش ۱ میلیارد تومان) ثابت‌اند. این لیست فیلتر آماری است و توصیه‌ی خرید یا فروش نیست.</div>'}
// ---- خرید گروهی (gb1) و مستعد خرید گروهی (gm1) ----
async function gxRun(C,md){if(WP.run)return;WP.run=true;WP.err="";C.cl=0;WP.msg="دریافت فهرست کل بازار از بورس…";if(wlOn())wlPaint();
try{var list=parseMW(await getAny("/tsev2/data/MarketWatchInit.aspx?h=0&r=0"));if(list.length<50)throw mkErr("data",0,"parse");
var gc=+S.gc||50,hp=+S.hv||5,b=nfIn(C,list),cand=b.inM.filter(function(r){return r.vol>0&&r.pl>0&&r.py>0&&r.pl>=r.py&&r.vol*r.pl>=1e10&&(md==="gm"?!(r.smx>0&&r.pl>=r.smx):true)}),res=[],tk=key(today),er=0,sh=0,fe=null,nb=0;
await pool(cand,8,async function(r){var bl,a,h;try{bl=nbl(firstArr(JSON.parse(await GET(TS+"BestLimits/"+r.c)))).slice().sort(function(x,y){return num(x.number)-num(y.number)}).slice(0,5)}catch(e){er++;if(!fe)fe=e;return}
var tz=0,tq=0,sz=0,mz=0,i,x;for(i=0;i<bl.length;i++){x=bl[i];tz+=num(x.zmd);tq+=num(x.qmd);sz+=num(x.zmo);if(num(x.zmd)>mz)mz=num(x.zmd)}
if(!(mz>=(md==="gb"?gc:gc*0.5)))return;nb++;
try{var j=JSON.parse(await GET(TS+"ClosingPrice/GetClosingPriceDailyList/"+r.c+"/40"));a=firstArr(j.closingPriceDaily||j).slice()}catch(e){er++;if(!fe)fe=e;return}
h=nfHist(a,r,tk);if(!h){sh++;return}var p=h.p.slice(0,30);if(p.length<10){sh++;return}
var av=0;p.forEach(function(q){av+=q.vol});av/=p.length;if(!(av>0))return;var hv=av*hp/100,pr=num((bl[0]||{}).pmd)||r.pl;
if(md==="gb"){var gl=0,gz=0,gq=0;bl.forEach(function(y){var z=num(y.zmd),q=num(y.qmd);if(z>=gc&&q>0&&q/z<=hv/10){gl++;gz+=z;gq+=q}});
if(!gl)return;res.push({c:r.c,n:r.n,nm:r.nm,gl:gl,gz:gz,gq:gq,gv:gq*pr,chg:(r.pl/r.py-1)*100})}
else{if(mz>=gc)return;var ar=tz>0?tq/tz:0;if(!(tz>0&&ar<=hv/10))return;var rt=sz>0?tz/sz:99;if(rt<1.5)return;var vr=r.vol/av;if(vr<1)return;
res.push({c:r.c,n:r.n,nm:r.nm,mz:mz,sc:mz/gc*100,rt:rt,vr:vr,chg:(r.pl/r.py-1)*100})}},nfProg(cand));
if(cand.length&&er>cand.length*0.5&&fe)throw fe;
if(md==="gb")res.sort(function(x,y){return y.gz-x.gz});else res.sort(function(x,y){return y.sc-x.sc||y.rt-x.rt});
C.dg=(b.nf?"فیلتر بازار اعمال نشد — ":"")+"نمادهای بررسی‌شده: "+cand.length.toLocaleString("fa-IR")+" — دارای تعداد سفارش بالا در تابلو: "+nb.toLocaleString("fa-IR")+" — خطای دریافت: "+er.toLocaleString("fa-IR")+" — سابقه‌ی کم: "+sh.toLocaleString("fa-IR")+(cand.length?"":" (بازار هنوز معامله‌ای ندارد)");
C.tot=res.length;C.items=res.slice(0,20);C.ft=Date.now();WP.stat={m:list.length,c:cand.length};wlSave()}
catch(e){return nfEnd(e)}
WP.run=false;if(wlOn()){wlPaint();setTimeout(wlLoad,50)}}
function gxDetail(C,md){var it=C.items||[],gb=md==="gb",nm=gb?"خرید گروهی":"مستعد خرید گروهی",gc=(+S.gc||50).toLocaleString("fa-IR"),hp=(+S.hv||5).toLocaleString("fa-IR");
var rows=it.map(function(x,i){return'<tr'+tcA(x)+'><td class="drw">'+(i+1).toLocaleString("fa-IR")+'</td><td style="font-weight:700">'+esc(x.n)+'</td>'+(gb?
'<td><span style="background:#ffd600;color:#000;font-weight:700;border-radius:6px;padding:1px 6px">'+cfp(x.gz)+'</span></td><td>'+x.gl.toLocaleString("fa-IR")+'</td><td>'+wlK(x.gq)+'</td><td>'+cfp(x.gv/1e10,1)+'</td>':
'<td>'+cfp(x.mz)+'</td><td style="color:var(--up);font-weight:700">'+cfp(x.sc,0)+'٪</td><td>×'+cfp(x.rt>=99?99:x.rt,1)+'</td><td>×'+cfp(x.vr,1)+'</td>')+
'<td style="color:'+(x.chg>=0?"var(--up)":"var(--dn)")+';font-weight:700">'+cfp(Math.abs(x.chg),2)+'</td></tr>'}).join("");
var hd=gb?'<th>سفارش گروهی</th><th>ردیف گروهی</th><th>حجم</th><th>ارزش</th>':'<th>بیشترین تعداد</th><th>نسبت به آستانه</th><th>خرید÷فروش</th><th>حجم×</th>';
var tb=it.length?'<div class="sc scv"><table class="stk"><tr><th class="drw">ردیف</th><th>نماد</th>'+hd+'<th>تغییر ٪</th></tr>'+rows+'</table></div>':'<div class="mut" style="padding:8px">'+(C.cl?"لیست خالی است.":"نمادی با شرط‌های این فیلتر پیدا نشد (در ساعات بازار و با تابلوی زنده نتیجه می‌دهد).")+'</div>';
var ex=gb?
'<b>این لیست چیست؟</b> نمادهایی که همین الان در پنج ردیف اول تابلوی «خرید» آن‌ها خرید گروهی دیده می‌شود؛ یعنی تعداد زیادی خریدار کوچک با سفارش‌های ریز پشت قیمت‌ها صف کشیده‌اند. همان تشخیصی است که در صفحه‌ی عمق بازار با زرد شدن ستون «تعداد» نشان داده می‌شود.<br><b>شرط‌ها (همه با هم):</b> ۱) نماد مثبت (آخرین قیمت برابر یا بالاتر از دیروز) و ارزش معاملات امروز بیش از ۱ میلیارد تومان. ۲) دست‌کم یک ردیف از پنج ردیف اول خرید که تعداد سفارش آن حداقل '+gc+' باشد (عدد «گروهی» در تنظیمات). ۳) میانگین حجم هر سفارش آن ردیف از یک‌دهم آستانه‌ی «سنگین» ('+hp+'٪ میانگین حجم ۳۰ روز) کمتر یا برابر باشد. ۴) حداقل ۱۰ روز معاملاتی سابقه.<br><b>نحوه‌ی چیدن:</b> بر اساس مجموع تعداد سفارش ردیف‌های گروهی از زیاد به کم. فقط ۲۰ نماد اول نمایش داده می‌شود.<br><b>ستون‌ها:</b> سفارش گروهی = مجموع تعداد سفارش ردیف‌های گروهی. ردیف گروهی = تعداد ردیف‌های گروهی از ۵ ردیف. حجم = مجموع حجم آن ردیف‌ها (K هزار، M میلیون). ارزش = حجم × قیمت به میلیارد تومان. تغییر ٪ = تغییر آخرین قیمت نسبت به دیروز.<br>':
'<b>این لیست چیست؟</b> نمادهایی که هنوز به خرید گروهی کامل نرسیده‌اند ولی تابلوی خریدشان به آن نزدیک است و مستعد تبدیل شدن به خرید گروهی‌اند: تعداد سفارش‌های خرید در حال انباشته شدن است، سفارش‌ها ریزند و خریدارها از فروشنده‌ها بیشتر شده‌اند. برای دیدن نمادها پیش از زرد شدن ستون «تعداد» در عمق بازار.<br><b>شرط‌ها (همه با هم):</b> ۱) نماد مثبت و بیرون از صف خرید، با ارزش معاملات امروز بیش از ۱ میلیارد تومان. ۲) بیشترین تعداد سفارش در یک ردیف خرید بین ۵۰٪ و ۱۰۰٪ آستانه‌ی «گروهی» ('+gc+') باشد؛ یعنی هنوز گروهی نشده ولی نزدیک است. ۳) میانگین حجم هر سفارش در پنج ردیف خرید از یک‌دهم آستانه‌ی «سنگین» ('+hp+'٪ میانگین حجم ۳۰ روز) کمتر یا برابر باشد (سفارش‌ها ریز). ۴) مجموع تعداد سفارش خرید حداقل ۱٫۵ برابر مجموع تعداد سفارش فروش در پنج ردیف اول. ۵) حجم امروز حداقل برابر میانگین ۳۰ روز. ۶) حداقل ۱۰ روز معاملاتی سابقه.<br><b>نحوه‌ی چیدن:</b> بر اساس «نسبت به آستانه» از زیاد به کم (نزدیک‌ترین به خرید گروهی بالاتر)، و در تساوی بر اساس خرید÷فروش. فقط ۲۰ نماد اول نمایش داده می‌شود.<br><b>ستون‌ها:</b> بیشترین تعداد = بیشترین تعداد سفارش در یک ردیف خرید. نسبت به آستانه = آن تعداد ÷ عدد «گروهی» تنظیمات. خرید÷فروش = تعداد سفارش خرید ÷ تعداد سفارش فروش در ۵ ردیف اول. حجم× = حجم امروز ÷ میانگین ۳۰ روز. تغییر ٪ = تغییر آخرین قیمت نسبت به دیروز.<br>';
return'<div class="card" style="padding:6px;margin-top:8px"><b>جزئیات '+nm+'</b><div class="mut" style="font-size:11px;line-height:1.8">'+esc(wpMsg(C))+(C.dg?" | "+C.dg:"")+(C.tot>it.length?" — "+C.tot.toLocaleString("fa-IR")+" نماد مطابق فیلتر؛ ۲۰ مورد اول نمایش داده شده":"")+'</div>'+tb+'</div>'+
'<div class="card" style="padding:8px;margin-top:8px;line-height:2;font-size:12px"><b>توضیح کامل '+nm+'</b><br>'+ex+
'<b>دکمه‌ها:</b> ▶ لیست را از نو با تابلوی لحظه‌ی بورس می‌سازد (برای هر نماد تابلو و سابقه گرفته می‌شود و ممکن است چند دقیقه طول بکشد). پاک‌کن لیست را خالی می‌کند. با لمس هر ردیف لیست بالا صفحه‌ی عمق بازار و با لمس هر ردیف این جدول صفحه‌ی TSE همان نماد باز می‌شود.<br>'+
'<b>نکته‌ها:</b> فقط وقتی بازار باز است و تابلو زنده است نتیجه می‌دهد. تعداد سفارش‌ها لحظه‌ای است و با لغو یا اجرای سفارش‌ها سریع عوض می‌شود. آستانه‌ها از تنظیمات «تحلیل عمق بازار» (گروهی و سنگین) خوانده می‌شود. این لیست فیلتر آماری است و توصیه‌ی خرید یا فروش نیست.</div>'}
// ---- RSI اشباع ----
function rsCalc(cl){var n=cl.length,p=14;if(n<p+1)return null;var g=0,l=0,i,d;for(i=1;i<=p;i++){d=cl[i]-cl[i-1];if(d>0)g+=d;else l-=d}g/=p;l/=p;for(i=p+1;i<n;i++){d=cl[i]-cl[i-1];g=(g*(p-1)+(d>0?d:0))/p;l=(l*(p-1)+(d<0?-d:0))/p}return l===0?100:100-100/(1+g/l)}
async function rsRun(C){if(WP.run)return;WP.run=true;WP.err="";C.cl=0;WP.msg="دریافت فهرست کل بازار از بورس…";if(wlOn())wlPaint();
try{var list=parseMW(await getAny("/tsev2/data/MarketWatchInit.aspx?h=0&r=0"));if(list.length<50)throw mkErr("data",0,"parse");
var b=nfIn(C,list),cand=b.inM.filter(function(r){return r.vol>0&&r.hg>0&&r.lw>0&&r.pl>0&&r.vol*r.pl>=1e10}),res=[],tk=key(today),fb=0,er=0,sh=0,fe=null,maxD=0;
if(cand.length<20){cand=b.inM;fb=1}
await pool(cand,8,async function(r){var j,a,h;try{j=JSON.parse(await GET(TS+"ClosingPrice/GetClosingPriceDailyList/"+r.c+"/65"));a=firstArr(j.closingPriceDaily||j).slice()}catch(e){er++;if(!fe)fe=e;return}
h=nfHist(a,r,tk);if(!h||h.p.length<29){sh++;return}var t=h.t;
if(!(t.vol>0&&t.pc>0&&t.pl>0&&t.vol*t.pl>=1e10))return;
var p20=h.p.slice(0,20),av=0;p20.forEach(function(x){av+=x.vol});av/=p20.length;if(!(av>0&&t.vol>=av))return;
var cl=h.p.slice().reverse().map(function(x){return x.pc});cl.push(t.pc);var rs=rsCalc(cl);if(rs==null||!(rs<=30-5*LVZ||rs>=70+5*LVZ))return;
var d=h.live?0:t.d;if(d>maxD)maxD=d;
res.push({d:d,c:r.c,n:r.n,nm:r.nm,rs:rs,os:rs<=30-5*LVZ,vr:t.vol/av,chg:t.py>0?(t.pl/t.py-1)*100:0})},nfProg(cand));
if(er>cand.length*0.5&&fe)throw fe;
res=res.filter(function(x){return !x.d||x.d>=maxD});
var os=res.filter(function(x){return x.os}).sort(function(x,y){return x.rs-y.rs}),ob=res.filter(function(x){return !x.os}).sort(function(x,y){return y.rs-x.rs});
C.dg=nfDg(b,cand,fb,er,sh)+" — اشباع فروش: "+os.length.toLocaleString("fa-IR")+"، اشباع خرید: "+ob.length.toLocaleString("fa-IR");
C.tot=res.length;C.items=os.slice(0,15).concat(ob.slice(0,15));C.ft=Date.now();WP.stat={m:list.length,c:cand.length};wlSave()}
catch(e){return nfEnd(e)}
WP.run=false;if(wlOn()){wlPaint();setTimeout(wlLoad,50)}}
function rsDetail(C){var it=C.items||[];
var rows=it.map(function(x,i){return'<tr'+tcA(x)+'><td class="drw">'+(i+1).toLocaleString("fa-IR")+'</td><td style="font-weight:700">'+esc(x.n)+'</td><td style="color:'+(x.os?"var(--dn)":"var(--up)")+';font-weight:700">'+cfp(x.rs,1)+'</td><td>'+(x.os?"اشباع فروش":"اشباع خرید")+'</td><td>×'+cfp(x.vr,1)+'</td><td style="color:'+(x.chg>=0?"var(--up)":"var(--dn)")+';font-weight:700">'+cfp(Math.abs(x.chg),2)+'</td></tr>'}).join("");
var tb=it.length?'<div class="sc scv"><table class="stk"><tr><th class="drw">ردیف</th><th>نماد</th><th>RSI<span class="qm" data-wl="H:rs_r">?</span></th><th>وضعیت<span class="qm" data-wl="H:rs_s">?</span></th><th>حجم×<span class="qm" data-wl="H:rs_x">?</span></th><th>تغییر ٪</th></tr>'+rows+'</table></div>':'<div class="mut" style="padding:8px">'+(C.cl?"لیست خالی است.":"نمادی با شرط‌های این فیلتر پیدا نشد.")+'</div>';
return'<div class="card" style="padding:6px;margin-top:8px"><b>جزئیات RSI اشباع<span class="qm" data-wl="H:rs_d">?</span></b><div class="mut" style="font-size:11px;line-height:1.8">'+esc(wpMsg(C))+(C.dg?" | "+C.dg:"")+(C.tot>it.length?" — "+C.tot.toLocaleString("fa-IR")+" نماد مطابق فیلتر؛ حداکثر ۱۵ مورد از هر گروه نمایش داده شده":"")+'</div>'+tb+'</div>'+
'<div class="card" style="padding:8px;margin-top:8px;line-height:2;font-size:12px"><b>توضیح کامل RSI اشباع</b><br>'+
'<b>این لیست چیست؟</b> نمادهایی که شاخص RSI ۱۴ روزه‌شان در ناحیه‌ی اشباع است: RSI برابر ۳۰ یا کمتر («اشباع فروش»؛ قیمت تند افت کرده و ممکن است نزدیک برگشت باشد) یا ۷۰ و بیشتر («اشباع خرید»؛ قیمت تند بالا رفته و ممکن است نزدیک اصلاح باشد). فقط نمادهایی می‌آیند که حجم امروزشان هم تأیید می‌کند.<br>'+
'<b>شرط‌ها (همه با هم):</b> ۱) حداقل ۳۰ روز معاملاتی سابقه. ۲) RSI امروز ≤ ۳۰ یا ≥ ۷۰. ۳) حجم امروز حداقل برابر میانگین حجم ۲۰ روز معاملاتی قبل. ۴) ارزش معاملات امروز (حجم × آخرین قیمت) بیش از ۱ میلیارد تومان.<br>'+
'<b>محاسبه‌ی RSI:</b> روی قیمت پایانی روزهای معامله‌شده؛ میانگین سود و ضرر ۱۴ روز با هموارسازی وایلدر. RS = میانگین سود ÷ میانگین ضرر و RSI = ۱۰۰ − ۱۰۰ ÷ (۱ + RS). قیمت پایانی امروز به‌صورت لحظه‌ای حساب می‌شود.<br>'+
'<b>نحوه‌ی چیدن:</b> اول گروه اشباع فروش (RSI کمتر بالاتر)، بعد گروه اشباع خرید (RSI بیشتر بالاتر). حداکثر ۱۵ نماد از هر گروه نمایش داده می‌شود.<br>'+
'<b>ستون‌ها:</b> RSI = مقدار امروز (قرمز = اشباع فروش، سبز = اشباع خرید). وضعیت = گروه نماد. حجم× = حجم امروز ÷ میانگین ۲۰ روز. تغییر ٪ = تغییر آخرین قیمت نسبت به دیروز.<br>'+
'<b>دکمه‌ها:</b> ▶ لیست را از نو با داده‌ی لحظه‌ی بورس می‌سازد (سابقه‌ی ۶۵ روزه‌ی نمادهای معامله‌شده دریافت می‌شود و ممکن است چند دقیقه طول بکشد). پاک‌کن لیست را خالی می‌کند. با لمس هر ردیف لیست بالا صفحه‌ی عمق بازار و با لمس هر ردیف این جدول صفحه‌ی TSE همان نماد باز می‌شود.<br>'+
'<b>کاربرد:</b> یافتن نمادهای افراطی از نظر شتاب قیمت برای بررسی برگشت یا اصلاح؛ نقطه‌ی شروع تحلیل است نه سیگنال خرید یا فروش.<br>'+
'<b>نکته‌ها:</b> RSI شاخصی دیرکرد است و در روند قوی می‌تواند مدت‌ها در اشباع بماند. در بورس ایران محدودیت دامنه‌ی نوسان و صف‌های خرید و فروش RSI را زودتر به اشباع می‌برند و ممکن است گمراه‌کننده باشد. قیمت‌ها خام و تعدیل‌نشده‌اند. این لیست فیلتر آماری است و توصیه‌ی خرید یا فروش نیست.</div>'}
// ---------- توضیح کارایی، کاربرد و محدودیت‌ها برای همه‌ی دیده‌بان‌ها به جز «اصلی» ----------
function wlEff(C){if(!C||fpIsMain(C,WL.lists?WL.lists.indexOf(C):-1))return"";
var T={
wp1:["ورود پول","نمادهایی را می‌یابد که فروشنده‌هایشان بیشتر از خریدارها ولی خریدارها درشت‌ترند و قیمت و حجم امروز بالاست؛ الگویی که گاهی نشانه‌ی جمع شدن سهم در دست خریدار بزرگ است.","سریع‌ترین و کم‌هزینه‌ترین ایده‌ی غربال: فقط برای نمادهایی که از فیلتر اولیه رد می‌شوند سابقه‌ی ۶۰ روزه دریافت می‌شود، پس اجرا معمولاً کوتاه است.","«حقیقی/حقوقی» فقط نوع کد معامله‌گر است و نیت یا آگاهی او را نشان نمی‌دهد؛ صندوق‌ها و بازارگردان‌ها هم حقوقی‌اند. شمارش خریدار و فروشنده با چند سفارش درشت عوض می‌شود. نمادهای در صف خرید به‌خاطر حجم کم ممکن است از شرط حجم رد شوند. اعداد در طول روز عوض می‌شوند."],
wp2:["خروج پول","نمادهایی را می‌یابد که حجم امروزشان بالاست ولی قیمت منفی است و سرانه‌ی فروش حقیقی از سرانه‌ی خرید بیشتر است؛ یعنی فروشنده‌ها درشت‌ترند. برای هشدار دادن درباره‌ی نمادهای در حال خالی شدن مفید است.","اجرا مثل «ورود پول» نسبتاً سریع است چون سابقه‌ی حجم فقط برای نمادهای رد شده از فیلتر اولیه گرفته می‌شود.","فروش سنگین همیشه به معنای ادامه‌ی ریزش نیست؛ ممکن است سهم بعد از رشد تازه سود بگیرد. حجم مبنا و میانگین ۳۰ روز اگر نماد تازه عرضه شده باشد کم‌دقت‌اند. اعداد در طول روز عوض می‌شوند."],
kk1:["کد به کد","نمادهایی را می‌یابد که خریدار اصلی حقیقی و فروشنده‌ی اصلی حقوقی است، با شدت بالا. برای دیدن جابه‌جایی سهم از حقوقی به حقیقی مناسب است.","این دیده‌بان سابقه‌ی روزانه نمی‌گیرد و فقط از داده‌ی لحظه‌ای بازار ساخته می‌شود، پس سریع‌ترین لیست است.","فروشنده‌ی حقوقی ممکن است صندوق یا بازارگردانی باشد که به دلیل نیاز نقدینگی یا وظیفه‌ی بازارگردانی می‌فروشد، نه به‌خاطر قصد خروج. آستانه‌ها (۴۰٪ حجم، شدت بالای ۳، ارزش بالای ۱ میلیارد تومان) ثابت‌اند و برای نمادهای کم‌ارزش بسیار سخت‌گیرانه‌اند."],
sm1:["پول هوشمند","نمادهایی را می‌یابد که سرانه‌ی خرید حقیقی‌ها از سرانه‌ی فروششان بیشتر است (بالای ۱٫۵ برابر)، سرانه‌ی خرید بزرگ است (بالای ۵۰ میلیون تومان)، حجم خرید حقیقی از فروش بیشتر است و قیمت آخر بالاتر از پایانی است.","فیلتر روی داده‌ی لحظه‌ای بازار اجرا می‌شود و سابقه‌ی ۶۰ روزه فقط برای نمادهای تأییدشده گرفته می‌شود (برای ستون‌های حجم به ۱۴ روز و ریسک)، پس سریع است.","سرانه‌ی بزرگ می‌تواند از یک یا چند معامله‌ی درشت بیاید و لزوماً به معنای «پول هوشمند» نیست. شرط حجم بالای ۱۰۰ هزار برای نمادهای گران کم‌کار است. ستون ریسک نزدیک ۱۰۰٪ یعنی قیمت روی سقف ۶۰ روز است و ریسک برگشت دارد."],
ci2:["کراس ایچی","نمادهایی را نشان می‌دهد که امروز تنکان از کیجون عبور صعودی کرده است؛ ابزاری ساده برای پیدا کردن شروع روند صعودی کوتاه‌مدت.","سنگین‌ترین لیست: سابقه‌ی ۶۰ روزه‌ی هر نماد معامله‌شده جداگانه گرفته می‌شود، پس اجرای کامل چند دقیقه طول می‌کشد و حجم اینترنت بیشتری می‌برد. فقط ۱۰ نماد اول نمایش داده می‌شود.","ایچیموکو شاخصی دیرکرد است؛ کراس در بازار خنثی یا نوسانی زیاد سیگنال کاذب می‌دهد. کراس زیر ابر ضعیف‌تر از کراس بالای ابر است و این فیلتر ابر را نمی‌سنجد. حجم و ورود پول را هم نگاه نمی‌کند."],
pb1:["پول بک","نمادهایی را نشان می‌دهد که کیجون‌سنشان ۳ روز تخت بوده، امروز کفشان زیر کیجون رفته و آخرین قیمتشان دوباره بالای آن است؛ الگوی برگشت از حمایت در بازار محدوده‌ای.","مثل «کراس ایچی» سنگین است: سابقه‌ی ۶۰ روزه‌ی هر نماد معامله‌شده جداگانه گرفته می‌شود و اجرای کامل چند دقیقه طول می‌کشد. به همین دلیل خودکار فقط یک‌بار اجرا می‌شود و بعد با ▶ دستی بروز می‌شود.","شرط با قیمت‌های لحظه‌ای امروز سنجیده می‌شود و ممکن است تا پایان روز عوض شود. تخت بودن کیجون یعنی بازار در محدوده است؛ شکست محدوده به پایین، پولبک را بی‌اثر می‌کند. روند کلی، حجم و ابر ایچیموکو بررسی نمی‌شوند."],
bo1:["شکست حجمی","نمادهایی را نشان می‌دهد که امروز از بالاترین سقف ۲۰ روز اخیر عبور کرده‌اند و حجمشان دست‌کم دو برابر میانگین ۲۰ روز است؛ ابزاری برای پیدا کردن شکست‌های همراه با حجم.","مثل «کراس ایچی» سنگین است: سابقه‌ی روزانه‌ی نمادهای معامله‌شده‌ی صعودی جداگانه گرفته می‌شود و اجرای کامل ممکن است چند دقیقه طول بکشد. خودکار یک‌بار اجرا می‌شود و بعد با ▶ دستی بروز می‌شود. فقط ۲۰ نماد اول نمایش داده می‌شود.","شکست‌ها بسیار زود به کاذب بودن می‌رسند و قیمت ممکن است تا پایان روز برگردد. سقف ۲۰ روز روی قیمت خام و تعدیل‌نشده حساب می‌شود. آستانه‌ی حجم (۲ برابر) و ارزش (۱ میلیارد تومان) ثابت است. روند کلی و ورود پول بررسی نمی‌شوند."],
hs1:["صنعت‌های داغ","صنعت‌های بورس و فرابورس را از نظر میانگین بازده، ورود پول حقیقی و ارزش معاملات مقایسه می‌کند و پرمعامله‌ترین نماد ۱۵ صنعت برتر را در لیست بالا می‌آورد.","نسبتاً سبک است: فهرست بازار و آمار حقیقی/حقوقی یک‌بار گرفته می‌شود و نام صنعت‌ها فقط بار اول دریافت و در گوشی ذخیره می‌شود. هر ۵ دقیقه که صفحه باز باشد خودکار بروز می‌شود.","میانگین وزنی صنعت با چند نماد بزرگ می‌تواند منحرف شود و ورود پول حقیقی فقط جابه‌جایی کدهای حقیقی را نشان می‌دهد، نه نیت خریدار. صنعت داغ تضمین ادامه‌ی رشد نیست."],
nb1:["حباب NAV","صندوق‌های قابل معامله‌ی امروز را بر پایه‌ی حباب مثبت یا منفی، ارزش خرید (ورود پول حقیقی)، ارزش فروش (خروج پول حقیقی) و ارزش معاملات مرتب می‌کند.","سنگین‌تر از لیست‌های ساده است: NAV هر صندوق جداگانه گرفته می‌شود، ولی تا ۲ دقیقه در گوشی نگه داشته می‌شود تا بروزرسانی‌های بعدی سریع باشند.","NAV صندوق‌ها در طول روز تقریبی است و ممکن است با سایت صندوق فرق داشته باشد. صندوق‌هایی که معامله نشده‌اند یا NAV ندارند در لیست نمی‌آیند. حباب به‌تنهایی دلیل خرید یا فروش نیست."],
fx1:["فیلتر ساز","شرط‌های دلخواه خودتان را انتخاب و با «و» یا «یا» ترکیب می‌کنید؛ نمادهای منطبق به‌صورت دیده‌بان نمایش داده می‌شوند.","بازار یک‌بار دریافت و شرط‌ها روی گوشی بررسی می‌شود. شرط «ورود پول حقیقی» یک درخواست اضافه می‌زند. هر ۵ دقیقه که صفحه باز باشد خودکار بروز می‌شود.","حداکثر ۸۰ نماد با بیشترین ارزش معاملات نمایش داده می‌شود. نتیجه‌ی فیلتر آماری است و توصیه‌ی خرید یا فروش نیست."],sx1:["شاخص ساز","۱۵ نمادی را نشان می‌دهد که امروز بیشترین اثر را روی «شاخص کل بورس» گذاشته‌اند (چه بالا‌برنده، چه پایین‌آورنده). اثر هر نماد از تغییر ارزش بازارش نسبت به ارزش کل بازار بورس و مقدار شاخص دیروز برآورد می‌شود.","نسبتاً سبک است: فهرست بازار یک‌بار گرفته می‌شود و تعداد سهام نمادها فقط بار اول (و بعد از آن هفته‌ای یک‌بار) دریافت و در گوشی ذخیره می‌شود. هر ۵ دقیقه که صفحه باز باشد خودکار بروز می‌شود.","عدد اثر برآوردی است و دقیقاً با عدد سایت بورس برابر نیست: شاخص کل بر پایه‌ی ارزش بازار تعدیل‌شده محاسبه می‌شود و ما فقط ۳۰۰ نماد پرمعامله‌ی بورس را بررسی می‌کنیم. ترتیب نمادها قابل اعتماد است ولی توصیه‌ی خرید یا فروش نیست."],qb1:["صف خرید قوی","نمادهایی را نشان می‌دهد که همین الان در صف خرید هستند و حجم صف خریدشان حداقل برابر میانگین حجم ۳۰ روز و ارزشش بالای ۱ میلیارد تومان است.","سبک است: فقط برای نمادهایی که قیمتشان روی سقف مجاز است تابلو و سابقه گرفته می‌شود. هر ۵ دقیقه که صفحه باز باشد خودکار بروز می‌شود. فقط ۲۰ نماد اول نمایش داده می‌شود.","حجم صف لحظه‌ای است و با لغو سفارش یا فروش سنگین سریع عوض می‌شود. صف قوی تضمین ادامه‌ی صف یا رشد فردا نیست. وقتی بازار بسته است لیست خالی می‌ماند. آستانه‌ها ثابت‌اند."],
gb1:["خرید گروهی","نمادهایی را نشان می‌دهد که همین الان در تابلوی خریدشان خرید گروهی (تعداد زیاد سفارش‌های ریز) دیده می‌شود.","سنگین است: برای هر نماد مثبت تابلو دریافت می‌شود و برای نمادهای دارای تعداد سفارش بالا سابقه‌ی ۳۰ روزه هم گرفته می‌شود؛ اجرای کامل ممکن است چند دقیقه طول بکشد. فقط ۲۰ نماد اول نمایش داده می‌شود.","فقط در ساعت بازار نتیجه می‌دهد. خرید گروهی تضمین رشد قیمت نیست و سفارش‌ها هر لحظه عوض می‌شوند. آستانه‌ها از تنظیمات تحلیل عمق بازار خوانده می‌شود."],
sc1:["سهام کوچک","۲۰ سهم با کمترین ارزش بازار را نشان می‌دهد؛ ارزش بازار = تعداد کل سهام × آخرین قیمت. فقط سهام بورس و فرابورس که امروز معامله شده‌اند (بدون صندوق).","سبک و سریع است و فقط از فهرست لحظه‌ای بازار استفاده می‌کند و سابقه‌ای نمی‌گیرد. هر ۵ دقیقه خودکار تازه می‌شود و با دکمه‌ی ▶ هم می‌توانید دستی تازه‌اش کنید.","سهام کم‌ارزش معمولاً کم‌نقدشونده‌اند، نوسان و ریسک بالایی دارند و با پول کم هم قیمتشان جابه‌جا می‌شود. این لیست فقط یک فیلتر اندازه است و توصیه‌ی خرید نیست."],
gm1:["مستعد خرید گروهی","نمادهایی را نشان می‌دهد که به خرید گروهی نزدیک‌اند: تعداد سفارش خرید در حال انباشته شدن است، سفارش‌ها ریزند و خریدار از فروشنده بیشتر است.","مثل «خرید گروهی» سنگین است و اجرای کامل ممکن است چند دقیقه طول بکشد. فقط ۲۰ نماد اول نمایش داده می‌شود.","فقط در ساعت بازار نتیجه می‌دهد. مستعد بودن پیش‌بینی نیست؛ بسیاری از این نمادها هیچ‌وقت به خرید گروهی نمی‌رسند. آستانه‌ها از تنظیمات تحلیل عمق بازار خوانده می‌شود."],
rs1:["RSI اشباع","نمادهایی را نشان می‌دهد که RSI ۱۴ روزه‌شان کمتر از ۳۰ (اشباع فروش) یا بیشتر از ۷۰ (اشباع خرید) است و حجم امروزشان از میانگین ۲۰ روز کمتر نیست.","سنگین است: سابقه‌ی ۶۵ روزه‌ی نمادهای معامله‌شده جداگانه گرفته می‌شود و اجرای کامل چند دقیقه طول می‌کشد. خودکار یک‌بار اجرا می‌شود و بعد با ▶ دستی بروز می‌شود. حداکثر ۱۵ نماد از هر گروه نمایش داده می‌شود.","RSI شاخصی دیرکرد است و در روند قوی می‌تواند مدت‌ها در اشباع بماند. محدودیت دامنه‌ی نوسان و صف در بورس ایران آن را زودتر به اشباع می‌برد. اشباع فروش لزوماً برگشت نیست و اشباع خرید لزوماً ریزش نیست."]
}[C.flt];
if(!T){if(C.flt)return"";
return'<div class="card" style="padding:8px;margin-top:8px;line-height:2;font-size:12px"><b>توضیح دیده‌بان</b><br><b>این لیست چیست؟</b> فهرستی دستی از نمادهای مورد نظر شما با قیمت لحظه‌ای.<br><b>ستون‌ها:</b> نماد، درصد قیمت پایانی نسبت به دیروز، قیمت پایانی، کندل امروز، آخرین قیمت و درصد آخرین قیمت نسبت به دیروز. رنگ‌ها وضعیت قیمت و تابلوی سفارش‌ها را نشان می‌دهد؛ نماد در صف خرید یا فروش رنگ مخالف نمی‌گیرد.<br><b>کار با لیست:</b> با لمس سربرگ هر ستون لیست مرتب می‌شود. با نگه داشتن ۲ ثانیه‌ی ردیف و کشیدن، جای نماد عوض می‌شود. دکمه‌ی + نماد اضافه می‌کند و ✎ حالت ویرایش (جابه‌جایی و حذف) را باز می‌کند. دکمه‌ی ▦ ستون‌های جدول را انتخاب می‌کند؛ در همین فهرست ستون‌های «حجم تقاضا»، «قیمت تقاضا»، «قیمت عرضه» و «حجم عرضه» را هم می‌توانید جداگانه (در حالت عمودی هم) اضافه کنید. در صفحه‌ی «فیلترها» دکمه‌ی 📌 کنار آن، همان فیلتر را به دیده‌بان اضافه یا از آن برمی‌دارد. دکمه‌ی بازگشت گوشی هر پنجره‌ی بازشده و حالت ویرایش را می‌بندد.<br><b>کارایی و محدودیت‌ها:</b> قیمت‌ها از بورس (TSETMC) گرفته می‌شوند و به‌روز بودنشان به اتصال و لحظه‌ی دریافت بستگی دارد. تا ساعت ۰۸:۴۵ داده‌ها روی جلسه‌ی قبل می‌مانند. این لیست تحلیل یا توصیه‌ی خرید و فروش نیست.</div>'}
return'<div class="card" style="padding:8px;margin-top:8px;line-height:2;font-size:12px"><b>کارایی، کاربرد و محدودیت‌های '+T[0]+'</b><br><b>کاربرد:</b> '+T[1]+'<br><b>سرعت و حجم داده:</b> '+T[2]+'<br><b>محدودیت‌ها و احتیاط:</b> '+T[3]+'<br><b>لمس نمادها:</b> با لمس هر ردیف لیست بالا صفحه‌ی عمق بازار و با لمس هر ردیف جدول «جزئیات» (لیست دوم) صفحه‌ی TSE همان نماد باز می‌شود.<br><b>نکته‌ی کلی:</b> هر دیده‌بان فیلتر آماری است و خروجی آن فقط نقطه‌ی شروع بررسی است، نه توصیه‌ی خرید یا فروش. پیش از تصمیم، چارت، تابلوی سفارش‌ها، حجم و ورود پول را هم ببینید. نتایج با هر اجرا و در طول روز عوض می‌شوند؛ بیش از آستانه‌ها هیچ تضمینی درباره‌ی ادامه‌ی حرکت قیمت وجود ندارد.</div>'}
function ciCfg(C){var c=C.cfg||{};return{mode:c.mode==="all"?"all":"traded",mkt:{bf:1,b:1,f:1,p:1,e:1}[c.mkt]?c.mkt:"bf",n:Math.max(0,+c.n||0)}}
function ciSet(C){var o=document.getElementById("hb");if(o)o.remove();o=document.createElement("div");o.id="hb";
var OP=[["mode","نحوه‌ی نمایش دیده‌بان",[["traded","نمادهای معامله‌شده"],["all","همه‌ی نمادها"]]],["mkt","بازار انتخابی برای نمایش",[["bf","بورس و فرابورس"],["b","بازار بورس"],["f","بازار فرابورس"],["p","بازار پایه"],["e","بورس انرژی"]]]];
function draw(){var cf=ciCfg(C);o.innerHTML='<div class="bx"><b class="t">تنظیمات کراس ایچی</b>'+OP.map(function(g){return'<div style="margin:8px 0"><div style="font-size:13px;margin-bottom:4px">'+g[1]+'</div>'+'<select data-csel="'+g[0]+'" style="width:100%;max-width:none">'+g[2].map(function(v){return'<option value="'+v[0]+'"'+(cf[g[0]]===v[0]?" selected":"")+">"+v[1]+"</option>"}).join("")+"</select>"+'</div>'}).join("")+'<div class="mut" style="font-size:11px;line-height:1.8">فقط سهام بررسی می‌شود و فقط ۱۰ نماد اول لیست نمایش داده می‌شود. بعد از تغییر، «اعمال و اجرا» را بزنید.</div><button type="button" id="cs_ok">اعمال و اجرا</button> <button type="button" id="cs_x">بستن</button></div>'}
draw();o.onchange=function(e){var q=e.target.closest("[data-csel]");if(q){C.cfg=ciCfg(C);C.cfg[q.getAttribute("data-csel")]=q.value;wlSave()}};o.onclick=function(e){var b=e.target.closest("[data-cs]");if(b){var a=b.getAttribute("data-cs").split(":");C.cfg=ciCfg(C);C.cfg[a[0]]=a[1];wlSave();draw();return}
if(e.target.id==="cs_ok"){o.remove();C.cl=0;wpRun(C);return}if(e.target===o||e.target.id==="cs_x")o.remove()};document.body.appendChild(o)}
function ciDetail(C){var it=(C.items||[]).slice(0,10),f=function(v){return cfp(v,1)};
var rows=it.map(function(x,i){return'<tr'+tcA(x)+'><td class="drw">'+(i+1).toLocaleString("fa-IR")+'</td><td style="font-weight:700">'+esc(x.n)+'</td><td>'+f(x.tt)+'</td><td>'+f(x.kt)+'</td><td style="color:var(--up);font-weight:700">'+cfp(x.pc,2)+'</td><td>'+f(x.sy)+'</td></tr>'}).join("");
var tb=it.length?'<div class="sc scv"><table class="stk"><tr><th class="drw">ردیف</th><th>نماد</th><th>تنکان<span class="qm" data-wl="H:i_t">?</span></th><th>کیجون<span class="qm" data-wl="H:i_k">?</span></th><th>فاصله ٪<span class="qm" data-wl="H:i_s">?</span></th><th>دیروز<span class="qm" data-wl="H:i_y">?</span></th></tr>'+rows+'</table></div>':'<div class="mut" style="padding:8px">'+(C.cl?"لیست خالی است.":"نمادی با شرط‌های این فیلتر پیدا نشد.")+'</div>';
return'<div class="card" style="padding:6px;margin-top:8px"><b>جزئیات کراس ایچی<span class="qm" data-wl="H:i_d">?</span></b><div class="mut" style="font-size:11px;line-height:1.8">'+esc(wpMsg(C))+(C.dg?" | "+C.dg:"")+(C.tot>10?" — "+C.tot.toLocaleString("fa-IR")+" نماد مطابق فیلتر؛ ۱۰ مورد اول نمایش داده شده":"")+'</div>'+tb+'</div>'+
'<div class="card" style="padding:8px;margin-top:8px;line-height:2;font-size:12px"><b>توضیح کامل کراس ایچی</b><br>'+
'<b>این لیست چیست؟</b> دیده‌بانی خودکار که از روی کل سهام بازار بورس و فرابورس نمادهایی را پیدا می‌کند که امروز «کراس صعودی ایچیموکو» داده‌اند؛ یعنی خط سریع (تنکان‌سن) از زیر یا برابر خط کند (کیجون‌سن) به بالای آن رفته است.<br>'+
'<b>شرط‌ها:</b> ۱) تنکان‌سن = میانگین بالاترین سقف و پایین‌ترین کف ۹ روز معاملاتی اخیر (با احتساب امروز). ۲) کیجون‌سن = همین محاسبه برای ۲۶ روز. ۳) سیگنال = تنکان − کیجون. نماد وارد لیست می‌شود اگر سیگنال امروز مثبت باشد و سیگنال دیروز صفر یا منفی بوده باشد (کراس همین امروز رخ داده) و حداقل ۲۶ روز معاملاتی سابقه برای محاسبه‌ی دیروز وجود داشته باشد. روزهای بدون معامله شمرده نمی‌شوند. بازار و حالت نمایش (نمادهای معامله‌شده یا همه) از دکمه‌ی چرخ‌دنده (تنظیمات) قابل تغییر است؛ حالت پیش‌فرض «بورس و فرابورس» و «نمادهای معامله‌شده» است. نمادی با کمتر از ۶۰ روز سابقه وارد لیست نمی‌شود. فقط ۱۰ نماد اول (با بیشترین فاصله) نمایش داده می‌شود.<br>'+
'<b>نحوه‌ی چیدن:</b> بر اساس «فاصله ٪» = (تنکان − کیجون) ÷ کیجون؛ بالاتر یعنی حرکت امروز قوی‌تر بوده است.<br>'+
'<b>دکمه‌ها:</b> دکمه‌ی ▶ (اجرای فیلتر) لیست را از نو با قیمت‌های لحظه‌ی بورس می‌سازد (چند دقیقه طول می‌کشد چون سابقه‌ی تک‌تک نمادها دریافت می‌شود). دکمه‌ی پاک‌کن (پاک کردن لیست) همه‌ی نمادهای لیست را حذف می‌کند و تا زمانی که دوباره ▶ را نزنید خودبه‌خود پر نمی‌شود. با «؟» روی هر ستون توضیح همان ستون را می‌بینید.<br>'+
'<b>کاربرد:</b> این لیست برای غربال سریع بازار و پیدا کردن نمادهایی است که شروع تغییر روند به سمت بالا را نشان می‌دهند؛ برای مثال به‌عنوان نقطه‌ی شروع تحلیل بیشتر (چارت، حجم، ورود پول، ابر ایچیموکو). کراس‌هایی که زیر ابر ایچیموکو رخ می‌دهند معمولاً ضعیف‌ترند و کراس بالای ابر قوی‌تر است.<br>'+
'<b>نکته‌ها:</b> محاسبه روی قیمت‌های خام و تعدیل‌نشده‌ی بورس انجام می‌شود (افزایش سرمایه یا سود نقدی روی سقف و کف تأثیر دارد) و امروز با قیمت‌های لحظه‌ای تا همین الان حساب می‌شود، پس ممکن است تا پایان روز تغییر کند. این لیست فیلتر آماری است و توصیه‌ی خرید یا فروش نیست.</div>'+'<div class="card" style="padding:8px;margin-top:8px;line-height:2;font-size:12px"><b>معنی واژه‌های جدول</b><br><b>نماد:</b> نام سهمی که امروز کراس صعودی داده است.<br>'+["i_t","i_k","i_s","i_y"].map(function(k){return'<b>'+WLH[k][0]+':</b> '+WLH[k][1]}).join("<br>")+'</div>'}

var WLH={bo_d:["جزئیات شکست حجمی","نمادهایی که امروز از بالاترین سقف ۲۰ روز معاملاتی قبل عبور کرده‌اند و حجمشان حداقل ۲ برابر میانگین ۲۰ روز است. از بیشترین «حجم×» به کمترین مرتب شده‌اند. لمس هر ردیف صفحه‌ی TSE آن نماد را باز می‌کند. این لیست فیلتر آماری است و توصیه‌ی خرید یا فروش نیست."],
bo_v:["حجم×","حجم امروز ÷ میانگین حجم ۲۰ روز معاملاتی قبل. مثلاً ×۳ یعنی امروز سه برابر حجم معمول معامله شده است. شرط فیلتر این است که حداقل ۲ باشد."],
bo_b:["شکست ٪","(آخرین قیمت − سقف ۲۰ روز) ÷ سقف ۲۰ روز × ۱۰۰. هر چه بیشتر باشد، قیمت بیشتر از مقاومت قبلی بالا رفته است و هر چه کمتر باشد شکست تازه‌تر است."],
bo_h:["سقف ۲۰ روز","بالاترین قیمت معامله‌شده در ۲۰ روز معاملاتی قبل از امروز (به ریال). قیمت‌ها خام و تعدیل‌نشده‌اند."],
hs_d:["جزئیات صنعت‌های داغ","میانگین بازده و ورود پول هر صنعت بر پایه‌ی کل بورس و فرابورس. با لمس عنوان ستون‌ها ترتیب عوض می‌شود لمس نام صنعت فهرست نمادهای آن را باز می‌کند و لمس بقیه‌ی ردیف صفحه‌ی TSE پرمعامله‌ترین نماد آن صنعت را."],hs_p:["درصد","میانگین درصد تغییر آخرین قیمت نمادهای صنعت نسبت به پایانی دیروز، وزن‌دهی‌شده با ارزش معاملات هر نماد."],hs_f:["ورود پول","مجموع (خرید − فروش) حقیقی × قیمت نمادهای صنعت، به میلیارد تومان. مثبت یعنی پول حقیقی وارد صنعت شده و منفی یعنی خارج شده."],hs_v:["ارزش","مجموع ارزش معاملات امروز نمادهای صنعت، به میلیارد تومان."],hs_u:["▲/▼","تعداد نمادهای مثبت (سبز) و منفی (قرمز) در صنعت."],hs_t:["نماد برتر","پرمعامله‌ترین نماد صنعت از نظر ارزش معاملات امروز؛ در لیست بالا هم همین نماد نشان داده می‌شود."],hs_b:["سرانه خرید","میانگین ارزش خرید هر خریدار حقیقی در نمادهای صنعت، به میلیون تومان."],hs_s:["سرانه فروش","میانگین ارزش فروش هر فروشنده‌ی حقیقی در نمادهای صنعت، به میلیون تومان."],hs_q:["قدرت","سرانه خرید تقسیم بر سرانه فروش. بالای ۱ (سبز) یعنی خریدارها درشت‌تر از فروشنده‌ها هستند."],
nb_d:["جزئیات حباب NAV","صندوق‌های قابل معامله‌ی معامله‌شده‌ی امروز با حباب، NAV، ارزش معاملات و ورود پول حقیقی. با دکمه‌های بالای جدول بر پایه‌ی حباب مثبت، حباب منفی، ارزش خرید، ارزش فروش یا ارزش معاملات مرتب می‌شود."],nb_b:["حباب ٪","(آخرین قیمت ÷ NAV − ۱) × ۱۰۰. مثبت یعنی قیمت بازار بالاتر از NAV و منفی یعنی پایین‌تر از NAV."],nb_n:["NAV","ارزش خالص دارایی هر واحد صندوق (ریال) که از بورس گرفته می‌شود و در طول روز تقریبی است."],nb_p:["آخرین","آخرین قیمت معامله‌ی صندوق (ریال)."],nb_v:["ارزش معاملات","ارزش کل معاملات امروز صندوق، به میلیارد تومان."],nb_f:["ورود پول","(خرید حقیقی − فروش حقیقی) × قیمت، به میلیارد تومان. مثبت یعنی ورود پول حقیقی (ارزش خرید بیشتر) و منفی یعنی خروج پول (ارزش فروش بیشتر)."],
sx_d:["جزئیات شاخص ساز","۱۵ نماد بورس که بیشترین اثر مثبت یا منفی را روی شاخص کل دارند، از بیشترین اثر (بدون توجه به علامت) به کمترین. لمس هر ردیف صفحه‌ی TSE آن نماد را باز می‌کند."],sx_i:["اثر در شاخص","برآورد تغییری که این نماد امروز در عدد شاخص کل ایجاد کرده است: (تغییر ارزش بازار نماد ÷ ارزش کل بازار بورس) × شاخص دیروز. سبز یعنی شاخص را بالا برده و قرمز یعنی پایین آورده."],sx_p:["درصد قیمت","درصد تغییر آخرین قیمت امروز نسبت به قیمت پایانی دیروز."],sx_m:["ارزش بازار","آخرین قیمت × تعداد کل سهام، به هزار میلیارد تومان. نمادهای بزرگ‌تر با تغییر قیمت کوچک هم می‌توانند اثر زیادی داشته باشند."],qb_d:["جزئیات صف خرید قوی","نمادهایی که همین الان در صف خرید هستند و حجم صفشان حداقل برابر میانگین حجم ۳۰ روز و ارزشش بیش از ۱ میلیارد تومان است. از بیشترین «صف÷میانگین» به کمترین مرتب شده‌اند. لمس هر ردیف صفحه‌ی TSE آن نماد را باز می‌کند. این لیست فیلتر آماری است و توصیه‌ی خرید یا فروش نیست."],
qb_q:["حجم صف","تعداد سهم در صف خرید (بهترین سطح تابلو). K یعنی هزار و M یعنی میلیون."],
qb_v:["ارزش صف","حجم صف × قیمت صف، به میلیارد تومان. شرط فیلتر این است که بیشتر از ۱ باشد."],
qb_r:["صف÷میانگین","حجم صف خرید ÷ میانگین حجم ۳۰ روز معاملاتی قبل. ×۲ یعنی صف دو برابر یک روز معامله‌ی معمولی است. شرط فیلتر این است که حداقل ۱ باشد."],
qb_x:["حجم×","حجم امروز ÷ میانگین حجم ۳۰ روز معاملاتی قبل."],
rs_d:["جزئیات RSI اشباع","نمادهایی که RSI ۱۴ روزه‌شان ≤ ۳۰ (اشباع فروش) یا ≥ ۷۰ (اشباع خرید) است و حجم امروزشان حداقل برابر میانگین ۲۰ روز است. اول اشباع فروش و بعد اشباع خرید چیده شده‌اند. لمس هر ردیف صفحه‌ی TSE آن نماد را باز می‌کند. این لیست فیلتر آماری است و توصیه‌ی خرید یا فروش نیست."],
rs_r:["RSI","شاخص قدرت نسبی ۱۴ روزه (روش وایلدر) روی قیمت پایانی: ۱۰۰ − ۱۰۰ ÷ (۱ + میانگین سود ÷ میانگین ضرر). زیر ۳۰ یعنی افت تند و بالای ۷۰ یعنی رشد تند."],
rs_s:["وضعیت","اشباع فروش: RSI ≤ ۳۰ و اشباع خرید: RSI ≥ ۷۰. اشباع به معنای برگشت قطعی نیست و در روند قوی می‌تواند ادامه پیدا کند."],
rs_x:["حجم×","حجم امروز ÷ میانگین حجم ۲۰ روز معاملاتی قبل. شرط فیلتر این است که حداقل ۱ باشد."],
i_d:["جزئیات کراس ایچی","نمادهایی که امروز تنکان‌سن (۹ روزه) از زیر، کیجون‌سن (۲۶ روزه) را به سمت بالا قطع کرده‌اند. اعداد از آخرین اجرای فیلتر هستند و لیست از بیشترین فاصله‌ی تنکان از کیجون به کمترین مرتب شده است. این لیست فیلتر آماری است و توصیه‌ی خرید یا فروش نیست."],
i_t:["تنکان‌سن","میانگین بالاترین سقف و پایین‌ترین کف ۹ روز معاملاتی اخیر (شامل امروز)؛ خط سریع ایچیموکو که زود به حرکت قیمت واکنش می‌دهد. قیمت‌ها به ریال هستند."],
i_k:["کیجون‌سن","میانگین بالاترین سقف و پایین‌ترین کف ۲۶ روز معاملاتی اخیر (شامل امروز)؛ خط کندِ ایچیموکو که روند میان‌مدت را نشان می‌دهد."],
i_s:["فاصله ٪","(تنکان امروز − کیجون امروز) ÷ کیجون امروز × ۱۰۰. عدد مثبت یعنی تنکان بالای کیجون است. هر چه کوچک‌تر باشد کراس تازه‌تر و هر چه بزرگ‌تر باشد حرکت قوی‌تر (یا دیرتر دیده شده) است."],
i_y:["سیگنال دیروز","تنکان دیروز − کیجون دیروز (به ریال). شرط کراس این است که این عدد صفر یا منفی باشد، یعنی دیروز تنکان هنوز بالای کیجون نبوده است."],
nm:["نماد","نام نماد در دیده‌بان. با لمس هر ردیف لیست بالا، صفحه‌ی عمق بازار همان نماد باز می‌شود؛ در لیست‌های فیلتر، با لمس هر ردیف جدول جزئیات (لیست دوم) صفحه‌ی TSE آن نماد باز می‌شود."],
pl:["درصد آخرین قیمت","درصد تغییر آخرین قیمت معامله‌شده نسبت به قیمت دیروز. سبز یعنی مثبت و قرمز یعنی منفی."],
lp:["آخرین قیمت","آخرین قیمتی که روی نماد معامله شده است. رنگ سبز یا قرمز نسبت به قیمت دیروز است. زیر عدد، حجم سرخط (بهترین صف) با نوار رنگی نشان داده می‌شود."],
cd:["کندل روز","کندل کوچک امروز: خط وسط قیمت دیروز است، بدنه از قیمت اولین معامله تا آخرین قیمت کشیده می‌شود و فتیله‌ها بالاترین و پایین‌ترین قیمت روز را نشان می‌دهند."],
cp:["قیمت پایانی","میانگین وزنی قیمت معاملات روز (قیمت پایانی). اگر از آخرین قیمت کمتر باشد یعنی معاملات اخیر بالاتر از میانگین روز انجام شده است. زیر عدد، حجم سرخط فروش نشان داده می‌شود."],
pc:["درصد قیمت پایانی","درصد تغییر قیمت پایانی نسبت به قیمت دیروز."],
dt:["جزئیات ورود پول","نمادهای این لیست از بیشترین ورود پول حقیقی به کمترین مرتب شده‌اند. اعداد از آخرین اجرای فیلتر بورس هستند و هر ۵ دقیقه که صفحه باز باشد دوباره ساخته می‌شوند. این لیست فیلتر آماری است و توصیه‌ی خرید یا فروش نیست."],
in:["ورود پول حقیقی","(حجم خرید حقیقی − حجم فروش حقیقی) × قیمت پایانی، به میلیارد تومان. مثبت یعنی پول حقیقی وارد نماد شده و هر چه بزرگ‌تر باشد ورود پول بیشتر است."],
pw:["قدرت خریدار حقیقی","میانگین حجم هر خریدار حقیقی ÷ میانگین حجم هر فروشنده‌ی حقیقی. عدد بالای ۱ یعنی خریدارها درشت‌تر از فروشنده‌ها هستند."],
vr:["حجم به میانگین","حجم امروز ÷ میانگین حجم روزهای پرحجم ۶۰ روز گذشته. مثلاً ×۲ یعنی امروز دو برابر یک روز پرحجم معمول معامله شده است. شرط فیلتر این است که این عدد بیشتر از ۱ باشد."],
cn:["تعداد خریدار / فروشنده","تعداد کدهای خریدار به تعداد کدهای فروشنده (حقیقی و حقوقی روی هم) در امروز."],
kp:["نسبت فروشنده به خریدار","تعداد فروشنده ÷ تعداد خریدار. شرط فیلتر این است که بیشتر از ۱٫۳ باشد؛ یعنی خریدارها کم‌تعداد ولی درشت‌اند و سهم در دست تعداد کمتری جمع می‌شود."]};
function wlHelp(k){var h=WLH[k];if(!h)return;var o=document.getElementById("hb");if(o)o.remove();o=document.createElement("div");o.id="hb";
o.innerHTML='<div class="bx"><b class="t">'+esc(h[0])+'</b><div style="line-height:2;font-size:13px;margin:6px 0">'+esc(h[1])+'</div><button type="button" id="wh_x">بستن</button></div>';
o.onclick=function(e){if(e.target===o||e.target.id==="wh_x")o.remove()};document.body.appendChild(o)}
function wlSave(){try{localStorage.setItem("wl4",JSON.stringify({l:WL.lists,c:(typeof FP!=="undefined"&&FP.o)?FP.gc:WL.cur}))}catch(e){}}
function wlFlLoad(){try{return JSON.parse(localStorage.getItem("wlfl1")||"{}")||{}}catch(e){return{}}}
function wlFlSave(){try{var o={};for(var k in WL.fl)if(WL.fl[k]>0)o[k]=WL.fl[k];localStorage.setItem("wlfl1",JSON.stringify(o))}catch(e){}}
async function getFloat(c){var I=JSON.parse(await GET(TS+"Instrument/GetInstrumentInfo/"+c)),f=findNum(I,[/float|shenavar|شناور/i],0);if(f>0&&f<=100)return f;
try{var H=JSON.parse(await GET(TS+"Shareholder/GetInstrumentShareHolderLast/"+c)),a=firstArr(H.shareShareHolder||H),sm=0;a.forEach(function(r){var q=num(r.perOfShares!=null?r.perOfShares:(r.sharePercent!=null?r.sharePercent:r.percent));if(q>=5)sm+=q});if(sm>0&&sm<100)return Math.round((100-sm)*10)/10}catch(e){}return null}
function wlSortFl(){var C=wlCur();if(!C||C.flt!=="fl1"||WL.edit||WL.sk)return;var ks=C.items.map(function(x,i){return[x,i]});ks.sort(function(a,b){var u=WL.fl[a[0].c],v=WL.fl[b[0].c];u=u>0?u:1e9;v=v>0?v:1e9;return u-v||a[1]-b[1]});C.items=ks.map(function(k){return k[0]});wlSave()}
async function wlMig(){var ch=false;var n0=WL.lists.length;WL.lists=WL.lists.filter(function(l){return l.name!=="طلا"&&l.name!=="درآمد ثابت"&&l.name!=="شناوری"&&l.name!=="پردرآمد"&&l.flt!=="fl1"&&l.flt!=="rv1"&&l.flt!=="ic3"});if(WL.lists.length!==n0){ch=true;WL.cur=Math.max(0,Math.min(WL.cur,WL.lists.length-1))}
WL.lists.forEach(function(l){if(l.name==="شاخص"){l.name="اصلی";ch=true}});
try{if(!localStorage.getItem("wp1m")){localStorage.setItem("wp1m","1");if(!WL.lists.some(function(l){return l.flt==="wp1"})){WL.lists.push({name:"ورود پول",flt:"wp1",items:[]});ch=true}}}catch(e){}
try{if(!localStorage.getItem("ci2m")){localStorage.setItem("ci2m","1");if(!WL.lists.some(function(l){return l.flt==="ci2"})){WL.lists.push({name:"کراس ایچی",flt:"ci2",items:[]});ch=true}}}catch(e){}
try{if(!localStorage.getItem("pb1m")){localStorage.setItem("pb1m","1");if(!WL.lists.some(function(l){return l.flt==="pb1"})){var ix6=WL.lists.findIndex(function(l){return l.flt==="ci2"});ix6=ix6>=0?ix6+1:WL.lists.length;WL.lists.splice(ix6,0,{name:"پول بک",flt:"pb1",items:[]});if(WL.cur>=ix6)WL.cur++;ch=true}}}catch(e){}
try{if(!localStorage.getItem("wp2m")){localStorage.setItem("wp2m","1");if(!WL.lists.some(function(l){return l.flt==="wp2"})){var ix=WL.lists.findIndex(function(l){return l.flt==="wp1"});ix=ix>=0?ix+1:WL.lists.length;WL.lists.splice(ix,0,{name:"خروج پول",flt:"wp2",items:[]});if(WL.cur>=ix)WL.cur++;ch=true}}}catch(e){}
try{if(!localStorage.getItem("kk1m")){localStorage.setItem("kk1m","1");if(!WL.lists.some(function(l){return l.flt==="kk1"})){var ix2=WL.lists.findIndex(function(l){return l.flt==="wp2"});ix2=ix2>=0?ix2+1:WL.lists.length;WL.lists.splice(ix2,0,{name:"کد به کد",flt:"kk1",items:[]});if(WL.cur>=ix2)WL.cur++;ch=true}}}catch(e){}
try{if(!localStorage.getItem("fx1m")){localStorage.setItem("fx1m","1");if(!WL.lists.some(function(l){return l.flt==="fx1"})){WL.lists.push({name:"فیلتر ساز",flt:"fx1",items:[],fx:{m:"and",mk:"b",c:[]}});ch=true}}}catch(e){}
try{if(!localStorage.getItem("sx1m")){localStorage.setItem("sx1m","1");if(!WL.lists.some(function(l){return l.flt==="sx1"})){var ixs=WL.lists.length?1:0;WL.lists.splice(ixs,0,{name:"شاخص ساز",flt:"sx1",items:[]});if(WL.cur>=ixs)WL.cur++;ch=true}}}catch(e){}
[["hs1","صنعت‌های داغ"],["nb1","حباب NAV"]].forEach(function(z){try{if(!localStorage.getItem(z[0]+"m")){localStorage.setItem(z[0]+"m","1");if(!WL.lists.some(function(l){return l.flt===z[0]})){var iq=WL.lists.findIndex(function(l){return l.flt==="sx1"}),ip=WL.lists.findIndex(function(l){return l.flt==="hs1"});var at=z[0]==="nb1"&&ip>=0?ip+1:(iq>=0?iq+1:(WL.lists.length?2:0));WL.lists.splice(at,0,{name:z[1],flt:z[0],items:[]});if(WL.cur>=at)WL.cur++;ch=true}}}catch(e){}});
try{if(!localStorage.getItem("sm1m")){localStorage.setItem("sm1m","1");if(!WL.lists.some(function(l){return l.flt==="sm1"})){var ix3=WL.lists.findIndex(function(l){return l.flt==="wp2"});ix3=ix3>=0?ix3+1:WL.lists.length;WL.lists.splice(ix3,0,{name:"پول هوشمند",flt:"sm1",items:[]});if(WL.cur>=ix3)WL.cur++;ch=true}}}catch(e){}
[["bo1","شکست حجمی"],["qb1","صف خرید قوی"],["rs1","RSI اشباع"],["gb1","خرید گروهی"],["sc1","سهام کوچک"]].forEach(function(z){try{if(!localStorage.getItem(z[0]+"m")){localStorage.setItem(z[0]+"m","1");if(!WL.lists.some(function(l){return l.flt===z[0]})){WL.lists.push({name:z[1],flt:z[0],items:[]});ch=true}}}catch(e){}});
WL.lists.forEach(function(l){if(l.flt==="ci2"&&l.name!=="کراس ایچی"){l.name="کراس ایچی";ch=true}if(l.flt==="wp1"&&l.name!=="ورود پول"){l.name="ورود پول";ch=true}});
try{if(!localStorage.getItem("nx1m")){localStorage.setItem("nx1m","1");localStorage.setItem("nx2m","1");localStorage.setItem("nx4m","1");localStorage.setItem("nx6m","1");if(nxAdd(WL.lists,NX_ORDER.filter(function(k){return!NX[k].vip})))ch=true}}catch(e){}
try{if(!localStorage.getItem("nx2m")){localStorage.setItem("nx2m","1");if(nxAdd(WL.lists,NX2_ORDER))ch=true}}catch(e){}
try{if(!localStorage.getItem("nx9m")){localStorage.setItem("nx9m","1");var cu9=WL.lists[WL.cur];if(nxAddTop(WL.lists,NX5_ORDER)){ch=true;WL.cur=Math.max(0,WL.lists.indexOf(cu9))}}}catch(e){}
try{if(!localStorage.getItem("nx8m")){localStorage.setItem("nx8m","1");var RN={vcp1:["VCP (انقباض نوسان)","الگوی VCP"],bq5:["تقاضای سنگین (۵ ردیف خرید)","تقاضای سنگین"],kc1:["عبور از ابر ایچیموکو","عبور از ابر"],lr1:["برگشت از کف مجاز","برگشت از کف"],cap1:["ظرفیت ورود سرمایه","ظرفیت سرمایه"],fq1:["صف خرید شکننده","صف شکننده"],mq1:["صف‌های چندروزه","صف چندروزه"]};
WL.lists.forEach(function(l){var z=RN[l.flt];if(z&&l.name===z[0]){l.name=z[1];ch=true}});var cu8=WL.lists[WL.cur];if(nxAddTop(WL.lists,["sm2"]))ch=true;if(nxAdd(WL.lists,["rq1"]))ch=true;WL.cur=Math.max(0,WL.lists.indexOf(cu8))}}catch(e){}
try{if(!localStorage.getItem("nx7m")){localStorage.setItem("nx7m","1");var cu7=WL.lists[WL.cur];if(nxAddTop(WL.lists,["lc1"])){ch=true;WL.cur=Math.max(0,WL.lists.indexOf(cu7))}}}catch(e){}
try{if(!localStorage.getItem("nx6m")){localStorage.setItem("nx6m","1");if(nxAdd(WL.lists,["bq5"]))ch=true}}catch(e){}
