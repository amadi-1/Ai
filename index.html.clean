var APPV="2.1";
var ISWEB=!!window.__WEB||(!window.Android&&/^https?:/.test(location.protocol));
var PLAT=ISWEB?"web":"android";
var API="";
var SID="";try{SID=localStorage.getItem("sid")||"";if(!SID){SID=Date.now().toString(36)+Math.random().toString(36).slice(2,10);localStorage.setItem("sid",SID)}}catch(e){}
