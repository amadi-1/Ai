var MS={l:null,t:0,run:0,err:0,f:"a",q:"",op:{},ph:""};
function msPick(r,rx){for(var k in r){if(rx.test(k)&&r[k]!=null&&String(r[k]).trim())return r[k]}return""}
function msRows(j){return firstArr(j).map(function(r){var d=num(msPick(r,/^dEven$|date/i)),t=num(msPick(r,/^hEven$|time/i)),tt=ar(String(msPick(r,/title/i)||"")).trim(),ds2=ar(String(msPick(r,/desc|text|body/i)||"")).trim(),fl=num(msPick(r,/flow/i)),id=msPick(r,/idn|^id$/i);return{d:d,t:t,tt:tt,ds:ds2,fl:fl,id:String(id||(d+"-"+t+"-"+tt))}}).filter(function(x){return x.tt||x.ds})}
async function msLoad(force){if(MS.run||(!force&&MS.l&&Date.now()-MS.t<60000))return;MS.run=1;var L=[];
 try{L=msRows(JSON.parse(await GET(TS+"Msg/GetMsgByFlow/0/100")))}catch(e){}
 if(!L.length){await Promise.all([1,2].map(async function(f){try{msRows(JSON.parse(await GET(TS+"Msg/GetMsgByFlow/"+f+"/60"))).forEach(function(x){if(!x.fl)x.fl=f;L.push(x)})}catch(e){}}))}
 var seen={};L=L.filter(function(x){if(seen[x.id])return false;seen[x.id]=1;return true}).sort(function(a,b){return(b.d-a.d)||(b.t-a.t)});
 if(L.length){MS.l=L;MS.err=0}else if(!MS.l)MS.err=1;MS.t=Date.now();MS.run=0;if(tab==="i"&&IG.t==="p")msPaint()}
function msWhen(d,t){var s="";if(d>19000101){try{s=new Date(Math.floor(d/1e4),Math.floor(d/100)%100-1,d%100).toLocaleDateString("fa-IR")}catch(e){}}if(t>0){var hh=Math.floor(t/1e4),mm=Math.floor(t/100)%100;s+=(s?" — ":"")+(hh<10?"0":"")+hh+":"+(mm<10?"0":"")+mm}return s.replace(/\d/g,function(c){return"۰۱۲۳۴۵۶۷۸۹"[c]})}
function msList(){if(!MS.l)return'<div class="mut" style="padding:10px;text-align:center">'+(MS.err?"پیام‌ها دریافت نشد؛ اینترنت را بررسی کنید.":"در حال دریافت پیام‌های ناظر…")+'</div>';
 var q=nz(MS.q),L=MS.l.filter(function(x){if(MS.f==="b"&&x.fl&&x.fl!==1)return false;if(MS.f==="f"&&x.fl&&x.fl!==2)return false;return!q||nz(x.tt+" "+x.ds).indexOf(q)>=0});
 if(!L.length)return'<div class="mut" style="padding:10px;text-align:center">پیامی پیدا نشد.</div>';
 return L.slice(0,100).map(function(x){return'<div class="msg1'+(MS.op[x.id]?" op":"")+'" data-msi="'+esc(x.id)+'"><div class="msgt">'+esc(x.tt||"پیام ناظر")+'</div><div class="msgd">'+msWhen(x.d,x.t)+(x.fl===1?" · بورس":(x.fl===2?" · فرابورس":""))+'</div><div class="msgb">'+esc(x.ds)+'</div></div>'}).join("")}
function msPaint(){var b=document.getElementById("igb");if(!b)return;if(!document.getElementById("msgl")){var f=function(v,l){return'<button type="button" data-msf="'+v+'"'+(MS.f===v?' class="on"':'')+'>'+l+'</button>'};
  b.innerHTML='<div><div class="mmbar">'+f("a","همه")+f("b","بورس")+f("f","فرابورس")+'<button type="button" data-msr="1" style="margin-right:auto">↻</button></div><input id="msgq" placeholder="جستجو در پیام‌ها (نام نماد یا متن)" value="'+esc(MS.q)+'"><div class="mut" style="font-size:11px;margin-top:4px">پیام‌های ناظر بازار (TSETMC)؛ برای دیدن متن کامل روی عنوان هر پیام بزنید.</div></div><div class="card" id="msgl" style="padding:4px 10px"></div>';MS.ph=""}
 var h=msList();if(h!==MS.ph){MS.ph=h;document.getElementById("msgl").innerHTML=h}msLoad()}
document.getElementById("v").addEventListener("click",function(e){if(tab!=="i"||!e.target.closest)return;var t=e.target;
 var c=t.closest("[data-mmc]");if(c){openDepth(c.getAttribute("data-mmc"),c.getAttribute("data-mmn"));return}
