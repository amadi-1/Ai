try{localStorage.setItem("c1:"+u,v)}catch(e){ccPrune();try{localStorage.setItem("c1:"+u,v)}catch(e2){}}}
// before 08:45 everything (prices, candles, charts, order books, money flow) stays frozen on the last session's data
function GET(url){var live=ccLive(url);
if(live&&preOpen()){var c=ccGet(url);if(c!==null)return Promise.resolve(c)}
return GET0(url).then(function(b){if(live&&!preOpen())ccSave(url,b);else if(!live)ccSave(url,b,1);try{localStorage.setItem("lastok",String(Date.now()))}catch(e){}return b})}
