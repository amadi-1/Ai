mkKV("سقف تاریخی ("+jtxt(o.hi.k)+")","$"+f1(o.hi.r,2)+" <small>("+(dh>0?"+":"−")+f1(Math.abs(dh),1)+"٪ تا امروز)</small>")+
mkKV("کف تاریخی ("+jtxt(o.lo.k)+")","$"+f1(o.lo.r,2)+" <small>("+(dl>0?"+":"−")+f1(Math.abs(dl),1)+"٪ تا امروز)</small>")+'</div>'}

