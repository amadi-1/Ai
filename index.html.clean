'<div id="mkc_m" class="mut" style="font-size:12px;min-height:16px"></div><div class="mut" style="font-size:11.5px;line-height:1.9">قیمت را از فهرست tgju انتخاب کنید (مثلاً «دلار کانادا» یا «طلای ۱۸ عیار») و نام و واحد را بنویسید. واحد «تومان» یعنی عدد tgju (ریال) تقسیم بر ۱۰. فهرست بعد از اولین دریافت قیمت‌ها ساخته می‌شود.</div></div>';
return'<div class="card mkc" id="mkc">'+add+'<div style="margin-top:12px;border-top:1px solid var(--ln);padding-top:10px"><b>ویرایش قیمت‌های لحظه‌ای</b><div class="mut" style="font-size:11.5px;line-height:1.9">ردیف‌های جدول «قیمت‌ها» در بالای همین صفحه را ویرایش، جابه‌جا، حذف یا اضافه کنید.</div>'+
vis.map(function(r,i){return'<div class="rw"><span class="n">'+esc(r.n)+(r.cust?' <small class="mut">('+esc(tgFa(r.key))+')</small>':'')+'</span><button type="button" data-mkc="e:'+r.id+'">✎</button><button type="button" data-mkc="u:'+r.id+'"'+(i?'':' disabled')+'>▲</button><button type="button" data-mkc="d:'+r.id+'"'+(i<vis.length-1?'':' disabled')+'>▼</button><button type="button" class="x" data-mkc="x:'+r.id+'">✕</button></div>'}).join("")+
(hid.length?'<div class="mut" style="margin-top:8px;font-size:12px">ردیف‌های حذف‌شده (برای بازگرداندن بزنید):</div><div>'+hid.map(function(r){return'<span class="chip" data-mkc="r:'+r.id+'">+ '+esc(r.n)+'</span>'}).join("")+'</div>':'')+
'<div style="text-align:center;margin-top:6px"><button type="button" data-mkc="rs">بازگشت جدول به حالت اولیه</button></div></div></div>'}
function mkcRefresh(){if(tab==="m"){MK.ph="";mkPaint();return}var e=document.getElementById("mkc");if(e){var t=document.createElement("div");t.innerHTML=mkcCard();e.replaceWith(t.firstChild)}}
document.addEventListener("click",function(e){var b=e.target.closest&&e.target.closest("[data-mkc]");if(!b||(tab!=="s"&&tab!=="m"))return;var a=b.getAttribute("data-mkc"),c=mkcGet(),m=/^([eudxr]):(.+)$/.exec(a),id=m&&m[2],k=m&&m[1];
