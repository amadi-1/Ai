function ccPrune(){try{var ks=[],i,k,t;for(i=0;i<localStorage.length;i++){k=localStorage.key(i);if(k&&k.indexOf("c1:")===0){t=0;try{t=JSON.parse(localStorage.getItem(k)).t}catch(e){}ks.push([k,t])}}
