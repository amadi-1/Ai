function mkcRows(){var c=mkcGet(),all=MKD.map(function(d){return{id:d[0],n:c.nm[d[0]]||d[1],k:d[2],get:d[3],dg:d[4],std:1}}).concat(c.a.map(function(a){return{id:a.id,n:a.n,k:a.u,key:a.k,cust:1}}));
all.forEach(function(r,i){r.i=i;r.hid=c.h.indexOf(r.id)>=0;var p=c.o.indexOf(r.id);r.p=p>=0?p:1e4+i});
return all.sort(function(a,b){return a.p-b.p})}
