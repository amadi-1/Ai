function jkey(g){var d=Math.floor(g/1e4),m=Math.floor(g/100)%100,dd=g%100;if(!MJF)MJF=new Intl.DateTimeFormat("en-US-u-ca-persian-nu-latn",{year:"numeric",month:"numeric",day:"numeric"});
var p={};MJF.formatToParts(new Date(d,m-1,dd,12)).forEach(function(x){p[x.type]=x.value});return(+(p.year||p.relatedYear))*10000+(+p.month)*100+(+p.day)}
