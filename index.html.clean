// ---------- صفحه‌ی «گفتگو»: تیکت پشتیبانی + پیام‌رسان‌ها ----------
var TKS=["پشتیبانی فنی","گزارش خطا","پیشنهاد و انتقاد","آموزش و راهنمایی","اشتراک و پرداخت","همکاری و تبلیغات","سایر"];
var TKST={open:["در انتظار پاسخ","#ef6c00"],answered:["پاسخ داده شد","#1b7a3a"],closed:["بسته شده","#6b7a74"]};
var TK={sub:"",list:[],open:"",err:"",ok:"",busy:false,name:"",phone:""};
try{TK.list=JSON.parse(localStorage.getItem("tk1"))||[];var _tp=JSON.parse(localStorage.getItem("tkp")||"{}");TK.name=_tp.n||"";TK.phone=_tp.p||""}catch(e){}
function tkSave(){try{localStorage.setItem("tk1",JSON.stringify(TK.list));localStorage.setItem("tkp",JSON.stringify({n:TK.name,p:TK.phone}))}catch(e){}}
function tkT(t){try{return new Date(t).toLocaleString("fa-IR",{month:"long",day:"numeric",hour:"2-digit",minute:"2-digit"})}catch(e){return""}}
function tkUnread(x){return x.st==="answered"&&(x.seen||0)<(x.up||0)}
function tkDot(){var b=document.querySelector('[data-t="t"]'),n=TK.list.filter(tkUnread).length;if(b)b.classList.toggle("dot",n>0);try{window.dispatchEvent(new CustomEvent("sinotk",{detail:n}))}catch(e){}}
async function tkSync(){return;try{var r=await apiPost("/api/tickets/lookup",{items:TK.list.map(function(x){return[x.id,x.k]})});
(r.items||[]).forEach(function(t){TK.list.forEach(function(x){if(x.id===t.id){x.st=t.status;x.up=t.lastAdminAt||0;x.at=t.updatedAt;x.msgs=t.messages;x.code=t.code;x.sub=t.subject}})});
if(TK.open){var o=TK.list.filter(function(x){return x.id===TK.open})[0];if(o)o.seen=o.up||0}
tkSave();tkDot();if(tab==="t")tkPaint()}catch(e){}}
function tkThread(x){var m=x.msgs||[];return'<div class="tkth">'+m.map(function(q){var me=q.from!=="admin";return'<div class="tkm '+(me?"tkme":"tkad")+'"><div class="tkmb">'+(me?"":'<div class="tkwho">پشتیبانی سینو بورس</div>')+esc(q.text).replace(/\n/g,"<br>")+'<div class="tkmt">'+tkT(q.at)+'</div></div></div>'}).join("")+'</div>'+
(x.st==="closed"?'<div class="mut" style="text-align:center;padding:6px">این تیکت بسته شده است؛ برای موضوع جدید تیکت تازه ثبت کنید.</div>':'<div class="tkrep"><textarea id="tk_r" rows="2" placeholder="پاسخ یا توضیح بیشتر…"></textarea><button class="tkbtn" data-tk="reply">ارسال</button></div>')}
function tkMine(){if(!TK.list.length)return'<div class="mut" style="text-align:center;padding:10px">هنوز تیکتی ثبت نکرده‌اید.</div>';
return TK.list.slice().sort(function(a,b){return(b.at||0)-(a.at||0)}).map(function(x){var s=TKST[x.st]||TKST.open,op=TK.open===x.id;
return'<div class="tki'+(op?" on":"")+'"><div class="tkih" data-tko="'+esc(x.id)+'"><span class="tkcode">#'+esc(x.code||"")+'</span><span class="tksub">'+esc(x.sub||"")+'</span>'+(tkUnread(x)?'<span class="tknew">پاسخ جدید</span>':"")+'<span class="tkst" style="background:'+s[1]+'">'+s[0]+'</span><span class="mut tkat">'+(x.at?tkT(x.at):"")+'</span></div>'+(op?tkThread(x):"")+'</div>'}).join("")}
function tkForm(){return'<div class="tkrow"><input id="tk_n" maxlength="60" placeholder="نام و نام خانوادگی" value="'+esc(TK.name)+'"><input id="tk_p" maxlength="11" inputmode="numeric" dir="ltr" placeholder="موبایل (اختیاری)" value="'+esc(TK.phone)+'"></div>'+
'<textarea id="tk_x" rows="4" maxlength="3000" placeholder="متن پیام خود را بنویسید…"></textarea>'+
(TK.err?'<div class="tkerr">'+esc(TK.err)+'</div>':"")+(TK.ok?'<div class="tkok">'+esc(TK.ok)+'</div>':"")+
'<button class="tkbtn tkgo" data-tk="send"'+(TK.busy?" disabled":"")+'>'+(TK.busy?"در حال ارسال…":"ثبت تیکت")+'</button>'}
function tkHtml(){var L=CFG.links;return'<div class="card tkcard tkimg'+(CHC.t?" cclp":"")+'"><div class="tkhd"><b>گفتگو در پیام‌رسان‌های سینو بورس</b></div>'+
'<button type="button" class="tkbale" id="tgp" style="background:linear-gradient(135deg,#1c93e3,#2aabee);box-shadow:0 8px 22px rgba(42,171,238,.3);margin-bottom:10px"><span class="tkbi" style="color:#2aabee">ت</span><span><b>چت در تلگرام</b><small>گروه گفتگو در زمان صلح</small></span><span class="tkar">‹</span></button>'+
'<button type="button" class="tkbale" id="bale"><span class="tkbi">ب</span><span><b>چت در بله</b><small>گروه گفتگو در زمان جنگ</small></span><span class="tkar">‹</span></button></div>'+COMM()}
function tkPaint(){var l=document.getElementById("tkL");if(l)l.innerHTML=tkMine()}
function tkFormPaint(){var f=document.getElementById("tkF");if(f)f.innerHTML=tkForm()}
async function tkSend(){var n=(document.getElementById("tk_n").value||"").trim(),p=fa2en((document.getElementById("tk_p").value||"").trim()),x=(document.getElementById("tk_x").value||"").trim();
TK.name=n;TK.phone=p;TK.err="";TK.ok="";
if(!TK.sub)TK.sub="سایر";if(n.length<2)TK.err="لطفاً نام خود را بنویسید.";else if(p&&!/^09\d{9}$/.test(p))TK.err="شماره موبایل باید ۱۱ رقم و با ۰۹ شروع شود.";else if(x.length<5)TK.err="متن پیام خیلی کوتاه است.";
if(TK.err){tkFormPaint();document.getElementById("tk_x").value=x;return}
TK.busy=true;tkFormPaint();document.getElementById("tk_x").value=x;
try{var r=await apiPost("/api/tickets",{subject:TK.sub,name:n,phone:p,text:x,platform:PLAT,version:APPV,device:SID});
TK.list.push({id:r.id,k:r.key,code:r.code,sub:TK.sub,st:"open",at:Date.now(),msgs:[{from:"user",text:x,at:Date.now()}]});TK.open=r.id;TK.ok="تیکت شما با کد #"+r.code+" ثبت شد. پاسخ در همین صفحه نمایش داده می‌شود.";TK.sub="";tkSave()}
catch(e){TK.err=e.message||"ارسال تیکت انجام نشد."}
TK.busy=false;tkFormPaint();tkPaint()}
async function tkReply(){var t=document.getElementById("tk_r"),x=(t&&t.value||"").trim(),o=TK.list.filter(function(q){return q.id===TK.open})[0];if(!o||x.length<1)return;
t.disabled=true;try{await apiPost("/api/tickets/"+encodeURIComponent(o.id)+"/messages",{k:o.k,text:x});o.msgs=(o.msgs||[]).concat([{from:"user",text:x,at:Date.now()}]);o.st="open";o.at=Date.now();tkSave();tkPaint();tkSync()}
catch(e){t.disabled=false;alertBox(e.message)}}
function alertBox(m){var e=document.createElement("div");e.className="tktoast";e.textContent=m;document.body.appendChild(e);setTimeout(function(){e.style.opacity=0},2600);setTimeout(function(){if(e.parentNode)e.parentNode.removeChild(e)},3200)}
function fa2en(s){return String(s).replace(/[۰-۹]/g,function(d){return"۰۱۲۳۴۵۶۷۸۹".indexOf(d)}).replace(/[٠-٩]/g,function(d){return"٠١٢٣٤٥٦٧٨٩".indexOf(d)})}
function commBind(){var L=CFG.links;
var e=document.getElementById("eita");if(e)e.onclick=function(){openIn("ir.eitaa.messenger",L.eitaa)};
e=document.getElementById("tg");if(e)e.onclick=function(){openIn("org.telegram.messenger",L.telegram)};
e=document.getElementById("tgp");if(e)e.onclick=function(){openIn("org.telegram.messenger","https://t.me/+nLO-n41BjTE2NDQ8")};
e=document.getElementById("bale");if(e)e.onclick=function(){openIn("ir.nasim",L.bale)};
e=document.getElementById("sup_t");if(e)e.onclick=function(){openIn("","tel:"+L.phone)};
e=document.getElementById("sup_s");if(e)e.onclick=function(){openIn("","sms:"+L.phone)}}
function tkBind(){commBind();var v=document.getElementById("v");if(!v)return;
v.onclick=function(e){if(tab!=="t")return;var t=e.target;
var c=t.closest("[data-tks]");if(c){TK.sub=c.getAttribute("data-tks");document.querySelectorAll("[data-tks]").forEach(function(b){b.classList.toggle("on",b===c)});return}
var o=t.closest("[data-tko]");if(o){var id=o.getAttribute("data-tko");TK.open=TK.open===id?"":id;var x=TK.list.filter(function(q){return q.id===id})[0];if(x){x.seen=x.up||0;tkSave();tkDot()}tkPaint();if(TK.open)tkSync();return}
var b=t.closest("[data-tk]");if(!b)return;var a=b.getAttribute("data-tk");if(a==="send")tkSend();else if(a==="reply")tkReply();else if(a==="sync"){b.textContent="لطفا صبر کنید";tkSync().then(function(){b.textContent="↻ بروزرسانی"})}}}
// ---------- تعطیلات رسمی در تنظیمات (خودکار، فقط نمایش) ----------
// ===== تنظیمات: همه‌ی بخش‌ها پیش‌فرض بسته؛ با لمس عنوان باز و بسته می‌شوند =====
var SACC={};
function setAcc(){var v=document.getElementById("v");if(!v)return;var sb=v.querySelector(":scope>.syb");if(sb)v=sb;
[].slice.call(v.children).filter(function(c){return c.classList&&c.classList.contains("card")}).forEach(function(c,i){
if(c.querySelector("#gh"))return;
var hd=c.firstElementChild;
if(!(hd&&hd.tagName==="B")){hd=document.createElement("b");hd.textContent="قیمت و درصد تغییر";c.insertBefore(hd,c.firstChild)}
var bd=document.createElement("div");bd.className="accb";
while(hd.nextSibling)bd.appendChild(hd.nextSibling);
c.appendChild(bd);hd.classList.add("acch");c.classList.add("acc");
var k="k"+i;c.classList.toggle("accopen",!!SACC[k]);
hd.onclick=function(){SACC[k]=!SACC[k];c.classList.toggle("accopen",!!SACC[k])}})}
function holCard(){var t0=ds(today),set={},man={};(S.hol||[]).forEach(function(k){if(k>=t0){set[k]=1;man[k]=1}});
Object.keys(HC).forEach(function(k){if(k>=t0&&HC[k]===1&&!(S.hx||[]).some(function(x){return x===k})&&iso(k).getDay()!==5)set[k]=1});
(S.hx||[]).forEach(function(k){delete set[k]});
var L=Object.keys(set).sort().slice(0,60);
return'<div class="card"><b>تعطیلات رسمی و دستی</b><div class="mut" style="line-height:1.9;margin:4px 0 8px">پنجشنبه و جمعه همیشه تعطیل بازار حساب می‌شوند. روزهای زیر تعطیل رسمی هستند (پیش‌فرض‌های برنامه و تقویم اینترنتی)؛ با ✕ هر روز را از تعطیلات کم کنید و با انتخاب تاریخ، روز تعطیل تازه اضافه کنید.</div>'+
(L.length?'<div class="hlst">'+L.map(function(k){var d=iso(k);return'<div class="hli"><span class="hld">'+JD.format(d)+'</span><span class="hlw">'+NM[d.getDay()]+'</span><span class="hlt">'+(man[k]?"تعطیلی":"تعطیل رسمی")+'</span><button type="button" data-hx="'+k+'">✕</button></div>'}).join("")+'</div>':'<div class="mut">تعطیلی پیش رو نیست.</div>')+
'<div class="row2" style="justify-content:center;gap:8px"><input type="date" id="hn" style="flex:1;max-width:200px"><button id="ha">افزودن تعطیل</button></div>'+
'<div class="row2" style="justify-content:center"><button id="rh">دریافت دوباره از اینترنت</button></div><div class="mut" id="hm" style="text-align:center"></div></div>'}
function dpCard(){return'<div class="card"><b>تحلیل عمق بازار</b>'+
'<div class="row2"><label>گروهی</label><select id="i_gc">'+[20,50,100,200].map(function(n){return'<option value="'+n+'"'+(n===(+S.gc||50)?" selected":"")+'>'+n.toLocaleString("fa-IR")+'</option>'}).join("")+'</select></div>'+
'<div class="row2"><label>سنگین</label><select id="i_hv">'+[1,2,5,10,20].map(function(n){return'<option value="'+n+'"'+(n===(+S.hv||5)?" selected":"")+'>'+n.toLocaleString("fa-IR")+' ٪</option>'}).join("")+'</select></div>'+
'<div class="mut" style="line-height:1.9">«گروهی»: عدد انتخابی حداقل تعداد سفارش در یک ردیف تابلو است؛ اگر تعداد سفارش‌ها از این عدد بیشتر ولی میانگین حجم هر سفارش کوچک باشد، آن ردیف گروهی است و ستون «تعداد» آن زرد می‌شود.<br>«سنگین»: عدد انتخابی درصدی از میانگین حجم روزانه است (٪ حجم)؛ اگر میانگین حجم هر سفارش از این درصد بیشتر باشد، آن ردیف سنگین است و ستون «حجم» آن آبی می‌شود.</div></div>'}
function thmCard(){var m=thmMode();return'<div class="card"><b>نمایش</b><div class="row2"><label>حالت رنگ</label><select id="i_th"><option value="auto"'+(m==="auto"?" selected":"")+'>خودکار (روز روشن، شب تاریک)</option><option value="light"'+(m==="light"?" selected":"")+'>همیشه روشن</option><option value="dark"'+(m==="dark"?" selected":"")+'>همیشه تاریک</option></select></div><div class="mut">در حالت خودکار از ساعت ۶ صبح تا ۶ عصر رنگ‌بندی روشن و بقیه‌ی ساعت‌ها تاریک است.</div></div>'}

ddInit();setGo();refreshAll();sinoInit();
// ---------- کشیدن انگشت به پایین (از بالای صفحه) = بروزرسانی دستی همان صفحه ----------
var PT={y:0,x:0,on:false,dy:0,busy:false};
function ptEl(){var e=document.getElementById("ptr");if(!e){e=document.createElement("div");e.id="ptr";e.innerHTML='<svg viewBox="0 0 24 24"><path d="M20 11a8 8 0 10-2 6"/><path d="M20 4v7h-7"/></svg>';document.body.appendChild(e)}return e}
function ptSet(dy,spin){var e=ptEl();e.className=spin?"spin":"";e.style.opacity=(dy>4||spin)?1:0;e.style.transform="translate(-50%,"+Math.round(Math.min(dy,110)*.5)+"px)"}
async function pullRefresh(){if(PT.busy)return;PT.busy=true;
try{var k=bgOf(tab);BG.t[k]=Date.now();
if(k==="px")await refreshAll("pull");else if(k==="m")await mkLoad(true);else if(k==="k"){CH.t=0;await BGT.k.f()}else await BGT[k].f()}catch(e){}
try{await new Promise(function(r){setTimeout(r,300)});offFlash()}catch(e){}
PT.busy=false}
document.addEventListener("touchstart",function(e){var t=e.target;if(PT.busy||e.touches.length!==1||window.pageYOffset>0||(t&&t.closest&&t.closest("#chw,.cht,.chb,.csp,input,textarea,select,#dd,#hb"))){PT.on=false;return}
PT.y=e.touches[0].clientY;PT.x=e.touches[0].clientX;PT.on=true;PT.dy=0},{passive:true});
document.addEventListener("touchmove",function(e){if(!PT.on)return;var dy=e.touches[0].clientY-PT.y,dx=Math.abs(e.touches[0].clientX-PT.x);
if(dy<=0||dx>dy){if(dy<0)PT.on=false;PT.dy=0;ptSet(0,false);return}
PT.dy=dy;ptSet(dy,false)},{passive:true});
document.addEventListener("touchend",function(){if(!PT.on)return;PT.on=false;var go=PT.dy>90;PT.dy=0;
if(go){ptSet(70,true);pullRefresh().then(function(){setTimeout(function(){ptSet(0,false)},250)})}else ptSet(0,false)},{passive:true});
document.addEventListener("touchcancel",function(){PT.on=false;PT.dy=0;ptSet(0,false)},{passive:true});
setTimeout(function(){bgAll(tab)},1500);
(function(){var RX=/[+\-−\u200e\u200f]?\s?([\d۰-۹٠-٩][\d۰-۹٠-٩٫٬.,]*)\s?[٪%]/g;
function fx(n){if(!n)return;var w=document.createTreeWalker(n,NodeFilter.SHOW_TEXT,null),a=[],t;while(t=w.nextNode())a.push(t);a.forEach(function(t){var s=t.nodeValue;if(s&&/[٪%]/.test(s)){var r=s.replace(RX,"$1");if(r!==s)t.nodeValue=r}})}
var ob=new MutationObserver(function(){ob.disconnect();try{fx(document.getElementById("v"));fx(document.getElementById("sub"))}catch(e){}go()});
function go(){["v","sub"].forEach(function(i){var e=document.getElementById(i);if(e)ob.observe(e,{childList:true,subtree:true,characterData:true})})}
go();fx(document.getElementById("v"));fx(document.getElementById("sub"))})();

// ---------- نوار ۴ دکمه‌ای صفحه‌ی نماد: تابلو / چارت / کدال / TSE ----------
function pgNav(cur){return'<div class="pgnav optrow dpn" style="display:flex;gap:4px;overflow-x:auto;direction:rtl;-webkit-overflow-scrolling:touch;scrollbar-width:none">'+[["w","تابلو"],["f","پیش رو"],["c","زنجیره آپشن"],["sg","استراتژی"],["k","چارت"],["e","TSE"],["q","کدال"]].map(function(x){return'<button type="button" data-pg="'+x[0]+'"'+(x[0]==="c"?' data-cf="1"':"")+''+(x[0]===cur?' class="on"':'')+'>'+x[1]+'</button>'}).join("")+'</div>'}
(function(){var w0=depthHtml,k0=chartHtml,q0=cdHtml,e0=tsHtml;
depthHtml=function(){return pgNav("w")+w0()};chartHtml=function(){return(IG.sv?"":pgNav("k"))+k0()};cdHtml=function(){return pgNav("q")+q0()};tsHtml=function(){return pgNav("e")+e0()}})();
document.getElementById("v").addEventListener("click",function(e){var b=e.target.closest&&e.target.closest("[data-pg]");if(!b)return;var t=b.getAttribute("data-pg");if(t==="c"){var cf=b.hasAttribute("data-cf")?"w":"o";if(CHFROM!==cf&&tab==="c"){CHFROM=cf;view();return}CHFROM=cf}if(t!==tab)goTab(t)});
(function(){var ob=document.querySelector('.tabs [data-t="o"]');if(ob)ob.addEventListener("click",function(){var was=CHFROM;CHFROM="o";if(was==="w"&&tab==="c")setTimeout(function(){view()},0)},true)})();

// ---------- منوی «آپشن»: پیش رو / زنجیره آپشن / بازده آپشن + فهرست نمادهای آپشن‌دار ----------
var OPTL=0;
function optPg(cur){S.ot=cur;return'<div class="pgnav optrow" style="display:flex;gap:4px;overflow-x:auto;direction:rtl;-webkit-overflow-scrolling:touch;scrollbar-width:none">'+[["d","پیش رو"],["c","زنجیره آپشن"],["y","بازده آپشن"],["v","ارزش معاملات"],["j","فیلترها"]].map(function(x){return'<button type="button" data-pg="'+x[0]+'"'+(x[0]===cur?' class="on"':'')+'>'+x[1]+'</button>'}).join("")+'</div>'}
function optNav(cur){S.ot=cur;var o=UL.slice().sort(function(a,b){return a.n<b.n?-1:1}),has=o.some(function(u){return String(u.c)===String(S.ins)});
if(!o.length&&!OPTL){OPTL=1;getOpts().then(function(){if(tab==="d"||tab==="c"||tab==="y")view()}).catch(function(){})}
return optPg(cur)+
'<select id="optsym" class="optsel" style="width:100%;margin:0 0 8px" onchange="optPick(this.value)">'+(has?'':'<option value="">'+(o.length?"انتخاب نماد آپشن‌دار…":"در حال دریافت نمادهای آپشن‌دار…")+'</option>')+o.map(function(u){return'<option value="'+esc(u.c)+'"'+(String(u.c)===String(S.ins)?" selected":"")+'>'+esc(u.n)+'</option>'}).join("")+'</select>'}
var CHFROM="o";
(function(){var c0=chainHtml,y0=yieldHtml;chainHtml=function(){return(CHFROM==="w"?pgNav("c"):optNav("c"))+c0()};yieldHtml=function(){return optNav("y")+y0()}})();
function optPick(c){var u=UL.filter(function(x){return String(x.c)===c})[0];if(u)Promise.resolve(pickU(u)).then(function(){view()},function(){view()})}

// ---- تست کد فیلتر: پیدا کردن خطا، سطر آن و توضیح فارسی ----
function fxFa(m){m=String(m||"");var r;
if(/Unexpected end of input/i.test(m))return"کد ناتمام است؛ پرانتز، آکولاد یا عبارتی در انتهای کد بسته یا کامل نشده";
if(/missing \) after argument list/i.test(m))return"پرانتز بسته «)» در فراخوانی تابع جا افتاده";
if(/Invalid or unexpected token/i.test(m))return"کاراکتر نامعتبر (شاید علامت فارسی، کوتیشن کج یا حرف اضافه)";
if(r=/Unexpected token '?([^']*)'?/i.exec(m))return"علامت «"+r[1]+"» در جای نادرست آمده";
if(r=/Unexpected identifier '?([^']*)'?/i.exec(m))return"کلمه‌ی «"+r[1]+"» در جای نادرست آمده (شاید عملگر یا ; جا افتاده)";
if(/Unexpected number/i.test(m))return"عدد در جای نادرست آمده (شاید عملگر جا افتاده)";
if(/Unexpected string/i.test(m))return"متن در جای نادرست آمده";
if(r=/(\S+) is not defined/i.exec(m))return"متغیر یا نام «"+r[1].replace(/^V\./,"")+"» تعریف نشده است";
if(r=/Cannot read propert(?:y|ies) of (undefined|null)(?: \(reading '([^']*)'\))?/i.exec(m))return"خواندن «"+(r[2]||"")+"» از مقدار خالی؛ احتمالاً شماره‌ی روز [ih] از سابقه‌ی موجود بیشتر است یا نام فیلد اشتباه است";
if(r=/(\S+) is not a function/i.exec(m))return /^V\./.test(r[1])?"بعد از «("+r[1].slice(2)+")» یک عملگر مثل && یا || یا ; جا افتاده (احتمالاً انتهای سطر قبل)":"«"+r[1]+"» تابع نیست یا نامش اشتباه نوشته شده";
if(/Invalid left-hand side in assignment/i.test(m))return"سمت چپ = قابل مقداردهی نیست (برای مقایسه از == یا === استفاده کنید)";
if(/Assignment to constant/i.test(m))return"مقدار const را نمی‌توان عوض کرد";
if(/has already been declared/i.test(m))return"این نام دو بار تعریف شده است";
return m}
// بررسی جفت بودن پرانتز، کروشه و آکولاد (بیرون از متن‌ها و توضیحات)
function fxBr(t){var st=[],ln=1,q="",cm="",P={")":"(","]":"[","}":"{"},N={"(":"پرانتز","[":"کروشه","{":"آکولاد"};
for(var i=0;i<t.length;i++){var c=t[i],d=t[i+1];if(c==="\n"){ln++;if(cm==="l")cm="";continue}
if(cm){if(cm==="b"&&c==="*"&&d==="/"){cm="";i++}continue}if(q){if(c==="\\"){i++;continue}if(c===q)q="";continue}
if(c==="/"&&d==="/"){cm="l";continue}if(c==="/"&&d==="*"){cm="b";continue}if(c==="'"||c==='"'||c==="`"){q=c;continue}
if(c==="("||c==="["||c==="{")st.push([c,ln]);else if(P[c]){var o=st.pop();if(!o)return{bad:1,ln:ln,msg:"«"+c+"» بسته شده ولی "+N[P[c]]+"ی برایش باز نشده"};if(o[0]!==P[c])return{bad:1,ln:ln,msg:N[o[0]]+" باز «"+o[0]+"» (سطر "+o[1].toLocaleString("fa-IR")+") با «"+c+"» بسته شده"}}}
if(st.length){var o2=st[st.length-1];return{bad:1,ln:o2[1],msg:N[o2[0]]+" «"+o2[0]+"» باز شده ولی بسته نشده"}}return{bad:0}}
function fxLine(lines,i){var t=(lines[i-1]||"").trim();return" — سطر "+i.toLocaleString("fa-IR")+(t?": "+(t.length>45?t.slice(0,45)+"…":t):"")}
async function fxDiag(code,iv){if(!String(code||"").trim())return{ok:1,msg:"کد خالی است؛ فیلتر فقط با شرط‌های ساده اجرا می‌شود."};
var t=fxTr(code),ls=String(code).replace(/\r/g,"").split("\n"),tl=t.split("\n");
try{new Function("V","CT","IH","IS",t)}catch(e){var ln=0,em=e.message,B=fxBr(t);
if(B.bad)return{ok:0,msg:"✖ کد خراب است: "+B.msg+fxLine(ls,B.ln)};
for(var i=1;i<=tl.length;i++){try{new Function("V","CT","IH","IS",tl.slice(0,i).join("\n"))}catch(e2){if(!/Unexpected end of input|missing \) after argument list|Unexpected token '\}'/i.test(e2.message)){ln=i;em=e2.message;break}}}
if(!ln&&/Unexpected token '\}'|Unexpected end of input/i.test(em))return{ok:0,msg:"✖ کد خراب است: کد ناتمام است؛ عبارت آخر کامل نشده (مثلاً بعد از && یا || چیزی نیامده)"+fxLine(ls,ls.length)};
return{ok:0,msg:"✖ کد خراب است: "+fxFa(em)+(ln?fxLine(ls,ln):"")}}
var Q=fxComp(code);if(Q.err)return{ok:0,msg:"✖ کد خراب است: "+fxFa(Q.err)};
var rows=[];try{rows=(await mwGet()).filter(function(r){return fxL(r)>0&&r.py>0}).slice(0,60)}catch(e){}
if(!rows.length)rows=[{c:"0",pl:1000,pc:990,py:980,pf:985,vol:5e5,val:5e8,tr:100,bv:2e5,lw:970,hg:1010,eps:50,smx:1050,smn:950,fl:"1",sc:"1",z:1e9}];
var H=[];for(var k=0;k<Math.max(Q.n,5);k++)H.push(fxIHrow({pClosing:1000,pDrCotVal:1000,priceFirst:990,priceMin:980,priceMax:1020,priceYesterday:995,qTotTran5J:3e5,qTotCap:3e8,zTotTran:80,dEven:20260101-k}));
var CT0={bI:20,bN:1,bvR:3e5,bvN:1e4,sI:25,sN:1,svR:2e5,svN:5e4},IS=fxIS(iv),n=0,tr=0,und=0;
for(var j=0;j<rows.length;j++){try{var V=fxVars(rows[j],{}),res=Q.f(V,fxCT(CT0),H,IS,Q.t);n++;if(res===undefined)und++;else if(res)tr++}catch(x){var st=String(x&&x.stack||""),lm=/<anonymous>:(\d+):\d+/.exec(st.split("\n").slice(0,4).join("\n")),ln2=lm?+lm[1]:0;
return{ok:0,msg:"✖ کد خراب است (خطای اجرا): "+fxFa(x&&x.message||x)+(ln2>0&&ln2<=ls.length?fxLine(ls,ln2):"")}}}
if(und===n)return{ok:0,msg:"✖ کد خراب است: آخرین عبارت کد مقداری برنمی‌گرداند؛ سطر آخر باید یک شرط باشد (مثلاً (pl)>(py))."};
return{ok:1,msg:"✔ کد سالم است — روی "+n.toLocaleString("fa-IR")+" نماد نمونه بدون خطا اجرا شد ("+tr.toLocaleString("fa-IR")+" نماد شرط را داشت). فیلتر روی کل بازار اجرا می‌شود."}}

// ---- پیشنهاد کد از متن فارسی (قاعده‌محور، بدون اینترنت) ----
function fxNL(txt){var t0=String(txt||"").trim();if(!t0)return{msg:"اول توضیح فیلتر را بنویسید؛ مثلاً: ورود پول حقیقی بیشتر از ۵ میلیارد و حجم ۲ برابر میانگین ماه و آخرین قیمت مثبت"};
var t=" "+lat(ar(t0)).replace(/[‌‏]/g," ").replace(/ي/g,"ی").replace(/ك/g,"ک").replace(/[٫]/g,".").replace(/\s+/g," ")+" ";
