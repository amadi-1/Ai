else if(/ورود\s*(پول|نقدینگی)|پول\s*(حقیقی|هوشمند)?\s*وارد/.test(p)){var v2=Nb(p,"میلیارد",N(p,0));vr("inflow","var inflow=((ct).Buy_I_Volume-(ct).Sell_I_Volume)*(pc); // ورود پول حقیقی (ریال)");cf.push("(cfield0)=Math.round(inflow/1e9)/10; // ورود پول (میلیارد تومان)");add(p,"inflow"+dir(p,">")+v2+"*1e10")}
else if(/قدرت\s*(خرید|خریدار)|نسبت\s*سرانه/.test(p)){vr("pw","var pw=((ct).Buy_CountI>0&&(ct).Sell_CountI>0&&(ct).Sell_I_Volume>0)?((ct).Buy_I_Volume/(ct).Buy_CountI)/((ct).Sell_I_Volume/(ct).Sell_CountI):0; // قدرت خریدار حقیقی");cf.push("(cfield1)=Math.round(pw*100)/100; // قدرت خریدار");add(p,"pw"+dir(p,">")+N(p,1.5))}
else if(/قدرت\s*(فروش|فروشنده)/.test(p)){vr("pw","var pw=((ct).Buy_CountI>0&&(ct).Sell_CountI>0&&(ct).Sell_I_Volume>0)?((ct).Buy_I_Volume/(ct).Buy_CountI)/((ct).Sell_I_Volume/(ct).Sell_CountI):0; // قدرت خریدار حقیقی");add(p,"pw>0 && 1/pw"+dir(p,">")+N(p,1.5))}
