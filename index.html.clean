function fpIsMain(l,i){return l.name==="اصلی"||(i===0&&!WL.lists.some(function(x){return x.name==="اصلی"}))}
function fpOpen(i){if(!WL.lists||!WL.lists[i])return;if(!FP.o){FP.gc=WL.cur;FP.o=1}FP.last=i;FP.ed=0;FP.del=-1;WL.cur=i;WL.sk=null;WL.edit=false;WL.le=false;WP.err="";view();window.scrollTo(0,0);setTimeout(wlLoad,30);}
function fpRestore(){if(!FP.o)return;FP.o=0;if(WL.lists)WL.cur=Math.max(0,Math.min(FP.gc,WL.lists.length-1));WL.sk=null;WL.edit=false;WL.dg=-1;WL.dgOn=0}
