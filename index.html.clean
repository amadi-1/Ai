a.textContent=(t?" | ":"")+"NAV "+fp(S.nav)+" | حباب ";b.textContent=(bb>0?"+":(bb<0?"−":""))+Math.abs(bb).toLocaleString("fa-IR",{maximumFractionDigits:2});b.style.color=c;b.style.fontWeight="700";z.textContent=" %";z.style.color=c;
