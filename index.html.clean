 G=(MM.g?[g[MM.g]]:Object.keys(g).map(function(k){return g[k]})).sort(function(a,b){return b.s-a.s});
 var sec=mmSq(G,0,0,W,H),h="";
 sec.forEach(function(q){var o=q.t,hd=q.h>34&&q.w>40?13:0,ss=o.a.sort(function(a,b){return b.s-a.s});
  h+='<div class="mms" style="left:'+q.x.toFixed(1)+'px;top:'+q.y.toFixed(1)+'px;width:'+q.w.toFixed(1)+'px;height:'+q.h.toFixed(1)+'px">'+(hd?'<i>'+esc(nm[o.k]||("گروه "+o.k))+'</i>':'');
  mmSq(ss,0,hd,q.w,q.h-hd).forEach(function(c){var x=c.t,r=x.r,f0=Math.min((c.w-4)/((r.n.length||3)*0.86+0.4),c.h/2.7),fs=Math.max(7,Math.min(16+(z-1)*4,f0)),lb=f0>=6.3;
