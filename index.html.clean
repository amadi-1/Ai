else{bg="var(--upb)";txt="حتی اگر تا سررسید "+cfp(b.td)+" روز "+dirB+" کامل بخورد، نماد پایه فقط به "+fp(b.uT)+" می‌رسد و هنوز "+(b.call?"بالاتر از":"پایین‌تر از")+" قیمت اعمال ("+fp(b.K)+") است؛ پس با حد نوسان این "+side+" سوخت نمی‌شود."}}
else{post+=tsKV("وضعیت",'<span style="color:var(--dn)">در وضعیت سوخت</span>');bg="var(--dnb)";
txt="نماد پایه ("+fp(b.px)+") هم‌اکنون "+(b.call?"کمتر یا برابر":"بیشتر یا برابر")+" قیمت اعمال ("+fp(b.K)+") است و این "+side+" در وضعیت سوخت قرار دارد. برای نجات از سوختن باید "+cfp(b.back)+" روز "+dirO+" کامل بخورد"+(b.back>b.td?"؛ ولی تا سررسید فقط "+cfp(b.td)+" روز معاملاتی مانده و حتی با همه‌ی آن‌ها به "+fp(b.uT)+" می‌رسد، یعنی قطعاً سوخت می‌شود.":"؛ تا سررسید "+cfp(b.td)+" روز معاملاتی مانده است.")}
post+='<div style="padding:7px 9px;margin:6px 0;border-radius:9px;background:'+bg+';font-size:12px;line-height:1.9">'+txt+'</div>'}
