function oxDig(s){return String(s).replace(/[۰-۹]/g,function(d){return"۰۱۲۳۴۵۶۷۸۹".indexOf(d)}).replace(/[٠-٩]/g,function(d){return"٠١٢٣٤٥٦٧٨٩".indexOf(d)}).replace(/٬/g,",").replace(/٫/g,".")}
function oxStrip(h){return oxDig(String(h).replace(/<[^>]*>/g," ").replace(/&nbsp;/gi," ").replace(/&#?\w+;/g," "))}
function oxVal(html){var t=oxStrip(html),m=t.match(/[-−]?\s*\(?\s*[-−]?\s*[\d,]+(?:\.\d+)?\s*\)?\s*%?/g)||[],ns=[];
