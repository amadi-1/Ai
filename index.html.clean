if(!(p>0))throw mkErr("data",0,"no price");
S.base=p;S.pl=l;S.pc=cl||null;S.pla=ls||null;S.py=+c.priceYesterday>0?+c.priceYesterday:0;S.pa=false;save();upd=true;setGo();
