// ---- option chain: calls on the right, strike in the middle, puts on the left ----
// highest / lowest possible underlying price on the expiry date (daily limit, holidays, whole-price rounding)
function projTo(ed){var u=+S.base,v=+S.base,p=S.pct/100,e=iso(ed);
for(var d=add(today,1);d<=e;d=add(d,1)){if(!off(d)){u=up(u,p);v=dn(v,p)}}
return{u:u,v:v}}
// "g" = buying is profitable even in the worst case, "r" = selling is profitable even in the worst case
function sig(side,B,P){if(!(B>0))return"";
if(side==="c")return P.v>B?"g":(P.u<B?"r":"");
return P.u<B?"g":(P.v>B?"r":"")}
function beAttr(b,pr){return b?' style="color:'+(b>pr?"var(--up)":(b<pr?"var(--dn)":"inherit"))+';font-weight:700"':""}
function kmf(v){if(v==null||!isFinite(v)||v<0)return"—";var a=+v,u="";if(a>=1e6){a=a/1e6;u="M"}else if(a>=1e3){a=a/1e3;u="K"}return a.toLocaleString("fa-IR",{maximumFractionDigits:u?1:0})+(u?' <b style="color:'+(u==="K"?"#1976d2":"#f97316")+'">'+u+'</b>':"")}
function chainHtml(){
var ch=(S.ch&&S.ch.ins===S.ins)?S.ch.items:[],t0=ds(today),its=ch.filter(function(x){return x.e>=t0}),ex=[];
its.forEach(function(x){if(ex.indexOf(x.e)<0)ex.push(x.e)});ex.sort();
if(!ex.length)return'<div class="card mut">'+(/پیدا نشد/.test(ST.o||"")?"برای این نماد اختیار معامله‌ای پیدا نشد.":"زنجیره آپشن این نماد هنوز دریافت نشده؛ «بروزرسانی قیمت» را بزنید.")+'</div>';
var pr=+(S.pc||S.base);
function tbl(e,side,P){var l=its.filter(function(x){return x.e===e&&(side==="c"?x.c:x.p)}).sort(function(a,b){return a.k-b.k});if(!l.length)return"";
var pre=(side==="c"?l[0].c:l[0].p).replace(/\d+$/,""),rows="";
l.forEach(function(x,n){var nm=side==="c"?x.c:x.p,pm=(side==="c"?x.cp:x.pp)||0,v=side==="c"?x.vc:x.vp,yv=(side==="c"?x.yc:x.yp)||0,
ok=pm>0&&!(v===0),B=ok?(side==="c"?x.k+pm:x.k-pm):0,sc=ok?sig(side,B,P):"",
nc=sc==="g"?"color:var(--up)":(sc==="r"?"color:var(--dn)":""),
pc=(ok&&yv>0)?(pm>yv?"color:var(--up);font-weight:700":(pm<yv?"color:var(--dn);font-weight:700":"")):"";
rows+='<tr'+(n%2?"":' class="zb"')+'><td class="nm" data-sy="'+esc(nm||"")+'" style="cursor:pointer;'+nc+'">'+esc(nm||"—")+'</td><td style="'+pc+'">'+(ok?fp(pm):"—")+'</td><td><b>'+x.k.toLocaleString("fa-IR")+'</b></td><td'+beAttr(B,pr)+'>'+(B?fp(B):"—")+'</td><td style="font-size:11px">'+(v==null?"—":cfp(v))+'</td></tr>'});
return'<div class="mt2s">'+(side==="c"?"زنجیره اختیار خرید ":"زنجیره اختیار فروش ")+esc(pre)+'</div><table class="stk ct"><tr><th style="width:24%">نام نماد</th><th style="width:17%">آخرین قیمت</th><th style="width:17%">مبلغ اعمال</th><th class="sbs" style="width:18%">سربه‌سر</th><th style="width:24%">حجم</th></tr>'+rows+'</table>'}
var out="";if(!CX||ex.indexOf(CX)<0)CX=ex[0];
var dl0=Math.round((iso(CX)-today)/864e5),bar2='<div class="exb2"><span class="l">سررسید</span><div class="exs2">'+ex.map(function(e){return'<button type="button" data-ce="'+e+'"'+(e===CX?' class="on"':'')+'>'+JJ.format(iso(e))+'</button>'}).join("")+'</div><span class="l">روزمانده <b>'+dl0.toLocaleString("fa-IR")+'</b></span></div>';
(function(e){var P=projTo(e);out=tbl(e,"c",P)+tbl(e,"p",P)})(CX);
return preBanner()+'<div class="card">'+bar2+'<div class="sc scv">'+out+'</div>'+'<div class="mut" style="line-height:1.9;margin-top:8px"><b style="color:var(--up)">نماد سبز</b>: خرید قطعاً سودآور &nbsp; <b style="color:var(--dn)">نماد قرمز</b>: فروش قطعاً سودآور &nbsp; نماد بدون رنگ: نامشخص<br>رنگ «آخرین قیمت»: سبز = مثبت، قرمز = منفی نسبت به دیروز. رنگ «سربه‌سر»: سبز = بالاتر از قیمت نماد پایه، قرمز = پایین‌تر.<br>نمادهایی که امروز حجم معامله ندارند محاسبه نمی‌شوند (—). محاسبه با بدترین حالت تا سررسید (درصد دامنه، روزهای مانده و تعطیلات).</div></div>'}
