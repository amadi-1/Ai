else if(a==="nl"){var nt=(document.getElementById("fxnl")||{}).value||"",G=fxNL(nt),ta=document.getElementById("fxc");C.fxn=nt;if(!G.code){fxShow({ok:0,msg:G.msg});return}if(ta)ta.value=G.code;C.fxd=G.code;C.fxt=null;fxShow({ok:-1,msg:G.msg})}
