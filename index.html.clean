t=t.replace(/(^|\s)(یک|دو|سه|چهار|پنج|شش|شیش|هفت|هشت|ده|بیست|سی|چهل|پنجاه|شصت|صد|نیم)(?=\s)/g,function(m,a,w){return a+W[w]});
