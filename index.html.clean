function nxAddTop(L,K){var at=L.findIndex(function(l){return l.flt==="sx1"});if(at<0)at=L.findIndex(function(l){return l.name==="اصلی"});at=at+1;var ch=false;
K.forEach(function(k){if(!L.some(function(l){return l.flt===k})){L.splice(at,0,{name:NX[k].name,flt:k,items:[]});at++;ch=true}});return ch}
// «فیلتر ساز» همیشه آخر
function fpFxLast(){var L=WL.lists;if(!L)return false;var fx=L.filter(function(l){return l.flt==="fx1"}),ot=L.filter(function(l){return l.flt!=="fx1"});if(!fx.length)return false;var N=ot.concat(fx),same=N.every(function(l,i){return l===L[i]});if(same)return false;
var cur=L[WL.cur],lst=FP.last>=0?L[FP.last]:null,gc=L[FP.gc];WL.lists=N;WL.cur=Math.max(0,N.indexOf(cur));FP.last=lst?N.indexOf(lst):-1;if(gc)FP.gc=Math.max(0,N.indexOf(gc));return true}
// تابلوی عمق بازار: توضیح رنگ آبی (سفارش سنگین) و زرد (سفارش گروهی)
function dkNote(H,G,AV){if(!H&&!G)return"";var hv=AV*(+S.hv||5)/100;
return'<div class="card" style="padding:8px 10px;line-height:2;font-size:12px"><b>راهنمای رنگ‌های تابلو</b>'+
(H?'<div style="margin-top:4px"><span class="dkc" style="background:#1976d2;color:#fff">حجم آبی</span> <b>سفارش سنگین:</b> میانگین حجم هر سفارش در این ردیف (حجم ÷ تعداد) از '+cfp(+S.hv||5)+' درصد میانگین حجم روزانه‌ی نماد'+(AV>0?' (حدود '+wlK(hv)+' سهم)':'')+' بیشتر است. یعنی چند سفارش درشت در این قیمت نشسته‌اند؛ معمولاً کار حقوقی، صندوق، بازارگردان یا سهامدار عمده است. در سمت خرید می‌تواند نشانه‌ی حمایت جدی و در سمت فروش نشانه‌ی عرضه‌ی سنگین باشد. ممکن است فقط برای نمایش (قدرت‌نمایی) گذاشته شده باشد و قبل از رسیدن قیمت حذف شود.</div>':'')+
(G?'<div style="margin-top:4px"><span class="dkc" style="background:#ffd600;color:#000">تعداد زرد</span> <b>سفارش گروهی (خرد):</b> تعداد سفارش‌های این ردیف حداقل '+cfp(+S.gc||50)+' است ولی میانگین حجم هر سفارش خیلی کوچک (کمتر از یک‌دهم حد «سنگین») است. یعنی تعداد زیادی سهامدار خرد هم‌زمان در این قیمت سفارش گذاشته‌اند؛ در سمت خرید معمولاً هیجان و خرید گروهی و در سمت فروش ترس و فروش هیجانی را نشان می‌دهد.</div>':'')+
'<div class="mut" style="font-size:11px;margin-top:4px">حدهای «سنگین» و «گروهی» در صفحه‌ی تنظیمات، بخش «تحلیل عمق بازار» قابل تغییرند. این رنگ‌ها فقط نشانه‌اند و توصیه‌ی خرید یا فروش نیستند.</div></div>'}
async function nxRun(C){var D=NX[C.flt];if(!D||WP.run)return;NXCUR=C;lvSetC(C);WP.run=true;WP.err="";C.cl=0;WP.msg="دریافت فهرست کل بازار از بورس…";if(wlOn())wlPaint();
try{var raw=await getAny("/tsev2/data/MarketWatchInit.aspx?h=0&r=0"),list=parseMW(raw);if(list.length<50)throw mkErr("data",0,"parse");
var b=nfIn(C,list),res=[],dg="",er=0,sh=0,fe=null;
