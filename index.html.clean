<script>
(function(){
var RX=/(^|[\s(>،:|\[])([0-9۰-۹][0-9۰-۹٬,]*(?:[٫.][0-9۰-۹]+)?)(\s?)(٪|%)/g;
function skip(el){while(el&&el!==document.body){var t=el.tagName;if(t==="OPTION"||t==="SELECT"||t==="SCRIPT"||t==="STYLE"||t==="TEXTAREA"||t==="INPUT")return true;var c=el.classList;if(c&&(c.contains("cs")||c.contains("csp")||c.contains("csb")))return true;el=el.parentNode}return false}
function fix(n){var v=n.nodeValue;if(!v||v.length>60||(v.indexOf("٪")<0&&v.indexOf("%")<0))return;
var nv=v.replace(RX,function(m,p,num,sp,u){if(!/[1-9۱-۹]/.test(num))return m;return p+"\u202a+"+num+sp+u+"\u202c"});
if(nv!==v&&!skip(n.parentNode))n.nodeValue=nv}
function walk(r){if(r.nodeType===3){fix(r);return}if(r.nodeType!==1)return;var w=document.createTreeWalker(r,NodeFilter.SHOW_TEXT),n,a=[];while((n=w.nextNode()))a.push(n);for(var i=0;i<a.length;i++)fix(a[i])}
try{new MutationObserver(function(ms){for(var i=0;i<ms.length;i++){var m=ms[i];if(m.type==="characterData")fix(m.target);else for(var j=0;j<m.addedNodes.length;j++)walk(m.addedNodes[j])}}).observe(document.body,{childList:true,subtree:true,characterData:true});walk(document.body)}catch(e){}
})();

</script>
