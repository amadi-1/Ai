if(!(sfx||(single&&!/(_c|_p|call|put)$/.test(kk))))continue;
if(/priceyesterday|yesterday/.test(kk))y=v}
return y}
// initial margin per contract if the exchange row carries one (_C/_P suffix or a single-option row)
function marginOf(r,side,single){var best=0;
for(var k in r){var v=+r[k];if(!(v>0))continue;var kk=k.toLowerCase();
if(!/margin|deposit|tazmin|collat/.test(kk))continue;
var sfx=side==="c"?/(_c|call)$/.test(kk):/(_p|put)$/.test(kk);
if(sfx||(single&&!/(_c|_p|call|put)$/.test(kk)))best=Math.max(best,v)}
return best}
function csz(r){for(var k in r){if(/contract.*size|size.*contract/i.test(k)&&+r[k]>0)return+r[k]}return 0}
function jIso(y,m,d){if(y<1700){var g=j2g(y,m,d);return g?ds(g):null}return ds(D(y,m-1,d))}
