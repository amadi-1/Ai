 var fl=MM.mk==="b"?["1"]:(MM.mk==="f"?["2"]:["1","2"]),g={},n=0;
 D.l.forEach(function(r){if(fl.indexOf(r.fl)<0||!(r.py>0))return;var lp=r.pl>0?r.pl:0,p=lp>0?lp:r.py,s=MM.sz==="c"?(r.z>0?r.z*p:0):r.val;if(!(s>0))return;var k=r.sc||"?",o=g[k]||(g[k]={k:k,s:0,a:[],top:r});o.s+=s;o.a.push({s:s,r:r,p:lp>0?(lp/r.py-1)*100:0});if(s>(o.ts||0)){o.ts=s;o.top=r}n++});
