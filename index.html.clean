var W0=WL.q[it.c]||{},hv=wlHv(q.bl),st0=W0.st||"",cls=W0.cl?"wcl":((st0==="AG"||(ph()==="ord"&&!W0.cl))?"wor":""),
th0=WL.thr[it.c]||0,pp0=(py>0&&pl>0)?(pl/py-1)*100:0,hiL=th0>0&&pp0>=th0-0.15,loL=th0>0&&pp0<=-(th0-0.15),bq=hv.b>0&&(!(hv.s>0)||(hiL&&hv.b>hv.s)),sq=hv.s>0&&(!(hv.b>0)||(loL&&hv.s>hv.b)),qf=function(c){return((bq&&c==="var(--dn)")||(sq&&c==="var(--up)"))?"":c},
