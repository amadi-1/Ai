var sg=function(v,d){return v==null||!isFinite(v)?"—":(v>0?"+":(v<0?"−":""))+cfp(Math.abs(v),d)},cl=function(v){return v>0?"var(--up)":(v<0?"var(--dn)":"inherit")};
R.sort(function(a,b){return sk==="n"?String(a.n).localeCompare(String(b.n),"fa"):((b[sk]||0)-(a[sk]||0))});
var th=function(k,t){return'<th data-hsk="'+k+'" style="cursor:pointer">'+t+(sk===k?" ▼":"")+'</th>'};
var tb=R.length?'<div class="sc scv" style="max-height:55vh"><table class="stk"><tr>'+th("n","نماد")+th("ch","درصد")+th("val","ارزش")+th("fl","ورود پول")+'</tr>'+R.map(function(r){return'<tr data-hsc="'+esc(r.c)+'" data-hsn="'+esc(r.n)+'" style="cursor:pointer"><td style="font-weight:700">'+esc(r.n)+'</td><td dir="ltr" style="color:'+cl(r.ch)+';font-weight:700">'+sg(r.ch,2)+'٪</td><td>'+cfp(r.val/1e10,1)+'</td><td dir="ltr" style="color:'+cl(r.fl)+'">'+(r.fl==null?"—":sg(r.fl/1e10,1))+'</td></tr>'}).join("")+'</table></div>':'<div class="mut">فهرست نمادها هنوز در دسترس نیست. یک‌بار فیلتر «صنعت‌های داغ» را اجرا کنید (دکمهٔ ▶ زیر جدول).</div>';
