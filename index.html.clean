l=hd0>0?"سرخط سفارش‌گیری":(ls||cl)?(S.pt==="last"?(ls?"آخرین قیمت":"قیمت پایانی"):(cl?"قیمت پایانی":"آخرین قیمت")):"قیمت دیروز";
