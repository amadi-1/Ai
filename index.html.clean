eps=num(e.estimatedEPS)||num(e.epsValue),spe=num(e.sectorPE),dps=num(e.dps)||num(I.dps),pr=dxLast(),pcl=num(c.pClosing)||num(c.pDrCotVal),
sec=I.sector&&I.sector.lSecVal?ar(String(I.sector.lSecVal).trim()):"",mk=I.flowTitle?ar(String(I.flowTitle).trim()):"",
O=DX.ins===S.ins?DX.O:null,tp=O?(O.side==="p"?"اختیار فروش":"اختیار خرید"):(num(I.nav)>0?"صندوق":"سهام");
function avg(days){var cut=key(add(today,-days)),a=H.filter(function(x){return x.d>=cut&&x.v>0});if(!a.length)return NaN;var s=0;a.forEach(function(x){s+=x.v});return s/a.length}
var a1=num(I.qTotTran5JAvg)||avg(31),a3=avg(93),tf="—";
var rr=(th.mx>0&&th.mn>0)?(th.mx-th.mn)/(th.mx+th.mn):0;if(pcl>0&&rr>0.004&&rr<0.25){var pc2=Math.min(10,Math.max(1,Math.round(rr*100)))/100;tf=fp(dn(pcl,pc2))+" - "+fp(up(pcl,pc2))}
