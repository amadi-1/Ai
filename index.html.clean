else if(D.ob){var OB=nxOBof(raw);b.inM.forEach(function(r){var x=D.pickOB(r,OB[r.c]||{});if(x){x.c=r.c;x.n=r.n;x.nm=r.nm;res.push(x)}});dg="بررسی‌شده: "+b.inM.length.toLocaleString("fa-IR")+" نماد"}
else{var cand=b.inM.filter(function(r){return r.vol>0&&r.hg>0&&r.lw>0}),fb=0;if(cand.length<20){cand=b.inM;fb=1}
var OBH=D.obh?nxOBof(raw):null;var CT=null;if(D.ct){WP.msg="دریافت حقیقی و حقوقی…";if(wlOn())wlPaint();try{CT=nxCT(await getAny("/tsev2/data/ClientTypeAll.aspx"))}catch(e){CT={}}}
await pool(cand,8,async function(r){var a;try{a=await nxHist(r.c,D.hist)}catch(e){er++;if(!fe)fe=e;return}var S=nxSeries(a,r);if(S.s.length<15){sh++;return}var x=D.pick(r,S,CT?CT[r.c]:null,OBH?(OBH[r.c]||{}):null);if(x){x.c=r.c;x.n=r.n;x.nm=r.nm;res.push(x)}},nfProg(cand));
if(cand.length&&er>cand.length*0.5&&fe)throw fe;dg=nfDg(b,cand,fb,er,sh)}
if(D.post)res=D.post(res);if(D.sort)res.sort(D.sort);C.dg=dg;C.tot=res.length;var n=(C.cfg&&C.cfg.n>0)?C.cfg.n:100;C.items=res.slice(0,n);C.ft=Date.now();WP.stat={m:list.length,c:b.inM.length};wlSave()}
catch(e){return nfEnd(e)}
WP.run=false;if(wlOn()){wlPaint();setTimeout(wlLoad,50)}}
