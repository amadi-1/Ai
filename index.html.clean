function lvSet(C){var c=C.cfg=C.cfg||{};askText("حداکثر تعداد نماد در لیست (۰ = همه)",String(c.n||0),function(v){c.n=Math.max(0,Math.min(200,+wlD(v)||0));wlSave();C.cl=0;C.rt=Date.now();wpRun(C)})}
function wlSortBy(k){var C=wlCur();if(!C||!C.items.length)return;if(WL.sk===k)WL.sd=-WL.sd;else{WL.sk=k;WL.sd=k==="nm"?1:-1}
var val=function(it){var q=WL.q[it.c]||{},py=q.py,pl=q.pl>0?q.pl:py,pc=q.pc>0?q.pc:py,n=null;
if(k==="nm")return it.n;
if(k==="pl")n=(py>0&&pl>0)?pl/py-1:null;else if(k==="pc")n=(py>0&&pc>0)?pc/py-1:null;
else if(k==="lp")n=pl>0?pl:null;else if(k==="cp")n=pc>0?pc:null;
else if(k==="cd")n=(q.hi>q.lo&&pl>0)?(pl-q.lo)/(q.hi-q.lo):null;else n=wlcSV(k,q,it,py);return n};
var a=C.items.map(function(x,i){return[x,i,val(x)]});
a.sort(function(u,v){if(u[2]===null&&v[2]===null)return u[1]-v[1];if(u[2]===null)return 1;if(v[2]===null)return -1;var r=k==="nm"?String(u[2]).localeCompare(String(v[2]),"fa"):u[2]-v[2];return(r*WL.sd)||(u[1]-v[1])});
C.items=a.map(function(x){return x[0]});if(k==="nm"&&fpIsMain(C,WL.lists.indexOf(C))){C.items=C.items.filter(function(x){return x.pq}).concat(C.items.filter(function(x){return !x.pq}))}wlSave();view()}
function lsCells(hv,bq,sq){var g="background:#d9f5e4!important;color:#1b7a3a;font-weight:700",r="background:#fbdcdc!important;color:#b3261e;font-weight:700",f=function(v){return v>0?cfp(v):"—"};
return'<td class="lsc" style="'+g+'">'+(sq?"—":f(hv.b))+'</td><td class="lsc" style="'+g+'">'+f(hv.pb)+'</td><td class="lsc" style="'+r+'">'+f(hv.ps)+'</td><td class="lsc" style="'+r+'">'+(bq?"—":f(hv.s))+'</td>'}
function lsOne(hv,bq,sq,k){var g="background:#d9f5e4!important;color:#1b7a3a;font-weight:700",r="background:#fbdcdc!important;color:#b3261e;font-weight:700",f=function(v){return v>0?cfp(v):"—"};
if(k==="dv")return'<td style="'+g+'">'+(sq?"—":f(hv.b))+'</td>';if(k==="dp")return'<td style="'+g+'">'+f(hv.pb)+'</td>';if(k==="op")return'<td style="'+r+'">'+f(hv.ps)+'</td>';return'<td style="'+r+'">'+(bq?"—":f(hv.s))+'</td>'}
function wlHv(bl){var x=(bl||[]).slice().sort(function(a,b){return num(a.number)-num(b.number)})[0]||{};return{b:num(x.qmd),s:num(x.qmo),pb:num(x.pmd),ps:num(x.pmo)}}
function wlBg(vol,k){return"";if(!(vol>0)||!(WMXG>0))return"";var w=Math.max(8,Math.min(100,Math.sqrt(vol/WMXG)*100)),c=k==="hb"?"rgba(52,199,89,.45)":"rgba(255,107,107,.45)",d=k==="hb"?"to right":"to left";return"background:linear-gradient("+d+","+c+" "+w+"%,#fff "+w+"%);"}
var WMXG=0;var WYD={};try{WYD=JSON.parse(localStorage.getItem("wlyd1"))||{}}catch(e){WYD={}}
async function wlYdLoad(c){var k=String(c),d=key(today);if(WYD[k]&&WYD[k].k===d)return;try{var j=JSON.parse(await GET(TS+"ClosingPrice/GetClosingPriceDailyList/"+k+"/5")),a=firstArr(j.closingPriceDaily||j).slice().sort(function(x,y){return num(y.dEven)-num(x.dEven)}),r=null,i;for(i=0;i<a.length;i++){if(num(a[i].dEven)<d&&(num(a[i].pClosing)>0||num(a[i].pDrCotVal)>0)){r=a[i];break}}if(r){WYD[k]={k:d,fi:num(r.priceFirst),hi:num(r.priceMax),lo:num(r.priceMin),pl:num(r.pDrCotVal),pc:num(r.pClosing),py:num(r.priceYesterday),vol:num(r.qTotTran5J)};try{localStorage.setItem("wlyd1",JSON.stringify(WYD))}catch(e){}}}catch(e){}}
function wlK(v){var a=Math.abs(v),f=function(x){return x.toLocaleString("fa-IR",{maximumFractionDigits:1})};return a>=1e9?f(a/1e9)+"B":(a>=1e6?f(a/1e6)+"M":(a>=1e3?f(a/1e3)+"K":cfp(a)))}
function wlPct(p,py,qf){if(!(p>0&&py>0))return'<td class="wpc">—</td>';var v=(p/py-1)*100,c=v>0?"var(--up)":(v<0?"var(--dn)":"inherit");if(qf)c=qf(c)||"inherit";return'<td class="wpc" style="color:'+c+';font-weight:700">'+cfp(Math.abs(v),2)+'</td>'}
function askText(t,v,cb){var o=document.getElementById("hb");if(o)o.remove();o=document.createElement("div");o.id="hb";o.innerHTML='<div class="bx"><b class="t">'+esc(t)+'</b><input id="at_i" style="width:100%" value="'+esc(v||"")+'"><button type="button" id="at_k">تأیید</button></div>';o.onclick=function(e){if(e.target===o)o.remove()};document.body.appendChild(o);var i=o.querySelector("#at_i");try{i.focus()}catch(e){}o.querySelector("#at_k").onclick=function(){var x=i.value.trim();o.remove();if(x)cb(x)}}
function wlCur(){var L=WL.lists;if(tab==="g"&&L&&L[WL.cur]&&!wlInG(L[WL.cur],WL.cur)){var m=L.findIndex(function(l){return l.name==="اصلی"});WL.cur=m>=0?m:0;WL.sk=null}return L&&L[WL.cur]?L[WL.cur]:null}
function wlBarRow(q,n){var py=q.py,pr=q.pl>0?q.pl:(q.pc>0?q.pc:0),pc=(WL.thr[q.c]||5)/100;if(!(py>0&&pr>0))return'<tr class="wlb"><td colspan="'+n+'"></td></tr>';
var X=function(p){return Math.max(0,Math.min(100,50+((p/py-1)/pc)*50))},x=X(pr),lo=q.lo>0?X(q.lo):x,hi=q.hi>0?X(q.hi):x;
return'<tr class="wlb"><td colspan="'+n+'"><div><b style="right:'+Math.min(lo,hi)+'%;width:'+Math.abs(hi-lo)+'%"></b><i style="right:'+x+'%"></i></div></td></tr>'}
function wlDetAll(C){return (C.flt==="ci2"?ciDetail(C):"")+(C.flt==="pb1"?pbDetail(C):"")+(C.flt==="bo1"?boDetail(C):"")+(C.flt==="qb1"?qbDetail(C):"")+(C.flt==="sx1"?sxDetail(C):"")+(C.flt==="fx1"?fxDetail(C):"")+(C.flt==="hs1"?hsDetail(C):"")+(C.flt==="nb1"?nbDetail(C):"")+(C.flt==="gb1"?gxDetail(C,"gb"):"")+(C.flt==="gm1"?gxDetail(C,"gm"):"")+(C.flt==="rs1"?rsDetail(C):"")+(C.flt==="wp1"?wpDetail(C):"")+((C.flt==="wp2"||C.flt==="kk1")?wxDetail(C):"")+(C.flt==="sm1"?smDetail(C):"")+(C.flt==="sc1"?scDetail(C):"")+(NX[C.flt]?nxDetail(C):"")}
// ===== علامت سؤال روی ستون‌های جدول «جزئیات» همه‌ی فیلترها (به‌جز ردیف، نماد و درصد) =====
var NQ={
"حجم×":"حجم معاملات امروز ÷ میانگین حجم ۲۰ روز معاملاتی قبل. مثلاً ×۲ یعنی امروز دو برابر یک روز معمولی معامله شده؛ حجم بالاتر سیگنال را معتبرتر می‌کند.",
"قدرت خریدار":"سرانه‌ی خرید حقیقی ÷ سرانه‌ی فروش حقیقی (میانگین حجم هر خریدار حقیقی ÷ میانگین حجم هر فروشنده‌ی حقیقی). بیشتر از ۱ یعنی خریدارها درشت‌تر از فروشنده‌ها هستند.",
"حجم÷میانگین ماه":"حجم امروز ÷ میانگین حجم ۳۰ روز معاملاتی قبل. هر چه بزرگ‌تر، حجم امروز غیرعادی‌تر است.",
"ورود پول حقیقی (B)":"(حجم خرید حقیقی − حجم فروش حقیقی) × قیمت، به میلیارد تومان. مثبت یعنی پول حقیقی وارد سهم شده است.",
"سقف":"بالاترین قیمت امروز؛ قیمتی که فروشنده‌ی حقوقی اجازه‌ی عبور از آن را نداده است.",
"برخورد ۱۰ روز":"تعداد روزهایی از ۱۰ روز معاملاتی اخیر (با امروز) که بالاترین قیمت روز به همین سقف رسیده (با اختلاف حداکثر ۰٫۴٪) و از آن بالاتر نرفته است.",
"دیوار فروش":"ردیفی از تابلوی فروش روی همان قیمت سقف که حجم سنگین و سفارش‌های درشت دارد: حجم / تعداد سفارش.",
"فروش حقوقی ٪":"حجم فروش حقوقی امروز ÷ حجم کل معاملات امروز.",
"تا سقف ٪":"فاصله‌ی آخرین قیمت تا سقف، به درصد. هرچه کمتر، قیمت به سقف نزدیک‌تر است.",
"حجم منفی÷مثبت":"میانگین حجم روزهای منفی ÷ میانگین حجم روزهای مثبت در ۱۵ روز اخیر. کمتر از ۱ یعنی فروش کم‌حجم و خرید پرحجم است (عرضه در حال تمام شدن).",
"عرضه تابلو÷ارزش روز ٪":"ارزش کل سفارش‌های فروش ۵ ردیف تابلو ÷ میانگین ارزش معاملات روزانه‌ی ۳۰ روز. کمتر یعنی تابلوی فروش خلوت‌تر است.",
"سهم مبلغ شما ٪":"مبلغ تعیین‌شده در تنظیمات ÷ میانگین ارزش معاملات روزانه. نشان می‌دهد کل مبلغ شما چند درصد معاملات یک روز سهم است؛ کمتر یعنی ورود و خروج راحت‌تر.",
"انقباض‌ها ٪":"دامنه‌ی نوسان (سقف − کف) ÷ سقف در سه بازه‌ی ۱۰ روزه‌ی پشت سر هم، از قدیم به جدید. باید پشت سر هم کوچک‌تر شوند.",
"vcp1|تا سقف ٪":"فاصله‌ی آخرین قیمت تا سقف ۱۲۰ روزه، به درصد.",
"rl1|تا سقف ٪":"فاصله‌ی آخرین قیمت تا سقف ۶۰ روزه، به درصد.",
"حجم ۱۰÷۵۰":"میانگین حجم ۱۰ روز اخیر ÷ میانگین حجم ۵۰ روز. کمتر از ۱ یعنی حجم در حال خشک شدن است (نشانه‌ی تمام شدن عرضه در الگوی VCP).",
"رتبه RS":"رتبه‌ی قدرت نسبی بین ۰ تا ۹۹: ۴۰٪ رتبه‌ی بازده ۲۰ روزه + ۶۰٪ رتبه‌ی بازده ۶۰ روزه در کل بازار انتخابی. ۹۰ یعنی از ۹۰٪ نمادها قوی‌تر بوده است.",
"بازده ۲۰ روز ٪":"تغییر قیمت در ۲۰ روز معاملاتی اخیر.",
"بازده ۶۰ روز ٪":"تغییر قیمت در ۶۰ روز معاملاتی اخیر.",
"حجم ۱۰ روز×":"میانگین حجم ۱۰ روز اخیر ÷ میانگین حجم ۵۰ روز قبل از آن.",
"دامنه ۱۰ روز ٪":"(بالاترین − پایین‌ترین قیمت ۱۰ روز اخیر) ÷ پایین‌ترین قیمت. کم بودن آن یعنی قیمت با وجود حجم بالا حرکت نکرده است.",
"امروز ٪":"تغییر قیمت امروز نسبت به دیروز.",
"پهنای باند قبل ٪":"کمترین پهنای باند بولینگر (۴ انحراف معیار ÷ میانگین ۲۰ روزه) در ۳ روز قبل از امروز.",
"عبور از باند ٪":"آخرین قیمت امروز چند درصد بالاتر از باند بالای بولینگر دیروز است.",
"کف اول":"پایین‌ترین قیمت در بازه‌ی ۴۵ تا ۱۵ روز معاملاتی پیش.",
"کف دوم":"پایین‌ترین قیمت از ۸ روز بعد از کف اول تا دیروز؛ باید حداکثر ۳٪ با کف اول اختلاف داشته باشد.",
"خط گردن":"در کف دوقلو: بالاترین قیمت بین دو کف. در سقف دوقلو: پایین‌ترین قیمت بین دو سقف. شکست آن تأیید الگو است.",
"db1|وضعیت":"«شکسته شد» یعنی آخرین قیمت بالای خط گردن است؛ «نزدیک گردن» یعنی حداکثر ۳٪ زیر آن.",
"dt1|وضعیت":"«شکسته شد» یعنی آخرین قیمت زیر خط گردن است؛ «نزدیک گردن» یعنی حداکثر ۳٪ بالای آن.",
"سقف اول":"بالاترین قیمت در بازه‌ی ۴۵ تا ۱۵ روز معاملاتی پیش.",
"سقف دوم":"بالاترین قیمت از ۸ روز بعد از سقف اول تا دیروز؛ حداکثر ۳٪ اختلاف با سقف اول.",
"امتیاز":"تعداد نشانه‌های مثبت از ۸ نشانه: بالای MA20، MA20 بالای MA50، MACD مثبت، RSI بین ۵۰ و ۷۰، حجم بالا، بسته شدن نزدیک سقف روز، قدرت خریدار و ورود پول حقیقی.",
"RSI":"شاخص قدرت نسبی ۱۴ روزه؛ بالای ۷۰ اشباع خرید، زیر ۳۰ اشباع فروش و بین ۵۰ تا ۷۰ روند صعودی سالم.",
"RSI امروز":"RSI ۱۴ روزه‌ی امروز.",
"RSI کف قبلی":"RSI در کف قبلی قیمت.","RSI کف جدید":"RSI در کف جدید قیمت؛ در واگرایی مثبت از کف قبلی بالاتر است.",
"RSI سقف قبلی":"RSI در سقف قبلی قیمت.","RSI سقف جدید":"RSI در سقف جدید قیمت؛ در واگرایی منفی از سقف قبلی پایین‌تر است.",
"افت کف ٪":"کف جدید قیمت چند درصد پایین‌تر از کف قبلی است.","رشد سقف ٪":"سقف جدید قیمت چند درصد بالاتر از سقف قبلی است.",
"حمایت":"کمترین قیمت ۲۰ یا ۶۰ روز معاملاتی قبل (هر کدام که کف امروز به آن نزدیک‌تر است).",
"فاصله تا حمایت ٪":"آخرین قیمت چند درصد بالاتر از خط حمایت است.",
"سایه÷بدنه":"طول سایه‌ی پایین کندل امروز ÷ طول بدنه. در کندل چکش حداقل ۲ است؛ بزرگ‌تر یعنی برگشت قوی‌تر از کف.",
"مرحله":"مرحله‌ی افزایش سرمایه از روی عنوان اطلاعیه: پیشنهاد هیئت مدیره، مجمع، پذیره‌نویسی، ثبت یا سایر.",
"عنوان":"عنوان اطلاعیه در کدال. با لمس ردیف، اطلاعیه باز می‌شود.",
"تاریخ":"تاریخ انتشار اطلاعیه در کدال.","تاریخ انتشار":"تاریخ انتشار آگهی دعوت به مجمع در کدال؛ تاریخ برگزاری داخل متن آگهی است.",
"حجم امروز":"تعداد سهم معامله‌شده امروز.","میانگین ماه":"میانگین حجم روزانه‌ی ۳۰ روز معاملاتی قبل.",
"sr1|وضعیت":"اینکه قیمت نزدیک حمایت (کمترین قیمت بازه) است یا مقاومت (بیشترین قیمت بازه) و طول بازه (۲۰، ۶۰ یا ۱۲۰ روز).",
"سطح":"قیمت خط حمایت یا مقاومت.","sr1|فاصله ٪":"فاصله‌ی آخرین قیمت تا سطح حمایت یا مقاومت، به درصد.",
"qg1|وضعیت":"«در حال کاهش» = هنوز در صف خرید ولی صف کوچک شده؛ «صف ریخت» = امروز به سقف رسیده ولی الان زیر سقف است.",
"qn1|وضعیت":"«در حال کاهش» = هنوز در صف فروش ولی صف کوچک شده؛ «صف جمع شد» = امروز به کف رسیده ولی الان بالای کف است.",
"حجم صف":"حجم سفارش‌های ردیف اول (صف) تابلو.","صف÷حجم امروز":"حجم صف ÷ حجم معامله‌شده‌ی امروز. کمتر یعنی صف نسبت به معاملات کوچک است و زودتر تمام می‌شود.",
"خریداران صف":"تعداد سفارش‌های خرید در ردیف اول تابلو.","فروشندگان صف":"تعداد سفارش‌های فروش در ردیف اول تابلو.",
"پیش‌بینی":"نوع صف احتمالی فردا: صف خرید یا صف فروش.",
"فاصله پایانی تا حد ٪":"فاصله‌ی قیمت پایانی تا سقف (یا کف) مجاز، نسبت به قیمت دیروز. کمتر از ۱٪ یعنی بیشتر معاملات روز روی صف انجام شده است.",
"الگو":"نوع الگوی شناسایی‌شده: پرچم صعودی، کنج نزولی یا مثلث (متقارن، صعودی، نزولی).",
"توضیح":"جزئیات عددی الگو (اندازه‌ی میله و مدت استراحت در پرچم، یا شیب سقف‌ها و کف‌ها).",
"فشردگی":"میانگین دامنه‌ی ۵ روز آخر ÷ میانگین دامنه‌ی ۵ روز اول بازه‌ی ۲۰ روزه. کمتر یعنی نوسان بیشتر جمع شده است.",
"اوراق":"نماد اوراق اختیار فروش تبعی منتشرشده برای این سهم.","تعداد سری":"تعداد سری‌های فعال اوراق تبعی.",
"قیمت اعمال":"قیمت اعمال اوراق تبعی (از نام اوراق)؛ ناشر متعهد است در سررسید سهم را به این قیمت بخرد.",
"قیمت سهم":"آخرین قیمت خود سهم.","نماد حق تقدم":"نماد حق تقدم (نماد سهم + «ح»).","آخرین حق":"آخرین قیمت حق تقدم.",
"حباب ٪":"(قیمت حق تقدم + ۱۰۰۰ ریال آورده) ÷ قیمت سهم − ۱. مثبت یعنی خرید حق تقدم گران‌تر از خود سهم تمام می‌شود.",
"حجم حق":"حجم معامله‌ی امروز حق تقدم.","نوع مجمع":"عادی سالیانه، عادی، فوق‌العاده یا فوق‌العاده‌ی افزایش سرمایه (از عنوان آگهی).",
"MA20":"میانگین متحرک ساده‌ی ۲۰ روزه‌ی قیمت پایانی.","MA50":"میانگین متحرک ساده‌ی ۵۰ روزه‌ی قیمت پایانی.",
"روز از کراس":"چند روز معاملاتی از قطع شدن خطوط گذشته؛ «امروز» یعنی کراس امروز رخ داده است.",
"md1|وضعیت":"«زیر صفر» یعنی کراس در محدوده‌ی منفی MACD رخ داده (زودهنگام)؛ «بالای صفر» یعنی روند صعودی از قبل شروع شده بوده.",
"MACD٪":"مقدار MACD (EMA12 − EMA26) ÷ قیمت، به درصد.",
"پهنای باند ٪":"پهنای باند بولینگر امروز: (باند بالا − باند پایین) ÷ میانگین ۲۰ روزه.",
"جای قیمت در باند ٪":"موقعیت قیمت بین دو باند: ۰ روی باند پایین، ۱۰۰ روی باند بالا.",
"سقف قبلی":"بالاترین قیمت ۱۲۰ روز معاملاتی قبل از امروز.","عبور ٪":"آخرین قیمت چند درصد بالاتر از سقف قبلی است.",
"بدنه امروز ٪":"طول بدنه‌ی سبز امروز ÷ قیمت دیروز.","افت ۴ روز قبل ٪":"افت قیمت در ۴ روز قبل از امروز (روند نزولی قبل از الگو).",
"رشد ۳ روز ٪":"رشد قیمت در سه روز الگو.","گپ ٪":"قیمت اولین معامله‌ی امروز چند درصد بالاتر از سقف دیروز است.","سقف دیروز":"بالاترین قیمت دیروز؛ تا وقتی قیمت به زیر آن برنگشته گپ پر نشده است.",
"آخرین ٪":"تغییر آخرین قیمت نسبت به دیروز.","کف روز ٪":"پایین‌ترین قیمت امروز نسبت به دیروز (حدود کف مجاز).","برگشت ٪":"فاصله‌ی آخرین قیمت از کف امروز، نسبت به قیمت دیروز.",
"سقف ابر":"بیشترِ سنکو A و سنکو B ایچیموکو برای امروز.","kc1|فاصله ٪":"آخرین قیمت چند درصد بالاتر از سقف ابر است.",
"خرید حقوقی ٪":"حجم خرید حقوقی ÷ حجم کل امروز.","خالص حقوقی (B)":"(خرید − فروش حقوقی) × قیمت پایانی، به میلیارد تومان.",
"میانگین ارزش روزانه (B)":"میانگین ارزش معاملات روزانه‌ی ۳۰ روز اخیر، به میلیارد تومان.","سهم از معاملات روز ٪":"مبلغ تعیین‌شده ÷ میانگین ارزش معاملات روزانه.",
"روز لازم برای ورود":"اگر هر روز حداکثر ۱۰٪ معاملات نماد را بخرید، ورود با کل مبلغ چند روز طول می‌کشد (خروج هم همین‌قدر).",
"ارزش صف (B)":"حجم صف خرید × سقف قیمت، به میلیارد تومان.","صف÷معاملات امروز ٪":"ارزش صف ÷ ارزش معاملات امروز.",
"روزهای صف":"تعداد روزهای پشت سر هم (با امروز) که نماد روی سقف مجاز بسته شده است.","ارزش صف امروز (B)":"حجم صف خرید امروز × قیمت سقف، به میلیارد تومان.","رشد در این روزها ٪":"رشد قیمت از قبل از شروع صف‌ها تا سقف امروز.",
"٪ از ارزش شرکت":"ارزش ۵ ردیف خرید تابلو ÷ ارزش بازار کل شرکت (تعداد سهام × قیمت).","ارزش ۵ ردیف خرید (B)":"مجموع حجم × قیمت ۵ ردیف اول خرید تابلو.","ارزش شرکت (B)":"ارزش بازار شرکت = تعداد کل سهام × آخرین قیمت.",
"خرید÷فروش تابلو":"ارزش ۵ ردیف خرید ÷ ارزش ۵ ردیف فروش. بیشتر از ۱ یعنی تابلو خریدارتر است.","صف":"اینکه نماد الان در صف خرید است یا نه.",
"هزینه‌ی تخمینی یک روز (B)":"بیشترِ «میانگین ارزش معاملات روزانه» و «ارزش ۵ ردیف فروش تا سقف مجاز»؛ تخمین مبلغ لازم برای جذب عرضه‌ی یک روز معمول.",
"عرضه تابلو (B)":"ارزش سفارش‌های فروش ۵ ردیف تابلو تا سقف مجاز.","روز با بودجه":"بودجه ÷ هزینه‌ی تخمینی یک روز.","روزهای صف ۳۰ روز":"تعداد روزهای ۳۰ روز اخیر که روی سقف مجاز بسته شده است.","الان":"وضعیت فعلی نماد: در صف خرید هست یا نه.",
"خروج پول (م.م)":"(حجم فروش حقیقی − حجم خرید حقیقی) × قیمت، به میلیارد تومان (م.م = میلیارد).","حجم به میانگین":"حجم امروز ÷ میانگین حجم ۳۰ روز.","نسبت سرانه":"سرانه‌ی خرید حقیقی ÷ سرانه‌ی فروش حقیقی؛ کمتر از ۱ یعنی فروشنده‌ها درشت‌ترند.",
"سرانه خرید":"ارزش خرید حقیقی ÷ تعداد خریداران حقیقی.","سرانه فروش":"ارزش فروش حقیقی ÷ تعداد فروشندگان حقیقی.","نسبت":"سرانه‌ی خرید ÷ سرانه‌ی فروش.","خریدار":"تعداد خریداران حقیقی امروز.",
"حجم/۱۴روز":"حجم امروز ÷ میانگین حجم ۱۴ روز معاملاتی قبل.","ریسک":"ارزیابی ساده‌ی ریسک ورود بر اساس رشد قیمت امروز و فاصله تا سقف مجاز.",
"شدت":"شدت کد به کد = (خرید حقیقی ÷ فروش حقیقی) × (فروش حقوقی ÷ خرید حقوقی) به ارزش ریالی، با افزودن ۱ میلیارد تومان به مخرج‌ها. بیشتر از ۳ لازم است.",
"سرانه خرید (م.ت)":"ارزش خرید حقیقی ÷ تعداد خریداران حقیقی، به میلیون تومان.","نسبت تابلو":"میانگین حجم هر خریدار حقیقی ÷ میانگین حجم هر فروشنده‌ی حقیقی.","ارزش (م.م)":"ارزش معاملات امروز، به میلیارد تومان.",
"کیجون":"خط کیجون‌سن امروز: میانگین بالاترین و پایین‌ترین قیمت ۲۶ روز معاملاتی.","کف امروز":"پایین‌ترین قیمت معامله‌شده‌ی امروز (زیر کیجون رفته).","آخرین":"آخرین قیمت معامله‌شده.",
"pb1|فاصله ٪":"(آخرین قیمت − کیجون) ÷ کیجون. کمتر یعنی قیمت هنوز نزدیک خط حمایت است.",
"تغییر ٪":"تغییر آخرین قیمت نسبت به قیمت دیروز.",
"ارزش بازار (م.م)":"ارزش بازار شرکت (تعداد سهام × قیمت)، به میلیارد تومان.","ارزش معاملات (م.م)":"ارزش معاملات امروز، به میلیارد تومان.",
"سفارش گروهی":"تعداد کل سفارش‌های خرید در ردیف‌هایی از تابلو که «گروهی» حساب شده‌اند (تعداد زیاد سفارش با حجم کم هر سفارش).",
"ردیف گروهی":"تعداد ردیف‌های تابلوی خرید که شرط «گروهی» را دارند.","حجم":"مجموع حجم سفارش‌های خرید در ردیف‌های گروهی.","ارزش":"حجم × قیمت سفارش‌های گروهی، به میلیارد تومان.",
"بیشترین تعداد":"بیشترین تعداد سفارش در یک ردیف تابلوی خرید.","نسبت به آستانه":"بیشترین تعداد سفارش ÷ آستانه‌ی «گروهی» در تنظیمات؛ بیشتر از ۱ یعنی از آستانه گذشته.",
"خرید÷فروش":"حجم ۵ ردیف خرید ÷ حجم ۵ ردیف فروش تابلو؛ بیشتر از ۱ یعنی تابلو خریدارتر است.",
"مقاومت ۲۰ روز":"بالاترین قیمت ۲۰ روز معاملاتی قبل از امروز؛ سطحی که شکستنش شروع صعود است.","تا مقاومت ٪":"آخرین قیمت چند درصد زیر مقاومت است.","حجم ۳ روز×":"میانگین حجم ۳ روز اخیر ÷ میانگین حجم ۲۰ روز قبل از آن.",
"اصلاح از سقف ٪":"عمق اصلاح: فاصله‌ی کف اصلاح تا سقف ۶۰ روزه، به درصد.","کف اصلاح":"پایین‌ترین قیمت اصلاح (در ۲ تا ۱۰ روز معاملاتی اخیر).","برگشت از کف ٪":"آخرین قیمت چند درصد بالاتر از کف اصلاح است.","RSI (کف←امروز)":"کمترین RSI در ۱۰ روز اخیر و RSI امروز؛ برگشت از زیر ۳۵ به بالای ۴۰ نشانه‌ی پایان فشار فروش است.",
"موج ۱ ٪":"رشد موج ۱ الیوت: از کف شروع تا سقف موج ۱.","اصلاح موج ۲ ٪":"موج ۲ چند درصد از طول موج ۱ را اصلاح کرده (۳۸٫۲ تا ۷۸٫۶ مجاز است).","سقف موج ۱":"بالاترین قیمت موج ۱؛ عبور از آن یعنی شروع موج ۳.","el1|عبور ٪":"آخرین قیمت چند درصد بالاتر از سقف موج ۱ است؛ کمتر یعنی موج ۳ تازه‌تر شروع شده.","هدف موج ۳":"هدف کلاسیک: کف موج ۲ + ۱٫۶۱۸ × طول موج ۱.",
"P/E":"قیمت ÷ سود هر سهم پیش‌بینی‌شده (EPS). کمتر یعنی سهم نسبت به سودش ارزان‌تر است.","P/E گروه":"میانگین P/E صنعت نماد؛ P/E سهم باید حداقل ۲۰٪ کمتر از آن باشد.","بازده سود نقدی ٪":"آخرین سود نقدی هر سهم (DPS) ÷ قیمت فعلی.",
"cfield0":"ستون سفارشی اول؛ مقداری که در کد فیلتر به (cfield0) داده‌اید.","cfield1":"ستون سفارشی دوم؛ مقدار (cfield1) در کد فیلتر.","cfield2":"ستون سفارشی سوم؛ مقدار (cfield2) در کد فیلتر."
};
function nqAdd(h,flt){return h.replace(/<th(\s+class="drw")?>([^<]+)<\/th>/g,function(m,cl,tx){var t=tx.trim();if(/^(ردیف|نماد|درصد)$/.test(t))return m;var d=NQ[flt+"|"+t]||NQ[t];if(!d)return m;return'<th'+(cl||"")+'>'+tx+'<span class="qm" data-nq="'+esc(flt+"|"+t)+'">?</span></th>'})}
