'<div class="mkadd"><input id="mkc_n" placeholder="نام ردیف"><input id="mkc_k" list="mkc_l" placeholder="قیمت (از فهرست tgju)"><datalist id="mkc_l">'+tgOpts(ks)+'</datalist>'+
